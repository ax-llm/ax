{
  "description": "Port-only: an agent run without its required context field goes on without inputValidation: 'fail', as this release does. TS fails it before any request.",
  "expected_output": {
    "answer": "Refunds take 30 days."
  },
  "expected_request_count": 3,
  "features": {
    "functions": false,
    "streaming": true,
    "structured_outputs": false
  },
  "input": {
    "question": "How long do refunds take?"
  },
  "kind": "agent_forward",
  "name": "agent-forward-input-context-field-missing-lenient",
  "options": {
    "contextFields": ["doc"],
    "directResponse": "off",
    "inputValidation": "lenient",
    "runtime": {
      "language": "JavaScript"
    }
  },
  "responses": [
    {
      "content": "{\"javascriptCode\":\"final(\\\"Answer the question\\\", {})\"}"
    },
    {
      "content": "{\"javascriptCode\":\"final(\\\"Answer the question\\\", {policy: \\\"Refunds take 30 days.\\\"})\"}"
    },
    {
      "content": "Answer: Refunds take 30 days."
    }
  ],
  "runtime_script": [
    {
      "expected_code": "final(\"Answer the question\", {})",
      "result": {
        "args": ["Answer the question", {}],
        "type": "final"
      }
    },
    {
      "expected_code": "final(\"Answer the question\", {policy: \"Refunds take 30 days.\"})",
      "result": {
        "args": [
          "Answer the question",
          {
            "policy": "Refunds take 30 days."
          }
        ],
        "type": "final"
      }
    }
  ],
  "signature": "question:string, doc:string -> answer:string"
}
