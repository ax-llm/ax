{
  "name": "credential-provider-401-no-retry",
  "kind": "ai_chat",
  "provider": "openai",
  "credential_provider_fixture": {
    "headers": [{ "Authorization": "Bearer rejected-fresh-token" }]
  },
  "request": {
    "chat_prompt": [{ "role": "user", "content": "One attempt only." }]
  },
  "transport_responses": [
    {
      "status": 401,
      "json": {
        "error": { "message": "bad fresh token", "code": "invalid_api_key" }
      }
    }
  ],
  "expected_error_contains": "bad fresh token",
  "expected_transport_request_count": 1,
  "expected_credential_requests": [
    {
      "profile": "openai",
      "operation": "chat",
      "method": "POST",
      "url": "https://api.openai.com/v1/chat/completions"
    }
  ],
  "expected_transport_requests": [
    { "headers": { "Authorization": "Bearer rejected-fresh-token" } }
  ]
}
