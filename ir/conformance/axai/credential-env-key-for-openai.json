{
  "env": {
    "ANTHROPIC_API_KEY": "anthropic-env-key",
    "ANTHROPIC_BASE_URL": "https://anthropic-proxy.test/v1",
    "OPENAI_API_KEY": "openai-env-key",
    "OPENAI_APIKEY": null,
    "OPENAI_BASE_URL": null
  },
  "expected_transport_request": {
    "headers": {
      "Authorization": "Bearer openai-env-key"
    },
    "url": "https://api.openai.com/v1/chat/completions"
  },
  "kind": "ai_chat",
  "model": "gpt-5.4-mini",
  "name": "credential-env-key-for-openai",
  "no_api_key": true,
  "provider": "openai",
  "request": {
    "chat_prompt": [
      {
        "content": "Hi",
        "role": "user"
      }
    ],
    "model_config": {
      "stream": false
    }
  },
  "transport_responses": [
    {
      "json": {
        "choices": [
          {
            "finish_reason": "stop",
            "index": 0,
            "message": {
              "content": "ok",
              "refusal": null,
              "role": "assistant"
            }
          }
        ],
        "id": "chatcmpl_sampling",
        "model": "gpt-5.4-mini",
        "object": "chat.completion",
        "usage": {
          "completion_tokens": 2,
          "prompt_tokens": 1,
          "total_tokens": 3
        }
      },
      "status": 200
    }
  ]
}
