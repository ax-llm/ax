      "fieldDescriptions": {
        "urgent": {
          "description": "Is this urgent?",
          "valueDescriptions": {
            "true": "Core task blocked",
            "false": "Routine request"
          }
        },
        "team": {
          "description": "Which team?",
          "valueDescriptions": {
            "billing": "Invoice problems"
          }
        }
      }
    },
    "modelConfig": {
      "stream": false
    }
  },
  "service_options": {},
  "transport_responses": [
    {
      "answers": {
        "urgent": {
          "type": "noul",
