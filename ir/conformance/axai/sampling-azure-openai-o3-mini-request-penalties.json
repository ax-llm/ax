{
  "api_version": "api-version=2024-10-21",
  "deployment_name": "o3-mini",
  "expected_transport_json_absent": [
    "temperature",
    "top_p",
    "max_completion_tokens",
    "presence_penalty",
    "frequency_penalty",
    "reasoning_effort"
  ],
  "expected_transport_request": {
    "json": {
      "n": 2
    }
  },
  "expected_warnings": [
    "Ax dropped presencePenalty for o3-mini: the model does not accept it.",
    "Ax dropped frequencyPenalty for o3-mini: the model does not accept it."
  ],
  "kind": "ai_chat",
  "model": "o3-mini",
  "name": "sampling-azure-openai-o3-mini-request-penalties",
  "provider": "azure-openai",
  "request": {
    "chat_prompt": [
      {
        "content": "Hi",
        "role": "user"
      }
    ],
    "model_config": {
      "frequencyPenalty": 0.2,
      "n": 2,
      "presencePenalty": 0.1,
      "stream": false
    }
  },
  "resource_name": "example",
  "transport_responses": [
    {
      "json": {
        "choices": [
          {
            "finish_reason": "stop",
            "index": 0,
            "message": {
              "content": "ok",
              "refusal": null,
              "role": "assistant"
            }
          }
        ],
        "id": "chatcmpl_sampling",
        "model": "o3-mini",
        "object": "chat.completion",
        "usage": {
          "completion_tokens": 2,
          "prompt_tokens": 1,
          "total_tokens": 3
        }
      },
      "status": 200
    }
  ]
}
