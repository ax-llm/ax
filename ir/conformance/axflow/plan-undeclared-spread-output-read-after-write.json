        "kind": "execute",
        "reads": ["topic"],
        "writes": ["audienceResult", "angle"],
        "outputs": ["angle"],
        "barrier": false,
        "stepIndex": 1
      },
      {
        "name": "join",
        "kind": "execute",
        "reads": ["facts", "angle"],
        "writes": ["joinResult", "answer"],
        "outputs": ["answer"],
        "barrier": false,
        "stepIndex": 2
      },
      {
        "name": "review",
        "kind": "execute",
        "reads": ["answer"],
        "writes": ["reviewResult"],
        "barrier": false,
        "stepIndex": 3
      }
    ],
    "groups": [
      {
