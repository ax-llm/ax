    },
    {
      "kind": "execute",
      "name": "join",
      "signature": "facts:string, angle:string -> answer:string"
    },
    {
      "kind": "execute",
      "name": "review",
      "signature": "answer:string -> verdict:string",
      "options": {
        "reads": ["answer"],
        "writes": ["reviewResult"],
        "isBarrier": false
      }
    }
  ],
