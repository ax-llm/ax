{
  "name": "structured-output-json-object-invented-key-retry",
  "kind": "forward",
  "signature": "task:string -> javascriptCode:code",
  "input": { "task": "write a program" },
  "features": {
    "structured_outputs": false,
    "structured_output_modes": ["json_object", "function"],
    "functions": true
  },
  "options": { "validation_retries": 1 },
  "responses": [
    { "content": "{\"request\":\"wrong key\"}" },
    { "content": "{\"javascriptCode\":\"final(42);\"}" }
  ],
  "expected_output": { "javascriptCode": "final(42);" },
  "expected_request_count": 2
}
