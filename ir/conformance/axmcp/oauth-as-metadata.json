{
  "name": "mcp oauth authorization-server metadata validation",
  "kind": "mcp",
  "operation": "oauth_as_metadata",
  "cases": [
    {
      "metadata": {
        "issuer": "https://auth.example.com/tenant",
        "authorization_endpoint": "https://auth.example.com/tenant/authorize",
        "token_endpoint": "https://auth.example.com/tenant/token",
        "code_challenge_methods_supported": ["S256"],
        "token_endpoint_auth_methods_supported": ["none", "client_secret_post"],
        "authorization_response_iss_parameter_supported": true
      },
      "expected_issuer": "https://auth.example.com/tenant",
      "require_authorization": true,
      "client_auth_method": "none",
      "expected": {
        "ok": true,
        "issuer": "https://auth.example.com/tenant",
        "authorizationEndpoint": "https://auth.example.com/tenant/authorize",
        "tokenEndpoint": "https://auth.example.com/tenant/token",
        "requireIss": true
      }
    },
    {
      "metadata": {
        "issuer": "https://auth.example.com",
        "authorization_endpoint": "https://auth.example.com/authorize",
        "token_endpoint": "https://auth.example.com/token",
        "code_challenge_methods_supported": ["plain"]
      },
      "expected_issuer": "https://auth.example.com",
      "require_authorization": true,
      "client_auth_method": "none",
      "expected": {
        "ok": false,
        "message": "Authorization server does not advertise PKCE S256 support"
      }
    },
    {
      "metadata": {
        "issuer": "https://auth.example.com",
        "token_endpoint": "https://auth.example.com/token",
        "token_endpoint_auth_methods_supported": ["client_secret_basic"]
      },
      "expected_issuer": "https://auth.example.com",
      "require_authorization": false,
      "client_auth_method": "client_secret_post",
      "expected": {
        "ok": false,
        "message": "Authorization server does not advertise token endpoint auth method client_secret_post"
      }
    }
  ]
}
