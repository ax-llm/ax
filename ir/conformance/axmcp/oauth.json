{
  "name": "mcp oauth PKCE and endpoint-keyed cached token flow",
  "kind": "mcp",
  "operation": "oauth",
  "endpoint": "https://example.com/mcp",
  "verifier": "test-verifier",
  "expected_challenge": "JBbiqONGWPaAmwXk_8bT6UnlPfrn65D32eZlJS-zGG0",
  "stored_token": {
