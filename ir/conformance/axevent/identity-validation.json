{
  "name": "event identity validation matches TypeScript before routing",
  "kind": "event",
  "operation": "identity_validation",
  "cases": [
    {
      "event": {
        "specversion": "1.0",
        "id": "event-1",
        "source": "test://events",
        "type": "test.event"
      },
      "expected_error": null
    },
    {
      "event": {
        "specversion": "1.0",
        "id": 42,
        "source": "test://events",
        "type": "test.event"
      },
      "expected_error": "AxEventEnvelope.id must be a non-empty string"
    },
    {
      "event": {
        "specversion": "1.0",
        "id": {},
        "source": "test://events",
        "type": "test.event"
      },
      "expected_error": "AxEventEnvelope.id must be a non-empty string"
    },
    {
      "event": {
        "specversion": "1.0",
        "id": [],
        "source": "test://events",
        "type": "test.event"
      },
      "expected_error": "AxEventEnvelope.id must be a non-empty string"
    },
    {
      "event": {
        "specversion": "1.0",
        "id": true,
        "source": "test://events",
        "type": "test.event"
      },
      "expected_error": "AxEventEnvelope.id must be a non-empty string"
    },
    {
      "event": {
        "specversion": "1.0",
        "id": null,
        "source": "test://events",
        "type": "test.event"
      },
      "expected_error": "AxEventEnvelope.id must be a non-empty string"
    },
    {
      "event": {
        "specversion": "1.0",
        "id": "",
        "source": "test://events",
        "type": "test.event"
      },
      "expected_error": "AxEventEnvelope.id must be a non-empty string"
    },
    {
      "event": {
        "specversion": "1.0",
        "id": " \t\r\n",
        "source": "test://events",
        "type": "test.event"
      },
      "expected_error": "AxEventEnvelope.id must be a non-empty string"
    },
    {
      "event": {
        "specversion": "1.0",
        "id": " ﻿ ",
        "source": "test://events",
        "type": "test.event"
      },
      "expected_error": "AxEventEnvelope.id must be a non-empty string"
    },
    {
      "event": {
        "specversion": "1.0",
        "id": " padded ",
        "source": "test://events",
        "type": "test.event"
      },
      "expected_error": null
    },
    {
      "event": {
        "specversion": "1.0",
        "id": "",
        "source": "test://events",
        "type": "test.event"
      },
      "expected_error": null
    },
    {
      "event": {
        "specversion": "1.0",
        "source": "test://events",
        "type": "test.event"
      },
      "expected_error": "AxEventEnvelope.id must be a non-empty string"
    },
    {
      "event": {
        "specversion": "1.0",
        "id": "event-1",
        "source": 42,
        "type": "test.event"
      },
      "expected_error": "AxEventEnvelope.source must be a non-empty string"
    },
    {
      "event": {
        "specversion": "1.0",
        "id": "event-1",
        "source": {},
        "type": "test.event"
      },
      "expected_error": "AxEventEnvelope.source must be a non-empty string"
