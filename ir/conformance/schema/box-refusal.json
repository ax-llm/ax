              "box": {
                "type": "object",
                "properties": {
                  "top": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "bottom": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "left": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "right": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": ["top", "bottom", "left", "right"],
                "additionalProperties": false
              }
            },
            "required": ["status", "box"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": ["refused"]
              }
            },
            "required": ["status"],
            "additionalProperties": false
          }
        ],
        "description": "Return normalized top, bottom, left and right edges in [0, 1], measured from the image top-left; top < bottom and left < right."
      }
    },
    "required": ["target"],
    "additionalProperties": false
  }
