{
  "name": "box-refusal",
  "kind": "json_schema",
  "signature": "query:string -> target:box(evidence, refusal return)",
  "target": "outputs",
  "expected_schema": {
    "type": "object",
    "title": "Schema",
    "properties": {
      "target": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
