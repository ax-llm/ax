  op ax.mcp.semantic @mcp_classify_discovery_result {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-modern-era"
    type signature = "(result:json) -> json"
    body @entry(%result: json) {
      %out = core.map
      %none = core.call intrinsic.none()
      core.set %out["valid"] = false
      core.set %out["serverInfo"] = %none
      %empty_meta = core.map
      core.set %out["meta"] = %empty_meta
      %is_object = core.type_is %result type "object"
      core.if %is_object {
        %result_type = core.get %result["resultType"] default ""
        %complete = core.call intrinsic.eq(%result_type, "complete")
        %versions = core.get %result["supportedVersions"] default null
        %versions_list = core.type_is %versions type "list"
        %versions_valid = core.let %versions_list
        core.if %versions_list {
          core.for %version in %versions {
            %version_string = core.type_is %version type "string"
            %version_invalid = core.call intrinsic.not(%version_string)
            core.if %version_invalid {
              %versions_valid = core.const false
            }
          }
        }
        %capabilities = core.get %result["capabilities"] default null
        %capabilities_valid = core.type_is %capabilities type "object"
        %ttl = core.get %result["ttlMs"] default null
        %ttl_number = core.type_is %ttl type "number"
        %ttl_valid = core.const false
        core.if %ttl_number {
          %ttl_text = core.call intrinsic.json.stringify(%ttl)
          %ttl_integer = core.regex_match %ttl_text pattern "^[0-9]+$"
          %ttl_nonnegative = core.call intrinsic.gte(%ttl, 0)
          %ttl_valid = core.call intrinsic.and(%ttl_integer, %ttl_nonnegative)
        }
        %scope = core.get %result["cacheScope"] default ""
        %private_scope = core.call intrinsic.eq(%scope, "private")
        %public_scope = core.call intrinsic.eq(%scope, "public")
        %scope_valid = core.call intrinsic.or(%private_scope, %public_scope)
        %shape_a = core.call intrinsic.and(%complete, %versions_valid)
        %shape_b = core.call intrinsic.and(%capabilities_valid, %ttl_valid)
        %shape_c = core.call intrinsic.and(%shape_a, %shape_b)
        %valid = core.call intrinsic.and(%shape_c, %scope_valid)
        core.if %valid {
          core.set %out["valid"] = true
          core.set %out["supportedVersions"] = %versions
          core.set %out["capabilities"] = %capabilities
          core.set %out["ttlMs"] = %ttl
          core.set %out["cacheScope"] = %scope
          %meta_raw = core.get %result["_meta"] default null
          %meta_is_object = core.type_is %meta_raw type "object"
          core.if %meta_is_object {
            %meta_base = core.map
            %meta = core.call intrinsic.map.merge(%meta_base, %meta_raw)
            core.set %out["meta"] = %meta
            %server_info_raw = core.get %meta["io.modelcontextprotocol/serverInfo"] default null
            %server_info_object = core.type_is %server_info_raw type "object"
            core.if %server_info_object {
              %server_name = core.get %server_info_raw["name"] default null
              %server_version = core.get %server_info_raw["version"] default null
              %server_name_string = core.type_is %server_name type "string"
              %server_version_string = core.type_is %server_version type "string"
              %server_info_valid = core.call intrinsic.and(%server_name_string, %server_version_string)
              core.if %server_info_valid {
                %server_info_base = core.map
                %server_info = core.call intrinsic.map.merge(%server_info_base, %server_info_raw)
                core.set %out["serverInfo"] = %server_info
              }
            }
          }
        }
      }
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_resolve_known_era {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-modern-era"
    type signature = "(configured:string, hint?:string, cached?:string, stored?:string) -> json"
    body @entry(%configured: string, %hint: string, %cached: string, %stored: string) {
      %out = core.map
      %configured_modern = core.call intrinsic.eq(%configured, "modern")
      %configured_legacy = core.call intrinsic.eq(%configured, "legacy")
      %configured_known = core.call intrinsic.or(%configured_modern, %configured_legacy)
      core.if %configured_known {
        core.set %out["era"] = %configured
        core.set %out["probe"] = false
        core.return %out
      }
      %hint_modern = core.call intrinsic.eq(%hint, "modern")
      %hint_legacy = core.call intrinsic.eq(%hint, "legacy")
      %hint_known = core.call intrinsic.or(%hint_modern, %hint_legacy)
      core.if %hint_known {
        core.set %out["era"] = %hint
        core.set %out["probe"] = false
        core.return %out
      }
      %cached_modern = core.call intrinsic.eq(%cached, "modern")
      %cached_legacy = core.call intrinsic.eq(%cached, "legacy")
      %cached_known = core.call intrinsic.or(%cached_modern, %cached_legacy)
      core.if %cached_known {
        core.set %out["era"] = %cached
        core.set %out["probe"] = false
        core.return %out
      }
      %stored_modern = core.call intrinsic.eq(%stored, "modern")
      %stored_legacy = core.call intrinsic.eq(%stored, "legacy")
      %stored_known = core.call intrinsic.or(%stored_modern, %stored_legacy)
      core.if %stored_known {
        core.set %out["era"] = %stored
        core.set %out["probe"] = false
        core.return %out
      }
      core.set %out["era"] = "modern"
      core.set %out["probe"] = true
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_select_mutual_version {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-modern-era"
    type signature = "(error_data:json, client_versions:list<string>) -> string"
    body @entry(%error_data: json, %client_versions: list<json>) {
      %is_object = core.type_is %error_data type "object"
      core.if %is_object {
        %supported = core.get %error_data["supported"] default null
        %supported_list = core.type_is %supported type "list"
        core.if %supported_list {
          core.for %version in %client_versions {
            %mutual = core.call intrinsic.contains(%supported, %version)
            core.if %mutual {
              core.return %version
            }
          }
        }
      }
      core.return ""
    }
  }

  op ax.mcp.semantic @mcp_build_request_meta {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-modern-era"
    type signature = "(existing:json, protocol_version:string, client_capabilities:json, client_info:json, log_level?:string, traceparent?:string, tracestate?:string) -> json"
    body @entry(%existing: json, %protocol_version: string, %client_capabilities: json, %client_info: json, %log_level: string, %traceparent: string, %tracestate: string) {
      %empty = core.map
      %out = core.let %empty
      %existing_object = core.type_is %existing type "object"
      core.if %existing_object {
        %out = core.call intrinsic.map.merge(%empty, %existing)
      }
      core.set %out["io.modelcontextprotocol/protocolVersion"] = %protocol_version
      core.set %out["io.modelcontextprotocol/clientCapabilities"] = %client_capabilities
      core.set %out["io.modelcontextprotocol/clientInfo"] = %client_info
      %log_missing = core.call intrinsic.is_none(%log_level)
      %has_log = core.call intrinsic.not(%log_missing)
      core.if %has_log {
        core.set %out["io.modelcontextprotocol/logLevel"] = %log_level
      }
      %has_traceparent = core.call intrinsic.truthy(%traceparent)
      core.if %has_traceparent {
        core.set %out["traceparent"] = %traceparent
      }
      %has_tracestate = core.call intrinsic.truthy(%tracestate)
      core.if %has_tracestate {
        core.set %out["tracestate"] = %tracestate
      }
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_client_capabilities {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-modern-era"
    type signature = "(has_roots:bool, has_sampling:bool, has_elicitation:bool, era:string, tasks_extension:bool) -> json"
    body @entry(%has_roots: bool, %has_sampling: bool, %has_elicitation: bool, %era: string, %tasks_extension: bool) {
      %out = core.map
      core.if %has_roots {
        %roots = core.map
