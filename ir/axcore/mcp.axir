      core.if %params_object {
        %tools_call = core.call intrinsic.eq(%method, "tools/call")
        %prompts_get = core.call intrinsic.eq(%method, "prompts/get")
        %named = core.call intrinsic.or(%tools_call, %prompts_get)
        core.if %named {
          %name = core.get %params["name"] default ""
          %name_string = core.type_is %name type "string"
          core.if %name_string {
            core.return %name
          }
        }
        %resources_read = core.call intrinsic.eq(%method, "resources/read")
        core.if %resources_read {
          %uri = core.get %params["uri"] default ""
          %uri_string = core.type_is %uri type "string"
          core.if %uri_string {
            core.return %uri
          }
        }
      }
      core.return ""
    }
  }

  op ax.mcp.semantic @mcp_header_value_plan {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-param-headers"
    type signature = "(value:string) -> json"
    body @entry(%value: string) {
      %out = core.map
      %edge_space = core.regex_match %value pattern "^[\\t ]|[\\t ]$"
      %sentinel_prefix = core.call intrinsic.string.starts_with(%value, "=?base64?")
      %sentinel_suffix = core.call intrinsic.string.ends_with(%value, "?=")
      %sentinel = core.call intrinsic.and(%sentinel_prefix, %sentinel_suffix)
      %unsafe_octet = core.regex_match %value pattern "[^\\t -~]"
      %edge_or_sentinel = core.call intrinsic.or(%edge_space, %sentinel)
      %encode = core.call intrinsic.or(%edge_or_sentinel, %unsafe_octet)
      core.if %encode {
        core.set %out["mode"] = "encode"
      } else {
        core.set %out["mode"] = "plain"
      }
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_param_header_bindings {
    attr body_source = "core"
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "mcp"
    tag "axmcp-param-headers"
    type signature = "(input_schema:json) -> json throws"
    body @entry(%input_schema: json) {
      %bindings = core.list
      %schema_object = core.type_is %input_schema type "object"
      %not_object = core.call intrinsic.not(%schema_object)
      core.if %not_object {
        core.return %bindings
      }
      %root_annotated = core.call intrinsic.map.contains(%input_schema, "x-mcp-header")
      core.if %root_annotated {
        %root_error = core.call intrinsic.error.validation("x-mcp-header at inputSchema is not statically reachable through properties")
        core.raise %root_error
      }
      %seen_names = core.list
      %properties = core.get %input_schema["properties"] default null
      %properties_object = core.type_is %properties type "object"
      core.if %properties_object {
        %property_names = core.call intrinsic.map.keys(%properties)
        core.for %property_name in %property_names {
          %property_schema = core.get %properties[%property_name] default null
          %property_object = core.type_is %property_schema type "object"
          core.if %property_object {
            %annotated = core.call intrinsic.map.contains(%property_schema, "x-mcp-header")
            core.if %annotated {
              %header_name = core.get %property_schema["x-mcp-header"] default null
              %header_string = core.type_is %header_name type "string"
              %header_not_string = core.call intrinsic.not(%header_string)
              core.if %header_not_string {
                %name_type_error = core.call intrinsic.error.validation("x-mcp-header must be a non-empty string")
                core.raise %name_type_error
              }
              %header_length = core.call intrinsic.len(%header_name)
              %header_nonempty = core.call intrinsic.gt(%header_length, 0)
              %header_invalid = core.call intrinsic.not(%header_nonempty)
              core.if %header_invalid {
                %name_error = core.call intrinsic.error.validation("x-mcp-header must be a non-empty string")
                core.raise %name_error
              }
              %token_valid = core.regex_match %header_name pattern "^[!#$%&'*+\\-.^_`|~0-9A-Za-z]+$"
              %token_invalid = core.call intrinsic.not(%token_valid)
              core.if %token_invalid {
                %token_error = core.call intrinsic.error.validation("x-mcp-header value is not an RFC 9110 field-name token")
                core.raise %token_error
              }
              %normalized_name = core.call intrinsic.string.lower(%header_name)
              %normalized_full_name = core.call intrinsic.string.format("mcp-param-{}", %normalized_name)
              %duplicate = core.call intrinsic.contains(%seen_names, %normalized_full_name)
              core.if %duplicate {
                %duplicate_error = core.call intrinsic.error.validation("x-mcp-header value is not case-insensitively unique")
                core.raise %duplicate_error
              }
              core.append %seen_names, %normalized_full_name
              %property_type = core.get %property_schema["type"] default null
              %type_string = core.call intrinsic.eq(%property_type, "string")
              %type_integer = core.call intrinsic.eq(%property_type, "integer")
              %type_boolean = core.call intrinsic.eq(%property_type, "boolean")
              %type_scalar_a = core.call intrinsic.or(%type_string, %type_integer)
              %type_valid = core.call intrinsic.or(%type_scalar_a, %type_boolean)
              %type_invalid = core.call intrinsic.not(%type_valid)
              core.if %type_invalid {
                %type_error = core.call intrinsic.error.validation("x-mcp-header requires type string, integer, or boolean")
                core.raise %type_error
              }
              %binding = core.map
              %full_header_name = core.call intrinsic.string.format("Mcp-Param-{}", %header_name)
              core.set %binding["headerName"] = %full_header_name
              %path = core.list
              core.append %path, %property_name
              core.set %binding["path"] = %path
              core.set %binding["type"] = %property_type
              core.append %bindings, %binding
            }
            %child_base = core.map
            %child_schema = core.call intrinsic.map.merge(%child_base, %property_schema)
            core.call intrinsic.map.delete(%child_schema, "x-mcp-header")
            %child_bindings = core.call @mcp_param_header_bindings(%child_schema)
            core.for %child_binding in %child_bindings {
              %child_header_name = core.get %child_binding["headerName"] default ""
              %child_normalized = core.call intrinsic.string.lower(%child_header_name)
              %child_duplicate = core.call intrinsic.contains(%seen_names, %child_normalized)
              core.if %child_duplicate {
                %child_duplicate_error = core.call intrinsic.error.validation("x-mcp-header value is not case-insensitively unique")
                core.raise %child_duplicate_error
              }
              core.append %seen_names, %child_normalized
              %child_path = core.get %child_binding["path"] default null
              %prefixed_path = core.list
              core.append %prefixed_path, %property_name
              core.for %child_part in %child_path {
                core.append %prefixed_path, %child_part
              }
              %prefixed_binding_base = core.map
              %prefixed_binding = core.call intrinsic.map.merge(%prefixed_binding_base, %child_binding)
              core.set %prefixed_binding["path"] = %prefixed_path
              core.append %bindings, %prefixed_binding
            }
          }
        }
      }
      %schema_keys = core.call intrinsic.map.keys(%input_schema)
      core.for %schema_key in %schema_keys {
        %is_properties = core.call intrinsic.eq(%schema_key, "properties")
        %is_annotation = core.call intrinsic.eq(%schema_key, "x-mcp-header")
        %skip_keyword = core.call intrinsic.or(%is_properties, %is_annotation)
        %visit_keyword = core.call intrinsic.not(%skip_keyword)
        core.if %visit_keyword {
          %keyword_value = core.get %input_schema[%schema_key] default null
          %keyword_object = core.type_is %keyword_value type "object"
          core.if %keyword_object {
