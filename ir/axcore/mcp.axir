  op ax.mcp.semantic @mcp_param_header_values {
    attr body_source = "core"
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "mcp"
    tag "axmcp-param-headers"
    type signature = "(bindings:json, arguments:json) -> json throws"
    body @entry(%bindings: json, %arguments: json) {
      %out = core.map
      %bindings_list = core.type_is %bindings type "list"
      %not_bindings = core.call intrinsic.not(%bindings_list)
      core.if %not_bindings {
        core.return %out
      }
      core.for %binding in %bindings {
        %header_name = core.get %binding["headerName"] default ""
        %path = core.get %binding["path"] default null
        %expected_type = core.get %binding["type"] default ""
        %current = core.let %arguments
        %present = core.const true
        core.for %part in %path {
          %current_object = core.type_is %current type "object"
          core.if %current_object {
            %has_part = core.call intrinsic.map.contains(%current, %part)
            core.if %has_part {
              %current = core.get %current[%part] default null
            } else {
              %present = core.const false
            }
          } else {
            %present = core.const false
          }
        }
        %is_null = core.call intrinsic.is_none(%current)
        %not_null = core.call intrinsic.not(%is_null)
        %emit_value = core.call intrinsic.and(%present, %not_null)
        core.if %emit_value {
          %expects_string = core.call intrinsic.eq(%expected_type, "string")
          core.if %expects_string {
            %is_string = core.type_is %current type "string"
            %invalid_string = core.call intrinsic.not(%is_string)
            core.if %invalid_string {
              %string_error = core.call intrinsic.error.validation("MCP parameter header expected string")
              core.raise %string_error
            }
            core.set %out[%header_name] = %current
          } else {
            %expects_boolean = core.call intrinsic.eq(%expected_type, "boolean")
            core.if %expects_boolean {
              %is_boolean = core.type_is %current type "boolean"
              %invalid_boolean = core.call intrinsic.not(%is_boolean)
              core.if %invalid_boolean {
                %boolean_error = core.call intrinsic.error.validation("MCP parameter header expected boolean")
                core.raise %boolean_error
              }
              core.if %current {
                core.set %out[%header_name] = "true"
              } else {
                core.set %out[%header_name] = "false"
              }
            } else {
              %is_number = core.type_is %current type "number"
              %not_number = core.call intrinsic.not(%is_number)
              core.if %not_number {
                %number_error = core.call intrinsic.error.validation("MCP parameter header expected integer")
                core.raise %number_error
              }
              %number_text = core.call intrinsic.json.stringify(%current)
              %is_integer = core.regex_match %number_text pattern "^-?(0|[1-9][0-9]*)$"
              %absolute = core.call intrinsic.math.abs(%current)
              %safe_high = core.call intrinsic.mul(9007199, 1000000000)
              %safe_max = core.call intrinsic.add(%safe_high, 254740991)
              %is_safe = core.call intrinsic.lte(%absolute, %safe_max)
              %valid_integer = core.call intrinsic.and(%is_integer, %is_safe)
              %invalid_integer = core.call intrinsic.not(%valid_integer)
              core.if %invalid_integer {
                %integer_error = core.call intrinsic.error.validation("MCP parameter header expected integer")
                core.raise %integer_error
              }
              core.set %out[%header_name] = %number_text
            }
          }
        }
      }
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_fold_cache_info {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-cacheable-results"
    type signature = "(pages:list<json>, fetched_at:number) -> json"
    body @entry(%pages: list<json>, %fetched_at: number) {
      %out = core.map
      core.set %out["fetchedAt"] = %fetched_at
      %page_count = core.call intrinsic.len(%pages)
      %has_pages = core.call intrinsic.gt(%page_count, 0)
      %ttl_valid = core.let %has_pages
      %first_ttl = core.const true
      %min_ttl = core.let 0
      %private_scope = core.const false
      %public_scope = core.let %has_pages
      core.for %page in %pages {
        %ttl = core.get %page["ttlMs"] default null
        %ttl_number = core.type_is %ttl type "number"
        %ttl_integer = core.const false
        %ttl_nonnegative = core.const false
        core.if %ttl_number {
          %ttl_text = core.call intrinsic.json.stringify(%ttl)
          %ttl_integer = core.regex_match %ttl_text pattern "^[0-9]+$"
          %ttl_nonnegative = core.call intrinsic.gte(%ttl, 0)
        }
        %page_ttl_valid = core.call intrinsic.and(%ttl_integer, %ttl_nonnegative)
        core.if %page_ttl_valid {
          core.if %first_ttl {
            %min_ttl = core.let %ttl
            %first_ttl = core.const false
          } else {
            %smaller = core.call intrinsic.lt(%ttl, %min_ttl)
            core.if %smaller {
              %min_ttl = core.let %ttl
            }
          }
        } else {
          %ttl_valid = core.const false
        }
        %scope = core.get %page["cacheScope"] default ""
        %page_private = core.call intrinsic.eq(%scope, "private")
        %page_public = core.call intrinsic.eq(%scope, "public")
        core.if %page_private {
          %private_scope = core.const true
        }
        %not_public = core.call intrinsic.not(%page_public)
        core.if %not_public {
          %public_scope = core.const false
        }
      }
      core.if %ttl_valid {
        core.set %out["ttlMs"] = %min_ttl
        %expires_at = core.call intrinsic.add(%fetched_at, %min_ttl)
        core.set %out["expiresAt"] = %expires_at
      }
      core.if %private_scope {
        core.set %out["cacheScope"] = "private"
      } else {
        core.if %public_scope {
          core.set %out["cacheScope"] = "public"
        }
      }
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_cache_freshness {
    attr body_source = "core"
    attr core_kind = "func"
