        }
      }
      %count = core.call intrinsic.len(%subscriptions)
      %has_subscriptions = core.call intrinsic.gt(%count, 0)
      core.if %has_subscriptions {
        core.set %out["resourceSubscriptions"] = %subscriptions
      } else {
        core.call intrinsic.map.delete(%out, "resourceSubscriptions")
      }
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_notification_subscription_filter {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    attr public = true
    tag "axmcp-subscriptions-listen"
    type signature = "(message:json, active_subscription_id?:string) -> json"
    body @entry(%message: json, %active_subscription_id: string) {
      %out = core.map
      core.set %out["deliver"] = true
      core.set %out["acknowledged"] = false
      %none = core.call intrinsic.none()
      core.set %out["subscriptionId"] = %none
      %message_text = core.call intrinsic.json.stringify(%message)
      %clean_message = core.call intrinsic.json.parse(%message_text)
      %message_object = core.type_is %clean_message type "object"
      core.if %message_object {
        %params = core.get %clean_message["params"] default null
        %params_object = core.type_is %params type "object"
        core.if %params_object {
          %meta = core.get %params["_meta"] default null
          %meta_object = core.type_is %meta type "object"
          core.if %meta_object {
            %subscription_id = core.get %meta["io.modelcontextprotocol/subscriptionId"] default null
            %subscription_string = core.type_is %subscription_id type "string"
            core.if %subscription_string {
              core.set %out["subscriptionId"] = %subscription_id
              %active_missing = core.call intrinsic.is_none(%active_subscription_id)
              core.if %active_missing {
              } else {
                %same_subscription = core.call intrinsic.eq(%subscription_id, %active_subscription_id)
                core.if %same_subscription {
                } else {
                  core.set %out["deliver"] = false
                }
              }
            }
            core.call intrinsic.map.delete(%meta, "io.modelcontextprotocol/subscriptionId")
            %meta_keys = core.call intrinsic.map.keys(%meta)
            %meta_count = core.call intrinsic.len(%meta_keys)
            %meta_empty = core.call intrinsic.eq(%meta_count, 0)
            core.if %meta_empty {
              core.call intrinsic.map.delete(%params, "_meta")
            }
          }
        }
        %method = core.get %clean_message["method"] default ""
        %is_ack = core.call intrinsic.eq(%method, "notifications/subscriptions/acknowledged")
        %delivered = core.get %out["deliver"] default false
        %ack_deliver = core.call intrinsic.and(%is_ack, %delivered)
        core.if %ack_deliver {
          %params = core.get %clean_message["params"] default null
          %params_object = core.type_is %params type "object"
          core.if %params_object {
            %notifications = core.get %params["notifications"] default null
            %notifications_object = core.type_is %notifications type "object"
            core.if %notifications_object {
              %received = core.get %out["subscriptionId"] default null
              %received_string = core.type_is %received type "string"
              %active_missing = core.call intrinsic.is_none(%active_subscription_id)
              %matches_active = core.const false
              core.if %active_missing {
                %matches_active = core.let %received_string
              } else {
                %matches_active = core.call intrinsic.eq(%received, %active_subscription_id)
              }
              core.if %matches_active {
                core.set %out["acknowledged"] = true
              }
            }
          }
        }
      }
      core.set %out["message"] = %clean_message
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_oauth_parse_www_authenticate {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    attr public = true
    tag "axmcp-oauth"
    type signature = "(www_authenticate:string) -> json"
    body @entry(%www_authenticate: string) {
      %out = core.map
      %scopes = core.list
      core.set %out["scopes"] = %scopes
      %parts = core.call intrinsic.string.split(%www_authenticate, ",")
      core.for %raw in %parts {
        %part = core.string_trim %raw
        %lower = core.call intrinsic.string.lower(%part)
        %bearer = core.call intrinsic.string.starts_with(%lower, "bearer ")
        core.if %bearer {
          %part = core.call intrinsic.string.slice(%part, 7)
          %part = core.string_trim %part
        }
        %pair = core.call intrinsic.string.split_once(%part, "=")
        %found = core.get %pair["found"] default false
        core.if %found {
          %name = core.get %pair["left"] default ""
          %name = core.string_trim %name
          %name = core.call intrinsic.string.lower(%name)
          %value = core.get %pair["right"] default ""
          %value = core.string_trim %value
          %value = core.call intrinsic.string.replace(%value, "\"", "")
          %is_resource = core.call intrinsic.eq(%name, "resource_metadata")
          core.if %is_resource {
            core.set %out["resourceMetadata"] = %value
          }
          %is_scope = core.call intrinsic.eq(%name, "scope")
          core.if %is_scope {
            %scopes = core.call intrinsic.string.split_trim_nonempty(%value, " ")
            core.set %out["scopes"] = %scopes
          }
        }
      }
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_oauth_discovery_endpoints {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    attr public = true
    tag "axmcp-oauth"
    type signature = "(requested_url:string, issuer:string, resource_metadata_url:string) -> json"
    body @entry(%requested_url: string, %issuer: string, %resource_metadata_url: string) {
      %out = core.map
      %resource_endpoints = core.list
      %as_endpoints = core.list
      core.set %out["resourceMetadataEndpoints"] = %resource_endpoints
      core.set %out["authorizationServerMetadataEndpoints"] = %as_endpoints
      %requested_scheme = core.call intrinsic.string.split_once(%requested_url, "://")
      %requested_valid = core.get %requested_scheme["found"] default false
      core.if %requested_valid {
      } else {
        core.set %out["ok"] = false
        core.set %out["message"] = "OAuth requested URL is invalid"
        core.return %out
      }
      %requested_rest = core.get %requested_scheme["right"] default ""
      %requested_scheme_name = core.get %requested_scheme["left"] default ""
      %requested_parts = core.call intrinsic.string.split_once(%requested_rest, "/")
      %requested_authority = core.get %requested_parts["left"] default ""
      %requested_origin = core.call intrinsic.string.format("{}://{}", %requested_scheme_name, %requested_authority)
      %requested_path_raw = core.get %requested_parts["right"] default ""
      %requested_query = core.call intrinsic.string.split_once(%requested_path_raw, "?")
      %requested_path_raw = core.get %requested_query["left"] default ""
      %requested_path = core.call intrinsic.string.format("/{}", %requested_path_raw)
      %requested_trim = core.call intrinsic.string.remove_suffix(%requested_path, "/")
      %requested_path = core.get %requested_trim["value"] default ""
      %has_header_endpoint = core.call intrinsic.truthy(%resource_metadata_url)
      core.if %has_header_endpoint {
        core.append %resource_endpoints, %resource_metadata_url
      } else {
        %has_path = core.call intrinsic.truthy(%requested_path)
        core.if %has_path {
          %path_endpoint = core.call intrinsic.string.format("{}/.well-known/oauth-protected-resource{}", %requested_origin, %requested_path)
          core.append %resource_endpoints, %path_endpoint
        }
        %root_endpoint = core.call intrinsic.string.format("{}/.well-known/oauth-protected-resource", %requested_origin)
        core.append %resource_endpoints, %root_endpoint
      }
      %has_issuer = core.call intrinsic.truthy(%issuer)
      core.if %has_issuer {
        %issuer_scheme = core.call intrinsic.string.split_once(%issuer, "://")
        %issuer_valid = core.get %issuer_scheme["found"] default false
        core.if %issuer_valid {
        } else {
          core.set %out["ok"] = false
          core.set %out["message"] = "OAuth issuer URL is invalid"
          core.return %out
        }
        %issuer_rest = core.get %issuer_scheme["right"] default ""
        %issuer_scheme_name = core.get %issuer_scheme["left"] default ""
        %issuer_parts = core.call intrinsic.string.split_once(%issuer_rest, "/")
        %issuer_authority = core.get %issuer_parts["left"] default ""
        %issuer_origin = core.call intrinsic.string.format("{}://{}", %issuer_scheme_name, %issuer_authority)
        %issuer_path_raw = core.get %issuer_parts["right"] default ""
        %issuer_query = core.call intrinsic.string.split_once(%issuer_path_raw, "?")
        %issuer_path_raw = core.get %issuer_query["left"] default ""
        %issuer_path = core.call intrinsic.string.format("/{}", %issuer_path_raw)
        %issuer_trim = core.call intrinsic.string.remove_suffix(%issuer_path, "/")
        %issuer_path = core.get %issuer_trim["value"] default ""
        %issuer_has_path = core.call intrinsic.truthy(%issuer_path)
        core.if %issuer_has_path {
          %oauth_path = core.call intrinsic.string.format("{}/.well-known/oauth-authorization-server{}", %issuer_origin, %issuer_path)
          %oidc_path = core.call intrinsic.string.format("{}/.well-known/openid-configuration{}", %issuer_origin, %issuer_path)
          %oidc_suffix = core.call intrinsic.string.format("{}{}{}", %issuer_origin, %issuer_path, "/.well-known/openid-configuration")
          core.append %as_endpoints, %oauth_path
          core.append %as_endpoints, %oidc_path
          core.append %as_endpoints, %oidc_suffix
        } else {
          %oauth_root = core.call intrinsic.string.format("{}/.well-known/oauth-authorization-server", %issuer_origin)
          %oidc_root = core.call intrinsic.string.format("{}/.well-known/openid-configuration", %issuer_origin)
          core.append %as_endpoints, %oauth_root
          core.append %as_endpoints, %oidc_root
        }
      }
      core.set %out["ok"] = true
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_oauth_validate_resource_coverage {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    attr public = true
    tag "axmcp-oauth"
    type signature = "(requested_url:string, metadata:json) -> json"
    body @entry(%requested_url: string, %metadata: json) {
      %out = core.map
      %resource = core.get %metadata["resource"] default null
      %resource_string = core.type_is %resource type "string"
      core.if %resource_string {
      } else {
        core.set %out["ok"] = false
        core.set %out["message"] = "Protected resource metadata is missing resource"
        core.return %out
      }
      %resource_trim = core.call intrinsic.string.remove_suffix(%resource, "/")
      %resource = core.get %resource_trim["value"] default %resource
      %requested_trim = core.call intrinsic.string.remove_suffix(%requested_url, "/")
      %requested = core.get %requested_trim["value"] default %requested_url
      %exact = core.call intrinsic.eq(%requested, %resource)
      %resource_prefix = core.call intrinsic.string.format("{}/", %resource)
      %nested = core.call intrinsic.string.starts_with(%requested, %resource_prefix)
      %covered = core.call intrinsic.or(%exact, %nested)
      core.if %covered {
      } else {
        core.set %out["ok"] = false
        %message = core.call intrinsic.string.format("Protected resource metadata resource {} does not cover requested URL {}", %resource, %requested_url)
        core.set %out["message"] = %message
        core.return %out
      }
      %issuers = core.get %metadata["authorization_servers"] default null
      %issuers_list = core.type_is %issuers type "list"
      core.if %issuers_list {
      } else {
        core.set %out["ok"] = false
        core.set %out["message"] = "No authorization_servers advertised by protected resource"
        core.return %out
      }
      %issuer_count = core.call intrinsic.len(%issuers)
      %has_issuers = core.call intrinsic.gt(%issuer_count, 0)
      core.if %has_issuers {
      } else {
        core.set %out["ok"] = false
        core.set %out["message"] = "No authorization_servers advertised by protected resource"
        core.return %out
      }
      %clean_issuers = core.list
      core.for %issuer in %issuers {
        %issuer_string = core.type_is %issuer type "string"
        core.if %issuer_string {
          core.append %clean_issuers, %issuer
        } else {
          core.set %out["ok"] = false
          core.set %out["message"] = "Protected resource metadata authorization_servers must contain strings"
          core.return %out
        }
      }
      core.set %out["ok"] = true
      core.set %out["resource"] = %resource
      core.set %out["issuers"] = %clean_issuers
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_oauth_validate_as_metadata {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    attr public = true
    tag "axmcp-oauth"
    type signature = "(metadata:json, expected_issuer:string, require_authorization:bool, client_auth_method:string) -> json"
    body @entry(%metadata: json, %expected_issuer: string, %require_authorization: bool, %client_auth_method: string) {
      %out = core.map
      %none_auth = core.call intrinsic.eq(%client_auth_method, "none")
      %secret_post = core.call intrinsic.eq(%client_auth_method, "client_secret_post")
      %auth_supported = core.call intrinsic.or(%none_auth, %secret_post)
      core.if %auth_supported {
      } else {
        core.set %out["ok"] = false
        core.set %out["message"] = "OAuth client auth method must be none or client_secret_post"
        core.return %out
      }
      %issuer = core.get %metadata["issuer"] default null
      %issuer_string = core.type_is %issuer type "string"
      %token_endpoint = core.get %metadata["token_endpoint"] default null
      %token_string = core.type_is %token_endpoint type "string"
      %base_valid = core.call intrinsic.and(%issuer_string, %token_string)
      core.if %base_valid {
      } else {
        core.set %out["ok"] = false
        core.set %out["message"] = "Authorization server metadata is missing issuer or token_endpoint"
        core.return %out
      }
      %issuer_matches = core.call intrinsic.eq(%issuer, %expected_issuer)
      core.if %issuer_matches {
      } else {
        core.set %out["ok"] = false
        %message = core.call intrinsic.string.format("OAuth AS metadata issuer mismatch: expected {}, received {}", %expected_issuer, %issuer)
        core.set %out["message"] = %message
        core.return %out
      }
      %advertised_auth = core.get %metadata["token_endpoint_auth_methods_supported"] default null
      %advertised_list = core.type_is %advertised_auth type "list"
      core.if %advertised_list {
        %method_advertised = core.call intrinsic.contains(%advertised_auth, %client_auth_method)
        core.if %method_advertised {
        } else {
          core.set %out["ok"] = false
          %message = core.call intrinsic.string.format("Authorization server does not advertise token endpoint auth method {}", %client_auth_method)
          core.set %out["message"] = %message
          core.return %out
        }
      }
      %authorization_endpoint = core.get %metadata["authorization_endpoint"] default null
      core.if %require_authorization {
        %authorization_string = core.type_is %authorization_endpoint type "string"
        core.if %authorization_string {
        } else {
          core.set %out["ok"] = false
          core.set %out["message"] = "Authorization server metadata is missing authorization_endpoint"
          core.return %out
        }
        %challenge_methods = core.get %metadata["code_challenge_methods_supported"] default null
        %challenge_list = core.type_is %challenge_methods type "list"
        core.if %challenge_list {
          %has_s256 = core.call intrinsic.contains(%challenge_methods, "S256")
          core.if %has_s256 {
          } else {
            core.set %out["ok"] = false
            core.set %out["message"] = "Authorization server does not advertise PKCE S256 support"
            core.return %out
          }
        } else {
          core.set %out["ok"] = false
          core.set %out["message"] = "Authorization server does not advertise PKCE S256 support"
          core.return %out
        }
      }
      core.set %out["ok"] = true
      core.set %out["issuer"] = %issuer
      core.set %out["tokenEndpoint"] = %token_endpoint
      core.if %require_authorization {
        core.set %out["authorizationEndpoint"] = %authorization_endpoint
      }
      %require_iss = core.get %metadata["authorization_response_iss_parameter_supported"] default false
      core.set %out["requireIss"] = %require_iss
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_oauth_authorization_request_params {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    attr public = true
    tag "axmcp-oauth"
    type signature = "(client_id:string, redirect_uri:string, scopes:list<string>, resource:string, state:string, code_challenge:string) -> json"
    body @entry(%client_id: string, %redirect_uri: string, %scopes: list<string>, %resource: string, %state: string, %code_challenge: string) {
      %out = core.map
      core.set %out["response_type"] = "code"
      core.set %out["client_id"] = %client_id
      core.set %out["redirect_uri"] = %redirect_uri
      core.set %out["state"] = %state
