      %has_resource = core.call intrinsic.truthy(%resource)
      core.if %has_resource {
        core.set %out["resource"] = %resource
      }
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_oauth_grant_body {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    attr public = true
    tag "axmcp-oauth"
    type signature = "(grant_type:string, client_id:string, client_secret:string, client_auth_method:string, resource:string, scopes:list<string>, code:string, redirect_uri:string, code_verifier:string, refresh_token:string) -> json"
    body @entry(%grant_type: string, %client_id: string, %client_secret: string, %client_auth_method: string, %resource: string, %scopes: list<string>, %code: string, %redirect_uri: string, %code_verifier: string, %refresh_token: string) {
      %out = core.map
      %body = core.map
      %none_auth = core.call intrinsic.eq(%client_auth_method, "none")
      %secret_post = core.call intrinsic.eq(%client_auth_method, "client_secret_post")
      %auth_supported = core.call intrinsic.or(%none_auth, %secret_post)
      core.if %auth_supported {
      } else {
        core.set %out["ok"] = false
        core.set %out["message"] = "OAuth client auth method must be none or client_secret_post"
        core.return %out
      }
      %has_client_id = core.call intrinsic.truthy(%client_id)
      core.if %has_client_id {
      } else {
        core.set %out["ok"] = false
        core.set %out["message"] = "OAuth client ID required"
        core.return %out
      }
      core.set %body["grant_type"] = %grant_type
      core.set %body["client_id"] = %client_id
      core.if %secret_post {
        %has_secret = core.call intrinsic.truthy(%client_secret)
        core.if %has_secret {
          core.set %body["client_secret"] = %client_secret
        } else {
          core.set %out["ok"] = false
          core.set %out["message"] = "OAuth client secret required"
          core.return %out
        }
      }
      %is_code = core.call intrinsic.eq(%grant_type, "authorization_code")
      %is_refresh = core.call intrinsic.eq(%grant_type, "refresh_token")
      %is_client = core.call intrinsic.eq(%grant_type, "client_credentials")
      core.if %is_code {
        %has_code = core.call intrinsic.truthy(%code)
        %has_redirect = core.call intrinsic.truthy(%redirect_uri)
        %has_verifier = core.call intrinsic.truthy(%code_verifier)
        %code_a = core.call intrinsic.and(%has_code, %has_redirect)
        %code_valid = core.call intrinsic.and(%code_a, %has_verifier)
        core.if %code_valid {
          core.set %body["code"] = %code
          core.set %body["redirect_uri"] = %redirect_uri
          core.set %body["code_verifier"] = %code_verifier
        } else {
          core.set %out["ok"] = false
          core.set %out["message"] = "OAuth authorization_code grant requires code, redirect_uri, and code_verifier"
          core.return %out
        }
      } else {
        core.if %is_refresh {
          %has_refresh = core.call intrinsic.truthy(%refresh_token)
          core.if %has_refresh {
            core.set %body["refresh_token"] = %refresh_token
          } else {
            core.set %out["ok"] = false
            core.set %out["message"] = "OAuth refresh_token grant requires refresh_token"
            core.return %out
          }
        } else {
          core.if %is_client {
          } else {
            core.set %out["ok"] = false
            %message = core.call intrinsic.string.format("OAuth unsupported grant type {}", %grant_type)
            core.set %out["message"] = %message
            core.return %out
          }
        }
      }
      %has_resource = core.call intrinsic.truthy(%resource)
      core.if %has_resource {
        core.set %body["resource"] = %resource
      }
      %scope_count = core.call intrinsic.len(%scopes)
      %has_scopes = core.call intrinsic.gt(%scope_count, 0)
      core.if %has_scopes {
        %scope = core.call intrinsic.string.join(" ", %scopes)
        core.set %body["scope"] = %scope
      }
      core.set %out["ok"] = true
      core.set %out["body"] = %body
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_oauth_parse_token_response {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    attr public = true
    tag "axmcp-oauth"
    type signature = "(response:json, now_ms:number, previous_refresh_token:string, issuer:string) -> json"
    body @entry(%response: json, %now_ms: number, %previous_refresh_token: string, %issuer: string) {
      %out = core.map
      %access_token = core.get %response["access_token"] default null
      %access_string = core.type_is %access_token type "string"
      core.if %access_string {
      } else {
        core.set %out["ok"] = false
        core.set %out["message"] = "OAuth token response is missing access_token"
        core.return %out
      }
      %token_type = core.get %response["token_type"] default null
      %token_type_string = core.type_is %token_type type "string"
      core.if %token_type_string {
      } else {
        core.set %out["ok"] = false
        core.set %out["message"] = "OAuth token response is missing token_type"
        core.return %out
      }
      %token_type_lower = core.call intrinsic.string.lower(%token_type)
      %bearer = core.call intrinsic.eq(%token_type_lower, "bearer")
      core.if %bearer {
      } else {
        %message = core.call intrinsic.string.format("OAuth returned unsupported token_type {}", %token_type)
        core.set %out["ok"] = false
        core.set %out["message"] = %message
        core.return %out
      }
      %token = core.map
      core.set %token["accessToken"] = %access_token
      core.set %token["tokenType"] = "Bearer"
      %refresh_token = core.get %response["refresh_token"] default null
      %refresh_string = core.type_is %refresh_token type "string"
      core.if %refresh_string {
        core.set %token["refreshToken"] = %refresh_token
      } else {
        %has_previous = core.call intrinsic.truthy(%previous_refresh_token)
        core.if %has_previous {
          core.set %token["refreshToken"] = %previous_refresh_token
        }
      }
      %expires_in = core.get %response["expires_in"] default null
      %expires_number = core.type_is %expires_in type "number"
      core.if %expires_number {
        %expires_nonnegative = core.call intrinsic.gte(%expires_in, 0)
        core.if %expires_nonnegative {
          %expires_ms = core.call intrinsic.mul(%expires_in, 1000)
          %expires_at = core.call intrinsic.add(%now_ms, %expires_ms)
          core.set %token["expiresAt"] = %expires_at
        } else {
          core.set %out["ok"] = false
          core.set %out["message"] = "OAuth token response expires_in must be non-negative"
          core.return %out
        }
      }
      %scope = core.get %response["scope"] default null
      %scope_string = core.type_is %scope type "string"
      core.if %scope_string {
        core.set %token["scope"] = %scope
      }
      %has_issuer = core.call intrinsic.truthy(%issuer)
      core.if %has_issuer {
        core.set %token["issuer"] = %issuer
      }
      core.set %out["ok"] = true
      core.set %out["token"] = %token
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_oauth_plan_ensure_token {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    attr public = true
    tag "axmcp-oauth"
    type signature = "(token:json, now_ms:number, force_refresh:bool, grant_type:string, has_on_auth_code:bool) -> json"
    body @entry(%token: json, %now_ms: number, %force_refresh: bool, %grant_type: string, %has_on_auth_code: bool) {
      %out = core.map
      %token_object = core.type_is %token type "object"
      core.if %token_object {
        %access_token = core.get %token["accessToken"] default null
        %has_access = core.call intrinsic.truthy(%access_token)
        %fresh = core.const true
        %expires_at = core.get %token["expiresAt"] default null
        %expires_number = core.type_is %expires_at type "number"
        core.if %expires_number {
          %refresh_at = core.call intrinsic.add(%expires_at, -60000)
          %fresh = core.call intrinsic.lt(%now_ms, %refresh_at)
        }
        %not_forced = core.call intrinsic.not(%force_refresh)
        %usable_a = core.call intrinsic.and(%has_access, %fresh)
        %usable = core.call intrinsic.and(%usable_a, %not_forced)
        core.if %usable {
          core.set %out["ok"] = true
          core.set %out["action"] = "cached"
          core.set %out["token"] = %token
          core.return %out
        }
        %refresh_token = core.get %token["refreshToken"] default null
        %has_refresh = core.call intrinsic.truthy(%refresh_token)
        core.if %has_refresh {
          core.set %out["ok"] = true
          core.set %out["action"] = "refresh"
          core.set %out["refreshToken"] = %refresh_token
          core.return %out
        }
      }
      %client_credentials = core.call intrinsic.eq(%grant_type, "client_credentials")
      core.if %client_credentials {
        core.set %out["ok"] = true
        core.set %out["action"] = "client_credentials"
        core.return %out
      }
      core.if %has_on_auth_code {
        core.set %out["ok"] = true
        core.set %out["action"] = "authorize"
        core.return %out
      }
      core.set %out["ok"] = false
      core.set %out["message"] = "Authorization required. Provide oauth.onAuthCode to complete the flow"
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_oauth_validate_issuer {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    attr public = true
    tag "axmcp-oauth"
    type signature = "(response:json, expected_issuer:string, require_iss:bool) -> json"
    body @entry(%response: json, %expected_issuer: string, %require_iss: bool) {
      %state = core.get %response["state"] default null
      %expected_state = core.get %response["expectedState"] default null
      %state_matches = core.call intrinsic.eq(%state, %expected_state)
      core.if %state_matches {
      } else {
        %out = core.map
        core.set %out["ok"] = false
        core.set %out["message"] = "OAuth state mismatch"
        core.return %out
      }
      %returned_issuer = core.get %response["iss"] default null
      %issuer_missing = core.call intrinsic.is_none(%returned_issuer)
      core.if %issuer_missing {
        core.if %require_iss {
          %out = core.map
          core.set %out["ok"] = false
          core.set %out["message"] = "OAuth authorization response issuer is required"
          core.return %out
        }
      } else {
        %issuer_matches = core.call intrinsic.eq(%returned_issuer, %expected_issuer)
        core.if %issuer_matches {
        } else {
          %message = core.call intrinsic.string.format("OAuth issuer mismatch: expected {}, received {}", %expected_issuer, %returned_issuer)
          %out = core.map
          core.set %out["ok"] = false
          core.set %out["message"] = %message
          core.return %out
        }
      }
      %out = core.map
      core.set %out["ok"] = true
      core.return %out
    }
  }
}
