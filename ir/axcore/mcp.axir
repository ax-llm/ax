        %elicitation_url = core.map
        core.set %elicitation["form"] = %elicitation_form
        core.set %elicitation["url"] = %elicitation_url
        core.set %out["elicitation"] = %elicitation
      }
      %modern = core.call intrinsic.eq(%era, "modern")
      %add_tasks = core.call intrinsic.and(%modern, %tasks_extension)
      core.if %add_tasks {
        %extensions = core.map
        %tasks = core.map
        core.set %extensions["io.modelcontextprotocol/tasks"] = %tasks
        core.set %out["extensions"] = %extensions
      }
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_negotiate_extensions {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-modern-era"
    type signature = "(client_ext:json, server_ext:json) -> json"
    body @entry(%client_ext: json, %server_ext: json) {
      %out = core.map
      %client_object = core.type_is %client_ext type "object"
      %server_object = core.type_is %server_ext type "object"
      %both_objects = core.call intrinsic.and(%client_object, %server_object)
      core.if %both_objects {
        %names = core.call intrinsic.map.keys(%client_ext)
        core.for %name in %names {
          %server_has = core.call intrinsic.map.contains(%server_ext, %name)
          core.if %server_has {
            %client_value = core.get %client_ext[%name] default null
            %server_value = core.get %server_ext[%name] default null
            %client_value_object = core.type_is %client_value type "object"
            %server_value_object = core.type_is %server_value type "object"
            %values_objects = core.call intrinsic.and(%client_value_object, %server_value_object)
            core.if %values_objects {
              %merged = core.call intrinsic.map.merge(%client_value, %server_value)
              core.set %out[%name] = %merged
            } else {
              core.set %out[%name] = %server_value
            }
          }
        }
      }
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_request_name {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-modern-era"
    type signature = "(method:string, params:json) -> string"
    body @entry(%method: string, %params: json) {
