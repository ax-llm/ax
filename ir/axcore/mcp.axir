            %keyword_binding_count = core.call intrinsic.len(%keyword_bindings)
            %keyword_annotated = core.call intrinsic.gt(%keyword_binding_count, 0)
            core.if %keyword_annotated {
              %keyword_error = core.call intrinsic.error.validation("x-mcp-header is not statically reachable through properties")
              core.raise %keyword_error
            }
          }
          %keyword_list = core.type_is %keyword_value type "list"
          core.if %keyword_list {
            core.for %keyword_item in %keyword_value {
              %keyword_item_object = core.type_is %keyword_item type "object"
              core.if %keyword_item_object {
                %item_bindings = core.call @mcp_param_header_bindings(%keyword_item)
                %item_binding_count = core.call intrinsic.len(%item_bindings)
                %item_annotated = core.call intrinsic.gt(%item_binding_count, 0)
                core.if %item_annotated {
                  %item_error = core.call intrinsic.error.validation("x-mcp-header is not statically reachable through properties")
                  core.raise %item_error
