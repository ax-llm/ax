        core.set %response["id"] = %id
        core.set %response["result"] = %result
        core.set %out["action"] = "respond"
        core.set %out["response"] = %response
        core.return %out
      }
      %roots_list = core.call intrinsic.eq(%method, "roots/list")
      core.if %roots_list {
        %roots_missing = core.call intrinsic.is_none(%roots)
        core.if %roots_missing {
        } else {
          %roots_text = core.call intrinsic.json.stringify(%roots)
          %roots_copy = core.call intrinsic.json.parse(%roots_text)
          %result = core.map
          core.set %result["roots"] = %roots_copy
          %response = core.map
          core.set %response["jsonrpc"] = "2.0"
          core.set %response["id"] = %id
          core.set %response["result"] = %result
          core.set %out["action"] = "respond"
          core.set %out["response"] = %response
          core.return %out
        }
      }
      %elicitation = core.call intrinsic.eq(%method, "elicitation/create")
      %can_elicit = core.call intrinsic.and(%elicitation, %has_elicitation)
      core.if %can_elicit {
        core.set %out["action"] = "elicitation"
        core.set %out["id"] = %id
        %params_missing = core.call intrinsic.is_none(%params)
        core.if %params_missing {
          %empty = core.map
          core.set %out["params"] = %empty
        } else {
          core.set %out["params"] = %params
        }
        core.return %out
      }
      %error = core.map
      core.set %error["code"] = -32601
      %message = core.call intrinsic.string.format("Unsupported server request: {}", %method)
      core.set %error["message"] = %message
      %response = core.map
      core.set %response["jsonrpc"] = "2.0"
      core.set %response["id"] = %id
      core.set %response["error"] = %error
      core.set %out["action"] = "respond"
      core.set %out["response"] = %response
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_task_terminal_outcome {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-tasks-v2"
    type signature = "(task:json) -> json"
    body @entry(%task: json) {
      %out = core.map
      %task_id = core.get %task["taskId"] default ""
      %status = core.get %task["status"] default ""
