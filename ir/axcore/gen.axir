  op ax.gen.semantic @run_assertions {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "assertions-host-boundary"
    type signature = "(AxGen, json) -> json throws"
    body @entry(%gen: AxGen, %output: json) {
      // The host evaluates the assertions in order and reports the first
      // failure: {status: "pass"}, {status: "fail", message?} or
      // {status: "error", error}. As in TS assertAssertions, a failure with a
      // message raises a retryable error here. A failure without a message
      // and an error thrown by the assertion come back to the caller, which
      // raises them outside its validation retries: TS throws those as plain
      // errors, which its validation loop does not retry.
      %result = core.call intrinsic.axgen.run_assertions(%gen, %output)
      %status = core.get %result["status"] default "pass"
      %threw = core.call intrinsic.eq(%status, "error")
      core.if %threw {
        %thrown = core.get %result["error"]
        core.return %thrown
      }
      %failed = core.call intrinsic.eq(%status, "fail")
      core.if %failed {
        %message = core.get %result["message"]
        %has_message = core.call intrinsic.is_not_none(%message)
        core.if %has_message {
          %assertion_error = core.call intrinsic.error.runtime(%message)
          core.raise %assertion_error
        }
        %message_less = core.call intrinsic.error.runtime("Assertion failed without message")
        core.return %message_less
      }
      %passed = core.call intrinsic.none()
      core.return %passed
    }
  }

