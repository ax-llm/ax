  op ax.gen.semantic @should_continue_steps {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "stop-functions-host-boundary"
    type signature = "(AxGen, list<json>) -> bool"
    body @entry(%gen: AxGen, %calls: list<json>) {
      %should_continue = core.call intrinsic.axgen.should_continue_steps(%gen, %calls)
      core.return %should_continue
    }
  }

  op ax.gen.semantic @retry_policy {
    attr core_kind = "semantic"
    tag "validation-vs-infra-retry"
    type fields = "validationRetries:i64,infraRetries:i64"
  }

  op ax.gen.semantic @complete_with_retries_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "infra-retry-core-helper"
    type signature = "(AIClient, AxChatRequest, json, i64) -> json throws"
    body @entry(%client: AIClient, %request: AxChatRequest, %options: json, %retries: i64) {
      %attempt = core.const 0
      %last_error = core.call intrinsic.none()
      core.loop {
        core.try {
          %response = core.call intrinsic.ai.complete_once(%client, %request, %options)
          core.return %response
        } catch %error {
          %aborted = core.call intrinsic.exception.is_aborted(%error)
          core.if %aborted {
            core.raise %error
          }
          %last_error = core.let %error
          %exhausted = core.call intrinsic.gte(%attempt, %retries)
          core.if %exhausted {
            core.raise %error
          }
          core.call intrinsic.retry.sleep(%attempt, %client, %options)
          %next_attempt = core.call intrinsic.add(%attempt, 1)
          %attempt = core.let %next_attempt
          core.continue
        }
      }
      core.raise %last_error
    }
  }

  op ax.gen.semantic @parse_output_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "parse-structured-output-core-helper"
    type signature = "(string) -> json throws"
    body @entry(%content: string) {
      %text = core.string_trim %content
      %output = core.call intrinsic.json.parse_strict(%text)
      core.return %output
    }
  }

  op ax.gen.semantic @is_flexible_json_field {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "is-flexible-json-field-core-helper"
    type signature = "(FieldType) -> bool"
    body @entry(%typ: FieldType) {
      %type_name = core.get %typ["name"]
      %is_json = core.call intrinsic.eq(%type_name, "json")
      %is_object = core.call intrinsic.eq(%type_name, "object")
      %fields = core.get %typ["fields"]
      %has_fields = core.call intrinsic.truthy(%fields)
      %no_fields = core.call intrinsic.not(%has_fields)
      %flexible = core.let %is_json
      core.if %is_object {
        core.if %no_fields {
          %flexible = core.let true
        }
      }
      core.return %flexible
    }
  }

  op ax.gen.semantic @parse_json_string_value {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "parse-json-string-value-core-helper"
    type signature = "(json) -> json"
    body @entry(%value: json) {
      %is_string = core.type_is %value type "string"
      %not_string = core.call intrinsic.not(%is_string)
      core.if %not_string {
        core.return %value
      }
      %result = core.let %value
      core.try {
        %parsed = core.call intrinsic.json.parse(%value)
        %result = core.let %parsed
      } catch %parse_error {
        %result = core.let %value
      }
      core.return %result
    }
  }

  op ax.gen.semantic @parse_json_string_for_field {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "parse-json-string-for-field-core-helper"
    type signature = "(Field, json) -> json"
    body @entry(%field: Field, %value: json) {
      %typ = core.get %field["type"]
      %value_is_none = core.call intrinsic.is_none(%value)
      core.if %value_is_none {
        core.return %value
      }
      %flexible = core.call @is_flexible_json_field(%typ)
      %is_array = core.get %typ["is_array"] default false
      %typ_fields = core.get %typ["fields"]
      %has_typ_fields = core.call intrinsic.truthy(%typ_fields)
      core.if %is_array {
        %value_is_list = core.type_is %value type "list"
        %not_list = core.call intrinsic.not(%value_is_list)
        core.if %not_list {
          core.return %value
        }
        core.if %flexible {
          %out = core.list
          core.for %item in %value {
            %parsed_item = core.call @parse_json_string_value(%item)
            core.append %out, %parsed_item
          }
          core.return %out
        }
        core.if %has_typ_fields {
          %rebuilt = core.list
          core.for %item in %value {
            %item_is_map = core.type_is %item type "object"
            core.if %item_is_map {
              %parsed_obj = core.call @parse_json_string_for_fields(%typ_fields, %item)
              core.append %rebuilt, %parsed_obj
            } else {
              core.append %rebuilt, %item
            }
          }
          core.return %rebuilt
        }
        core.return %value
      }
      core.if %flexible {
        %parsed_scalar = core.call @parse_json_string_value(%value)
        core.return %parsed_scalar
      }
      %type_name = core.get %typ["name"]
      %is_object = core.call intrinsic.eq(%type_name, "object")
      core.if %is_object {
        core.if %has_typ_fields {
          %parsed_obj2 = core.call @parse_json_string_for_fields(%typ_fields, %value)
          core.return %parsed_obj2
        }
      }
      core.return %value
    }
  }

  op ax.gen.semantic @parse_json_string_fields {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "parse-structured-json-field-values-core-helper"
    type signature = "(list<Field>, json) -> json"
    body @entry(%output_fields: list<Field>, %values: json) {
      %values_is_map = core.type_is %values type "object"
      %not_map = core.call intrinsic.not(%values_is_map)
      core.if %not_map {
        core.return %values
      }
      core.for %field in %output_fields {
        %name = core.get %field["name"]
        %has_key = core.call intrinsic.map.contains(%values, %name)
        core.if %has_key {
          %value = core.get %values[%name]
          %parsed = core.call @parse_json_string_for_field(%field, %value)
          core.set %values[%name] = %parsed
        }
      }
      core.return %values
    }
  }

  op ax.gen.semantic @parse_json_string_for_fields {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "parse-json-string-nested-fields-core-helper"
    type signature = "(json, json) -> json"
    body @entry(%fields_map: json, %values: json) {
      %values_is_map = core.type_is %values type "object"
      %not_map = core.call intrinsic.not(%values_is_map)
      core.if %not_map {
        core.return %values
      }
      %nested_fields = core.call intrinsic.fields.from_map(%fields_map)
      core.for %field in %nested_fields {
        %name = core.get %field["name"]
        %has_key = core.call intrinsic.map.contains(%values, %name)
        core.if %has_key {
          %value = core.get %values[%name]
          %parsed = core.call @parse_json_string_for_field(%field, %value)
          core.set %values[%name] = %parsed
        }
      }
      core.return %values
    }
  }

  op ax.gen.semantic @validate_exact_output_keys {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "validated-json-object-exact-wire-keys"
    type signature = "(list<Field>, json, string) -> void throws"
    body @entry(%fields: list<Field>, %values: json, %context: string) {
      %is_object = core.type_is %values type "object"
      %not_object = core.call intrinsic.not(%is_object)
      core.if %not_object {
        %object_message = core.call intrinsic.string.format("{} must be one JSON object", %context)
        %object_error = core.call intrinsic.error.validation(%object_message)
        core.raise %object_error
      }
      %keys = core.call intrinsic.map.keys(%values)
      core.for %key in %keys {
        %known = core.let false
        core.for %field in %fields {
          %field_name = core.get %field["name"]
          %matches = core.call intrinsic.eq(%field_name, %key)
          core.if %matches {
            %known = core.let true
          }
        }
        %unknown = core.call intrinsic.not(%known)
        core.if %unknown {
          %unknown_message = core.call intrinsic.string.format("Unexpected field '{}' in {}. Use only the exact declared wire keys.", %key, %context)
          %unknown_error = core.call intrinsic.error.validation(%unknown_message)
          core.raise %unknown_error
        }
      }
      core.for %field in %fields {
        %field_name = core.get %field["name"]
        %has_value = core.call intrinsic.map.contains(%values, %field_name)
        core.if %has_value {
          %typ = core.get %field["type"]
          %nested_map = core.get %typ["fields"]
          %has_nested = core.call intrinsic.truthy(%nested_map)
          core.if %has_nested {
            %nested_fields = core.call intrinsic.fields.from_map(%nested_map)
            %field_value = core.get %values[%field_name]
            %child_context = core.call intrinsic.string.format("{}.{}", %context, %field_name)
            %array_snake = core.get %typ["is_array"] default false
            %is_array = core.get %typ["isArray"] default %array_snake
            core.if %is_array {
              core.for %item in %field_value {
                core.call @validate_exact_output_keys(%nested_fields, %item, %child_context)
              }
            } else {
              core.call @validate_exact_output_keys(%nested_fields, %field_value, %child_context)
            }
          }
        }
      }
      core.return
    }
  }

  op ax.gen.semantic @tool_spec_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "tool-spec-core-helper"
    type signature = "(Tool) -> json"
    body @entry(%fn: Tool) {
      %spec = core.map
      %name = core.get %fn["name"]
      %description = core.get %fn["description"]
      %parameters = core.get %fn["parameters"]
      core.set %spec["name"] = %name
      core.set %spec["description"] = %description
      core.set %spec["parameters"] = %parameters
      %execution = core.get %fn["execution"] default "blocking"
      %background = core.call intrinsic.eq(%execution, "background")
      core.if %background {
        core.set %spec["execution"] = %execution
      }
      core.return %spec
    }
  }

  op ax.gen.semantic @function_call_mode_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "function-call-mode-core-helper"
    type signature = "(json) -> string"
    body @entry(%mode: json) {
      %missing = core.call intrinsic.is_none(%mode)
      core.if %missing {
        core.return "auto"
      }
      %is_native = core.call intrinsic.eq(%mode, "native")
      %is_auto = core.call intrinsic.eq(%mode, "auto")
      %native_or_auto = core.call intrinsic.or(%is_native, %is_auto)
      core.if %native_or_auto {
        core.return "auto"
      }
      %is_prompt = core.call intrinsic.eq(%mode, "prompt")
      core.if %is_prompt {
        core.return "none"
      }
      // A tool choice passed here ('required', 'none', or a named call) is
      // routed through @caller_function_call_impl. Other values behave like
      // TS, where any mode but 'prompt' sends native tools.
      core.return "auto"
    }
  }

  op ax.gen.semantic @response_function_calls_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "response-function-calls-core-helper"
    type signature = "(json) -> list<json>"
    body @entry(%response: json) {
      %empty = core.list
      %calls = core.get %response["function_calls"] default %empty
      core.return %calls
    }
  }

  op ax.gen.semantic @append_tool_call_messages_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "tool-call-message-core-helper"
    type signature = "(list<json>, json, list<json>) -> list<json>"
    body @entry(%messages: list<json>, %response: json, %calls: list<json>) {
      %chat_calls = core.list
      core.for %call in %calls {
        %chat_call = core.call @completion_call_to_chat_impl(%call)
        core.append %chat_calls, %chat_call
      }
      %content = core.get %response["content"] default ""
      %message = core.map
      core.set %message["role"] = "assistant"
      core.set %message["content"] = %content
      core.set %message["function_calls"] = %chat_calls
      %thought = core.get %response["thought"]
      %has_thought = core.call intrinsic.is_not_none(%thought)
      core.if %has_thought {
        core.set %message["thought"] = %thought
      }
      %thought_blocks = core.get %response["thought_blocks"]
      %has_thought_blocks = core.call intrinsic.is_not_none(%thought_blocks)
      core.if %has_thought_blocks {
        core.set %message["thought_blocks"] = %thought_blocks
      }
      %images = core.get %response["images"]
      %has_images = core.call intrinsic.is_not_none(%images)
      core.if %has_images {
        core.set %message["images"] = %images
      }
      %phase = core.get %response["phase"]
      %has_phase = core.call intrinsic.is_not_none(%phase)
      core.if %has_phase {
        core.set %message["phase"] = %phase
      }
      core.append %messages, %message
      core.return %messages
    }
  }

  op ax.gen.semantic @completion_call_to_chat_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "completion-call-to-chat-core-helper"
    type signature = "(json) -> json"
    body @entry(%call: json) {
      %id = core.get %call["id"]
      %name = core.get %call["name"]
      %params = core.get %call["params"]
      %function = core.map
      core.set %function["name"] = %name
      core.set %function["params"] = %params
      %out = core.map
      core.set %out["id"] = %id
      core.set %out["type"] = "function"
      core.set %out["function"] = %function
      core.return %out
    }
  }

  op ax.gen.semantic @tool_result_message_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "tool-result-message-core-helper"
    type signature = "(json, json) -> json"
    body @entry(%call: json, %result: json) {
      %id = core.get %call["id"]
      %name = core.get %call["name"]
      %result_json = core.call intrinsic.json.stringify(%result)
      %message = core.map
      core.set %message["role"] = "function"
      core.set %message["function_id"] = %id
      core.set %message["name"] = %name
      core.set %message["result"] = %result_json
      core.return %message
    }
  }

  op ax.gen.semantic @tool_error_message_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "tool-error-message-core-helper"
    type signature = "(json, error) -> json"
    body @entry(%call: json, %error: error) {
      %id = core.get %call["id"]
      %name = core.get %call["name"]
      %error_text = core.call intrinsic.exception.message(%error)
      %payload = core.map
      core.set %payload["error"] = %error_text
      %payload_json = core.call intrinsic.json.stringify(%payload)
      %message = core.map
      core.set %message["role"] = "function"
      core.set %message["function_id"] = %id
      core.set %message["name"] = %name
      core.set %message["result"] = %payload_json
      core.set %message["is_error"] = true
      core.return %message
    }
  }

  op ax.gen.semantic @append_validation_retry_messages_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "validation-retry-message-core-helper"
    type signature = "(list<json>, json, error) -> list<json>"
    body @entry(%messages: list<json>, %response: json, %error: error) {
      %content = core.get %response["content"] default ""
      %assistant_message = core.map
      core.set %assistant_message["role"] = "assistant"
      core.set %assistant_message["content"] = %content
      core.append %messages, %assistant_message
      %error_text = core.call intrinsic.exception.message(%error)
      %prefix_message = core.call intrinsic.add("The previous response failed validation: ", %error_text)
      %retry_content = core.call intrinsic.add(%prefix_message, ". Return only corrected JSON.")
      %retry_message = core.map
      core.set %retry_message["role"] = "user"
      core.set %retry_message["content"] = %retry_content
      core.append %messages, %retry_message
      // Callers must reassign from this return: in Go the forward loop's
      // messages can be a plain slice, so in-place appends never reach them.
      core.return %messages
    }
  }
  op ax.gen.semantic @parse_text_field_value_impl {
    attr core_kind = "func"
    attr private = true
    attr effect = "throws"
    attr emit_module = "gen"
    tag "wire-field-extraction"
    type signature = "(json, string) -> json throws"
    body @entry(%field: json, %text: string) {
      %text = core.string_trim %text
      %typ = core.get %field["type"]
      %name = core.get %typ["name"]
      %array = core.get %typ["is_array"] default false
      %is_boolean = core.call intrinsic.eq(%name, "boolean")
      %numeric = core.call intrinsic.eq(%name, "number")
      %json = core.call intrinsic.eq(%name, "json")
      %parse = core.call intrinsic.or(%is_boolean, %numeric)
      %parse = core.call intrinsic.or(%parse, %array)
      %parse = core.call intrinsic.or(%parse, %json)
      core.if %parse {
        %value = core.call intrinsic.json.parse_strict(%text)
        core.return %value
      }
      core.return %text
    }
  }

  op ax.gen.semantic @parse_text_output_fields_impl {
    attr core_kind = "func"
    attr private = true
    attr effect = "throws"
    attr emit_module = "gen"
    tag "src/ax/dsp/extract/streamingText.ts"
    type signature = "(string, list<Field>, bool) -> json throws"
    body @entry(%content: string, %fields: json, %is_final: bool) {
      %lines = core.call intrinsic.string.split(%content, "\n")
      %count = core.call intrinsic.len(%lines)
      %index = core.let 0
      %values = core.map
      %current = core.call intrinsic.none()
      %current_name = core.let ""
      %parts = core.list
      core.for %line in %lines {
        %index = core.call intrinsic.add(%index, 1)
        %line_trimmed = core.string_trim %line
        %matched = core.call intrinsic.none()
        %value = core.let ""
        %withhold = core.let false
        core.for %field in %fields {
          %name = core.get %field["name"]
          %title = core.get %field["title"] default %name
          %labels = core.list
          core.append %labels, %name
          core.append %labels, %title
          core.for %label in %labels {
            %prefix = core.call intrinsic.string.format("{}:", %label)
            %found = core.call intrinsic.string.starts_with(%line_trimmed, %prefix)
            core.if %found {
              %matched = core.let %field
              %length = core.call intrinsic.len(%prefix)
              %value = core.call intrinsic.string.slice(%line_trimmed, %length)
              core.break
            }
            %last = core.call intrinsic.eq(%index, %count)
            %partial = core.call intrinsic.not(%is_final)
            %partial = core.call intrinsic.and(%partial, %last)
            core.if %partial {
              %prefix_partial = core.call intrinsic.string.starts_with(%prefix, %line_trimmed)
              %withhold = core.call intrinsic.or(%withhold, %prefix_partial)
            }
          }
          %has_match = core.call intrinsic.is_not_none(%matched)
          core.if %has_match { core.break }
        }
        %has_match = core.call intrinsic.is_not_none(%matched)
        core.if %has_match {
          %has_current = core.call intrinsic.ne(%current_name, "")
          core.if %has_current {
            %raw = core.string_join %parts sep "\n"
            %parsed = core.call @parse_text_field_value_impl(%current, %raw)
            core.set %values[%current_name] = %parsed
          }
          %current = core.let %matched
          %current_name = core.get %matched["name"]
          %parts = core.list
          core.append %parts, %value
        } else {
          %has_current = core.call intrinsic.ne(%current_name, "")
          %keep = core.call intrinsic.not(%withhold)
          %keep = core.call intrinsic.and(%keep, %has_current)
          core.if %keep { core.append %parts, %line }
        }
      }
      %has_current = core.call intrinsic.ne(%current_name, "")
      core.if %has_current {
        %raw = core.string_join %parts sep "\n"
        core.try {
          %parsed = core.call @parse_text_field_value_impl(%current, %raw)
          core.set %values[%current_name] = %parsed
        } catch %parse_error {
          core.if %is_final { core.raise %parse_error }
        }
      }
      core.return %values
    }
  }

  op ax.gen.semantic @parse_output_fields_impl {
    attr core_kind = "func"
    attr private = true
    attr effect = "throws"
    attr emit_module = "gen"
    tag "wire-field-extraction"
    type signature = "(string, list<Field>) -> json throws"
    body @entry(%content: string, %fields: json) {
      %text = core.string_trim %content
      %is_json = core.call intrinsic.string.starts_with(%text, "{")
      core.if %is_json {
        %output = core.call @parse_output_impl(%text)
        core.return %output
      }
      %output = core.call @parse_text_output_fields_impl(%text, %fields, true)
      core.return %output
    }
  }

  op ax.gen.semantic @signature_has_complex_fields {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/sig.ts"
    type signature = "(AxSignature, json) -> bool"
    body @entry(%signature: AxSignature, %options: json) {
      %option_forced_snake = core.get %options["force_structured"] default false
      %option_forced = core.get %options["forceStructured"] default %option_forced_snake
      %signature_forced_snake = core.get %signature["force_structured"] default false
      %signature_forced = core.get %signature["forceStructured"] default %signature_forced_snake
      %forced = core.call intrinsic.or(%option_forced, %signature_forced)
      core.if %forced {
        core.return true
      }
      %output_fields = core.get %signature["output_fields"]
      core.for %field in %output_fields {
        %field_type = core.get %field["type"]
        %type_name = core.get %field_type["name"]
        %is_object = core.call intrinsic.eq(%type_name, "object")
        core.if %is_object {
          core.return true
        }
        %is_array_snake = core.get %field_type["is_array"] default false
        %is_array = core.get %field_type["isArray"] default %is_array_snake
        %nested_fields = core.get %field_type["fields"]
        %has_nested_fields = core.call intrinsic.truthy(%nested_fields)
        %object_array = core.call intrinsic.and(%is_array, %has_nested_fields)
        core.if %object_array {
          core.return true
        }
      }
      core.return false
    }
  }

  op ax.gen.semantic @caller_function_call_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/functions.ts"
    type signature = "(json) -> json"
    body @entry(%options: json) {
      %requested_snake = core.get %options["function_call"]
      %requested = core.get %options["functionCall"] default %requested_snake
      %has_requested = core.call intrinsic.is_not_none(%requested)
      core.if %has_requested {
        core.return %requested
      }
      // A tool choice passed as functionCallMode used to reach the provider on
      // every request. Route it through the caller functionCall instead.
      %mode_snake = core.get %options["function_call_mode"]
      %mode = core.get %options["functionCallMode"] default %mode_snake
      %is_required = core.call intrinsic.eq(%mode, "required")
      %is_none = core.call intrinsic.eq(%mode, "none")
      %is_named = core.type_is %mode type "object"
      %required_or_none = core.call intrinsic.or(%is_required, %is_none)
      %routed = core.call intrinsic.or(%required_or_none, %is_named)
      core.if %routed {
        core.return %mode
      }
      %none = core.call intrinsic.none()
      core.return %none
    }
  }

  op ax.gen.semantic @function_call_forces_tool_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/functions.ts"
    type signature = "(json) -> bool"
    body @entry(%choice: json) {
      %is_required = core.call intrinsic.eq(%choice, "required")
      core.if %is_required {
        core.return true
      }
      %is_named = core.type_is %choice type "object"
      core.return %is_named
    }
  }

  op ax.gen.semantic @function_call_names_output_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "structured-output-reserved-function-names"
    type signature = "(json) -> bool"
    body @entry(%choice: json) {
      %is_named = core.type_is %choice type "object"
      %not_named = core.call intrinsic.not(%is_named)
      core.if %not_named {
        core.return false
      }
      %empty_function = core.map
      %function = core.get %choice["function"] default %empty_function
      %name = core.get %function["name"] default ""
      %canonical = core.call intrinsic.eq(%name, "__axOutput")
      %legacy = core.call intrinsic.eq(%name, "__finalResult")
      %reserved = core.call intrinsic.or(%canonical, %legacy)
      core.return %reserved
    }
  }
}
