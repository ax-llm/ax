module @ax.gen version "0.1" {
  dialect @ax.gen version "0.1"

  op ax.gen.semantic @select_structured_output_rung {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "shape-aware-structured-output-selector"
    type signature = "(AxSignature, json, json) -> json throws"
    body @entry(%signature: AxSignature, %features: json, %options: json) {
      %native_snake = core.get %features["structured_outputs"]
      %native_raw = core.get %features["structuredOutputs"] default %native_snake
      %modes_snake = core.get %features["structured_output_modes"]
      %modes = core.get %features["structuredOutputModes"] default %modes_snake
      %has_modes = core.call intrinsic.is_not_none(%modes)
      %native_missing = core.call intrinsic.is_none(%native_raw)
      %supports_native = core.let true
      core.if %native_missing {
        %supports_native = core.let true
      } else {
        %supports_native = core.call intrinsic.truthy(%native_raw)
      }
      %functions_raw = core.get %features["functions"]
      %functions_missing = core.call intrinsic.is_none(%functions_raw)
      %supports_functions = core.let true
      core.if %functions_missing {
        %supports_functions = core.let true
      } else {
        %supports_functions = core.call intrinsic.truthy(%functions_raw)
      }
      %supports_json_object = core.let true
      core.if %has_modes {
        %supports_native = core.let false
        %supports_functions = core.let false
        %supports_json_object = core.let false
        core.for %candidate_mode in %modes {
          %candidate_native = core.call intrinsic.eq(%candidate_mode, "native")
          core.if %candidate_native {
            %supports_native = core.let true
          }
          %candidate_function = core.call intrinsic.eq(%candidate_mode, "function")
          core.if %candidate_function {
            %supports_functions = core.let true
          }
          %candidate_json_object = core.call intrinsic.eq(%candidate_mode, "json_object")
          core.if %candidate_json_object {
            %supports_json_object = core.let true
          }
        }
      }
      %mode_snake = core.get %options["structured_output_mode"]
      %mode = core.get %options["structuredOutputMode"] default %mode_snake
      %mode_missing = core.call intrinsic.is_none(%mode)
      core.if %mode_missing {
        %mode = core.let "auto"
      }
      %selection = core.map
      %requires_schema_snake = core.get %features["requires_structured_output"] default false
      %requires_schema = core.get %features["requiresStructuredOutput"] default %requires_schema_snake
      // A provider that requires structured output gets a rung for a simple
      // signature too, which, as in TS, its modes choose as for a complex
      // signature.
      core.if %requires_schema {
        core.set %selection["requires_schema"] = true
      }
      // TS selects no rung for a simple signature (no object or object-array
      // output, not forced), with or without tools: its output uses the
      // `field: value` text contract. Beside native tools a JSON response
      // contract also keeps live models calling tools instead of answering
      // (gemini-3.8-flash re-called tools 100+ times).
      %complex = core.call @signature_has_complex_fields(%signature, %options)
      %simple = core.call intrinsic.not(%complex)
      %not_required = core.call intrinsic.not(%requires_schema)
      %no_rung = core.call intrinsic.and(%simple, %not_required)
      core.if %no_rung {
        core.return %selection
      }
      %explicit_native = core.call intrinsic.eq(%mode, "native")
      core.if %explicit_native {
        %unsupported_native = core.call intrinsic.not(%supports_native)
        core.if %unsupported_native {
          core.raise "Structured output mode 'native' requires native JSON Schema support"
        }
        core.set %selection["rung"] = "native"
        core.return %selection
      }
      %explicit_function = core.call intrinsic.eq(%mode, "function")
      core.if %explicit_function {
        %unsupported_functions = core.call intrinsic.not(%supports_functions)
        core.if %unsupported_functions {
          core.raise "Structured output mode 'function' requires function calling support"
        }
        core.set %selection["rung"] = "function"
        core.return %selection
      }
      %explicit_json_object = core.call intrinsic.eq(%mode, "json_object")
      core.if %explicit_json_object {
        %unsupported_json_object = core.call intrinsic.not(%supports_json_object)
        core.if %unsupported_json_object {
          core.raise "Structured output mode 'json_object' requires JSON object response-format support"
        }
        core.set %selection["rung"] = "json_object"
        core.return %selection
      }
      core.if %has_modes {
        %mode_count = core.call intrinsic.len(%modes)
        %no_modes = core.call intrinsic.eq(%mode_count, 0)
        core.if %no_modes {
          core.raise "Structured output is not verified for the selected provider and model"
        }
      }
      %no_advertised_modes = core.call intrinsic.not(%has_modes)
      %native_default = core.call intrinsic.and(%no_advertised_modes, %supports_native)
      core.if %native_default {
        core.set %selection["rung"] = "native"
        core.return %selection
      }
      %output_fields = core.get %signature["output_fields"]
      %visible_fields = core.list
      core.for %field in %output_fields {
        %internal_snake = core.get %field["is_internal"] default false
        %internal = core.get %field["isInternal"] default %internal_snake
        %visible = core.call intrinsic.not(%internal)
        core.if %visible {
          core.append %visible_fields, %field
        }
      }
      %visible_count = core.call intrinsic.len(%visible_fields)
      %singleton = core.call intrinsic.eq(%visible_count, 1)
      %only_field = core.call intrinsic.list.get(%visible_fields, 0, %selection)
      %optional_snake = core.get %only_field["is_optional"] default false
      %optional = core.get %only_field["isOptional"] default %optional_snake
      %required = core.call intrinsic.not(%optional)
      %field_type = core.get %only_field["type"]
      %field_type_name = core.get %field_type["name"]
      %is_string = core.call intrinsic.eq(%field_type_name, "string")
      %is_code = core.call intrinsic.eq(%field_type_name, "code")
      %string_or_code = core.call intrinsic.or(%is_string, %is_code)
      %not_array_snake = core.get %field_type["is_array"] default false
      %is_array = core.get %field_type["isArray"] default %not_array_snake
      %not_array = core.call intrinsic.not(%is_array)
      %required_singleton = core.call intrinsic.and(%singleton, %required)
      %singleton_string = core.call intrinsic.and(%required_singleton, %string_or_code)
      %simple_shape = core.call intrinsic.and(%singleton_string, %not_array)
      %native_unavailable = core.call intrinsic.not(%supports_native)
      %json_object_optimization = core.call intrinsic.and(%simple_shape, %native_unavailable)
      core.if %json_object_optimization {
        core.if %supports_json_object {
          core.set %selection["rung"] = "json_object"
          core.return %selection
        }
      }
      core.if %has_modes {
        %preferred_mode = core.call intrinsic.list.get(%modes, 0, "")
        core.set %selection["rung"] = %preferred_mode
        core.return %selection
      }
      core.if %supports_functions {
        core.set %selection["rung"] = "function"
        core.return %selection
      }
      core.set %selection["rung"] = "json_object"
      core.return %selection
    }
  }

  op ax.gen.semantic @assert_no_reserved_output_functions {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "structured-output-reserved-function-names"
    type signature = "(list<Tool>) -> void throws"
    body @entry(%functions: list<Tool>) {
      core.for %fn in %functions {
        %name = core.get %fn["name"]
        %canonical = core.call intrinsic.eq(%name, "__axOutput")
        %legacy = core.call intrinsic.eq(%name, "__finalResult")
        %reserved = core.call intrinsic.or(%canonical, %legacy)
        core.if %reserved {
          core.raise "Function names '__axOutput' and '__finalResult' are reserved for Ax structured-output handling"
        }
      }
      core.return
    }
  }

  op ax.gen.semantic @find_structured_output_call {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "legacy-final-result-replay-compatibility"
    type signature = "(list<json>) -> json"
    body @entry(%calls: list<json>) {
      core.for %call in %calls {
        %direct_name = core.get %call["name"]
        %fn = core.get %call["function"]
        %name = core.get %fn["name"] default %direct_name
        %canonical = core.call intrinsic.eq(%name, "__axOutput")
        %legacy = core.call intrinsic.eq(%name, "__finalResult")
        %reserved = core.call intrinsic.or(%canonical, %legacy)
        core.if %reserved {
          core.return %call
        }
      }
      %none = core.call intrinsic.none()
      core.return %none
    }
  }

  op ax.gen.semantic @structured_output_call_args {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "structured-output-function-args"
    type signature = "(json) -> json throws"
    body @entry(%call: json) {
      %fn = core.get %call["function"]
      %direct_params = core.get %call["params"]
      %params = core.get %fn["params"] default %direct_params
      %missing = core.call intrinsic.is_none(%params)
      core.if %missing {
        %arguments = core.get %call["arguments"]
        %params = core.let %arguments
      }
      %is_string = core.type_is %params type "string"
      core.if %is_string {
        %parsed = core.call intrinsic.json.parse_strict(%params)
        %params = core.let %parsed
      }
      core.return %params
    }
  }

  op ax.gen.semantic @apply_model_config_option_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/generate.ts"
    type signature = "(json, json, json) -> void"
    body @entry(%runtime_options: json, %base_options: json, %options: json) {
      // modelConfig merges key by key: the constructor's keys, then the
      // call's, whichever of modelConfig and model_config each one uses.
      %empty = core.map
      %gen_options = core.call intrinsic.map.merge(%empty, %base_options)
      %call_options = core.call intrinsic.map.merge(%empty, %options)
      %gen_snake = core.get %gen_options["model_config"] default %empty
      %gen_camel = core.get %gen_options["modelConfig"] default %empty
      %call_snake = core.get %call_options["model_config"] default %empty
      %call_camel = core.get %call_options["modelConfig"] default %empty
      %gen_config = core.call intrinsic.map.merge(%gen_snake, %gen_camel)
      %call_config = core.call intrinsic.map.merge(%call_snake, %call_camel)
      %merged = core.call intrinsic.map.merge(%gen_config, %call_config)
      %merged_count = core.call intrinsic.len(%merged)
      %has_config = core.call intrinsic.gt(%merged_count, 0)
      core.if %has_config {
        core.call intrinsic.map.delete(%runtime_options, "model_config")
        core.set %runtime_options["modelConfig"] = %merged
      }
      // customLabels merge key by key as well: TS's AxGen passes the AI its
      // constructor's labels with the call's over them.
      %gen_labels_snake = core.get %gen_options["custom_labels"] default %empty
      %gen_labels_camel = core.get %gen_options["customLabels"] default %empty
      %call_labels_snake = core.get %call_options["custom_labels"] default %empty
      %call_labels_camel = core.get %call_options["customLabels"] default %empty
      %gen_labels = core.call intrinsic.map.merge(%gen_labels_snake, %gen_labels_camel)
      %call_labels = core.call intrinsic.map.merge(%call_labels_snake, %call_labels_camel)
      %labels = core.call intrinsic.map.merge(%gen_labels, %call_labels)
      %labels_count = core.call intrinsic.len(%labels)
      %has_labels = core.call intrinsic.gt(%labels_count, 0)
      core.if %has_labels {
        core.call intrinsic.map.delete(%runtime_options, "custom_labels")
        core.set %runtime_options["customLabels"] = %labels
      }
      core.return
    }
  }

  op ax.gen.semantic @build_gen_chat_request {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    ref prompt = @render_prompt
    tag "src/ax/dsp/generate.ts"
    type signature = "(AxGen, list<json>, json, json, i64) -> AxChatRequest throws"
    body @entry(%gen: AxGen, %messages: list<json>, %options: json, %selection: json, %step: i64) {
      %empty_model_config = core.map
      %model_config_snake = core.get %options["model_config"] default %empty_model_config
      %model_config_base = core.get %options["modelConfig"] default %model_config_snake
      %model_config = core.call intrinsic.map.merge(%empty_model_config, %model_config_base)
      %stream_value = core.get %options["stream"] default false
      %stream_bool = core.call intrinsic.truthy(%stream_value)
      core.set %model_config["stream"] = %stream_bool
      %budget_snake = core.get %options["thinking_token_budget"]
      %budget = core.get %options["thinkingTokenBudget"] default %budget_snake
      %has_budget = core.call intrinsic.is_not_none(%budget)
      core.if %has_budget {
        core.set %model_config["thinkingTokenBudget"] = %budget
      }
      %reasoning_snake = core.get %options["reasoning_effort"]
      %reasoning = core.get %options["reasoningEffort"] default %reasoning_snake
      %has_reasoning = core.call intrinsic.is_not_none(%reasoning)
      core.if %has_reasoning {
        core.set %model_config["reasoning_effort"] = %reasoning
      }
      %show_thoughts_snake = core.get %options["show_thoughts"]
      %show_thoughts = core.get %options["showThoughts"] default %show_thoughts_snake
      %has_show_thoughts = core.call intrinsic.is_not_none(%show_thoughts)
      core.if %has_show_thoughts {
        core.set %model_config["showThoughts"] = %show_thoughts
      }
      %temperature = core.get %options["temperature"]
      %has_temperature = core.call intrinsic.is_not_none(%temperature)
      core.if %has_temperature {
        core.set %model_config["temperature"] = %temperature
      }
      %max_tokens = core.get %options["max_tokens"]
      %has_max_tokens = core.call intrinsic.is_not_none(%max_tokens)
      core.if %has_max_tokens {
        core.set %model_config["max_tokens"] = %max_tokens
      }
      %top_p = core.get %options["top_p"]
      %has_top_p = core.call intrinsic.is_not_none(%top_p)
      core.if %has_top_p {
        core.set %model_config["top_p"] = %top_p
      }
      %presence_penalty = core.get %options["presence_penalty"]
      %has_presence_penalty = core.call intrinsic.is_not_none(%presence_penalty)
      core.if %has_presence_penalty {
        core.set %model_config["presence_penalty"] = %presence_penalty
      }
      %frequency_penalty = core.get %options["frequency_penalty"]
      %has_frequency_penalty = core.call intrinsic.is_not_none(%frequency_penalty)
      core.if %has_frequency_penalty {
        core.set %model_config["frequency_penalty"] = %frequency_penalty
      }
      %sample_count_snake = core.get %options["sample_count"]
      %sample_count = core.get %options["sampleCount"] default %sample_count_snake
      %n = core.get %options["n"] default %sample_count
      %has_n = core.call intrinsic.is_not_none(%n)
      core.if %has_n {
        core.set %model_config["n"] = %n
      }
      %stop_sequences = core.get %options["stop_sequences"]
      %has_stop_sequences = core.call intrinsic.is_not_none(%stop_sequences)
      core.if %has_stop_sequences {
        core.set %model_config["stop_sequences"] = %stop_sequences
      }
      %request = core.map
      %model = core.get %options["model"]
      core.set %request["model"] = %model
      core.set %request["chat_prompt"] = %messages
      %functions = core.get %gen["functions"]
      core.call @assert_no_reserved_output_functions(%functions)
      // A caller-forced call ('required' or a named function) applies to the
      // first step only. Later steps drop it together with the caller tools
      // so the model can answer, as in TS createFunctionConfig.
      %caller_choice = core.call @caller_function_call_impl(%options)
      %forced = core.call @function_call_forces_tool_impl(%caller_choice)
      %first_step = core.call intrinsic.eq(%step, 0)
      %later_step = core.call intrinsic.not(%first_step)
      %forcing_dropped = core.call intrinsic.and(%forced, %later_step)
      %keep_caller_tools = core.call intrinsic.not(%forcing_dropped)
      %function_specs = core.list
      core.if %keep_caller_tools {
        core.for %fn in %functions {
          %spec = core.call @tool_spec_impl(%fn)
          core.append %function_specs, %spec
        }
      }
      %mode_snake = core.get %options["function_call_mode"]
      %mode_raw = core.get %options["functionCallMode"] default %mode_snake
      %mode = core.call @function_call_mode_impl(%mode_raw)
      core.set %request["function_call"] = %mode
      %has_caller_choice = core.call intrinsic.is_not_none(%caller_choice)
      %send_caller_choice = core.call intrinsic.and(%has_caller_choice, %keep_caller_tools)
      core.if %send_caller_choice {
        core.set %request["function_call"] = %caller_choice
        core.set %request["function_call_source"] = "caller"
      }
      %signature = core.get %gen["signature"]
      %output_fields = core.get %signature["output_fields"]
      %rung = core.get %selection["rung"]
      %fn_count = core.call intrinsic.len(%function_specs)
      %requires_schema = core.get %selection["requires_schema"] default false
      %no_functions = core.call intrinsic.eq(%fn_count, 0)
      %omit_function_call = core.call intrinsic.and(%requires_schema, %no_functions)
      core.if %omit_function_call {
        core.call intrinsic.map.delete(%request, "function_call")
      }
      %use_function = core.call intrinsic.eq(%rung, "function")
      core.if %use_function {
        %schema_options = core.map
        %function_schema = core.call @schema_to_json_schema_impl(%output_fields, "output", %schema_options)
        %synthetic = core.map
        core.set %synthetic["name"] = "__axOutput"
        core.set %synthetic["description"] = "Emit the complete structured program output using the declared argument shape."
        core.set %synthetic["parameters"] = %function_schema
        // A caller-forced call must reach a user function, so the output
        // function is offered only once the forcing is dropped.
        %forcing_now = core.call intrinsic.and(%forced, %first_step)
        %forces_output = core.call @function_call_names_output_impl(%caller_choice)
        %forces_other = core.call intrinsic.not(%forces_output)
        %forces_user_tool = core.call intrinsic.and(%forcing_now, %forces_other)
        %has_user_specs = core.call intrinsic.gt(%fn_count, 0)
        %withhold_output = core.call intrinsic.and(%forces_user_tool, %has_user_specs)
        %offer_output = core.call intrinsic.not(%withhold_output)
        core.if %offer_output {
          core.append %function_specs, %synthetic
        }
        %no_user_functions = core.call intrinsic.eq(%fn_count, 0)
        core.if %no_user_functions {
          %forced_function_ref = core.map
          core.set %forced_function_ref["name"] = "__axOutput"
          %forced_function = core.map
          core.set %forced_function["type"] = "function"
          core.set %forced_function["function"] = %forced_function_ref
          core.set %request["function_call"] = %forced_function
          core.set %request["function_call_source"] = "ax"
        }
      }
      core.set %request["functions"] = %function_specs
      %use_native = core.call intrinsic.eq(%rung, "native")
      core.if %use_native {
        %schema_options = core.map
        core.set %schema_options["strictStructuredOutputs"] = true
        core.set %schema_options["flexibleJsonFieldsAsString"] = true
        %output_schema = core.call @schema_to_json_schema_impl(%output_fields, "output", %schema_options)
        %schema_wrap = core.map
        core.set %schema_wrap["name"] = "output"
        core.set %schema_wrap["strict"] = true
        core.set %schema_wrap["schema"] = %output_schema
        %response_format = core.map
        core.set %response_format["type"] = "json_schema"
        core.set %response_format["schema"] = %schema_wrap
        %annotations = core.call @signature_output_value_descriptions_impl(%output_fields)
        %has_annotations = core.call intrinsic.truthy(%annotations)
        core.if %has_annotations {
          core.set %response_format["fieldDescriptions"] = %annotations
        }
        core.set %request["response_format"] = %response_format
      }
      %use_json_object = core.call intrinsic.eq(%rung, "json_object")
      core.if %use_json_object {
        %response_format = core.map
        core.set %response_format["type"] = "json_object"
        core.set %request["response_format"] = %response_format
      }
      %has_rung = core.call intrinsic.is_not_none(%rung)
      core.if %has_rung {
        %ax_metadata = core.map
        core.set %ax_metadata["structured_output_rung"] = %rung
        %provider_metadata = core.map
        core.set %provider_metadata["ax"] = %ax_metadata
        core.set %request["provider_metadata"] = %provider_metadata
      }
      core.set %request["model_config"] = %model_config
      // The request's step: a native chat session's response budget is the
      // run's maxSteps less it, as TS's maxResponses is.
      core.set %request["_ax_step_index"] = %step
      core.return %request
    }
  }

  op ax.gen.semantic @parse_sample_outputs {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "axgen-indexed-multi-sample-parse"
    type signature = "(AxGen, list<Field>, json, bool, string, string, bool, bool, json) -> json throws"
    body @entry(%gen: AxGen, %output_fields: list<Field>, %response: json, %validate_exact_json: bool, %thought_field: string, %thought_prefix: string, %text_contract: bool, %strict_mode: bool, %parse_state: json) {
      %empty_results = core.list
      %completions = core.get %response["results"] default %empty_results
      %completion_count = core.call intrinsic.len(%completions)
      %missing_completions = core.call intrinsic.eq(%completion_count, 0)
      core.if %missing_completions {
        %completions = core.list
        core.append %completions, %response
      }
      %outputs = core.list
      %samples = core.list
      %feedback = core.list
      %position = core.const 0
      core.for %completion in %completions {
        %content = core.get %completion["content"] default ""
        %output = core.map
        %extracted = core.let false
        core.if %text_contract {
          // TS extractValues, after the port-only JSON object fallback.
          %text_parsed = core.call @parse_text_contract_output_impl(%content, %output_fields, %strict_mode)
          %output = core.get %text_parsed["values"]
          %extracted = core.get %text_parsed["extracted"] default false
        } else {
          core.if %validate_exact_json {
            // As in TS, a json_object answer that isn't one JSON object fails
            // validation with this message, not the parser's.
            %strict_parsed = core.let false
            core.try {
              %output = core.call @parse_output_impl(%content)
              %strict_parsed = core.let true
            } catch %strict_parse_error {
            }
            %strict_failed = core.call intrinsic.not(%strict_parsed)
            core.if %strict_failed {
              %strict_error = core.call intrinsic.error.validation("Structured output must be one JSON object with no prose or Markdown fences.")
              core.raise %strict_error
            }
          } else {
            %output = core.call @parse_output_fields_impl(%content, %output_fields)
          }
        }
        core.if %validate_exact_json {
          core.call @validate_exact_output_keys(%output_fields, %output, "output")
        }
        %validated = core.let %output
        %not_extracted = core.call intrinsic.not(%extracted)
        core.if %not_extracted {
          %recovered = core.call @parse_json_string_fields(%output_fields, %output)
          %validated = core.call @stream_json_validate_output_impl(%output_fields, %recovered)
          core.if %text_contract {
            // The deprecated JSON object fallback stands in for the text
            // contract, whose required check includes internal fields.
            core.call @stream_text_required_check_impl(%validated, %output_fields)
          }
        }
        // The answer's values parsed: TS's memory cleanup runs here, before
        // the field processors and assertions (response/nonStreaming.ts).
        core.set %parse_state["parsed"] = true
        // TS field processors see the parsed values and feed back text for
        // another step.
        %processor_state = core.map
        core.set %processor_state["values"] = %validated
        %sample_feedback = core.call @stream_run_processors_impl(%gen, "feedback", %processor_state, %content, true)
        %processor_failure = core.get %processor_state["fatal_error"]
        %processor_failed = core.call intrinsic.is_not_none(%processor_failure)
        core.if %processor_failed {
          // The caller raises it outside its validation retries.
          %processor_bundle = core.map
          core.set %processor_bundle["assertion_failure"] = %processor_failure
          core.return %processor_bundle
        }
        core.for %feedback_text in %sample_feedback {
          core.append %feedback, %feedback_text
        }
        %processed = core.call @apply_field_processors(%gen, %validated)
        %assertion_failure = core.call @run_assertions(%gen, %processed)
        %assertion_failed = core.call intrinsic.is_not_none(%assertion_failure)
        core.if %assertion_failed {
          // The caller raises it outside its validation retries.
          %failure_bundle = core.map
          core.set %failure_bundle["assertion_failure"] = %assertion_failure
          core.return %failure_bundle
        }
        %stripped_output = core.call @strip_internal_fields(%output_fields, %processed)
        %sample_thought = core.get %completion["thought"] default ""
        %public_output = core.call @with_output_thought_impl(%stripped_output, %thought_field, %thought_prefix, %sample_thought)
        core.append %outputs, %public_output
        %sample_index = core.get %completion["index"] default %position
        %sample = core.map
        core.set %sample["index"] = %sample_index
        core.set %sample["sample"] = %public_output
        core.append %samples, %sample
        %next_position = core.call intrinsic.add(%position, 1)
        %position = core.let %next_position
      }
      %bundle = core.map
      core.set %bundle["outputs"] = %outputs
      core.set %bundle["samples"] = %samples
      core.set %bundle["feedback"] = %feedback
      core.return %bundle
    }
  }

  op ax.gen.semantic @select_sample_index {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "axgen-result-picker"
    type signature = "(list<json>, json) -> number throws"
    body @entry(%samples: list<json>, %options: json) {
      %picker_snake = core.get %options["result_picker"]
      %picker = core.get %options["resultPicker"] default %picker_snake
      %missing_picker = core.call intrinsic.is_none(%picker)
      %sample_count = core.call intrinsic.len(%samples)
      %single_or_empty = core.call intrinsic.lte(%sample_count, 1)
      %use_default = core.call intrinsic.or(%missing_picker, %single_or_empty)
      core.if %use_default {
        core.return 0
      }
      %payload = core.map
      core.set %payload["type"] = "fields"
      core.set %payload["results"] = %samples
      %selected = core.call intrinsic.object.call_method(%picker, "call", %payload)
      %is_number = core.type_is %selected type "number"
      %not_number = core.call intrinsic.not(%is_number)
      %negative = core.call intrinsic.lt(%selected, 0)
      %too_large = core.call intrinsic.gte(%selected, %sample_count)
      %out_of_bounds = core.call intrinsic.or(%negative, %too_large)
      %invalid = core.call intrinsic.or(%not_number, %out_of_bounds)
      core.if %invalid {
        %max_index = core.call intrinsic.add(%sample_count, -1)
        %message = core.call intrinsic.string.format("Result picker returned invalid index: {}. Must be between 0 and {}", %selected, %max_index)
        %error = core.call intrinsic.error.runtime(%message)
        core.raise %error
      }
      core.return %selected
    }
  }

  op ax.gen.semantic @forward {
    attr core_kind = "method"
    attr effect = "throws"
    attr emit_module = "gen"
    attr emit_name = "_forward_impl"
    ref execute_tool = @execute_tool_call
    ref strip = @strip_internal_fields
    ref validate = @validate_output
    tag "src/ax/dsp/generate.ts"
    type signature = "(AxGen, AIClient, json, options?:json) -> json throws"
    body @entry(%gen: AxGen, %client: AIClient, %values: json, %options: json) {
      %base_options = core.get %gen["options"]
      %runtime_options = core.call intrinsic.map.merge(%base_options, %options)
      core.call @apply_model_config_option_impl(%runtime_options, %base_options, %options)
      // TS forward reads its cachingFunction first: a stored output comes
      // back without a request, and an error from the read propagates. A
      // host that read it before opening the run's telemetry, as TS does,
      // passes that lookup, and only the store is left.
      %cache_fn = core.call intrinsic.none()
      %cache_key = core.let ""
      %lookup = core.call @cache_lookup_option_impl(%options)
      %looked_up = core.call intrinsic.is_not_none(%lookup)
      core.if %looked_up {
        %cache_fn = core.get %lookup["fn"]
        %cache_key = core.get %lookup["key"] default ""
      } else {
        %read = core.call @cache_lookup_impl(%gen, %values, %options, false)
        %read_hit = core.get %read["hit"] default false
        core.if %read_hit {
          // As in TS, a stored output's audio outputs are rendered.
          %cached = core.get %read["value"]
          %rendered_cached = core.call @render_audio_outputs_impl(%gen, %client, %cached, %options)
          core.return %rendered_cached
        }
        %cache_fn = core.get %read["fn"]
        %cache_key = core.get %read["key"] default ""
      }
      core.call intrinsic.map.delete(%runtime_options, "_ax_cache_lookup")
      // As in TS, a streamed forward returns what a streaming consumer merges.
      %stream_option = core.get %runtime_options["stream"] default false
      %streamed = core.call intrinsic.truthy(%stream_option)
      core.if %streamed {
        %no_sink = core.call intrinsic.none()
        %merged = core.call @streaming_forward(%gen, %client, %values, %options, %no_sink)
        core.call @cache_store_impl(%cache_fn, %cache_key, %merged)
        core.return %merged
      }
      %signature = core.get %gen["signature"]
      %model = core.get %runtime_options["model"]
      %features = core.call intrinsic.ai.client_features(%client, %model)
      %functions = core.get %gen["functions"]
      %selection = core.call @select_structured_output_rung(%signature, %features, %runtime_options)
      %selected_rung = core.get %selection["rung"]
      %validate_exact_json = core.call intrinsic.eq(%selected_rung, "json_object")
      // With no structured rung the answer uses the `Label: value` text
      // contract.
      %text_contract = core.call intrinsic.is_none(%selected_rung)
      %strict_mode = core.call @strict_mode_option_impl(%base_options, %options)
      %input_fields = core.get %signature["input_fields"]
      core.call @validate_fields(%input_fields, %values, "input")
      %prompt_template = core.get %gen["prompt_template"]
      // As in TS, the prompt is rendered for the selected rung: a structured
      // rung puts the exact JSON shape and the rung's formatting rule in the
      // system prompt, and no instruction turn follows the user message.
      %render_options = core.call @structured_output_render_options_impl(%selection)
      core.call @include_optional_render_option_impl(%render_options, %options)
      %messages = core.call intrinsic.object.call_method(%prompt_template, "render", %values, %render_options)
      %example_messages = core.call @render_examples(%gen)
      %demo_messages = core.call @render_demos(%gen)
      %system_message = core.call intrinsic.list.get(%messages, 0, %messages)
      %user_message = core.call intrinsic.list.get(%messages, 1, %messages)
      %ordered_messages = core.list
      core.append %ordered_messages, %system_message
      core.for %example_message in %example_messages {
        core.append %ordered_messages, %example_message
      }
      core.for %demo_message in %demo_messages {
        core.append %ordered_messages, %demo_message
      }
      core.append %ordered_messages, %user_message
      %output_fields = core.get %signature["output_fields"]
      %output_fields = core.call @date_parse_fields_impl(%output_fields, %base_options, %options)
      %validation_feedback_snake = core.get %runtime_options["validation_feedback"] default ""
      %validation_feedback = core.get %runtime_options["validationFeedback"] default %validation_feedback_snake
      %has_validation_feedback = core.call intrinsic.truthy(%validation_feedback)
      core.if %has_validation_feedback {
        %validation_feedback_message = core.map
        core.set %validation_feedback_message["role"] = "user"
        core.set %validation_feedback_message["content"] = %validation_feedback
        core.append %ordered_messages, %validation_feedback_message
      }
      %cached_messages = core.call intrinsic.axgen.apply_context_cache(%gen, %ordered_messages, %options)
      %messages = core.let %cached_messages
      core.call intrinsic.axgen.memory_add_request(%gen, %messages)
      // As in TS, maxRetries (default 3) caps both the validation retries
      // and the infrastructure retries of each step.
      // validation_retries and infra_retries stay as port-specific overrides.
      %max_retries_snake = core.get %runtime_options["max_retries"] default 3
      %max_retries = core.get %runtime_options["maxRetries"] default %max_retries_snake
      %validation_retries_snake = core.get %runtime_options["validation_retries"] default %max_retries
      %validation_retries = core.get %runtime_options["validationRetries"] default %validation_retries_snake
      %infra_retries_snake = core.get %runtime_options["infra_retries"] default %max_retries
      %infra_retries = core.get %runtime_options["infraRetries"] default %infra_retries_snake
      %attempt = core.const 0
      %infra_attempt = core.let 0
      // TS reads thoughtFieldName from the constructor options only. The
      // output thought joins each step's thought, and a validation or refusal
      // retry starts it over.
      %thought_field_snake = core.get %base_options["thought_field_name"] default "thought"
      %thought_field = core.get %base_options["thoughtFieldName"] default %thought_field_snake
      %thought_prefix = core.let ""
      %max_steps_snake = core.get %runtime_options["max_steps"] default 25
      %max_steps = core.get %runtime_options["maxSteps"] default %max_steps_snake
      // TS keeps a failed answer and its correction in memory until a later
      // answer parses or calls tools, and then drops them
      // (response/nonStreaming.ts): a retry after an assertion failure sends
      // only the latest failed answer, while parse and validation failures
      // pile up. %failed_messages holds the failed attempts since the last
      // such answer; disableMemoryCleanup keeps them all, as in TS.
      %failed_messages = core.list
      %memory_cleanup = core.call @memory_cleanup_option_impl(%runtime_options)
      %step = core.let 0
      %control_step = core.let -1
      core.loop {
        // A step is one model turn; validation retries stay inside it, as in TS.
        %steps_exhausted = core.call intrinsic.gte(%step, %max_steps)
        core.if %steps_exhausted {
          %max_steps_message = core.call intrinsic.string.format("Max steps reached: {}", %max_steps)
          %max_steps_error = core.call intrinsic.error.runtime(%max_steps_message)
          %max_steps_failed = core.call @generate_failed_impl(%max_steps_error)
          core.raise %max_steps_failed
        }
        // As in TS, run control updates queued for this run apply when a step
        // starts, not on its retries.
        %starts_step = core.call intrinsic.ne(%step, %control_step)
        core.if %starts_step {
          %control_step = core.let %step
          %control_updates = core.call intrinsic.ai.control_take_pending(%client)
          %messages = core.call @apply_control_updates_impl(%gen, %messages, %runtime_options, %control_updates)
        }
        %request_messages = core.call @settle_failed_attempts_impl(%messages, %failed_messages, false)
        %request = core.call @build_gen_chat_request(%gen, %request_messages, %runtime_options, %selection, %step)
        %response = core.map
        core.try {
          %completed = core.call intrinsic.ai.complete_once(%client, %request, %runtime_options)
          %response = core.let %completed
        } catch %completion_error {
          %aborted = core.call intrinsic.exception.is_aborted(%completion_error)
          core.if %aborted {
            core.raise %completion_error
          }
          // As in TS, only infrastructure errors (5xx status, network, timeout,
          // stream termination) and refusals are retried; anything else
          // surfaces at once.
          %infrastructure = core.call intrinsic.exception.is_infrastructure(%completion_error)
          core.if %infrastructure {
            // TS nests the validation loop inside the infrastructure loop of
            // each step: an infrastructure retry spends the step's budget and
            // restarts the validation loop with a fresh validation budget.
            %infra_exhausted = core.call intrinsic.gte(%infra_attempt, %infra_retries)
            core.if %infra_exhausted {
              core.raise %completion_error
            }
            core.call intrinsic.retry.sleep(%infra_attempt, %client, %runtime_options)
            %next_infra_attempt = core.call intrinsic.add(%infra_attempt, 1)
            %infra_attempt = core.let %next_infra_attempt
            %attempt = core.let 0
          } else {
            // As in TS, a refusal spends the validation budget: the same prompt
            // goes out again at once, with no backoff and no correction message.
            %refused = core.call intrinsic.exception.is_refusal(%completion_error)
            %not_refused = core.call intrinsic.not(%refused)
            core.if %not_refused {
              %provider_failure = core.call @generate_failed_impl(%completion_error)
              core.raise %provider_failure
            }
            %refusal_retries_exhausted = core.call intrinsic.gte(%attempt, %validation_retries)
            core.if %refusal_retries_exhausted {
              %refusal_failure = core.call @unable_to_fix_impl(%completion_error, "")
              core.raise %refusal_failure
            }
            %refusal_next_attempt = core.call intrinsic.add(%attempt, 1)
            %attempt = core.let %refusal_next_attempt
            %thought_prefix = core.let ""
          }
          core.continue
        }
        // With functionCallValidation: 'fail', a call without a name fails
        // the forward before the response is kept or any function runs, as
        // TS's AxMemory does; the default corrects it.
        core.try {
          core.call @check_completion_function_call_names(%response, %runtime_options)
        } catch %unnamed_call_error {
          %unnamed_call_failure = core.call @generate_failed_impl(%unnamed_call_error)
          core.raise %unnamed_call_failure
        }
        // A native chat session's turns before its final response (tool
        // calls and results, continued responses) belong in the prompt of any
        // later request, as they do in TS's memory.
        %session_turns = core.get %response["session_turns"]
        %has_session_turns = core.call intrinsic.is_not_none(%session_turns)
        core.if %has_session_turns {
          core.call intrinsic.map.delete(%response, "session_turns")
          core.for %session_turn in %session_turns {
            core.append %messages, %session_turn
          }
        }
        core.call intrinsic.axgen.memory_add_response(%gen, %request, %response)
        core.call intrinsic.axgen.record_chat_log(%gen, %request, %response)
        %calls = core.call @response_function_calls_impl(%response)
        %call_count = core.call intrinsic.len(%calls)
        %has_calls = core.call intrinsic.gt(%call_count, 0)
        core.if %has_calls {
          %structured_call = core.call @find_structured_output_call(%calls)
          %has_structured_call = core.call intrinsic.is_not_none(%structured_call)
          core.if %has_structured_call {
            %structured_failure = core.call intrinsic.none()
            %structured_done = core.call intrinsic.none()
            %structured_stage = core.let "validation"
            core.try {
              %structured_args = core.call @structured_output_call_args(%structured_call)
              core.call @validate_exact_output_keys(%output_fields, %structured_args, "output")
              %structured_recovered = core.call @parse_json_string_fields(%output_fields, %structured_args)
              %structured_validated = core.call @stream_json_validate_output_impl(%output_fields, %structured_recovered)
              %structured_processed = core.call @apply_field_processors(%gen, %structured_validated)
              %structured_stage = core.let "assertion"
              %structured_assertion_failure = core.call @run_assertions(%gen, %structured_processed)
              %structured_assertion_failed = core.call intrinsic.is_not_none(%structured_assertion_failure)
              core.if %structured_assertion_failed {
                %structured_failure = core.let %structured_assertion_failure
              } else {
                %structured_stripped = core.call @strip_internal_fields(%output_fields, %structured_processed)
                %structured_thought = core.get %response["thought"] default ""
                %structured_public = core.call @with_output_thought_impl(%structured_stripped, %thought_field, %thought_prefix, %structured_thought)
                core.call intrinsic.axgen.memory_cleanup_corrections(%gen)
                %structured_done = core.let %structured_public
              }
            } catch %structured_validation_error {
              %structured_retries_exhausted = core.call intrinsic.gte(%attempt, %validation_retries)
              core.if %structured_retries_exhausted {
                %structured_output_text = core.call @attempt_output_impl(%response)
                %structured_exhausted = core.call @unable_to_fix_impl(%structured_validation_error, %structured_output_text)
                core.raise %structured_exhausted
              }
              %structured_next_attempt = core.call intrinsic.add(%attempt, 1)
              %attempt = core.let %structured_next_attempt
              %thought_prefix = core.let ""
              // As in TS, a failed __axOutput call keeps the failed attempts
              // before it.
              %structured_retry_messages = core.call @append_structured_output_retry_messages_impl(%failed_messages, %response, %structured_call, %structured_validation_error, %structured_stage)
              %failed_messages = core.let %structured_retry_messages
              core.call intrinsic.axgen.memory_add_correction(%gen, %response, %structured_validation_error)
              core.continue
            }
            // As in TS, the answer's audio outputs are rendered after the
            // retries, where a speak() error surfaces as it is.
            %structured_answered = core.call intrinsic.is_not_none(%structured_done)
            core.if %structured_answered {
              %structured_rendered = core.call @render_audio_outputs_impl(%gen, %client, %structured_done, %options)
              core.call @record_trace(%gen, %values, %structured_rendered, "ok")
              core.call @cache_store_impl(%cache_fn, %cache_key, %structured_rendered)
              core.return %structured_rendered
            }
            // Only a non-retryable assertion failure leaves the try without
            // an answer; it surfaces without a retry.
            %structured_fatal = core.call @generate_failed_impl(%structured_failure)
            core.raise %structured_fatal
          }
          // As in TS, an answer that calls tools drops the failed attempts
          // before it.
          %settled_for_tools = core.call @settle_failed_attempts_impl(%messages, %failed_messages, %memory_cleanup)
          %messages = core.let %settled_for_tools
          %failed_messages = core.list
          %updated_messages = core.call @append_tool_call_messages_impl(%messages, %response, %calls)
          %messages = core.let %updated_messages
          %tool_messages = core.call @run_tool_calls_impl(%gen, %functions, %messages, %calls, %runtime_options)
          %messages = core.let %tool_messages
          %continue_after_tools = core.call @should_continue_steps(%gen, %calls)
          core.if %continue_after_tools {
            %next_step = core.call intrinsic.add(%step, 1)
            %step = core.let %next_step
            // As in TS, each step starts with fresh validation and
            // infrastructure budgets.
            %attempt = core.let 0
            %infra_attempt = core.let 0
            %step_thought = core.get %response["thought"] default ""
            %joined_thought = core.call intrinsic.add(%thought_prefix, %step_thought)
            %thought_prefix = core.let %joined_thought
            core.continue
          } else {
            // As in TS, a user stop function ends the forward without an
            // answer: the output keeps the thought, the stop step's included.
            %stop_output = core.map
            %stop_thought = core.get %response["thought"] default ""
            %stop_public = core.call @with_output_thought_impl(%stop_output, %thought_field, %thought_prefix, %stop_thought)
            core.call intrinsic.axgen.memory_cleanup_corrections(%gen)
            %stop_rendered = core.call @render_audio_outputs_impl(%gen, %client, %stop_public, %options)
            core.call @record_trace(%gen, %values, %stop_rendered, "ok")
            core.call @cache_store_impl(%cache_fn, %cache_key, %stop_rendered)
            core.return %stop_rendered
          }
        } else {
          %parsed_bundle = core.map
          %parse_state = core.map
          core.try {
            %parsed = core.call @parse_sample_outputs(%gen, %output_fields, %response, %validate_exact_json, %thought_field, %thought_prefix, %text_contract, %strict_mode, %parse_state)
            %parsed_bundle = core.let %parsed
          } catch %validation_error {
            %retries_exhausted = core.call intrinsic.gte(%attempt, %validation_retries)
            core.if %retries_exhausted {
              %output_text = core.call @attempt_output_impl(%response)
              %validation_exhausted = core.call @unable_to_fix_impl(%validation_error, %output_text)
              core.raise %validation_exhausted
            }
            %next_attempt = core.call intrinsic.add(%attempt, 1)
            %attempt = core.let %next_attempt
            %thought_prefix = core.let ""
            // As in TS, an answer whose values parsed (its field processors
            // or assertions failed) drops the failed attempts before it; a
            // parse or validation failure keeps them.
            %answer_parsed = core.get %parse_state["parsed"] default false
            core.if %answer_parsed {
              %settled_for_retry = core.call @settle_failed_attempts_impl(%messages, %failed_messages, %memory_cleanup)
              %messages = core.let %settled_for_retry
              %failed_messages = core.list
            }
            %retry_messages = core.call @append_assertion_retry_messages(%failed_messages, %response, %validation_error)
            %failed_messages = core.let %retry_messages
            core.call intrinsic.axgen.memory_add_correction(%gen, %response, %validation_error)
            core.continue
          }
          %assertion_failure = core.get %parsed_bundle["assertion_failure"]
          %assertion_failed = core.call intrinsic.is_not_none(%assertion_failure)
          core.if %assertion_failed {
            %assertion_fatal = core.call @generate_failed_impl(%assertion_failure)
            core.raise %assertion_fatal
          }
          // As in TS, an answer cut off by the token limit fails the forward
          // after its outputs parse, processors and assertions run.
          %length_failure = core.call @max_tokens_error_impl(%response)
          %length_failed = core.call intrinsic.is_not_none(%length_failure)
          core.if %length_failed {
            %length_fatal = core.call @generate_failed_impl(%length_failure)
            core.raise %length_fatal
          }
          %empty_feedback = core.list
          %feedback = core.get %parsed_bundle["feedback"] default %empty_feedback
          %feedback_count = core.call intrinsic.len(%feedback)
          %fed_back = core.call intrinsic.gt(%feedback_count, 0)
          core.if %fed_back {
            // As in TS, field processor feedback goes to the model after its
            // answer and the run takes another step; the answer is replaced
            // and the thought joins across steps. The failed attempts before
            // the answer are dropped.
            %settled_for_feedback = core.call @settle_failed_attempts_impl(%messages, %failed_messages, %memory_cleanup)
            %messages = core.let %settled_for_feedback
            %failed_messages = core.list
            %answer_content = core.get %response["content"] default ""
            %answer_message = core.map
            core.set %answer_message["role"] = "assistant"
            core.set %answer_message["content"] = %answer_content
            core.append %messages, %answer_message
            %feedback_messages = core.list
            core.for %feedback_text in %feedback {
              %feedback_message = core.call @feedback_message_impl(%feedback_text)
              core.append %messages, %feedback_message
              core.append %feedback_messages, %feedback_message
            }
            core.call intrinsic.axgen.memory_add_request(%gen, %feedback_messages)
            core.call intrinsic.axgen.memory_cleanup_corrections(%gen)
            %feedback_step = core.call intrinsic.add(%step, 1)
            %step = core.let %feedback_step
            %attempt = core.let 0
            %infra_attempt = core.let 0
            %feedback_thought = core.get %response["thought"] default ""
            %feedback_joined = core.call intrinsic.add(%thought_prefix, %feedback_thought)
            %thought_prefix = core.let %feedback_joined
            core.continue
          }
          // As in TS, a run control update queued during the step (a steer or
          // a thinking budget) takes another step, which applies it; the
          // answer then comes from that step.
          %control_pending = core.call intrinsic.ai.control_pending_count(%client)
          %steered = core.call intrinsic.gt(%control_pending, 0)
          core.if %steered {
            %settled_for_steer = core.call @settle_failed_attempts_impl(%messages, %failed_messages, %memory_cleanup)
            %messages = core.let %settled_for_steer
            %failed_messages = core.list
            %steered_content = core.get %response["content"] default ""
            %steered_message = core.map
            core.set %steered_message["role"] = "assistant"
            core.set %steered_message["content"] = %steered_content
            core.append %messages, %steered_message
            core.call intrinsic.axgen.memory_cleanup_corrections(%gen)
            %steered_step = core.call intrinsic.add(%step, 1)
            %step = core.let %steered_step
            %attempt = core.let 0
            %infra_attempt = core.let 0
            %steered_thought = core.get %response["thought"] default ""
            %steered_joined = core.call intrinsic.add(%thought_prefix, %steered_thought)
            %thought_prefix = core.let %steered_joined
            core.continue
          }
          %public_outputs = core.get %parsed_bundle["outputs"]
          %structured_samples = core.get %parsed_bundle["samples"]
          %selected_index = core.call @select_sample_index(%structured_samples, %runtime_options)
          %empty_public = core.map
          %public_output = core.call intrinsic.list.get(%public_outputs, %selected_index, %empty_public)
          core.call intrinsic.axgen.memory_cleanup_corrections(%gen)
          // As in TS, the picked answer's audio outputs are rendered, and the
          // trace and the cache get the rendered output.
          %rendered_output = core.call @render_audio_outputs_impl(%gen, %client, %public_output, %options)
          core.call @record_trace(%gen, %values, %rendered_output, "ok")
          core.call @cache_store_impl(%cache_fn, %cache_key, %rendered_output)
          core.return %rendered_output
        }
      }
      core.raise "unreachable AxGen forward loop exit"
    }
  }

