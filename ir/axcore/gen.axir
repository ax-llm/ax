  op ax.gen.semantic @tool_error_message_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "tool-error-message-core-helper"
    type signature = "(json, error) -> json"
    body @entry(%call: json, %error: error) {
      %id = core.get %call["id"]
      %name = core.get %call["name"]
      %error_text = core.call intrinsic.exception.message(%error)
      %payload = core.map
      core.set %payload["error"] = %error_text
      %payload_json = core.call intrinsic.json.stringify(%payload)
      %message = core.map
      core.set %message["role"] = "function"
      core.set %message["function_id"] = %id
      core.set %message["name"] = %name
      core.set %message["result"] = %payload_json
      core.set %message["is_error"] = true
      core.return %message
    }
  }

  op ax.gen.semantic @append_validation_retry_messages_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "validation-retry-message-core-helper"
    type signature = "(list<json>, json, error) -> list<json>"
    body @entry(%messages: list<json>, %response: json, %error: error) {
      %content = core.get %response["content"] default ""
      %assistant_message = core.map
      core.set %assistant_message["role"] = "assistant"
      core.set %assistant_message["content"] = %content
      core.append %messages, %assistant_message
      // As TS renders the error's fixing instructions (renderExtraFields):
      // one user message with a text part, "Invalid Field: <message>" for a
      // validation error and "Follow these instructions: <message>" for an
      // assertion, whose message ends with a period.
      %error_text = core.call intrinsic.exception.message(%error)
      %is_validation = core.call intrinsic.exception.is_validation(%error)
      %retry_text = core.let ""
      core.if %is_validation {
        %retry_text = core.call intrinsic.add("Invalid Field: ", %error_text)
      } else {
        %instruction = core.string_trim %error_text
        %has_period = core.call intrinsic.string.ends_with(%instruction, ".")
        %no_period = core.call intrinsic.not(%has_period)
        core.if %no_period {
          %instruction = core.call intrinsic.add(%instruction, ".")
        }
        %retry_text = core.call intrinsic.add("Follow these instructions: ", %instruction)
      }
      %retry_message = core.call @feedback_message_impl(%retry_text)
      core.append %messages, %retry_message
      // Callers must reassign from this return: in Go the forward loop's
      // messages can be a plain slice, so in-place appends never reach them.
      core.return %messages
    }
  }
  op ax.gen.semantic @parse_text_field_value_impl {
    attr core_kind = "func"
    attr private = true
    attr effect = "throws"
    attr emit_module = "gen"
    tag "wire-field-extraction"
    type signature = "(json, string) -> json throws"
    body @entry(%field: json, %text: string) {
      %text = core.string_trim %text
      %typ = core.get %field["type"]
      %name = core.get %typ["name"]
      %array = core.get %typ["is_array"] default false
      %is_boolean = core.call intrinsic.eq(%name, "boolean")
      %numeric = core.call intrinsic.eq(%name, "number")
      %json = core.call intrinsic.eq(%name, "json")
      %parse = core.call intrinsic.or(%is_boolean, %numeric)
      %parse = core.call intrinsic.or(%parse, %array)
      %parse = core.call intrinsic.or(%parse, %json)
      core.if %parse {
        %value = core.call intrinsic.json.parse_strict(%text)
        core.return %value
      }
      core.return %text
    }
  }

  op ax.gen.semantic @parse_text_output_fields_impl {
    attr core_kind = "func"
    attr private = true
    attr effect = "throws"
    attr emit_module = "gen"
    tag "src/ax/dsp/extract/streamingText.ts"
    type signature = "(string, list<Field>, bool) -> json throws"
    body @entry(%content: string, %fields: json, %is_final: bool) {
      %lines = core.call intrinsic.string.split(%content, "\n")
      %count = core.call intrinsic.len(%lines)
      %index = core.let 0
      %values = core.map
      %current = core.call intrinsic.none()
      %current_name = core.let ""
      %parts = core.list
      core.for %line in %lines {
        %index = core.call intrinsic.add(%index, 1)
        %line_trimmed = core.string_trim %line
        %matched = core.call intrinsic.none()
        %value = core.let ""
        %withhold = core.let false
        core.for %field in %fields {
          %name = core.get %field["name"]
          %title = core.get %field["title"] default %name
          %labels = core.list
          core.append %labels, %name
          core.append %labels, %title
          core.for %label in %labels {
            %prefix = core.call intrinsic.string.format("{}:", %label)
            %found = core.call intrinsic.string.starts_with(%line_trimmed, %prefix)
            core.if %found {
              %matched = core.let %field
              %length = core.call intrinsic.len(%prefix)
              %value = core.call intrinsic.string.slice(%line_trimmed, %length)
              core.break
            }
            %last = core.call intrinsic.eq(%index, %count)
            %partial = core.call intrinsic.not(%is_final)
            %partial = core.call intrinsic.and(%partial, %last)
            core.if %partial {
              %prefix_partial = core.call intrinsic.string.starts_with(%prefix, %line_trimmed)
              %withhold = core.call intrinsic.or(%withhold, %prefix_partial)
            }
          }
          %has_match = core.call intrinsic.is_not_none(%matched)
          core.if %has_match { core.break }
        }
        %has_match = core.call intrinsic.is_not_none(%matched)
        core.if %has_match {
          %has_current = core.call intrinsic.ne(%current_name, "")
          core.if %has_current {
            %raw = core.string_join %parts sep "\n"
            %parsed = core.call @parse_text_field_value_impl(%current, %raw)
            core.set %values[%current_name] = %parsed
          }
          %current = core.let %matched
          %current_name = core.get %matched["name"]
          %parts = core.list
          core.append %parts, %value
        } else {
          %has_current = core.call intrinsic.ne(%current_name, "")
          %keep = core.call intrinsic.not(%withhold)
          %keep = core.call intrinsic.and(%keep, %has_current)
          core.if %keep { core.append %parts, %line }
        }
      }
      %has_current = core.call intrinsic.ne(%current_name, "")
      core.if %has_current {
        %raw = core.string_join %parts sep "\n"
        core.try {
          %parsed = core.call @parse_text_field_value_impl(%current, %raw)
          core.set %values[%current_name] = %parsed
        } catch %parse_error {
          core.if %is_final { core.raise %parse_error }
        }
      }
      core.return %values
    }
  }

  op ax.gen.semantic @parse_output_fields_impl {
    attr core_kind = "func"
    attr private = true
    attr effect = "throws"
    attr emit_module = "gen"
    tag "wire-field-extraction"
    type signature = "(string, list<Field>) -> json throws"
    body @entry(%content: string, %fields: json) {
      %text = core.string_trim %content
      %is_json = core.call intrinsic.string.starts_with(%text, "{")
      core.if %is_json {
        %output = core.call @parse_output_impl(%text)
        core.return %output
      }
      %output = core.call @parse_text_output_fields_impl(%text, %fields, true)
      core.return %output
    }
  }

  op ax.gen.semantic @signature_has_complex_fields {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/sig.ts"
    type signature = "(AxSignature, json) -> bool"
    body @entry(%signature: AxSignature, %options: json) {
      %option_forced_snake = core.get %options["force_structured"] default false
      %option_forced = core.get %options["forceStructured"] default %option_forced_snake
      %signature_forced_snake = core.get %signature["force_structured"] default false
      %signature_forced = core.get %signature["forceStructured"] default %signature_forced_snake
      %forced = core.call intrinsic.or(%option_forced, %signature_forced)
      core.if %forced {
        core.return true
      }
      %output_fields = core.get %signature["output_fields"]
      core.for %field in %output_fields {
        %field_type = core.get %field["type"]
        %type_name = core.get %field_type["name"]
        %is_object = core.call intrinsic.eq(%type_name, "object")
        core.if %is_object {
          core.return true
        }
        %is_array_snake = core.get %field_type["is_array"] default false
        %is_array = core.get %field_type["isArray"] default %is_array_snake
        %nested_fields = core.get %field_type["fields"]
        %has_nested_fields = core.call intrinsic.truthy(%nested_fields)
        %object_array = core.call intrinsic.and(%is_array, %has_nested_fields)
        core.if %object_array {
          core.return true
        }
      }
      core.return false
    }
  }

  op ax.gen.semantic @caller_function_call_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/functions.ts"
    type signature = "(json) -> json"
    body @entry(%options: json) {
      %requested_snake = core.get %options["function_call"]
      %requested = core.get %options["functionCall"] default %requested_snake
      %has_requested = core.call intrinsic.is_not_none(%requested)
      core.if %has_requested {
        core.return %requested
      }
      // A tool choice passed as functionCallMode used to reach the provider on
      // every request. Route it through the caller functionCall instead.
      %mode_snake = core.get %options["function_call_mode"]
      %mode = core.get %options["functionCallMode"] default %mode_snake
      %is_required = core.call intrinsic.eq(%mode, "required")
      %is_none = core.call intrinsic.eq(%mode, "none")
      %is_named = core.type_is %mode type "object"
      %required_or_none = core.call intrinsic.or(%is_required, %is_none)
      %routed = core.call intrinsic.or(%required_or_none, %is_named)
      core.if %routed {
        core.return %mode
      }
      %none = core.call intrinsic.none()
      core.return %none
    }
  }

  op ax.gen.semantic @function_call_forces_tool_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/functions.ts"
    type signature = "(json) -> bool"
    body @entry(%choice: json) {
      %is_required = core.call intrinsic.eq(%choice, "required")
      core.if %is_required {
        core.return true
      }
      %is_named = core.type_is %choice type "object"
      core.return %is_named
    }
  }

  op ax.gen.semantic @function_call_names_output_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "structured-output-reserved-function-names"
    type signature = "(json) -> bool"
    body @entry(%choice: json) {
      %is_named = core.type_is %choice type "object"
      %not_named = core.call intrinsic.not(%is_named)
      core.if %not_named {
        core.return false
      }
      %empty_function = core.map
      %function = core.get %choice["function"] default %empty_function
      %name = core.get %function["name"] default ""
      %canonical = core.call intrinsic.eq(%name, "__axOutput")
      %legacy = core.call intrinsic.eq(%name, "__finalResult")
      %reserved = core.call intrinsic.or(%canonical, %legacy)
      core.return %reserved
    }
  }

  op ax.gen.semantic @append_structured_output_retry_messages_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "structured-output-retry-message-core-helper"
    type signature = "(list<json>, json, json, error, string) -> list<json>"
    body @entry(%messages: list<json>, %response: json, %call: json, %error: error, %stage: string) {
      // As in TS, the output call stays on the assistant turn with a "done"
      // result, followed by the tool-call failure notice and the rendered
      // error: "Follow these instructions" for an assertion, "Invalid Field"
      // otherwise. Dropping the call leaves an empty assistant turn that
      // providers reject.
      %output_calls = core.list
      core.append %output_calls, %call
      %with_call = core.call @append_tool_call_messages_impl(%messages, %response, %output_calls)
      %id = core.get %call["id"]
      %direct_name = core.get %call["name"]
      %fn = core.get %call["function"]
      %name = core.get %fn["name"] default %direct_name
      %result_message = core.map
      core.set %result_message["role"] = "function"
      core.set %result_message["function_id"] = %id
      core.set %result_message["name"] = %name
      core.set %result_message["result"] = "done"
      core.append %with_call, %result_message
      %notice = core.map
      core.set %notice["role"] = "user"
      core.set %notice["content"] = "The previous tool call failed. Fix arguments and try again, ensuring required fields match schema."
      core.append %with_call, %notice
      %error_text = core.call intrinsic.exception.message(%error)
      %error_text = core.string_trim %error_text
      %correction_text = core.call intrinsic.string.format("Invalid Field: {}", %error_text)
      %is_assertion = core.call intrinsic.eq(%stage, "assertion")
      core.if %is_assertion {
        %has_period = core.call intrinsic.string.ends_with(%error_text, ".")
        %period = core.let "."
        core.if %has_period {
          %period = core.let ""
        }
        %correction_text = core.call intrinsic.string.format("Follow these instructions: {}{}", %error_text, %period)
      }
      %correction = core.map
      core.set %correction["role"] = "user"
      core.set %correction["content"] = %correction_text
      core.append %with_call, %correction
      // Callers must reassign from this return: in Go the forward loop's
      // messages can be a plain slice, so in-place appends never reach them.
      core.return %with_call
    }
  }

  op ax.gen.semantic @with_output_thought_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/response/nonStreaming.ts"
    type signature = "(json, string, string, string) -> json"
    body @entry(%output: json, %field: string, %prefix: string, %thought: string) {
      // As in TS, a response's non-empty thought becomes an output under the
      // thought field, after the thoughts of the earlier tool steps.
      %joined = core.call intrinsic.add(%prefix, %thought)
      %has_thought = core.call intrinsic.truthy(%joined)
      core.if %has_thought {
        core.set %output[%field] = %joined
      }
      core.return %output
    }
  }

  op ax.gen.semantic @streaming_forward {
    attr core_kind = "method"
    attr effect = "throws"
    attr emit_module = "gen"
    attr emit_name = "_streaming_forward_impl"
    tag "src/ax/dsp/generate.ts"
    type signature = "(AxGen, AIClient, json, json, json) -> json throws"
    body @entry(%gen: AxGen, %client: AIClient, %values: json, %options: json, %sink: json) {
      // TS streamingForward: sends {version, index, delta} to the sink as the
      // model streams, and returns the merged output of the picked sample.
      // Retries, steps and tools follow forward; a validation or refusal retry
      // starts a new version, an infrastructure retry resumes the current one,
      // and a step after emitted output fields starts a new version that
      // carries the thought so far.
      %base_options = core.get %gen["options"]
      %runtime_options = core.call intrinsic.map.merge(%base_options, %options)
      core.call @apply_model_config_option_impl(%runtime_options, %base_options, %options)
      core.set %runtime_options["stream"] = true
      // TS streamingForward reads its cachingFunction first and ignores an
      // error from the read; a stored output comes back as one delta.
      // Without a sink, forward reads and stores the cache itself; a host
      // that read it before opening the run's telemetry passes that lookup.
      %cache_fn = core.call intrinsic.none()
      %cache_key = core.let ""
      %has_sink = core.call intrinsic.is_not_none(%sink)
      core.if %has_sink {
        %lookup = core.call @cache_lookup_option_impl(%options)
        %looked_up = core.call intrinsic.is_not_none(%lookup)
        core.if %looked_up {
          %cache_fn = core.get %lookup["fn"]
          %cache_key = core.get %lookup["key"] default ""
        } else {
          %read = core.call @cache_lookup_impl(%gen, %values, %options, true)
          %cache_fn = core.get %read["fn"]
          %cache_key = core.get %read["key"] default ""
          %read_hit = core.get %read["hit"] default false
          core.if %read_hit {
            // As in TS, a stored output's audio outputs are rendered before
            // it goes out as one delta.
            %cached = core.get %read["value"]
            %rendered_cached = core.call @render_audio_outputs_impl(%gen, %client, %cached, %options)
            %cached_envelope = core.map
            core.set %cached_envelope["version"] = 0
            core.set %cached_envelope["index"] = 0
            core.set %cached_envelope["delta"] = %rendered_cached
            core.call intrinsic.axgen.emit_delta(%sink, %cached_envelope)
            core.return %rendered_cached
          }
        }
      }
      core.call intrinsic.map.delete(%runtime_options, "_ax_cache_lookup")
      %signature = core.get %gen["signature"]
      %model = core.get %runtime_options["model"]
      %features = core.call intrinsic.ai.client_features(%client, %model)
      %functions = core.get %gen["functions"]
      %selection = core.call @select_structured_output_rung(%signature, %features, %runtime_options)
      %selected_rung = core.get %selection["rung"]
      %input_fields = core.get %signature["input_fields"]
      core.call @validate_fields(%input_fields, %values, "input")
      %prompt_template = core.get %gen["prompt_template"]
      // As in TS, the prompt is rendered for the selected rung: a structured
      // rung puts the exact JSON shape and the rung's formatting rule in the
      // system prompt, and no instruction turn follows the user message.
      %render_options = core.call @structured_output_render_options_impl(%selection)
      core.call @include_optional_render_option_impl(%render_options, %options)
      %messages = core.call intrinsic.object.call_method(%prompt_template, "render", %values, %render_options)
      %example_messages = core.call @render_examples(%gen)
      %demo_messages = core.call @render_demos(%gen)
      %system_message = core.call intrinsic.list.get(%messages, 0, %messages)
      %user_message = core.call intrinsic.list.get(%messages, 1, %messages)
      %ordered_messages = core.list
      core.append %ordered_messages, %system_message
      core.for %example_message in %example_messages {
        core.append %ordered_messages, %example_message
      }
      core.for %demo_message in %demo_messages {
        core.append %ordered_messages, %demo_message
      }
      core.append %ordered_messages, %user_message
      %output_fields = core.get %signature["output_fields"]
      %output_fields = core.call @date_parse_fields_impl(%output_fields, %base_options, %options)
      %validation_feedback_snake = core.get %runtime_options["validation_feedback"] default ""
      %validation_feedback = core.get %runtime_options["validationFeedback"] default %validation_feedback_snake
      %has_validation_feedback = core.call intrinsic.truthy(%validation_feedback)
      core.if %has_validation_feedback {
        %validation_feedback_message = core.map
        core.set %validation_feedback_message["role"] = "user"
        core.set %validation_feedback_message["content"] = %validation_feedback
        core.append %ordered_messages, %validation_feedback_message
      }
      %cached_messages = core.call intrinsic.axgen.apply_context_cache(%gen, %ordered_messages, %options)
      %messages = core.let %cached_messages
      core.call intrinsic.axgen.memory_add_request(%gen, %messages)
      %max_retries_snake = core.get %runtime_options["max_retries"] default 3
      %max_retries = core.get %runtime_options["maxRetries"] default %max_retries_snake
      %validation_retries_snake = core.get %runtime_options["validation_retries"] default %max_retries
      %validation_retries = core.get %runtime_options["validationRetries"] default %validation_retries_snake
      %infra_retries_snake = core.get %runtime_options["infra_retries"] default %max_retries
      %infra_retries = core.get %runtime_options["infraRetries"] default %infra_retries_snake
      %thought_field_snake = core.get %base_options["thought_field_name"] default "thought"
      %thought_field = core.get %base_options["thoughtFieldName"] default %thought_field_snake
      %max_steps_snake = core.get %runtime_options["max_steps"] default 25
      %max_steps = core.get %runtime_options["maxSteps"] default %max_steps_snake
      // Structured rungs and complex signatures parse the content as JSON;
      // the text contract extracts `Label: value` fields.
      %complex = core.call @signature_has_complex_fields(%signature, %runtime_options)
      %is_native = core.call intrinsic.eq(%selected_rung, "native")
      %is_json_object = core.call intrinsic.eq(%selected_rung, "json_object")
      %is_function_rung = core.call intrinsic.eq(%selected_rung, "function")
      %structured = core.call intrinsic.or(%complex, %is_native)
      %structured = core.call intrinsic.or(%structured, %is_json_object)
      %simple = core.call intrinsic.not(%complex)
      %native_simple = core.call intrinsic.and(%is_native, %simple)
      %strict_json = core.call intrinsic.or(%is_json_object, %native_simple)
      %not_function_rung = core.call intrinsic.not(%is_function_rung)
      %parse_json_strings = core.call intrinsic.and(%complex, %not_function_rung)
      %held = core.call @stream_held_fields_impl(%gen, %output_fields)
      %config = core.map
      core.set %config["fields"] = %output_fields
      core.set %config["held"] = %held
      core.set %config["structured"] = %structured
      core.set %config["strict_json"] = %strict_json
      core.set %config["parse_json_strings"] = %parse_json_strings
      core.set %config["thought_field"] = %thought_field
      %strict_mode = core.call @strict_mode_option_impl(%base_options, %options)
      core.set %config["strict_mode"] = %strict_mode
      // processStreamingResponse: with functionCot and functions, text before
      // a tool call is reasoning, so it neither assumes nor requires a field.
      %function_cot_snake = core.get %features["function_cot"] default false
      %function_cot = core.get %features["functionCot"] default %function_cot_snake
      %empty_functions = core.list
      %function_list = core.get %gen["functions"] default %empty_functions
      %function_count = core.call intrinsic.len(%function_list)
      %has_functions = core.call intrinsic.gt(%function_count, 0)
      %function_cot_on = core.call intrinsic.truthy(%function_cot)
      %skip_early_fail = core.call intrinsic.and(%function_cot_on, %has_functions)
      core.set %config["skip_early_fail"] = %skip_early_fail
      %sample_snake = core.get %runtime_options["sample_count"]
      %sample_camel = core.get %runtime_options["sampleCount"] default %sample_snake
      %sample_count = core.get %runtime_options["n"] default %sample_camel
      %no_sample_count = core.call intrinsic.is_none(%sample_count)
      core.if %no_sample_count {
        %sample_count = core.let 1
      }
      %picker_snake = core.get %runtime_options["result_picker"]
      %picker = core.get %runtime_options["resultPicker"] default %picker_snake
      %buffered = core.call intrinsic.is_not_none(%picker)
      %run = core.call @stream_run_state_impl(%sink, %buffered, %thought_field)
      // The run's result renders its audio outputs where TS renders them
      // (@render_stream_result_impl).
      %render_audio = core.map
      core.set %render_audio["gen"] = %gen
      core.set %render_audio["client"] = %client
      core.set %render_audio["options"] = %options
      core.set %run["render_audio"] = %render_audio
      %committed = core.map
      %control_version = core.let 0
      %step = core.let 0
      core.loop {
        %steps_exhausted = core.call intrinsic.gte(%step, %max_steps)
        core.if %steps_exhausted {
          %max_steps_message = core.call intrinsic.string.format("Max steps reached: {}", %max_steps)
          %max_steps_error = core.call intrinsic.error.runtime(%max_steps_message)
          %max_steps_failed = core.call @generate_failed_impl(%max_steps_error)
          core.raise %max_steps_failed
        }
        %step_started = core.call intrinsic.gt(%step, 0)
        %output_emitted = core.get %run["output_emitted"] default false
        %replace_output = core.call intrinsic.and(%step_started, %output_emitted)
        core.if %replace_output {
          // A step after emitted output fields replaces them: a new version
          // that re-sends the thought so far, so thought still joins.
          %held_version = core.get %run["current_version"] default 0
          %behind = core.call intrinsic.lt(%control_version, %held_version)
          core.if %behind {
            %control_version = core.let %held_version
          }
          %control_version = core.call intrinsic.add(%control_version, 1)
          %committed = core.map
          %empty_carried = core.list
          %carried = core.get %run["emitted_thought"] default %empty_carried
          core.call @stream_run_new_version_impl(%run, %control_version)
          core.for %carried_entry in %carried {
            %carried_text = core.get %carried_entry["text"] default ""
            %has_carried = core.call intrinsic.ne(%carried_text, "")
            core.if %has_carried {
              %carried_index = core.get %carried_entry["index"] default 0
              %carried_delta = core.map
              core.set %carried_delta[%thought_field] = %carried_text
              core.call @stream_yield_impl(%run, %control_version, %carried_index, %carried_delta)
            }
          }
        }
        // As in TS, run control updates queued for this run apply when a step
        // starts, and each one starts a new version.
        %control_updates = core.call intrinsic.ai.control_take_pending(%client)
        %messages = core.call @apply_control_updates_impl(%gen, %messages, %runtime_options, %control_updates)
        core.for %control_update in %control_updates {
          %update_held_version = core.get %run["current_version"] default 0
          %update_behind = core.call intrinsic.lt(%control_version, %update_held_version)
          core.if %update_behind {
            %control_version = core.let %update_held_version
          }
          %control_version = core.call intrinsic.add(%control_version, 1)
          %committed = core.map
        }
        %infra_attempt = core.let 0
        %infra_error = core.call intrinsic.none()
        core.loop {
          // errCount starts over: resume from the version consumers hold.
          %resume_version = core.get %run["current_version"] default 0
          %stale = core.call intrinsic.lt(%control_version, %resume_version)
          core.if %stale {
            %control_version = core.let %resume_version
          }
          %attempt = core.let 0
          %infra_retry = core.let false
          %next_step = core.let false
          core.loop {
            %version = core.call intrinsic.add(%control_version, %attempt)
            %states = core.list
            %state_index = core.let 0
            core.loop {
              %enough = core.call intrinsic.gte(%state_index, %sample_count)
              core.if %enough {
                core.break
              }
              %state = core.call @stream_state_impl(%state_index)
              core.append %states, %state
              %state_index = core.call intrinsic.add(%state_index, 1)
            }
            %retrying = core.call intrinsic.gt(%attempt, 0)
            core.if %retrying {
              %committed = core.map
            }
            %current = core.map
            %ctx = core.map
            core.set %ctx["run"] = %run
            core.set %ctx["committed"] = %committed
            core.set %ctx["current"] = %current
            core.set %ctx["version"] = %version
            core.set %ctx["control_version"] = %control_version
            core.set %ctx["attempt"] = %attempt
            // A native chat session's partial events and completed response
            // (session items from the client's stream) keep their state here.
            %session_stream = core.call @stream_session_state_impl(%output_fields, %thought_field)
            core.set %ctx["session"] = %session_stream
            %request = core.call @build_gen_chat_request(%gen, %messages, %runtime_options, %selection, %step)
            %events = core.list
            %stage = core.let "provider"
            %handle = core.call intrinsic.none()
            %recorded = core.let false
            %response = core.map
            %outcome = core.map
            %structured_call = core.call intrinsic.none()
            %structured_stage = core.let "validation"
            core.try {
              %handle = core.call intrinsic.ai.stream_open(%client, %request, %runtime_options)
              core.loop {
                %stage = core.let "provider"
                %event = core.call intrinsic.ai.stream_next(%handle)
                %exhausted = core.call intrinsic.is_none(%event)
                core.if %exhausted {
                  core.break
                }
                // A native chat session streams items: a response's partial
                // events, a response it continued from, and its final
                // response, which streams as one chunk on the attempt's
                // states and sends only what the partial events did not.
                %session_item = core.get %event["session"]
                %is_session_item = core.call intrinsic.is_not_none(%session_item)
                core.if %is_session_item {
                  %session_kind = core.get %session_item["type"] default ""
                  %session_response_id = core.get %session_item["response_id"] default ""
                  %empty_session_turns = core.list
                  %item_turns = core.get %session_item["turns"] default %empty_session_turns
                  core.set %session_stream["turns"] = %item_turns
                  %new_session_response = core.call @stream_session_select_impl(%ctx, %session_response_id)
                  core.if %new_session_response {
                    // A retry's prompt shows the response the correction is
                    // about, not an earlier one.
                    %events = core.list
                  }
                  %is_session_partial = core.call intrinsic.eq(%session_kind, "partial")
                  core.if %is_session_partial {
                    core.append %events, %event
                    %stage = core.let "validation"
                    %partial_outcome = core.call @stream_session_partial_impl(%gen, %config, %ctx, %event)
                    %partial_fatal = core.get %partial_outcome["fatal"]
                    %has_partial_fatal = core.call intrinsic.is_not_none(%partial_fatal)
                    core.if %has_partial_fatal {
                      %stage = core.let "fatal"
                      core.raise %partial_fatal
                    }
                    core.continue
                  }
                  %is_session_final = core.call intrinsic.eq(%session_kind, "final")
                  %not_session_final = core.call intrinsic.not(%is_session_final)
                  core.if %not_session_final {
                    core.continue
                  }
                  %events = core.list
                  core.set %session_stream["final"] = true
                }
                core.append %events, %event
                %stage = core.let "validation"
                %chunk = core.let %event
                %has_routing = core.call intrinsic.map.contains(%event, "routing")
                %has_wrapped = core.call intrinsic.map.contains(%event, "response")
                %router_envelope = core.call intrinsic.and(%has_routing, %has_wrapped)
                core.if %router_envelope {
                  %chunk = core.get %event["response"]
                }
                %empty_results = core.list
                %results = core.get %chunk["results"] default %empty_results
                core.for %result in %results {
                  %finish_snake = core.get %result["finish_reason"]
                  %finish = core.get %result["finishReason"] default %finish_snake
                  %failed_stream = core.call intrinsic.eq(%finish, "error")
                  core.if %failed_stream {
                    %stage = core.let "fatal"
                    %stream_error = core.call intrinsic.error.runtime("Streaming response failed")
                    core.raise %stream_error
                  }
                  // Terminal status often arrives in a separate empty chunk.
                  %result_content = core.get %result["content"] default ""
                  %result_thought = core.get %result["thought"] default ""
                  %empty_blocks = core.list
                  %blocks_snake = core.get %result["thought_blocks"] default %empty_blocks
                  %blocks = core.get %result["thoughtBlocks"] default %blocks_snake
                  %calls_snake = core.get %result["function_calls"] default %empty_blocks
                  %result_calls = core.get %result["functionCalls"] default %calls_snake
                  %phase = core.get %result["phase"]
                  %has_content = core.call intrinsic.truthy(%result_content)
                  %has_thought = core.call intrinsic.truthy(%result_thought)
                  %block_count = core.call intrinsic.len(%blocks)
                  %has_blocks = core.call intrinsic.gt(%block_count, 0)
                  %call_count = core.call intrinsic.len(%result_calls)
                  %has_result_calls = core.call intrinsic.gt(%call_count, 0)
                  %has_phase = core.call intrinsic.truthy(%phase)
                  %hit_length = core.call intrinsic.eq(%finish, "length")
                  %substantive = core.call intrinsic.or(%has_content, %has_thought)
                  %substantive = core.call intrinsic.or(%substantive, %has_blocks)
                  %substantive = core.call intrinsic.or(%substantive, %has_result_calls)
                  %substantive = core.call intrinsic.or(%substantive, %has_phase)
                  %substantive = core.call intrinsic.or(%substantive, %hit_length)
                  %skip_result = core.call intrinsic.not(%substantive)
                  core.if %skip_result {
                    core.continue
                  }
                  %index = core.get %result["index"] default 0
                  %no_state = core.call intrinsic.none()
                  %state = core.call intrinsic.list.get(%states, %index, %no_state)
                  %missing_state = core.call intrinsic.is_none(%state)
                  core.if %missing_state {
                    %stage = core.let "fatal"
                    %state_message = core.call intrinsic.string.format("No state found for result (index: {})", %index)
                    %state_error = core.call intrinsic.error.runtime(%state_message)
                    core.raise %state_error
                  }
                  %thought_is_text = core.type_is %result_thought type "string"
                  %thought_chunk = core.call intrinsic.and(%has_thought, %thought_is_text)
                  core.if %thought_chunk {
                    %empty_values = core.map
                    %state_values = core.get %state["values"] default %empty_values
                    %old_thought = core.get %state_values[%thought_field] default ""
                    %joined_thought = core.call intrinsic.add(%old_thought, %result_thought)
                    core.set %state_values[%thought_field] = %joined_thought
                    core.set %state["values"] = %state_values
                    %thought_delta = core.map
                    core.set %thought_delta[%thought_field] = %result_thought
                    %thought_deltas = core.list
                    core.append %thought_deltas, %thought_delta
                    %stage = core.let "fatal"
                    core.call @stream_emit_deltas_impl(%ctx, %index, %thought_deltas)
                    %stage = core.let "validation"
                  }
                  core.if %hit_length {
                    %stage = core.let "fatal"
                    %length_so_far = core.get %state["content"] default ""
                    %length_content = core.call intrinsic.add(%length_so_far, %result_content)
                    %length_message = core.call intrinsic.add("Max tokens reached before completion\nContent: ", %length_content)
                    %length_error = core.call intrinsic.error.runtime(%length_message)
                    core.raise %length_error
                  }
                  %content_deltas = core.call @stream_chunk_content_impl(%gen, %config, %state, %result)
                  %stage = core.let "fatal"
                  %callback_failure = core.get %state["fatal_error"]
                  %callback_failed = core.call intrinsic.is_not_none(%callback_failure)
                  core.if %callback_failed {
                    core.raise %callback_failure
                  }
                  core.call @stream_emit_deltas_impl(%ctx, %index, %content_deltas)
                  %stage = core.let "validation"
                }
              }
              %stage = core.let "validation"
              %messages = core.call @stream_session_add_turns_impl(%messages, %session_stream)
              %folded = core.call @fold_chat_response_stream(%events)
              %response = core.call @chat_response_to_completion(%folded)
              // The merged calls get the forward's check: with
              // functionCallValidation: 'fail', a call without a name fails
              // the run without a retry.
              %stage = core.let "fatal"
              core.call @check_completion_function_call_names(%response, %runtime_options)
              %stage = core.let "validation"
              core.call intrinsic.axgen.memory_add_response(%gen, %request, %response)
              core.call intrinsic.axgen.record_chat_log(%gen, %request, %response)
              %recorded = core.let true
              %calls = core.call @response_function_calls_impl(%response)
              %response_call_count = core.call intrinsic.len(%calls)
              %has_calls = core.call intrinsic.gt(%response_call_count, 0)
              core.if %has_calls {
                %structured_call = core.call @find_structured_output_call(%calls)
                %has_structured_call = core.call intrinsic.is_not_none(%structured_call)
                core.if %has_structured_call {
                  %stage = core.let "structured"
                  %structured_stage = core.let "validation"
                  %structured_args = core.call @structured_output_call_args(%structured_call)
                  core.call @validate_exact_output_keys(%output_fields, %structured_args, "output")
                  %structured_recovered = core.call @parse_json_string_fields(%output_fields, %structured_args)
                  %structured_validated = core.call @stream_json_validate_output_impl(%output_fields, %structured_recovered)
                  %structured_processed = core.call @apply_field_processors(%gen, %structured_validated)
                  %structured_stage = core.let "assertion"
                  %structured_failure = core.call @run_assertions(%gen, %structured_processed)
                  %structured_failed = core.call intrinsic.is_not_none(%structured_failure)
                  core.if %structured_failed {
                    %stage = core.let "fatal"
                    core.raise %structured_failure
                  }
                  %structured_public = core.call @strip_internal_fields(%output_fields, %structured_processed)
                  %stage = core.let "fatal"
                  core.for %structured_state in %states {
                    %structured_index = core.get %structured_state["index"] default 0
                    %structured_delta = core.map
                    %public_keys = core.call intrinsic.map.keys(%structured_public)
                    core.for %public_key in %public_keys {
                      %public_value = core.get %structured_public[%public_key]
                      core.set %structured_delta[%public_key] = %public_value
                    }
                    // A stream yields thought chunk by chunk; a response that
                    // did not is sent with the fields, as TS does.
                    %index_key = core.call intrinsic.string.format("{}", %structured_index)
                    %empty_attempt = core.map
                    %attempt_values = core.get %current[%index_key] default %empty_attempt
                    %thought_yielded = core.call intrinsic.map.contains(%attempt_values, %thought_field)
                    %thought_pending = core.call intrinsic.not(%thought_yielded)
                    %response_thought = core.get %response["thought"] default ""
                    %has_response_thought = core.call intrinsic.truthy(%response_thought)
                    %add_thought = core.call intrinsic.and(%thought_pending, %has_response_thought)
                    core.if %add_thought {
                      core.set %structured_delta[%thought_field] = %response_thought
                    }
                    %structured_version = core.get %ctx["version"] default %version
                    core.call @stream_yield_impl(%run, %structured_version, %structured_index, %structured_delta)
                  }
                  core.set %outcome["kind"] = "done"
                } else {
                  core.set %outcome["kind"] = "tools"
                  core.set %outcome["calls"] = %calls
                }
              } else {
                %feedback = core.list
                core.for %final_state in %states {
                  %finalized = core.call @stream_finalize_impl(%gen, %config, %ctx, %final_state)
                  %final_failure = core.get %finalized["failure"]
                  %has_final_failure = core.call intrinsic.is_not_none(%final_failure)
                  core.if %has_final_failure {
                    %stage = core.let "fatal"
                    core.raise %final_failure
                  }
                  %empty_final_feedback = core.list
                  %final_feedback = core.get %finalized["feedback"] default %empty_final_feedback
                  core.for %feedback_text in %final_feedback {
                    core.append %feedback, %feedback_text
                  }
                }
                %feedback_count = core.call intrinsic.len(%feedback)
                %fed_back = core.call intrinsic.gt(%feedback_count, 0)
                core.if %fed_back {
                  core.set %outcome["kind"] = "feedback"
                  core.set %outcome["feedback"] = %feedback
                } else {
                  core.set %outcome["kind"] = "done"
                }
              }
              %open_handle = core.call intrinsic.is_not_none(%handle)
              core.if %open_handle {
                core.call intrinsic.ai.stream_close(%handle)
              }
            } catch %attempt_error {
              %control_version = core.get %ctx["control_version"] default %control_version
              %close_handle = core.call intrinsic.is_not_none(%handle)
              core.if %close_handle {
                core.try {
                  core.call intrinsic.ai.stream_close(%handle)
                } catch %close_error {
                }
              }
              %is_fatal = core.call intrinsic.eq(%stage, "fatal")
              core.if %is_fatal {
                %fatal_failure = core.call @generate_failed_impl(%attempt_error)
                core.raise %fatal_failure
              }
              %aborted = core.call intrinsic.exception.is_aborted(%attempt_error)
              core.if %aborted {
                core.raise %attempt_error
              }
              %from_provider = core.call intrinsic.eq(%stage, "provider")
              core.if %from_provider {
                // As in forward, only infrastructure errors and refusals are
                // retried.
                %infrastructure = core.call intrinsic.exception.is_infrastructure(%attempt_error)
                core.if %infrastructure {
                  %infra_retry = core.let true
                  %infra_error = core.let %attempt_error
                  core.break
                }
                %refused = core.call intrinsic.exception.is_refusal(%attempt_error)
                %not_refused = core.call intrinsic.not(%refused)
                core.if %not_refused {
                  %stream_provider_failure = core.call @generate_failed_impl(%attempt_error)
                  core.raise %stream_provider_failure
                }
                %refusal_exhausted = core.call intrinsic.gte(%attempt, %validation_retries)
                core.if %refusal_exhausted {
                  %stream_refusal_failure = core.call @unable_to_fix_impl(%attempt_error, "")
                  core.raise %stream_refusal_failure
                }
                %attempt = core.call intrinsic.add(%attempt, 1)
                core.continue
              }
              %retries_exhausted = core.call intrinsic.gte(%attempt, %validation_retries)
              core.if %retries_exhausted {
                // As in TS, an exhausted streaming assertion surfaces as it is;
                // other exhausted retries are "Unable to fix" failures.
                %streaming_assertion = core.let false
                %stream_outputs = core.list
                core.for %exhausted_state in %states {
                  %empty_xstate = core.map
                  %exhausted_xstate = core.get %exhausted_state["xstate"] default %empty_xstate
                  %flagged = core.get %exhausted_xstate["assertion_failed"] default false
                  core.if %flagged {
                    %streaming_assertion = core.let true
                  }
                  %exhausted_content = core.get %exhausted_state["content"] default ""
                  core.append %stream_outputs, %exhausted_content
                }
                core.if %streaming_assertion {
                  core.raise %attempt_error
                }
                %stream_output_text = core.call intrinsic.string.join("\n---\n", %stream_outputs)
                %stream_exhausted = core.call @unable_to_fix_impl(%attempt_error, %stream_output_text)
                core.raise %stream_exhausted
              }
              %attempt = core.call intrinsic.add(%attempt, 1)
              %messages = core.call @stream_session_add_turns_impl(%messages, %session_stream)
              %not_recorded = core.call intrinsic.not(%recorded)
              core.if %not_recorded {
                %partial_folded = core.call @fold_chat_response_stream(%events)
                %response = core.call @chat_response_to_completion(%partial_folded)
                core.call intrinsic.axgen.memory_add_response(%gen, %request, %response)
                core.call intrinsic.axgen.record_chat_log(%gen, %request, %response)
              }
              %structured_retry = core.call intrinsic.eq(%stage, "structured")
              core.if %structured_retry {
                %structured_retry_messages = core.call @append_structured_output_retry_messages_impl(%messages, %response, %structured_call, %attempt_error, %structured_stage)
                %messages = core.let %structured_retry_messages
              } else {
                %retry_messages = core.call @append_assertion_retry_messages(%messages, %response, %attempt_error)
                %messages = core.let %retry_messages
              }
              core.call intrinsic.axgen.memory_add_correction(%gen, %response, %attempt_error)
              core.continue
            }
            %control_version = core.get %ctx["control_version"] default %control_version
            %kind = core.get %outcome["kind"] default "done"
            %is_tools = core.call intrinsic.eq(%kind, "tools")
            core.if %is_tools {
              %empty_calls = core.list
              %tool_calls = core.get %outcome["calls"] default %empty_calls
              %updated_messages = core.call @append_tool_call_messages_impl(%messages, %response, %tool_calls)
              %messages = core.let %updated_messages
              %tool_messages = core.call @run_tool_calls_impl(%gen, %functions, %messages, %tool_calls, %runtime_options)
              %messages = core.let %tool_messages
              %continue_after_tools = core.call @should_continue_steps(%gen, %tool_calls)
              core.if %continue_after_tools {
                %next_step = core.let true
                core.break
              }
              // A user stop function ends the run with what was streamed.
              %stop_output = core.call @stream_result_impl(%run, %runtime_options)
              core.call intrinsic.axgen.memory_cleanup_corrections(%gen)
              core.call @record_trace(%gen, %values, %stop_output, "ok")
              core.call @cache_store_streamed_impl(%cache_fn, %cache_key, %stop_output)
              core.return %stop_output
            }
            %is_feedback = core.call intrinsic.eq(%kind, "feedback")
            core.if %is_feedback {
              // Field processor feedback goes back to the model as user
              // messages after its answer, and the run takes another step.
              %assistant_content = core.get %response["content"] default ""
              %assistant_message = core.map
              core.set %assistant_message["role"] = "assistant"
              core.set %assistant_message["content"] = %assistant_content
              core.append %messages, %assistant_message
              %empty_feedback_texts = core.list
              %feedback_texts = core.get %outcome["feedback"] default %empty_feedback_texts
              %feedback_messages = core.list
              core.for %feedback_text in %feedback_texts {
                %feedback_message = core.call @feedback_message_impl(%feedback_text)
                core.append %messages, %feedback_message
                core.append %feedback_messages, %feedback_message
              }
              core.call intrinsic.axgen.memory_add_request(%gen, %feedback_messages)
              %next_step = core.let true
              core.break
            }
            // As in TS, a run control update queued during the step takes
            // another step, which applies it.
            %control_pending = core.call intrinsic.ai.control_pending_count(%client)
            %steered = core.call intrinsic.gt(%control_pending, 0)
            core.if %steered {
              %steered_content = core.get %response["content"] default ""
              %steered_message = core.map
              core.set %steered_message["role"] = "assistant"
              core.set %steered_message["content"] = %steered_content
              core.append %messages, %steered_message
              %next_step = core.let true
              core.break
            }
            %final_output = core.call @stream_result_impl(%run, %runtime_options)
            core.call intrinsic.axgen.memory_cleanup_corrections(%gen)
            core.call @record_trace(%gen, %values, %final_output, "ok")
            core.call @cache_store_streamed_impl(%cache_fn, %cache_key, %final_output)
            core.return %final_output
          }
          core.if %infra_retry {
            %infra_exhausted = core.call intrinsic.gte(%infra_attempt, %infra_retries)
            core.if %infra_exhausted {
              core.raise %infra_error
            }
            core.call intrinsic.retry.sleep(%infra_attempt, %client, %runtime_options)
            %infra_attempt = core.call intrinsic.add(%infra_attempt, 1)
            core.continue
          }
          core.if %next_step {
            core.break
          }
          core.raise "unreachable AxGen streaming attempt exit"
        }
        %step = core.call intrinsic.add(%step, 1)
      }
      core.raise "unreachable AxGen streaming loop exit"
    }
  }

  op ax.gen.semantic @parse_text_contract_output_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/extract/streamingText.ts"
    type signature = "(string, list<Field>, bool) -> json throws"
    body @entry(%content: string, %output_fields: list<Field>, %strict_mode: bool) {
      // TS extractValues parses `Label: value` answers. For compatibility the
      // ports still read an answer that is exactly one JSON object whose keys
      // are all output fields; that fallback is deprecated and TS treats such
      // an answer as text. Strict mode, which requires labels, skips it.
      %out = core.map
      %trimmed = core.string_trim %content
      %opens_object = core.call intrinsic.string.starts_with(%trimmed, "{")
      %lenient = core.call intrinsic.not(%strict_mode)
      %looks_json = core.call intrinsic.and(%opens_object, %lenient)
      core.if %looks_json {
        %candidate = core.call intrinsic.none()
        core.try {
          %candidate = core.call intrinsic.json.parse_strict(%trimmed)
        } catch %not_json {
        }
        %is_object = core.type_is %candidate type "object"
        core.if %is_object {
          %declared_only = core.let true
          %keys = core.call intrinsic.map.keys(%candidate)
          core.for %key in %keys {
            %declared = core.let false
            core.for %field in %output_fields {
              %field_name = core.get %field["name"] default ""
              %same = core.call intrinsic.eq(%field_name, %key)
              core.if %same {
                %declared = core.let true
              }
            }
            %undeclared = core.call intrinsic.not(%declared)
            core.if %undeclared {
              %declared_only = core.let false
            }
          }
          core.if %declared_only {
            core.call intrinsic.axgen.deprecation("json-text-contract", "A text-contract answer that is one JSON object of output fields is parsed as those fields for compatibility; TypeScript Ax reads it as text. This fallback is deprecated and will be removed in the next major version: answer with `Label: value` lines.")
            core.set %out["values"] = %candidate
            core.set %out["extracted"] = false
            core.return %out
          }
        }
      }
      %values = core.call @stream_text_extract_values_impl(%content, %output_fields, %strict_mode)
      core.set %out["values"] = %values
      core.set %out["extracted"] = true
      core.return %out
    }
  }

  op ax.gen.semantic @generate_failed_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/generate.ts"
    type signature = "(error) -> error"
    body @entry(%error: error) {
      // enhanceError: a generation failure surfaces as "Generate failed: ..."
      // with the original error as its cause; an abort surfaces as it is.
      // TS wraps it in AxGenerateError; the ports keep the original error's
      // class until the next major.
      %aborted = core.call intrinsic.exception.is_aborted(%error)
      core.if %aborted {
        core.return %error
      }
      %text = core.call intrinsic.exception.message(%error)
      %message = core.call intrinsic.add("Generate failed: ", %text)
      %wrapped = core.call intrinsic.exception.rewrap(%error, %message)
      core.return %wrapped
    }
  }

  op ax.gen.semantic @unable_to_fix_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/generate.ts"
    type signature = "(error, string) -> error"
    body @entry(%error: error, %output: string) {
      // Exhausted validation, assertion or refusal retries, as TS reports
      // them: "Unable to fix validation error: " with the last error's
      // message and the last attempt's output, as the cause of "Generate
      // failed: ...". The last error is the cause of the first.
      %text = core.call intrinsic.exception.message(%error)
      %message = core.call intrinsic.add("Unable to fix validation error: ", %text)
      %message = core.call intrinsic.add(%message, "\n\nLLM Output:\n")
      %message = core.call intrinsic.add(%message, %output)
      %unfixed = core.call intrinsic.exception.rewrap(%error, %message)
      %wrapped = core.call @generate_failed_impl(%unfixed)
      core.return %wrapped
    }
  }

  op ax.gen.semantic @attempt_output_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/generate.ts"
    type signature = "(json) -> string"
    body @entry(%response: json) {
      // The attempt's output as TS reports it: each sample's content, joined
      // with "\n---\n".
      %empty_results = core.list
      %completions = core.get %response["results"] default %empty_results
      %count = core.call intrinsic.len(%completions)
      %single = core.call intrinsic.eq(%count, 0)
      core.if %single {
        %completions = core.list
        core.append %completions, %response
      }
      %contents = core.list
      core.for %completion in %completions {
        // A sample with no content (a tool call, or null) answered "".
        %content = core.get %completion["content"] default ""
        %text = core.let ""
        %has_content = core.call intrinsic.is_not_none(%content)
        core.if %has_content {
          %text = core.let %content
        }
        core.append %contents, %text
      }
      %joined = core.call intrinsic.string.join("\n---\n", %contents)
      core.return %joined
    }
  }

  op ax.gen.semantic @max_tokens_error_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/response/nonStreaming.ts"
    type signature = "(json) -> json"
    body @entry(%response: json) {
      // processResponse: the first sample the token limit cut off fails the
      // forward. Returns the error, or none.
      %empty_results = core.list
      %completions = core.get %response["results"] default %empty_results
      %count = core.call intrinsic.len(%completions)
      %single = core.call intrinsic.eq(%count, 0)
      core.if %single {
        %completions = core.list
        core.append %completions, %response
      }
      core.for %completion in %completions {
        %finish_snake = core.get %completion["finish_reason"]
        %finish = core.get %completion["finishReason"] default %finish_snake
        %cut = core.call intrinsic.eq(%finish, "length")
        core.if %cut {
          %content = core.get %completion["content"] default ""
          %message = core.call intrinsic.add("Max tokens reached before completion\nContent: ", %content)
          %error = core.call intrinsic.error.runtime(%message)
          core.return %error
        }
      }
      %none = core.call intrinsic.none()
      core.return %none
    }
  }

  op ax.gen.semantic @strict_mode_option_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/generate.ts"
    type signature = "(json, json) -> bool"
    body @entry(%base_options: json, %options: json) {
      // strictMode from the forward call, else from the AxGen constructor.
      %empty = core.map
      %call_options = core.call intrinsic.map.merge(%empty, %options)
      %gen_options = core.call intrinsic.map.merge(%empty, %base_options)
      %gen_snake = core.get %gen_options["strict_mode"] default false
      %gen_strict = core.get %gen_options["strictMode"] default %gen_snake
      %call_snake = core.get %call_options["strict_mode"] default %gen_strict
      %strict = core.get %call_options["strictMode"] default %call_snake
      %strict_mode = core.call intrinsic.truthy(%strict)
      core.return %strict_mode
    }
  }

  op ax.gen.semantic @feedback_message_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/fieldProcessor.ts"
    type signature = "(json) -> json"
    body @entry(%text: json) {
      // addToMemory: a field processor's feedback is a user message with one
      // text part.
      %part = core.map
      core.set %part["type"] = "text"
      core.set %part["text"] = %text
      %parts = core.list
      core.append %parts, %part
      %message = core.map
      core.set %message["role"] = "user"
      core.set %message["content"] = %parts
      core.return %message
    }
  }

  op ax.gen.semantic @caching_function_option_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/generate.ts"
    type signature = "(AxGen, json) -> json"
    body @entry(%gen: AxGen, %options: json) {
      // The forward call's cachingFunction, else the AxGen constructor's,
      // else the process-wide one; none without one, and none under a run
      // control, the call's or, as a constructor default, the AxGen's, which
      // bypasses the cache.
      %empty = core.map
      %call_options = core.call intrinsic.map.merge(%empty, %options)
      %base_options = core.get %gen["options"] default %empty
      %run_options = core.call intrinsic.map.merge(%base_options, %call_options)
      %control = core.get %run_options["control"]
      %controlled = core.call intrinsic.is_not_none(%control)
      core.if %controlled {
        %no_cache = core.call intrinsic.none()
        core.return %no_cache
      }
      %cache_fn = core.call intrinsic.axgen.caching_function(%gen, %call_options)
      core.return %cache_fn
    }
  }

  op ax.gen.semantic @cache_key_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/generate.ts"
    type signature = "(AxGen, json) -> string"
    body @entry(%gen: AxGen, %values: json) {
      // computeCacheKey: the SHA-256 of the signature and the input values,
      // in input field order, media data included. Each language writes the
      // text its own way, so keys are deterministic but not shared across
      // languages.
      %signature = core.get %gen["signature"]
      %description = core.get %signature["description"] default ""
      %lines = core.list
      %description_line = core.call intrinsic.string.format("description {}", %description)
      core.append %lines, %description_line
      %inputs = core.list
      %input_fields = core.get %signature["input_fields"]
      core.for %field in %input_fields {
        %input_name = core.get %field["name"] default ""
        %input_label = core.call @stream_field_type_label_impl(%field)
        %input_optional = core.call @stream_field_flag_impl(%field, "is_optional", "isOptional")
        %input_line = core.call intrinsic.string.format("input {} {} {}", %input_name, %input_label, %input_optional)
        core.append %lines, %input_line
        %input_value = core.get %values[%input_name]
        core.append %inputs, %input_value
      }
      %output_fields = core.get %signature["output_fields"]
      core.for %field in %output_fields {
        %output_name = core.get %field["name"] default ""
        %output_label = core.call @stream_field_type_label_impl(%field)
        %output_optional = core.call @stream_field_flag_impl(%field, "is_optional", "isOptional")
        %output_line = core.call intrinsic.string.format("output {} {} {}", %output_name, %output_label, %output_optional)
        core.append %lines, %output_line
      }
      // Sorted keys, so the same values give the same key in every run.
      %inputs_json = core.call intrinsic.json.stable_stringify(%inputs)
      core.append %lines, %inputs_json
      %text = core.call intrinsic.string.join("\n", %lines)
      %key = core.call intrinsic.crypto.sha256_hex(%text)
      core.return %key
    }
  }

  op ax.gen.semantic @cache_store_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/generate.ts"
    type signature = "(json, string, json) -> void"
    body @entry(%cache_fn: json, %key: string, %output: json) {
      // TS stores the finished output and ignores an error from the store.
      %no_cache = core.call intrinsic.is_none(%cache_fn)
      core.if %no_cache {
        core.return
      }
      core.try {
        core.call intrinsic.axgen.cache_write(%cache_fn, %key, %output)
      } catch %cache_write_error {
      }
      core.return
    }
  }

  op ax.gen.semantic @cache_store_streamed_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/generate.ts"
    type signature = "(json, string, json) -> void"
    body @entry(%cache_fn: json, %key: string, %output: json) {
      // TS streamingForward stores only a run that yielded a delta, which
      // leaves a non-empty merged output.
      %output_count = core.call intrinsic.len(%output)
      %yielded = core.call intrinsic.gt(%output_count, 0)
      core.if %yielded {
        core.call @cache_store_impl(%cache_fn, %key, %output)
      }
      core.return
    }
  }

  op ax.gen.semantic @cache_lookup_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/generate.ts"
    type signature = "(AxGen, json, json, bool) -> json throws"
    body @entry(%gen: AxGen, %values: json, %options: json, %ignore_read_errors: bool) {
      // The forward's cache read: {fn, key, hit, value}, with fn none when
      // the forward does not cache. Hosts call it before they open the
      // run's span and metrics, as TS reads the cache before any telemetry,
      // and pass the result to the forward as its _ax_cache_lookup option.
      // A read error propagates unless ignore_read_errors, as for
      // streamingForward.
      %lookup = core.map
      %cache_fn = core.call @caching_function_option_impl(%gen, %options)
      core.set %lookup["fn"] = %cache_fn
      core.set %lookup["key"] = ""
      core.set %lookup["hit"] = false
      %use_cache = core.call intrinsic.is_not_none(%cache_fn)
      core.if %use_cache {
        %cache_key = core.call @cache_key_impl(%gen, %values)
        core.set %lookup["key"] = %cache_key
        %cached = core.call intrinsic.none()
        core.if %ignore_read_errors {
          core.try {
            %cached = core.call intrinsic.axgen.cache_read(%cache_fn, %cache_key)
          } catch %cache_read_error {
          }
        } else {
          %cached = core.call intrinsic.axgen.cache_read(%cache_fn, %cache_key)
        }
        %cache_hit = core.call intrinsic.is_not_none(%cached)
        core.if %cache_hit {
          core.set %lookup["hit"] = true
          core.set %lookup["value"] = %cached
        }
      }
      core.return %lookup
    }
  }

  op ax.gen.semantic @cache_lookup_option_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/generate.ts"
    type signature = "(json) -> json"
    body @entry(%options: json) {
      // The lookup a host already made for this forward, if any.
      %empty = core.map
      %call_options = core.call intrinsic.map.merge(%empty, %options)
      %lookup = core.get %call_options["_ax_cache_lookup"]
      core.return %lookup
    }
  }

  op ax.gen.semantic @apply_control_updates_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/generate.ts"
    type signature = "(AxGen, list<json>, json, json) -> list<json>"
    body @entry(%gen: AxGen, %messages: list<json>, %runtime_options: json, %updates: json) {
      // TS applies run control updates when a step starts: a steer joins the
      // conversation as a user message and stays in memory, and a thinking
      // level sets the thinking token budget of the requests that follow.
      // Returns the conversation, which callers reassign: a port's list need
      // not share the caller's.
      %steers = core.list
      core.for %update in %updates {
        %kind = core.get %update["type"] default ""
        %is_steer = core.call intrinsic.eq(%kind, "steer")
        core.if %is_steer {
          %text = core.get %update["text"] default ""
          %message = core.map
          core.set %message["role"] = "user"
          core.set %message["content"] = %text
          core.append %messages, %message
          core.append %steers, %message
        } else {
          %level = core.get %update["level"]
          core.set %runtime_options["thinkingTokenBudget"] = %level
        }
      }
      %steer_count = core.call intrinsic.len(%steers)
      %has_steers = core.call intrinsic.gt(%steer_count, 0)
      core.if %has_steers {
        core.call intrinsic.axgen.memory_add_request(%gen, %steers)
      }
      core.return %messages
    }
  }

  op ax.gen.semantic @structured_output_render_options_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "structured-output-rung-prompt-contract"
    type signature = "(json) -> json"
    body @entry(%selection: json) {
      // TS renders an AxGen prompt with structuredOutput set when a rung is
      // selected, and with __axOutput as its structured output function
      // under the function rung only. The system prompt then ends its output
      // section with the exact JSON shape, and its formatting rule asks for
      // a JSON object or a call to __axOutput.
      %render_options = core.map
      %rung = core.get %selection["rung"]
      %structured = core.call intrinsic.is_not_none(%rung)
      core.set %render_options["structured_output"] = %structured
      %extra_functions = core.list
      %function_rung = core.call intrinsic.eq(%rung, "function")
      core.if %function_rung {
        core.set %render_options["structured_output_function_name"] = "__axOutput"
        // TS adds __axOutput to the functions its prompt lists, after the
        // program's own.
        %output_function = core.map
        core.set %output_function["name"] = "__axOutput"
        core.set %output_function["description"] = "Emit the complete structured program output using the declared argument shape."
        core.append %extra_functions, %output_function
      }
      core.set %render_options["extra_functions"] = %extra_functions
      core.return %render_options
    }
  }

  op ax.gen.semantic @validate_completion_function_call_names {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "source:src/ax/ai/validate.ts#validateChatResponseFunctionCalls"
    type signature = "(json) -> void throws"
    body @entry(%response: json) {
      // TS checks a model response's function calls before any runs (a
      // forward's in AxMemory.addResponse, a stream's merged calls when it
      // ends): a call whose name is missing, not a string, empty or blank
      // fails with "Function call at index <call> in result <result> must
      // have a non-empty function name, received: <JSON.stringify(name, null,
      // 2)>", undefined for a missing name. The caller fails the forward
      // without a retry. A complete()-only client's answer without results
      // is result 0.
      %empty = core.list
      %results = core.get %response["results"]
      %no_results = core.call intrinsic.is_none(%results)
      core.if %no_results {
        %results = core.list
        core.append %results, %response
      }
      %result_index = core.let 0
      core.for %result in %results {
        %calls = core.get %result["function_calls"] default %empty
        %call_index = core.let 0
        core.for %call in %calls {
          // The flat {id, name, params} call, or TS's nested {function:
          // {name, params}} one.
          %has_name = core.call intrinsic.map.contains(%call, "name")
          %name = core.get %call["name"]
          %fn = core.get %call["function"]
          %fn_is_map = core.type_is %fn type "object"
          core.if %fn_is_map {
            %fn_has_name = core.call intrinsic.map.contains(%fn, "name")
            core.if %fn_has_name {
              %has_name = core.let true
              %name = core.get %fn["name"]
            }
          }
          %name_is_text = core.type_is %name type "string"
          %named = core.let false
          core.if %name_is_text {
            %trimmed = core.string_trim %name
            %named = core.call intrinsic.ne(%trimmed, "")
          }
          %unnamed = core.call intrinsic.not(%named)
          core.if %unnamed {
            %received = core.let "undefined"
            core.if %has_name {
              %received = core.call intrinsic.json.pretty(%name)
            }
            %message = core.call intrinsic.string.format("Function call at index {} in result {} must have a non-empty function name, received: {}", %call_index, %result_index, %received)
            %error = core.call intrinsic.error.runtime(%message)
            core.raise %error
          }
          %next_call_index = core.call intrinsic.add(%call_index, 1)
          %call_index = core.let %next_call_index
        }
        %next_result_index = core.call intrinsic.add(%result_index, 1)
        %result_index = core.let %next_result_index
      }
      core.return
    }
  }

  op ax.gen.semantic @check_completion_function_call_names {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "source:src/ax/ai/validate.ts#validateChatResponseFunctionCalls"
    type signature = "(json, json) -> void throws"
    body @entry(%response: json, %options: json) {
      // functionCallValidation says what a forward does with a model function
      // call that has no usable name. 'fail' fails it at once with TS's
      // message, as TypeScript does. 'correct', this release's default, runs
      // it as an unknown function, so the model gets a correction and another
      // request. Left unset, the correction warns once that the next major
      // version fails such a call.
      %mode_snake = core.get %options["function_call_validation"]
      %mode = core.get %options["functionCallValidation"] default %mode_snake
      %mode_set = core.call intrinsic.is_not_none(%mode)
      core.if %mode_set {
        %is_fail = core.call intrinsic.eq(%mode, "fail")
        %is_correct = core.call intrinsic.eq(%mode, "correct")
        %known = core.call intrinsic.or(%is_fail, %is_correct)
        %unknown = core.call intrinsic.not(%known)
        core.if %unknown {
          %mode_json = core.call intrinsic.json.pretty(%mode)
          %mode_message = core.call intrinsic.string.format("functionCallValidation must be 'correct' or 'fail', received: {}", %mode_json)
          %mode_error = core.call intrinsic.error.validation(%mode_message)
          core.raise %mode_error
        }
        core.if %is_fail {
          core.call @validate_completion_function_call_names(%response)
        }
        core.return
      }
      %unnamed = core.let false
      core.try {
        core.call @validate_completion_function_call_names(%response)
      } catch %unnamed_error {
        %unnamed = core.let true
      }
      core.if %unnamed {
        core.call intrinsic.axgen.deprecation("function-call-validation", "A model function call without a name gets a correction and another request; TypeScript Ax fails the forward at once. Pass functionCallValidation: 'fail' to fail it now, or functionCallValidation: 'correct' to keep the correction. Failing becomes the default in the next major version.")
      }
      core.return
    }
  }
  op ax.gen.semantic @include_optional_render_option_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/generate.ts"
    type signature = "(json, json) -> void"
    body @entry(%render_options: json, %options: json) {
      // TS: a forward's includeOptionalInputFieldsInSystemPrompt wins over
      // the constructor's, which the prompt template holds.
      %snake = core.get %options["include_optional_input_fields_in_system_prompt"] default null
      %value = core.get %options["includeOptionalInputFieldsInSystemPrompt"] default %snake
      %given = core.call intrinsic.is_not_none(%value)
      core.if %given {
        %flag = core.call intrinsic.truthy(%value)
        core.set %render_options["include_optional_input_fields_in_system_prompt"] = %flag
      }
      core.return
    }
  }
  op ax.gen.semantic @memory_cleanup_option_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/response/nonStreaming.ts"
    type signature = "(json) -> bool"
    body @entry(%options: json) {
      // TS's disableMemoryCleanup keeps every failed attempt and its
      // correction.
      %disabled_snake = core.get %options["disable_memory_cleanup"] default false
      %disabled_value = core.get %options["disableMemoryCleanup"] default %disabled_snake
      %disabled = core.call intrinsic.truthy(%disabled_value)
      %cleanup = core.call intrinsic.not(%disabled)
      core.return %cleanup
    }
  }

  op ax.gen.semantic @settle_failed_attempts_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/response/nonStreaming.ts"
    type signature = "(list<json>, list<json>, bool) -> list<json>"
    body @entry(%messages: list<json>, %failed: list<json>, %cleanup: bool) {
      // The messages followed by the failed attempts. With cleanup, the
      // messages TS tags and drops are left out: a failed answer and every
      // correction ('error' and 'correction'). A failed __axOutput call's
      // assistant turn and its "done" result carry no tag, so they stay.
      %failed_count = core.call intrinsic.len(%failed)
      %none_failed = core.call intrinsic.eq(%failed_count, 0)
      core.if %none_failed {
        core.return %messages
      }
      %settled = core.list
      core.for %message in %messages {
        core.append %settled, %message
      }
      core.for %failed_message in %failed {
        %keep = core.call intrinsic.not(%cleanup)
        %role = core.get %failed_message["role"] default ""
        %is_result = core.call intrinsic.eq(%role, "function")
        %keep = core.call intrinsic.or(%keep, %is_result)
        %calls = core.get %failed_message["function_calls"]
        %has_calls = core.call intrinsic.truthy(%calls)
        %keep = core.call intrinsic.or(%keep, %has_calls)
        core.if %keep {
          core.append %settled, %failed_message
        }
      }
      core.return %settled
    }
  }

  // TS functionResultFormatter: the run's formatter (the forward call's,
  // else the program's, else the process-wide one, as TS's
  // axGlobals.functionResultFormatter) writes the result, as
  // String(formatter(result)); without one, a string result goes as it is,
  // a missing one as "", and any other value as
  // JSON.stringify(result, null, 2) (axGlobals' default). An empty text
  // becomes "done", as processFunctions sends it.
  op ax.gen.semantic @function_result_text_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/globals.ts"
    tag "tool-result-message-core-helper"
    type signature = "(json, json) -> string throws"
    body @entry(%result: json, %options: json) {
      %empty_map = core.map
      %opts = core.call intrinsic.coalesce(%options, %empty_map)
      %formatter_snake = core.get %opts["function_result_formatter"]
      %formatter = core.get %opts["functionResultFormatter"] default %formatter_snake
      %has_local_formatter = core.call intrinsic.is_not_none(%formatter)
      core.if %has_local_formatter {
      } else {
        %global_formatter = core.call intrinsic.axgen.function_result_formatter()
        %formatter = core.let %global_formatter
      }
      %has_formatter = core.call intrinsic.is_not_none(%formatter)
      %text = core.let ""
      core.if %has_formatter {
        %formatted = core.call intrinsic.object.call_method(%formatter, "format_result", %result)
        %text = core.call intrinsic.string.str(%formatted)
      } else {
        %is_text = core.type_is %result type "string"
        %missing = core.call intrinsic.is_none(%result)
        core.if %is_text {
          %text = core.let %result
        } else {
          core.if %missing {
            %text = core.let ""
          } else {
            %text = core.call intrinsic.json.pretty(%result)
          }
        }
      }
      %empty = core.call intrinsic.eq(%text, "")
      core.if %empty {
        core.return "done"
      }
      core.return %text
    }
  }

  // Runs a tool step's calls in order and returns the messages with their
  // results. A tool that throws answers with an error message, as before. A
  // memory item keeps the text the model got in `result`, as in TS, and
  // in its compatibility alias `result_text`. As in TS, a
  // formatter that throws fails the forward ("Generate failed: ...") without
  // a retry: the call is traced as an error, and nothing reaches the model or
  // the memory.
  op ax.gen.semantic @run_tool_calls_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/functions.ts"
    tag "tool-result-message-core-helper"
    type signature = "(AxGen, list<Tool>, list<json>, list<json>, json) -> list<json> throws"
    body @entry(%gen: AxGen, %functions: list<Tool>, %messages: list<json>, %calls: list<json>, %options: json) {
      core.for %call in %calls {
        %tool_ok = core.let false
        %tool_result = core.call intrinsic.none()
        core.try {
          %executed = core.call @execute_tool_call(%functions, %call, %options)
          %tool_result = core.let %executed
          %tool_ok = core.let true
        } catch %tool_error {
          %tool_error_message = core.call @tool_error_message_impl(%call, %tool_error)
          core.append %messages, %tool_error_message
          %tool_error_text = core.get %tool_error_message["result"] default ""
          core.call intrinsic.axgen.memory_add_function_result(%gen, %call, %tool_error_text, false, %tool_error_text)
          core.call intrinsic.axgen.record_function_call(%gen, %call, %tool_error_message, "error")
        }
        core.if %tool_ok {
          %tool_text = core.let ""
          core.try {
            %formatted_text = core.call @function_result_text_impl(%tool_result, %options)
            %tool_text = core.let %formatted_text
          } catch %format_error {
            %format_error_message = core.call @tool_error_message_impl(%call, %format_error)
            core.call intrinsic.axgen.record_function_call(%gen, %call, %format_error_message, "error")
            %format_failure = core.call @generate_failed_impl(%format_error)
            core.raise %format_failure
          }
          %tool_message = core.call @tool_result_message_impl(%call, %tool_text)
          core.append %messages, %tool_message
          core.call intrinsic.axgen.memory_add_function_result(%gen, %call, %tool_text, true, %tool_text)
          core.call intrinsic.axgen.record_function_call(%gen, %call, %tool_result, "ok")
        }
      }
      core.return %messages
    }
  }
}
