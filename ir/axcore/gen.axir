    tag "assertion-retry-message-core-helper"
    type signature = "(list<json>, json, error) -> list<json>"
    body @entry(%messages: list<json>, %response: json, %error: error) {
      %updated_messages = core.call @append_validation_retry_messages_impl(%messages, %response, %error)
      core.return %updated_messages
    }
