  op ax.gen.semantic @append_tool_call_messages_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "tool-call-message-core-helper"
    type signature = "(list<json>, json, list<json>) -> list<json>"
    body @entry(%messages: list<json>, %response: json, %calls: list<json>) {
      %chat_calls = core.list
      core.for %call in %calls {
        %chat_call = core.call @completion_call_to_chat_impl(%call)
        core.append %chat_calls, %chat_call
      }
      %content = core.get %response["content"] default ""
      %message = core.map
      core.set %message["role"] = "assistant"
      core.set %message["content"] = %content
      core.set %message["function_calls"] = %chat_calls
      %thought = core.get %response["thought"]
      %has_thought = core.call intrinsic.is_not_none(%thought)
      core.if %has_thought {
        core.set %message["thought"] = %thought
      }
      %thought_blocks = core.get %response["thought_blocks"]
      %has_thought_blocks = core.call intrinsic.is_not_none(%thought_blocks)
      core.if %has_thought_blocks {
        core.set %message["thought_blocks"] = %thought_blocks
      }
      %images = core.get %response["images"]
      %has_images = core.call intrinsic.is_not_none(%images)
      core.if %has_images {
        core.set %message["images"] = %images
      }
      %phase = core.get %response["phase"]
      %has_phase = core.call intrinsic.is_not_none(%phase)
      core.if %has_phase {
        core.set %message["phase"] = %phase
      }
      core.append %messages, %message
      core.return %messages
    }
  }

  op ax.gen.semantic @completion_call_to_chat_impl {
