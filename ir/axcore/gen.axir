  op ax.gen.semantic @is_flexible_json_field {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "is-flexible-json-field-core-helper"
    type signature = "(FieldType) -> bool"
    body @entry(%typ: FieldType) {
      %type_name = core.get %typ["name"]
      %is_json = core.call intrinsic.eq(%type_name, "json")
      %is_object = core.call intrinsic.eq(%type_name, "object")
      %fields = core.get %typ["fields"]
      %has_fields = core.call intrinsic.truthy(%fields)
      %no_fields = core.call intrinsic.not(%has_fields)
      %flexible = core.let %is_json
      core.if %is_object {
        core.if %no_fields {
          %flexible = core.let true
        }
      }
      core.return %flexible
    }
  }

  op ax.gen.semantic @parse_json_string_value {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "parse-json-string-value-core-helper"
    type signature = "(json) -> json"
    body @entry(%value: json) {
      %is_string = core.type_is %value type "string"
      %not_string = core.call intrinsic.not(%is_string)
      core.if %not_string {
        core.return %value
      }
      %result = core.let %value
      core.try {
        %parsed = core.call intrinsic.json.parse(%value)
        %result = core.let %parsed
      } catch %parse_error {
        %result = core.let %value
      }
      core.return %result
    }
  }

  op ax.gen.semantic @parse_json_string_for_field {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "parse-json-string-for-field-core-helper"
    type signature = "(Field, json) -> json"
    body @entry(%field: Field, %value: json) {
      %typ = core.get %field["type"]
      %value_is_none = core.call intrinsic.is_none(%value)
      core.if %value_is_none {
        core.return %value
      }
      %flexible = core.call @is_flexible_json_field(%typ)
      %is_array = core.get %typ["is_array"] default false
      %typ_fields = core.get %typ["fields"]
      %has_typ_fields = core.call intrinsic.truthy(%typ_fields)
      core.if %is_array {
        %value_is_list = core.type_is %value type "list"
        %not_list = core.call intrinsic.not(%value_is_list)
        core.if %not_list {
          core.return %value
        }
        core.if %flexible {
          %out = core.list
          core.for %item in %value {
            %parsed_item = core.call @parse_json_string_value(%item)
            core.append %out, %parsed_item
          }
          core.return %out
        }
        core.if %has_typ_fields {
          %rebuilt = core.list
          core.for %item in %value {
            %item_is_map = core.type_is %item type "object"
            core.if %item_is_map {
              %parsed_obj = core.call @parse_json_string_for_fields(%typ_fields, %item)
              core.append %rebuilt, %parsed_obj
            } else {
              core.append %rebuilt, %item
            }
          }
          core.return %rebuilt
        }
        core.return %value
      }
      core.if %flexible {
        %parsed_scalar = core.call @parse_json_string_value(%value)
        core.return %parsed_scalar
      }
      %type_name = core.get %typ["name"]
      %is_object = core.call intrinsic.eq(%type_name, "object")
      core.if %is_object {
        core.if %has_typ_fields {
          %parsed_obj2 = core.call @parse_json_string_for_fields(%typ_fields, %value)
          core.return %parsed_obj2
        }
      }
      core.return %value
    }
  }

  op ax.gen.semantic @parse_json_string_fields {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "parse-structured-json-field-values-core-helper"
    type signature = "(list<Field>, json) -> json"
    body @entry(%output_fields: list<Field>, %values: json) {
      %values_is_map = core.type_is %values type "object"
      %not_map = core.call intrinsic.not(%values_is_map)
      core.if %not_map {
        core.return %values
      }
      core.for %field in %output_fields {
        %name = core.get %field["name"]
        %has_key = core.call intrinsic.map.contains(%values, %name)
        core.if %has_key {
          %value = core.get %values[%name]
          %parsed = core.call @parse_json_string_for_field(%field, %value)
          core.set %values[%name] = %parsed
        }
      }
      core.return %values
    }
  }

  op ax.gen.semantic @parse_json_string_for_fields {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "parse-json-string-nested-fields-core-helper"
    type signature = "(json, json) -> json"
    body @entry(%fields_map: json, %values: json) {
      %values_is_map = core.type_is %values type "object"
      %not_map = core.call intrinsic.not(%values_is_map)
      core.if %not_map {
        core.return %values
      }
      %nested_fields = core.call intrinsic.fields.from_map(%fields_map)
      core.for %field in %nested_fields {
        %name = core.get %field["name"]
        %has_key = core.call intrinsic.map.contains(%values, %name)
        core.if %has_key {
          %value = core.get %values[%name]
          %parsed = core.call @parse_json_string_for_field(%field, %value)
          core.set %values[%name] = %parsed
        }
      }
      core.return %values
    }
  }

  op ax.gen.semantic @validate_exact_output_keys {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "validated-json-object-exact-wire-keys"
    type signature = "(list<Field>, json, string) -> void throws"
    body @entry(%fields: list<Field>, %values: json, %context: string) {
      %is_object = core.type_is %values type "object"
      %not_object = core.call intrinsic.not(%is_object)
      core.if %not_object {
        %object_message = core.call intrinsic.string.format("{} must be one JSON object", %context)
        %object_error = core.call intrinsic.error.validation(%object_message)
        core.raise %object_error
      }
      %keys = core.call intrinsic.map.keys(%values)
      core.for %key in %keys {
        %known = core.let false
        core.for %field in %fields {
          %field_name = core.get %field["name"]
          %matches = core.call intrinsic.eq(%field_name, %key)
          core.if %matches {
            %known = core.let true
          }
        }
        %unknown = core.call intrinsic.not(%known)
        core.if %unknown {
          %unknown_message = core.call intrinsic.string.format("Unexpected field '{}' in {}. Use only the exact declared wire keys.", %key, %context)
          %unknown_error = core.call intrinsic.error.validation(%unknown_message)
          core.raise %unknown_error
        }
      }
      core.for %field in %fields {
        %field_name = core.get %field["name"]
        %has_value = core.call intrinsic.map.contains(%values, %field_name)
        core.if %has_value {
          %typ = core.get %field["type"]
          %nested_map = core.get %typ["fields"]
          %has_nested = core.call intrinsic.truthy(%nested_map)
          core.if %has_nested {
            %nested_fields = core.call intrinsic.fields.from_map(%nested_map)
            %field_value = core.get %values[%field_name]
            %child_context = core.call intrinsic.string.format("{}.{}", %context, %field_name)
            %array_snake = core.get %typ["is_array"] default false
            %is_array = core.get %typ["isArray"] default %array_snake
            core.if %is_array {
              core.for %item in %field_value {
                core.call @validate_exact_output_keys(%nested_fields, %item, %child_context)
              }
            } else {
              core.call @validate_exact_output_keys(%nested_fields, %field_value, %child_context)
            }
          }
        }
      }
      core.return
    }
  }

  op ax.gen.semantic @tool_spec_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "tool-spec-core-helper"
    type signature = "(Tool) -> json"
    body @entry(%fn: Tool) {
      %spec = core.map
      %name = core.get %fn["name"]
      %description = core.get %fn["description"]
      %parameters = core.get %fn["parameters"]
      core.set %spec["name"] = %name
      core.set %spec["description"] = %description
      core.set %spec["parameters"] = %parameters
      %execution = core.get %fn["execution"] default "blocking"
      %background = core.call intrinsic.eq(%execution, "background")
      core.if %background {
        core.set %spec["execution"] = %execution
      }
      core.return %spec
    }
  }

  op ax.gen.semantic @function_call_mode_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "function-call-mode-core-helper"
    type signature = "(json) -> string"
    body @entry(%mode: json) {
      %missing = core.call intrinsic.is_none(%mode)
      core.if %missing {
        core.return "auto"
      }
      %is_native = core.call intrinsic.eq(%mode, "native")
      %is_auto = core.call intrinsic.eq(%mode, "auto")
      %native_or_auto = core.call intrinsic.or(%is_native, %is_auto)
      core.if %native_or_auto {
        core.return "auto"
      }
      %is_prompt = core.call intrinsic.eq(%mode, "prompt")
      core.if %is_prompt {
        core.return "none"
      }
      // A tool choice passed here ('required', 'none', or a named call) is
      // routed through @caller_function_call_impl. Other values behave like
      // TS, where any mode but 'prompt' sends native tools.
      core.return "auto"
    }
  }

  op ax.gen.semantic @response_function_calls_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
