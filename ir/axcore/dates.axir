module @ax.dates version "0.1" {
  dialect @ax.gen version "0.1"

  // TypeScript's LLM-friendly date parsing (src/ax/dsp/datetime.ts) for
  // date, datetime, dateRange and datetimeRange output fields, used by the
  // text contract when a caller opts in with parse_dates / parseDates. See
  // dates.md. Values come back as TypeScript's JSON serialization of them:
  // Date.prototype.toISOString strings, and {start, end} maps of those.
  //
  // Scanning runs over UTF-16 code units, as JavaScript strings do, in one
  // linear pass: no host regular expressions, so the patterns TS matches
  // with backtracking regexes cannot slow a port down. Substrings are cut
  // from the port's own string at native offsets (see
  // @date_native_offset_impl).
  //
  // Times are epoch milliseconds. The only host operation is
  // intrinsic.date.zone_offset(name, epoch_ms): the UTC offset in seconds of
  // an IANA zone at an instant, from the platform tz database, raising for an
  // unknown zone. Zone names, abbreviations and the Intl.DateTimeFormat
  // arithmetic TS relies on (its DST-gap check, its earlier instant in an
  // overlap, and its era year for years before 1) are all here.

  // ----- option and fields -----

  op ax.gen.semantic @date_parse_dates_option_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/datetime.ts"
    type signature = "(json, json) -> bool"
    body @entry(%base_options: json, %options: json) {
      // parseDates from the forward call, else from the AxGen constructor.
      %empty = core.map
      %call_options = core.call intrinsic.map.merge(%empty, %options)
      %gen_options = core.call intrinsic.map.merge(%empty, %base_options)
      %gen_snake = core.get %gen_options["parse_dates"] default true
      %gen_parse = core.get %gen_options["parseDates"] default %gen_snake
      %call_snake = core.get %call_options["parse_dates"] default %gen_parse
      %parse = core.get %call_options["parseDates"] default %call_snake
      %parse_dates = core.call intrinsic.truthy(%parse)
      core.return %parse_dates
    }
  }

  op ax.gen.semantic @date_is_date_type_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/extract/fieldValue.ts"
    type signature = "(json) -> bool"
    body @entry(%name: json) {
      %is_date = core.call intrinsic.eq(%name, "date")
      core.if %is_date {
        core.return true
      }
      %is_datetime = core.call intrinsic.eq(%name, "datetime")
      core.if %is_datetime {
        core.return true
      }
      %is_date_range = core.call intrinsic.eq(%name, "dateRange")
      core.if %is_date_range {
        core.return true
      }
      %is_datetime_range = core.call intrinsic.eq(%name, "datetimeRange")
      core.return %is_datetime_range
    }
  }

  op ax.gen.semantic @date_parse_fields_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/extract/fieldValue.ts"
    type signature = "(json, json, json) -> json"
    body @entry(%fields: json, %base_options: json, %options: json) {
      // With parse_dates on, the text contract gets copies of the date-typed
      // output fields that carry parse_dates, which
      // @stream_convert_value_impl reads. Off, the list is returned as is.
      %parse_dates = core.call @date_parse_dates_option_impl(%base_options, %options)
      %off = core.call intrinsic.not(%parse_dates)
      core.if %off {
        core.return %fields
      }
      %out = core.list
      core.for %field in %fields {
        %typ = core.get %field["type"]
        %type_name = core.get %typ["name"] default "string"
        %dated = core.call @date_is_date_type_impl(%type_name)
        %plain = core.call intrinsic.not(%dated)
        core.if %plain {
          core.append %out, %field
          core.continue
        }
        %field_copy = core.map
        %name = core.get %field["name"]
        core.set %field_copy["name"] = %name
        %title = core.call @stream_field_title_impl(%field)
        core.set %field_copy["title"] = %title
        %description = core.get %field["description"]
        core.set %field_copy["description"] = %description
        core.set %field_copy["type"] = %typ
        %optional = core.call @stream_field_flag_impl(%field, "is_optional", "isOptional")
        core.set %field_copy["is_optional"] = %optional
        %internal = core.call @stream_field_flag_impl(%field, "is_internal", "isInternal")
        core.set %field_copy["is_internal"] = %internal
        %cached = core.call @stream_field_flag_impl(%field, "is_cached", "isCached")
        core.set %field_copy["is_cached"] = %cached
        core.set %field_copy["parse_dates"] = true
        core.append %out, %field_copy
      }
      core.return %out
    }
  }

  op ax.gen.semantic @date_convert_field_value_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/datetime.ts"
    type signature = "(json, json, json, bool) -> json throws"
    body @entry(%field: json, %type_name: json, %value: json, %may_skip: bool) {
      // parseLLMFriendlyDate, ...DateTime, ...DateRange and
      // ...DateTimeRange: {has, value}, where has is false where TS returns
      // undefined (an optional field's bad value). Other failures raise the
      // message TS's ValidationError carries.
      %out = core.map
      core.set %out["has"] = true
      %title = core.call @stream_field_title_impl(%field)
      %is_date = core.call intrinsic.eq(%type_name, "date")
      %is_datetime = core.call intrinsic.eq(%type_name, "datetime")
      %is_date_range = core.call intrinsic.eq(%type_name, "dateRange")
      %single = core.call intrinsic.or(%is_date, %is_datetime)
      core.if %single {
        // String(val)
        %text = core.call @stream_js_string_impl(%value)
        %millis = core.let 0
        core.try {
          core.if %is_date {
            %millis = core.call @date_parse_date_impl(%text)
          } else {
            %millis = core.call @date_parse_datetime_impl(%text)
          }
        } catch %single_error {
          core.if %may_skip {
            core.set %out["has"] = false
            core.return %out
          }
          %single_detail = core.call intrinsic.exception.message(%single_error)
          %single_message = core.call @date_error_message_impl(%type_name, %title, %single_detail, %text)
          %single_invalid = core.call intrinsic.error.runtime(%single_message)
          core.raise %single_invalid
        }
        %iso = core.call @date_iso_impl(%millis)
        core.set %out["value"] = %iso
        core.return %out
      }
      %kind = core.let "datetime"
      core.if %is_date_range {
        %kind = core.let "date"
      }
      %range_millis = core.map
      core.try {
        %range_millis = core.call @date_parse_range_impl(%value, %kind)
      } catch %range_error {
        core.if %may_skip {
          core.set %out["has"] = false
          core.return %out
        }
        %range_detail = core.call intrinsic.exception.message(%range_error)
        // stringifyRangeValue
        %range_text = core.let ""
        %range_is_text = core.type_is %value type "string"
        core.if %range_is_text {
          %range_text = core.let %value
        } else {
          %range_text = core.call @date_js_json_impl(%value)
        }
        %range_message = core.call @date_error_message_impl(%type_name, %title, %range_detail, %range_text)
        %range_invalid = core.call intrinsic.error.runtime(%range_message)
        core.raise %range_invalid
      }
      %start_millis = core.get %range_millis["start"]
      %end_millis = core.get %range_millis["end"]
      %range_value = core.map
      %start_iso = core.call @date_iso_impl(%start_millis)
      core.set %range_value["start"] = %start_iso
      %end_iso = core.call @date_iso_impl(%end_millis)
      core.set %range_value["end"] = %end_iso
      core.set %out["value"] = %range_value
      core.return %out
    }
  }

  op ax.gen.semantic @date_error_message_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/errors.ts"
    type signature = "(json, json, json, json) -> json"
    body @entry(%type_name: json, %title: json, %detail: json, %provided: json) {
      // createInvalidDateError, createInvalidDateTimeError,
      // createInvalidDateRangeError and createInvalidDateTimeRangeError.
      // Joined rather than formatted, so braces and "{}" in the model's text
      // stay as they are in every port.
      %lead = core.let "Invalid date/time range for '"
      %advice = core.let ". Prefer JSON like {\"start\":\"2024-05-09T14:30:00Z\",\"end\":\"2024-05-09T15:30:00Z\"} or an ISO interval like 2024-05-09T14:30:00Z/2024-05-09T15:30:00Z. You provided: "
      %is_date = core.call intrinsic.eq(%type_name, "date")
      core.if %is_date {
        %lead = core.let "Invalid date for '"
        %advice = core.let ". Use the exact format YYYY-MM-DD (e.g., 2024-05-09). You provided: "
      }
      %is_datetime = core.call intrinsic.eq(%type_name, "datetime")
      core.if %is_datetime {
        %lead = core.let "Invalid date/time for '"
        %advice = core.let ". Prefer ISO 8601 with an explicit timezone, e.g. 2024-05-09T14:30:00Z or 2024-05-09T14:30:00-07:00. Legacy values like \"2024-05-09 14:30 America/New_York\" are also accepted. You provided: "
      }
      %is_date_range = core.call intrinsic.eq(%type_name, "dateRange")
      core.if %is_date_range {
        %lead = core.let "Invalid date range for '"
        %advice = core.let ". Prefer JSON like {\"start\":\"2024-05-09\",\"end\":\"2024-05-12\"} or an interval like 2024-05-09/2024-05-12. You provided: "
      }
      %pieces = core.list
      core.append %pieces, %lead
      core.append %pieces, %title
      core.append %pieces, "': "
      core.append %pieces, %detail
      core.append %pieces, %advice
      core.append %pieces, %provided
      core.append %pieces, "."
      %message = core.string_join %pieces sep ""
      core.return %message
    }
  }

  // ----- parsing -----

  op ax.gen.semantic @date_parse_date_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/datetime.ts"
    type signature = "(json) -> json throws"
    body @entry(%text: json) {
      // ParseLlmFriendlyDate: YYYY-MM-DD after a JavaScript trim, checked by
      // a round trip through TS's getUtcTimestamp.
      %format_error = core.let "Invalid date format. Please provide the date in \"YYYY-MM-DD\" format."
      %units = core.call intrinsic.string.utf16_units(%text)
      %count = core.call intrinsic.len(%units)
      %bounds = core.call @date_trim_bounds_impl(%units, 0, %count)
      %start = core.get %bounds["start"]
      %end = core.get %bounds["end"]
      %length = core.call intrinsic.add(%end, 0)
      %negative_start = core.call intrinsic.mul(%start, -1)
      %length = core.call intrinsic.add(%length, %negative_start)
      %wrong_length = core.call intrinsic.ne(%length, 10)
      core.if %wrong_length {
        %length_error = core.call intrinsic.error.runtime(%format_error)
        core.raise %length_error
      }
      %parts = core.call @date_scan_date_impl(%units, %start)
      %no_parts = core.call intrinsic.is_none(%parts)
      core.if %no_parts {
        %shape_error = core.call intrinsic.error.runtime(%format_error)
        core.raise %shape_error
      }
      %millis = core.call @date_utc_ms_impl(%parts)
      %round = core.call @date_parts_of_ms_impl(%millis)
      %same = core.call @date_same_day_impl(%round, %parts)
      %different = core.call intrinsic.not(%same)
      core.if %different {
        %value_error = core.call intrinsic.error.runtime(%format_error)
        core.raise %value_error
      }
      core.return %millis
    }
  }

  op ax.gen.semantic @date_parse_datetime_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/datetime.ts"
    type signature = "(json) -> json throws"
    body @entry(%text: json) {
      // ParseLlmFriendlyDateTime: the ISO form with Z or a numeric offset,
      // else the legacy "YYYY-MM-DD HH:mm Zone" form.
      %units = core.call intrinsic.string.utf16_units(%text)
      %count = core.call intrinsic.len(%units)
      %bounds = core.call @date_trim_bounds_impl(%units, 0, %count)
      %start = core.get %bounds["start"]
      %end = core.get %bounds["end"]
      %offset_millis = core.call @date_parse_offset_datetime_impl(%units, %start, %end)
      %matched = core.call intrinsic.is_not_none(%offset_millis)
      core.if %matched {
        core.return %offset_millis
      }
      %named = core.call @date_parse_named_datetime_impl(%text, %units, %start, %end)
      core.return %named
    }
  }

  op ax.gen.semantic @date_parse_offset_datetime_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/datetime.ts"
    type signature = "(json, json, json) -> json throws"
    body @entry(%units: json, %start: json, %end: json) {
      // parseOffsetDateTime: none when the text is not
      // /^(<date time>)\s*(Z|(?:UTC|GMT)?[+-]\d{2}(?::?\d{2})?)$/i.
      %none = core.call intrinsic.none()
      %prefix = core.call @date_scan_datetime_impl(%units, %start, %end)
      %no_prefix = core.call intrinsic.is_none(%prefix)
      core.if %no_prefix {
        core.return %none
      }
      %cursor = core.get %prefix["end"]
      %zone_start = core.call @date_skip_space_impl(%units, %cursor, %end)
      %zone_ok = core.call @date_offset_zone_matches_impl(%units, %zone_start, %end)
      %zone_bad = core.call intrinsic.not(%zone_ok)
      core.if %zone_bad {
        core.return %none
      }
      %offset = core.call @date_offset_minutes_impl(%units, %zone_start, %end)
      %no_offset = core.call intrinsic.is_none(%offset)
      core.if %no_offset {
        %format_error = core.call @date_datetime_format_error_impl()
        core.raise %format_error
      }
      %parts = core.call @date_datetime_parts_impl(%prefix)
      %local = core.call @date_utc_ms_impl(%parts)
      %shift = core.call intrinsic.mul(%offset, -60000)
      %millis = core.call intrinsic.add(%local, %shift)
      core.return %millis
    }
  }

  op ax.gen.semantic @date_parse_named_datetime_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/datetime.ts"
    type signature = "(json, json, json, json) -> json throws"
    body @entry(%text: json, %units: json, %start: json, %end: json) {
      // parseNamedTimeZoneDateTime: /^(<date time>)\s+(.+)$/, then the zone
      // as an offset, a TS abbreviation, or a name Intl knows.
      %format_error = core.call @date_datetime_format_error_impl()
      %prefix = core.call @date_scan_datetime_impl(%units, %start, %end)
      %no_prefix = core.call intrinsic.is_none(%prefix)
      core.if %no_prefix {
        core.raise %format_error
      }
      %cursor = core.get %prefix["end"]
      %zone_start = core.call @date_skip_space_impl(%units, %cursor, %end)
      %no_space = core.call intrinsic.eq(%zone_start, %cursor)
      core.if %no_space {
        core.raise %format_error
      }
      %empty_zone = core.call intrinsic.gte(%zone_start, %end)
      core.if %empty_zone {
        core.raise %format_error
      }
      // (.+) does not match a line terminator.
      %scan = core.let %zone_start
      core.loop {
        %scan_done = core.call intrinsic.gte(%scan, %end)
        core.if %scan_done {
          core.break
        }
        %unit = core.get %units[%scan] default 0
        %terminator = core.call @date_is_line_terminator_impl(%unit)
        core.if %terminator {
          core.raise %format_error
        }
        %scan = core.call intrinsic.add(%scan, 1)
      }
      %mode = core.call @date_string_mode_impl()
      %zone_from = core.call @date_native_offset_impl(%units, %zone_start, %mode)
      %zone_to = core.call @date_native_offset_impl(%units, %end, %mode)
      %zone = core.call intrinsic.string.slice(%text, %zone_from, %zone_to)
      %offset = core.call @date_offset_minutes_impl(%units, %zone_start, %end)
      %parts = core.call @date_datetime_parts_impl(%prefix)
      %local = core.call @date_utc_ms_impl(%parts)
      %has_offset = core.call intrinsic.is_not_none(%offset)
      core.if %has_offset {
        %shift = core.call intrinsic.mul(%offset, -60000)
        %offset_millis = core.call intrinsic.add(%local, %shift)
        core.return %offset_millis
      }
      %abbreviation = core.call @date_abbreviation_offset_impl(%units, %zone_start, %end, %zone)
      %has_abbreviation = core.call intrinsic.is_not_none(%abbreviation)
      core.if %has_abbreviation {
        %abbreviation_shift = core.call intrinsic.mul(%abbreviation, -60000)
        %abbreviation_millis = core.call intrinsic.add(%local, %abbreviation_shift)
        core.return %abbreviation_millis
      }
      %resolved = core.call @date_zone_resolve_impl(%units, %zone_start, %end, %zone, %local)
      %millis = core.call @date_named_timestamp_impl(%parts, %resolved)
      core.return %millis
    }
  }

  op ax.gen.semantic @date_datetime_format_error_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/datetime.ts"
    type signature = "() -> json"
    body @entry {
      %error = core.call intrinsic.error.runtime("Invalid date and time format. Use ISO 8601 like \"YYYY-MM-DDTHH:mm:ssZ\" or \"YYYY-MM-DDTHH:mm:ss+05:30\". Legacy \"YYYY-MM-DD HH:mm Timezone\" values are also accepted.")
      core.return %error
    }
  }

  op ax.gen.semantic @date_values_error_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/datetime.ts"
    type signature = "() -> json"
    body @entry {
      %error = core.call intrinsic.error.runtime("Invalid date and time values. Please ensure all components are correct.")
      core.return %error
    }
  }

  op ax.gen.semantic @date_datetime_parts_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/datetime.ts"
    type signature = "(json) -> json throws"
    body @entry(%prefix: json) {
      // parseDateTimeParts: clock ranges, then a round trip through
      // getUtcTimestamp for the calendar.
      %parts = core.map
      %year = core.get %prefix["year"]
      core.set %parts["year"] = %year
      %month = core.get %prefix["month"]
      core.set %parts["month"] = %month
      %day = core.get %prefix["day"]
      core.set %parts["day"] = %day
      %hour = core.get %prefix["hour"]
      core.set %parts["hour"] = %hour
      %minute = core.get %prefix["minute"]
      core.set %parts["minute"] = %minute
      %second = core.get %prefix["second"]
      core.set %parts["second"] = %second
      %millisecond = core.get %prefix["millisecond"]
      core.set %parts["millisecond"] = %millisecond
      %bad_hour = core.call intrinsic.gt(%hour, 23)
      %bad_minute = core.call intrinsic.gt(%minute, 59)
      %bad_second = core.call intrinsic.gt(%second, 59)
      %bad_clock = core.call intrinsic.or(%bad_hour, %bad_minute)
      %bad_clock = core.call intrinsic.or(%bad_clock, %bad_second)
      core.if %bad_clock {
        %clock_error = core.call @date_values_error_impl()
        core.raise %clock_error
      }
      %millis = core.call @date_utc_ms_impl(%parts)
      %round = core.call @date_parts_of_ms_impl(%millis)
      %same = core.call @date_same_parts_impl(%round, %parts)
      %different = core.call intrinsic.not(%same)
      core.if %different {
        %calendar_error = core.call @date_values_error_impl()
        core.raise %calendar_error
      }
      core.return %parts
    }
  }

  // ----- time zones -----

  op ax.gen.semantic @date_abbreviation_offset_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/datetime.ts"
    type signature = "(json, json, json, json) -> json throws"
    body @entry(%units: json, %start: json, %end: json, %zone: json) {
      // parseTimeZoneAbbreviation: for a zone of ASCII letters only, TS's
      // literal offset in minutes, a correction for a rejected
      // abbreviation, else none.
      %none = core.call intrinsic.none()
      %cursor = core.let %start
      core.loop {
        %done = core.call intrinsic.gte(%cursor, %end)
        core.if %done {
          core.break
        }
        %unit = core.get %units[%cursor] default 0
        %letter = core.call @date_ascii_letter_impl(%unit)
        %not_letter = core.call intrinsic.not(%letter)
        core.if %not_letter {
          core.return %none
        }
        %cursor = core.call intrinsic.add(%cursor, 1)
      }
      %key = core.call intrinsic.string.lower(%zone)
      %tables = core.call intrinsic.json.parse(file "data/date-zone-abbreviations.json")
      %empty_offsets = core.map
      %offsets = core.get %tables["offsets_minutes"] default %empty_offsets
      %abbreviations = core.call intrinsic.map.keys(%offsets)
      core.for %abbreviation in %abbreviations {
        %lowered = core.call intrinsic.string.lower(%abbreviation)
        %same = core.call intrinsic.eq(%lowered, %key)
        core.if %same {
          %minutes = core.get %offsets[%abbreviation]
          core.return %minutes
        }
      }
      %empty_rejected = core.list
      %rejected = core.get %tables["rejected"] default %empty_rejected
      core.for %rejected_abbreviation in %rejected {
        %rejected_lowered = core.call intrinsic.string.lower(%rejected_abbreviation)
        %is_rejected = core.call intrinsic.eq(%rejected_lowered, %key)
        core.if %is_rejected {
          %message_pieces = core.list
          core.append %message_pieces, "Ambiguous or unsupported time zone abbreviation \""
          core.append %message_pieces, %zone
          core.append %message_pieces, "\". Please provide an IANA time zone name or a UTC offset. For example, \"Europe/London\" or \"+01:00\"."
          %message = core.string_join %message_pieces sep ""
          %error = core.call intrinsic.error.runtime(%message)
          core.raise %error
        }
      }
      core.return %none
    }
  }

  op ax.gen.semantic @date_zone_resolve_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/datetime.ts"
    type signature = "(json, json, json, json, json) -> json throws"
    body @entry(%units: json, %start: json, %end: json, %zone: json, %probe: json) {
      // The zone Intl.DateTimeFormat would use: an offset time zone
      // (+hh, +hhmm, +hh:mm, with an ASCII or U+2212 sign), or a name V8
      // accepts (case-insensitive, from data/date-time-zones.json) that the
      // platform tz database resolves: ICU's canonical name first, then the
      // other names of its group. Anything else is TS's RangeError path.
      %resolved = core.map
      %fixed = core.call @date_offset_zone_minutes_impl(%units, %start, %end)
      %is_fixed = core.call intrinsic.is_not_none(%fixed)
      core.if %is_fixed {
        core.set %resolved["kind"] = "fixed"
        %fixed_seconds = core.call intrinsic.mul(%fixed, 60)
        core.set %resolved["offset_seconds"] = %fixed_seconds
        core.return %resolved
      }
      %unrecognized_pieces = core.list
      core.append %unrecognized_pieces, "Unrecognized time zone "
      core.append %unrecognized_pieces, %zone
