        %opts_missing = core.call intrinsic.is_none(%opts)
        core.if %opts_missing {
          %opts = core.let %empty_map
        }
        %candidate = core.get %opts["type"] default "all"
        %candidate_is_list = core.type_is %candidate type "list"
        core.if %candidate_is_list {
          %type_raw = core.call intrinsic.list.get(%candidate, 0, "all")
        } else {
          %type_raw = core.let %candidate
        }
      }
      %type_name = core.call intrinsic.string.lower(%type_raw)
      %selected = core.get %registry[%type_name] default null
      %missing = core.call intrinsic.is_none(%selected)
      core.if %missing {
        %selected = core.get %registry["all"]
      }
      core.return %selected
    }
  }

  op ax.provider.semantic @provider_estimate_cost {
    attr core_kind = "func"
    attr emit_module = "ai"
    tag "provider-model-catalog-runtime"
    tag "axai-cache-write-cost"
    type signature = "(model_usage?:json) -> number"
    body @entry(%model_usage: json) {
      %has_usage = core.call intrinsic.truthy(%model_usage)
      core.if %has_usage {
      } else {
        core.return 0
      }
      %model = core.get %model_usage["model"] default ""
      %model_present = core.call intrinsic.truthy(%model)
      core.if %model_present {
      } else {
        core.return 0
      }
      %ai_raw = core.get %model_usage["ai"] default "openai"
      %ai_lower = core.call intrinsic.string.lower(%ai_raw)
      %provider_name = core.let %ai_lower
      %is_openai_compatible = core.call intrinsic.eq(%ai_lower, "openai-compatible")
      core.if %is_openai_compatible {
        %provider_name = core.let "openai"
      }
      %is_google_name = core.call intrinsic.eq(%ai_lower, "googlegeminiai")
      core.if %is_google_name {
        %provider_name = core.let "google-gemini"
      }
      %catalog = core.call @provider_model_catalog_registry()
      %providers = core.get %catalog["all"]
      %model_info = core.call intrinsic.none()
      %empty_aliases = core.list
      core.for %provider in %providers {
        %catalog_provider_name = core.get %provider["name"] default ""
        %provider_matches = core.call intrinsic.eq(%catalog_provider_name, %provider_name)
        core.if %provider_matches {
          %models = core.get %provider["models"]
          core.for %candidate in %models {
            %candidate_name = core.get %candidate["name"] default ""
            %name_matches = core.call intrinsic.eq(%candidate_name, %model)
            %aliases = core.get %candidate["aliases"] default %empty_aliases
            %alias_matches = core.call intrinsic.contains(%aliases, %model)
            %matches = core.call intrinsic.or(%name_matches, %alias_matches)
            core.if %matches {
              %model_info = core.let %candidate
            }
          }
        }
      }
      %has_model_info = core.call intrinsic.truthy(%model_info)
      core.if %has_model_info {
      } else {
        core.return 0
      }
      %tokens = core.get %model_usage["tokens"]
      %has_tokens = core.call intrinsic.truthy(%tokens)
      core.if %has_tokens {
      } else {
        core.return 0
      }
      %prompt_snake = core.get %tokens["prompt_tokens"] default 0
      %prompt = core.get %tokens["promptTokens"] default %prompt_snake
      %completion_snake = core.get %tokens["completion_tokens"] default 0
      %completion = core.get %tokens["completionTokens"] default %completion_snake
      %thoughts_snake = core.get %tokens["thoughts_tokens"] default 0
      %thoughts = core.get %tokens["thoughtsTokens"] default %thoughts_snake
      %cache_read_snake = core.get %tokens["cache_read_tokens"] default 0
      %cache_read = core.get %tokens["cacheReadTokens"] default %cache_read_snake
      %cache_creation_snake = core.get %tokens["cache_creation_tokens"] default 0
      %cache_creation = core.get %tokens["cacheCreationTokens"] default %cache_creation_snake
      %input_base = core.call intrinsic.add(%prompt, %cache_read)
      %total_input = core.call intrinsic.add(%input_base, %cache_creation)
      %threshold_raw = core.get %model_info["longContextThreshold"]
      %has_threshold = core.call intrinsic.is_not_none(%threshold_raw)
      %threshold = core.call intrinsic.coalesce(%threshold_raw, 0)
      %above_threshold = core.call intrinsic.gt(%total_input, %threshold)
      %long_context = core.call intrinsic.and(%has_threshold, %above_threshold)
      %speed = core.get %tokens["speed"] default ""
      %fast = core.call intrinsic.eq(%speed, "fast")
      %base_prompt_price = core.get %model_info["promptTokenCostPer1M"] default 0
      %base_completion_price = core.get %model_info["completionTokenCostPer1M"] default 0
      %prompt_price = core.let %base_prompt_price
      %completion_price = core.let %base_completion_price
      %cache_read_price = core.get %model_info["cacheReadTokenCostPer1M"] default %base_prompt_price
      %cache_write_price = core.get %model_info["cacheWriteTokenCostPer1M"] default %base_prompt_price
      core.if %long_context {
        %prompt_price = core.get %model_info["longContextPromptTokenCostPer1M"] default %base_prompt_price
        %completion_price = core.get %model_info["longContextCompletionTokenCostPer1M"] default %base_completion_price
        %cache_read_price = core.get %model_info["longContextCacheReadTokenCostPer1M"] default %cache_read_price
      }
      core.if %fast {
        %prompt_price = core.get %model_info["fastPromptTokenCostPer1M"] default %base_prompt_price
        %completion_price = core.get %model_info["fastCompletionTokenCostPer1M"] default %base_completion_price
        %cache_read_price = core.get %model_info["fastCacheReadTokenCostPer1M"] default %cache_read_price
        %cache_write_price = core.get %model_info["fastCacheWriteTokenCostPer1M"] default %cache_write_price
      }
      %total_output = core.call intrinsic.add(%completion, %thoughts)
      %prompt_cost_raw = core.call intrinsic.mul(%prompt, %prompt_price)
      %prompt_cost = core.call intrinsic.div(%prompt_cost_raw, 1000000)
      %completion_cost_raw = core.call intrinsic.mul(%total_output, %completion_price)
      %completion_cost = core.call intrinsic.div(%completion_cost_raw, 1000000)
      %cache_read_cost_raw = core.call intrinsic.mul(%cache_read, %cache_read_price)
      %cache_read_cost = core.call intrinsic.div(%cache_read_cost_raw, 1000000)
      %cache_write_cost_raw = core.call intrinsic.mul(%cache_creation, %cache_write_price)
      %cache_write_cost = core.call intrinsic.div(%cache_write_cost_raw, 1000000)
      %input_cost = core.call intrinsic.add(%prompt_cost, %cache_read_cost)
      %cache_cost = core.call intrinsic.add(%input_cost, %cache_write_cost)
      %total_cost = core.call intrinsic.add(%cache_cost, %completion_cost)
      core.return %total_cost
    }
  }

  op ax.provider.semantic @provider_route_request_requirements {
    attr core_kind = "func"
    attr emit_module = "ai"
    tag "provider-routing-runtime"
    type signature = "(request:json) -> json"
    body @entry(%request: json) {
      %requirements = core.map
      core.set %requirements["hasImages"] = false
      core.set %requirements["hasAudio"] = false
      core.set %requirements["hasAudioOutput"] = false
      core.set %requirements["hasFiles"] = false
      core.set %requirements["hasUrls"] = false
      core.set %requirements["requiresFunctions"] = false
      core.set %requirements["requiresStreaming"] = false
      core.set %requirements["requiresCaching"] = false
      %content_types = core.list
      core.set %requirements["contentTypes"] = %content_types
      core.set %requirements["estimatedTokens"] = 0
      %empty_list = core.list
      %prompt = core.get %request["chatPrompt"] default %empty_list
      %prompt_count_initial = core.call intrinsic.len(%prompt)
      %prompt_empty = core.call intrinsic.eq(%prompt_count_initial, 0)
      core.if %prompt_empty {
        %prompt = core.get %request["chat_prompt"] default %prompt
      }
      core.for %message in %prompt {
        %content = core.get %message["content"] default null
        %content_is_list = core.type_is %content type "list"
        core.if %content_is_list {
          core.for %part in %content {
            %part_type = core.get %part["type"] default "text"
            %known_type = core.call intrinsic.contains(%content_types, %part_type)
            %new_type = core.call intrinsic.not(%known_type)
            core.if %new_type {
              core.append %content_types, %part_type
            }
            %is_image = core.call intrinsic.eq(%part_type, "image")
            core.if %is_image {
              core.set %requirements["hasImages"] = true
              %cached = core.get %part["cache"] default false
              core.if %cached {
                core.set %requirements["requiresCaching"] = true
              }
            }
            %is_audio = core.call intrinsic.eq(%part_type, "audio")
            core.if %is_audio {
              core.set %requirements["hasAudio"] = true
              %cached_audio = core.get %part["cache"] default false
              core.if %cached_audio {
                core.set %requirements["requiresCaching"] = true
              }
            }
            %is_file = core.call intrinsic.eq(%part_type, "file")
            core.if %is_file {
              core.set %requirements["hasFiles"] = true
              %cached_file = core.get %part["cache"] default false
              core.if %cached_file {
                core.set %requirements["requiresCaching"] = true
              }
            }
            %is_url = core.call intrinsic.eq(%part_type, "url")
            core.if %is_url {
              core.set %requirements["hasUrls"] = true
              %cached_url = core.get %part["cache"] default false
              core.if %cached_url {
                core.set %requirements["requiresCaching"] = true
              }
            }
            %cached_part = core.get %part["cache"] default false
            core.if %cached_part {
              core.set %requirements["requiresCaching"] = true
            }
          }
        }
        %message_cached = core.get %message["cache"] default false
        core.if %message_cached {
          core.set %requirements["requiresCaching"] = true
        }
      }
      %functions = core.get %request["functions"] default %empty_list
      %functions_count = core.call intrinsic.len(%functions)
      %has_functions = core.call intrinsic.gt(%functions_count, 0)
      core.if %has_functions {
        core.set %requirements["requiresFunctions"] = true
      }
      %model_config = core.get %request["modelConfig"] default null
      %model_config_missing = core.call intrinsic.is_none(%model_config)
      core.if %model_config_missing {
        %model_config = core.get %request["model_config"] default null
      }
      %stream = core.get %model_config["stream"] default false
      core.if %stream {
        core.set %requirements["requiresStreaming"] = true
      }
      %audio_config = core.get %model_config["audio"] default null
      %audio_output = core.get %audio_config["output"] default null
      %audio_output_enabled = core.get %audio_output["enabled"] default false
      core.if %audio_output_enabled {
        core.set %requirements["hasAudioOutput"] = true
      }
      %capabilities = core.get %request["capabilities"] default null
      %requires_images = core.get %capabilities["requiresImages"] default false
      core.if %requires_images {
        core.set %requirements["hasImages"] = true
      }
      %requires_audio = core.get %capabilities["requiresAudio"] default false
      core.if %requires_audio {
        core.set %requirements["hasAudio"] = true
      }
      %requires_audio_output = core.get %capabilities["requiresAudioOutput"] default false
      core.if %requires_audio_output {
        core.set %requirements["hasAudioOutput"] = true
      }
      %requires_files = core.get %capabilities["requiresFiles"] default false
      core.if %requires_files {
        core.set %requirements["hasFiles"] = true
      }
      %requires_web_search = core.get %capabilities["requiresWebSearch"] default false
      core.if %requires_web_search {
        core.set %requirements["hasUrls"] = true
      }
      core.return %requirements
    }
  }

  op ax.provider.semantic @provider_features_support {
    attr core_kind = "func"
    attr emit_module = "ai"
    attr private = true
    tag "provider-routing-runtime"
    type signature = "(features:json, path:string) -> bool"
    body @entry(%features: json, %path: string) {
      %media = core.get %features["media"] default null
      %caching = core.get %features["caching"] default null
      %is_functions = core.call intrinsic.eq(%path, "functions")
      core.if %is_functions {
        %value = core.get %features["functions"] default false
        core.return %value
      }
      %is_streaming = core.call intrinsic.eq(%path, "streaming")
      core.if %is_streaming {
        %value_streaming = core.get %features["streaming"] default false
        core.return %value_streaming
      }
      %is_images = core.call intrinsic.eq(%path, "images")
      core.if %is_images {
        %images = core.get %media["images"] default null
        %value_images = core.get %images["supported"] default false
        core.return %value_images
      }
      %is_audio = core.call intrinsic.eq(%path, "audio")
      core.if %is_audio {
        %audio = core.get %media["audio"] default null
        %value_audio = core.get %audio["supported"] default false
        core.return %value_audio
      }
      %is_files = core.call intrinsic.eq(%path, "files")
      core.if %is_files {
        %files = core.get %media["files"] default null
        %value_files = core.get %files["supported"] default false
        core.return %value_files
      }
      %is_urls = core.call intrinsic.eq(%path, "urls")
      core.if %is_urls {
        %urls = core.get %media["urls"] default null
        %value_urls = core.get %urls["supported"] default false
        core.return %value_urls
      }
      %is_caching = core.call intrinsic.eq(%path, "caching")
      core.if %is_caching {
        %value_caching = core.get %caching["supported"] default false
        core.return %value_caching
      }
      core.return false
    }
  }

  op ax.provider.semantic @provider_route_preprocess_request {
    attr core_kind = "func"
    attr emit_module = "ai"
    tag "provider-routing-runtime"
    tag "provider-routing-native-image-preservation"
    type signature = "(features:json, request:json) -> json"
    body @entry(%features: json, %request: json) {
      %supports_images = core.call @provider_features_support(%features, "images")
      %does_not_support_images = core.call intrinsic.not(%supports_images)
      core.if %does_not_support_images {
        core.return %request
      }

      %has_camel_prompt = core.call intrinsic.map.contains(%request, "chatPrompt")
      %has_snake_prompt = core.call intrinsic.map.contains(%request, "chat_prompt")
      %has_any_prompt = core.call intrinsic.or(%has_camel_prompt, %has_snake_prompt)
      %missing_prompt = core.call intrinsic.not(%has_any_prompt)
      core.if %missing_prompt {
        core.return %request
      }

      %prompt_key = core.let "chatPrompt"
      %prompt = core.get %request["chatPrompt"] default null
      %missing_camel_prompt = core.call intrinsic.not(%has_camel_prompt)
      core.if %missing_camel_prompt {
        %prompt_key = core.let "chat_prompt"
        %prompt = core.get %request["chat_prompt"] default null
      }
      %prompt_is_list = core.type_is %prompt type "list"
      %prompt_not_list = core.call intrinsic.not(%prompt_is_list)
      core.if %prompt_not_list {
        core.return %request
      }

      %processed_prompt = core.list
      core.for %message in %prompt {
        %message_seed = core.map
        %message_copy = core.call intrinsic.map.merge(%message_seed, %message)
        %content = core.get %message["content"] default null
        %content_is_list = core.type_is %content type "list"
        core.if %content_is_list {
          %processed_content = core.list
          core.for %part in %content {
            %part_type = core.get %part["type"] default "text"
            %is_image = core.call intrinsic.eq(%part_type, "image")
            core.if %is_image {
              %image_seed = core.map
              %image_copy = core.call intrinsic.map.merge(%image_seed, %part)
              core.append %processed_content, %image_copy
            } else {
              core.append %processed_content, %part
            }
          }
          core.set %message_copy["content"] = %processed_content
        }
        core.append %processed_prompt, %message_copy
      }

      %request_seed = core.map
      %out = core.call intrinsic.map.merge(%request_seed, %request)
      core.set %out[%prompt_key] = %processed_prompt
      core.return %out
    }
  }

  op ax.provider.semantic @provider_route_score {
    attr core_kind = "func"
    attr emit_module = "ai"
    attr private = true
    tag "provider-routing-runtime"
    type signature = "(provider:json, requirements:json) -> json"
    body @entry(%provider: json, %requirements: json) {
      %features = core.get %provider["features"] default null
      %score = core.let 10
      %missing = core.list
      %supported = core.list
      %needs_images = core.get %requirements["hasImages"] default false
      core.if %needs_images {
        %ok_images = core.call @provider_features_support(%features, "images")
        core.if %ok_images {
          %score = core.call intrinsic.add(%score, 25)
          core.append %supported, "Images"
        } else {
          core.append %missing, "Image support"
        }
      }
      %needs_audio = core.get %requirements["hasAudio"] default false
      core.if %needs_audio {
        %ok_audio = core.call @provider_features_support(%features, "audio")
        core.if %ok_audio {
          %score = core.call intrinsic.add(%score, 25)
          core.append %supported, "Audio"
        } else {
          core.append %missing, "Audio support"
        }
      }
      %needs_files = core.get %requirements["hasFiles"] default false
      core.if %needs_files {
        %ok_files = core.call @provider_features_support(%features, "files")
        core.if %ok_files {
          %score = core.call intrinsic.add(%score, 25)
          core.append %supported, "Files"
        } else {
          core.append %missing, "File support"
        }
      }
      %needs_urls = core.get %requirements["hasUrls"] default false
      core.if %needs_urls {
        %ok_urls = core.call @provider_features_support(%features, "urls")
        core.if %ok_urls {
          %score = core.call intrinsic.add(%score, 25)
          core.append %supported, "URLs"
        } else {
          core.append %missing, "URL/Web search support"
        }
      }
      %needs_functions = core.get %requirements["requiresFunctions"] default false
      core.if %needs_functions {
        %ok_functions = core.call @provider_features_support(%features, "functions")
        core.if %ok_functions {
          %score = core.call intrinsic.add(%score, 15)
          core.append %supported, "Functions"
        } else {
          core.append %missing, "Function calling"
        }
      }
      %needs_streaming = core.get %requirements["requiresStreaming"] default false
      core.if %needs_streaming {
        %ok_streaming = core.call @provider_features_support(%features, "streaming")
        core.if %ok_streaming {
          %score = core.call intrinsic.add(%score, 10)
          core.append %supported, "Streaming"
        } else {
          core.append %missing, "Streaming responses"
        }
      }
      %needs_caching = core.get %requirements["requiresCaching"] default false
      core.if %needs_caching {
        %ok_caching = core.call @provider_features_support(%features, "caching")
        core.if %ok_caching {
          %score = core.call intrinsic.add(%score, 8)
          core.append %supported, "Caching"
        } else {
          core.append %missing, "Content caching"
        }
      }
      %thinking = core.get %features["thinking"] default false
      core.if %thinking {
        %score = core.call intrinsic.add(%score, 2)
      }
      %multi_turn = core.get %features["multiTurn"] default null
      %multi_turn_missing = core.call intrinsic.is_none(%multi_turn)
      core.if %multi_turn_missing {
        %multi_turn = core.get %features["multi_turn"] default false
      }
      core.if %multi_turn {
        %score = core.call intrinsic.add(%score, 2)
      }
      %missing_count = core.call intrinsic.len(%missing)
      %penalty = core.call intrinsic.mul(%missing_count, -10)
      %score = core.call intrinsic.add(%score, %penalty)
      %score = core.call intrinsic.add(%score, 0)
      %out = core.map
      core.set %out["provider"] = %provider
      core.set %out["score"] = %score
      core.set %out["missingCapabilities"] = %missing
      core.set %out["supportedCapabilities"] = %supported
      core.return %out
    }
  }

  op ax.provider.semantic @provider_route_recommendation {
    attr core_kind = "func"
    attr emit_module = "ai"
    tag "provider-routing-runtime"
    type signature = "(providers:list<json>, request:json, options:json) -> json throws"
    body @entry(%providers: json, %request: json, %options: json) {
      %provider_count = core.call intrinsic.len(%providers)
      %has_providers = core.call intrinsic.gt(%provider_count, 0)
      %no_providers = core.call intrinsic.not(%has_providers)
      core.if %no_providers {
        %error = core.call intrinsic.error.runtime("Provider selection failed: No providers available")
        core.raise %error
      }
      %requirements = core.call @provider_route_request_requirements(%request)
      %best = core.call intrinsic.list.get(%providers, 0, null)
      %best_score = core.let -999999
      %best_missing = core.list
      core.for %provider in %providers {
        %score_entry = core.call @provider_route_score(%provider, %requirements)
        %score = core.get %score_entry["score"] default 0
        %better = core.call intrinsic.gt(%score, %best_score)
        core.if %better {
          %best_score = core.let %score
          %best = core.let %provider
          %best_missing = core.get %score_entry["missingCapabilities"] default %best_missing
        }
      }
      %require_exact = core.get %options["requireExactMatch"] default false
      %allow_degradation = core.get %options["allowDegradation"] default true
      %missing_count = core.call intrinsic.len(%best_missing)
      %has_missing = core.call intrinsic.gt(%missing_count, 0)
      core.if %require_exact {
        core.if %has_missing {
          %missing_text = core.call intrinsic.string.join(", ", %best_missing)
          %message = core.call intrinsic.string.format("Provider selection failed: No providers fully support the request requirements: {}", %missing_text)
          %error_exact = core.call intrinsic.error.runtime(%message)
          core.raise %error_exact
        }
      }
      %degradation_disallowed = core.call intrinsic.not(%allow_degradation)
      core.if %degradation_disallowed {
        core.if %has_missing {
          %best_name_for_error = core.get %best["name"] default "provider"
          %missing_text_no_degrade = core.call intrinsic.string.join(", ", %best_missing)
          %message_no_degrade = core.call intrinsic.string.format("Provider selection failed: Best available provider ({}) is missing: {}", %best_name_for_error, %missing_text_no_degrade)
          %error_no_degrade = core.call intrinsic.error.runtime(%message_no_degrade)
          core.raise %error_no_degrade
        }
      }
      %features = core.get %best["features"] default null
      %processing = core.list
      %degradations = core.list
      %warnings = core.list
      %needs_images = core.get %requirements["hasImages"] default false
      core.if %needs_images {
        %ok_images = core.call @provider_features_support(%features, "images")
        %missing_images = core.call intrinsic.not(%ok_images)
        core.if %missing_images {
          core.append %degradations, "Images will be converted to text descriptions"
          core.append %processing, "Image-to-text conversion"
        }
      }
      %needs_audio = core.get %requirements["hasAudio"] default false
      core.if %needs_audio {
        %ok_audio = core.call @provider_features_support(%features, "audio")
        %missing_audio = core.call intrinsic.not(%ok_audio)
        core.if %missing_audio {
          core.append %degradations, "Audio will be transcribed to text"
          core.append %processing, "Audio-to-text transcription"
        }
      }
      %needs_files = core.get %requirements["hasFiles"] default false
      core.if %needs_files {
        %ok_files = core.call @provider_features_support(%features, "files")
        %missing_files = core.call intrinsic.not(%ok_files)
        core.if %missing_files {
          core.append %degradations, "File content will be extracted to text"
          core.append %processing, "File-to-text extraction"
        }
      }
      %needs_urls = core.get %requirements["hasUrls"] default false
      core.if %needs_urls {
        %ok_urls = core.call @provider_features_support(%features, "urls")
        %missing_urls = core.call intrinsic.not(%ok_urls)
        core.if %missing_urls {
          core.append %degradations, "URL content will be pre-fetched"
          core.append %processing, "URL content fetching"
        }
      }
      %needs_streaming = core.get %requirements["requiresStreaming"] default false
      core.if %needs_streaming {
        %ok_streaming = core.call @provider_features_support(%features, "streaming")
        %missing_streaming = core.call intrinsic.not(%ok_streaming)
        core.if %missing_streaming {
          core.append %warnings, "Streaming not supported - will use non-streaming mode"
        }
      }
      %needs_caching = core.get %requirements["requiresCaching"] default false
      core.if %needs_caching {
        %ok_caching = core.call @provider_features_support(%features, "caching")
        %missing_caching = core.call intrinsic.not(%ok_caching)
        core.if %missing_caching {
          core.append %warnings, "Content caching not supported"
        }
      }
      %out = core.map
      core.set %out["provider"] = %best
      %provider_name = core.get %best["name"] default ""
      core.set %out["providerName"] = %provider_name
      core.set %out["processingApplied"] = %processing
      core.set %out["degradations"] = %degradations
      core.set %out["warnings"] = %warnings
      core.set %out["requirements"] = %requirements
      core.return %out
    }
  }

  op ax.provider.semantic @provider_route_any_supports {
    attr core_kind = "func"
    attr emit_module = "ai"
    attr private = true
    tag "provider-routing-runtime"
    type signature = "(providers:list<json>, path:string) -> bool"
    body @entry(%providers: json, %path: string) {
      %ok = core.let false
      core.for %provider in %providers {
        %features = core.get %provider["features"] default null
        %supported = core.call @provider_features_support(%features, %path)
        core.if %supported {
          %ok = core.let true
        }
      }
      core.return %ok
    }
  }

  op ax.provider.semantic @provider_route_validation {
    attr core_kind = "func"
    attr emit_module = "ai"
    tag "provider-routing-runtime"
    type signature = "(providers:list<json>, request:json, processing:json, options:json) -> json throws"
    body @entry(%providers: json, %request: json, %processing: json, %options: json) {
      %issues = core.list
      %recommendations = core.list
      %result = core.map
      %recommendation = core.call @provider_route_recommendation(%providers, %request, %options)
      %degradations = core.get %recommendation["degradations"] default %issues
      core.for %degradation in %degradations {
        core.append %issues, %degradation
      }
      %warnings = core.get %recommendation["warnings"] default %issues
      core.for %warning in %warnings {
        core.append %issues, %warning
      }
      %degradation_count = core.call intrinsic.len(%degradations)
      %has_degradations = core.call intrinsic.gt(%degradation_count, 0)
      core.if %has_degradations {
        core.append %recommendations, "Consider using a provider that natively supports all media types"
      }
      %requirements = core.get %recommendation["requirements"] default null
      %needs_images = core.get %requirements["hasImages"] default false
      core.if %needs_images {
        %image_processor = core.get %processing["imageToText"] default null
        %has_image_processor = core.call intrinsic.is_not_none(%image_processor)
        %has_image_provider = core.call @provider_route_any_supports(%providers, "images")
        %no_image_processor = core.call intrinsic.not(%has_image_processor)
        %no_image_provider = core.call intrinsic.not(%has_image_provider)
        %image_problem = core.call intrinsic.and(%no_image_processor, %no_image_provider)
        core.if %image_problem {
          core.append %issues, "No image processing service available and no providers support images"
          core.append %recommendations, "Add imageToText processing service or use image-capable provider"
        }
      }
      %needs_audio = core.get %requirements["hasAudio"] default false
      core.if %needs_audio {
        %audio_processor = core.get %processing["audioToText"] default null
        %has_audio_processor = core.call intrinsic.is_not_none(%audio_processor)
        %has_audio_provider = core.call @provider_route_any_supports(%providers, "audio")
        %no_audio_processor = core.call intrinsic.not(%has_audio_processor)
        %no_audio_provider = core.call intrinsic.not(%has_audio_provider)
        %audio_problem = core.call intrinsic.and(%no_audio_processor, %no_audio_provider)
        core.if %audio_problem {
          core.append %issues, "No audio processing service available and no providers support audio"
          core.append %recommendations, "Add audioToText processing service or use audio-capable provider"
        }
      }
      %issue_count = core.call intrinsic.len(%issues)
      %no_issues = core.call intrinsic.eq(%issue_count, 0)
      %can_handle = core.call intrinsic.or(%no_issues, %has_degradations)
      core.set %result["canHandle"] = %can_handle
      core.set %result["issues"] = %issues
      core.set %result["recommendations"] = %recommendations
      core.return %result
    }
  }

  op ax.provider.semantic @provider_balancer_retry_policy {
    attr core_kind = "func"
    attr emit_module = "ai"
    tag "provider-balancer-runtime"
    type signature = "(options:json) -> json"
    body @entry(%options: json) {
      %out = core.map
      %strategy = core.get %options["strategy"] default "metric"
      core.set %out["strategy"] = %strategy
      %max_retries = core.get %options["maxRetries"] default null
      %max_retries_missing = core.call intrinsic.is_none(%max_retries)
      core.if %max_retries_missing {
        %max_retries = core.get %options["max_retries"] default 3
      }
      core.set %out["maxRetries"] = %max_retries
      %initial_backoff = core.get %options["initialBackoffMs"] default null
      %initial_backoff_missing = core.call intrinsic.is_none(%initial_backoff)
      core.if %initial_backoff_missing {
        %initial_backoff = core.get %options["initial_backoff_ms"] default 1000
      }
      core.set %out["initialBackoffMs"] = %initial_backoff
      %max_backoff = core.get %options["maxBackoffMs"] default null
      %max_backoff_missing = core.call intrinsic.is_none(%max_backoff)
      core.if %max_backoff_missing {
        %max_backoff = core.get %options["max_backoff_ms"] default 32000
      }
      core.set %out["maxBackoffMs"] = %max_backoff
      %debug = core.get %options["debug"] default true
      core.set %out["debug"] = %debug
      core.return %out
    }
  }

  op ax.provider.semantic @provider_balancer_metric_score {
    attr core_kind = "func"
    attr emit_module = "ai"
    tag "provider-balancer-runtime"
    type signature = "(metrics:json) -> number"
    body @entry(%metrics: json) {
      %latency = core.get %metrics["latency"] default null
      %chat = core.get %latency["chat"] default null
      %mean = core.get %chat["mean"] default 0
      core.return %mean
    }
  }

  op ax.provider.semantic @provider_balancer_candidate_allowed {
    attr core_kind = "func"
    attr emit_module = "ai"
    tag "provider-balancer-runtime"
    type signature = "(features:json, request:json) -> bool"
    body @entry(%features: json, %request: json) {
      %format = core.get %request["responseFormat"] default null
      %format_missing = core.call intrinsic.is_none(%format)
      core.if %format_missing {
        %format = core.get %request["response_format"] default null
      }
      %format_type = core.get %format["type"] default ""
      %requires_structured = core.call intrinsic.eq(%format_type, "json_schema")
      core.if %requires_structured {
        %structured = core.get %features["structuredOutputs"] default null
        %structured_missing = core.call intrinsic.is_none(%structured)
        core.if %structured_missing {
          %structured = core.get %features["structured_outputs"] default false
        }
        %no_structured = core.call intrinsic.not(%structured)
        core.if %no_structured {
          core.return false
        }
      }
      %capabilities = core.get %request["capabilities"] default null
      %media = core.get %features["media"] default null
      %requires_images = core.get %capabilities["requiresImages"] default null
      %requires_images_missing = core.call intrinsic.is_none(%requires_images)
      core.if %requires_images_missing {
        %requires_images = core.get %capabilities["requires_images"] default false
      }
      core.if %requires_images {
        %images = core.get %media["images"] default null
        %images_ok = core.get %images["supported"] default false
        %images_bad = core.call intrinsic.not(%images_ok)
        core.if %images_bad {
          core.return false
        }
      }
      %requires_audio = core.get %capabilities["requiresAudio"] default null
      %requires_audio_missing = core.call intrinsic.is_none(%requires_audio)
      core.if %requires_audio_missing {
        %requires_audio = core.get %capabilities["requires_audio"] default false
      }
      core.if %requires_audio {
        %audio = core.get %media["audio"] default null
        %audio_ok = core.get %audio["supported"] default false
        %audio_bad = core.call intrinsic.not(%audio_ok)
        core.if %audio_bad {
          core.return false
        }
      }
      core.return true
    }
  }

  op ax.provider.semantic @provider_balancer_adaptive_policy {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "ai"
    tag "provider-balancer-adaptive"
    type signature = "(strategy:json) -> json throws"
    body @entry(%strategy: json) {
      %deadline = core.get %strategy["deadlineMs"] default null
      %deadline_missing = core.call intrinsic.is_none(%deadline)
      core.if %deadline_missing {
        %deadline = core.get %strategy["deadline_ms"] default 0
      }
      %deadline_bad = core.call intrinsic.lte(%deadline, 0)
      core.if %deadline_bad {
        %error = core.call intrinsic.error.runtime("Adaptive deadlineMs must be finite and greater than zero.")
        core.raise %error
      }
      %bad_outcome = core.get %strategy["badOutcomeCost"] default null
      %bad_outcome_missing = core.call intrinsic.is_none(%bad_outcome)
      core.if %bad_outcome_missing {
        %bad_outcome = core.get %strategy["bad_outcome_cost"] default -1
      }
      %bad_outcome_bad = core.call intrinsic.lt(%bad_outcome, 0)
      core.if %bad_outcome_bad {
        %error = core.call intrinsic.error.runtime("Adaptive badOutcomeCost must be finite and non-negative.")
        core.raise %error
      }
      %out = core.map
      core.set %out["type"] = "adaptive"
      core.set %out["deadlineMs"] = %deadline
      core.set %out["badOutcomeCost"] = %bad_outcome
      %namespace = core.get %strategy["namespace"] default "default"
      core.set %out["namespace"] = %namespace
      %tokens = core.get %strategy["expectedTokens"] default null
      %tokens_missing = core.call intrinsic.is_none(%tokens)
      core.if %tokens_missing {
        %tokens = core.get %strategy["expected_tokens"] default null
      }
      core.set %out["expectedTokens"] = %tokens
      core.return %out
    }
  }

  op ax.provider.semantic @provider_balancer_route_stats {
    attr core_kind = "func"
    attr emit_module = "ai"
    tag "provider-balancer-adaptive"
    type signature = "() -> json"
    body @entry {
      %out = core.map
      core.set %out["version"] = 1
      core.set %out["observations"] = 0
      core.set %out["successes"] = 0
      core.set %out["failureEwma"] = 0.05
      core.set %out["logLatencyMean"] = 0
      core.set %out["logLatencyM2"] = 0
      core.return %out
    }
  }

  op ax.provider.semantic @provider_balancer_observe_route {
    attr core_kind = "func"
    attr emit_module = "ai"
    tag "provider-balancer-adaptive"
    type signature = "(stats:json, observation:json) -> json"
    body @entry(%stats: json, %observation: json) {
      %missing = core.call intrinsic.is_none(%stats)
      core.if %missing {
        %stats = core.call @provider_balancer_route_stats()
      }
      %outcome = core.get %observation["outcome"] default "failure"
      %failed = core.call intrinsic.eq(%outcome, "failure")
      %failed_number = core.call intrinsic.add(0, 0)
      core.if %failed {
        %failed_number = core.call intrinsic.add(1, 0)
      }
      %failure_ewma = core.get %stats["failureEwma"] default 0.05
      %old_weighted = core.call intrinsic.mul(0.8, %failure_ewma)
      %new_weighted = core.call intrinsic.mul(0.2, %failed_number)
      %next_failure = core.call intrinsic.add(%old_weighted, %new_weighted)
      %observations = core.get %stats["observations"] default 0
      %next_observations = core.call intrinsic.add(%observations, 1)
      %successes = core.get %stats["successes"] default 0
      %mean = core.get %stats["logLatencyMean"] default 0
      %m2 = core.get %stats["logLatencyM2"] default 0
      %out = core.map
      core.set %out["version"] = 1
      core.set %out["observations"] = %next_observations
      core.set %out["successes"] = %successes
      core.set %out["failureEwma"] = %next_failure
      core.set %out["logLatencyMean"] = %mean
      core.set %out["logLatencyM2"] = %m2
      core.if %failed {
        core.return %out
      }
      %latency = core.get %observation["latencyMs"] default null
      %latency_missing = core.call intrinsic.is_none(%latency)
      core.if %latency_missing {
        %latency = core.get %observation["latency_ms"] default 1
      }
      %too_small = core.call intrinsic.lt(%latency, 1)
      core.if %too_small {
        %latency = core.call intrinsic.add(1, 0)
      }
      %log_latency = core.call intrinsic.math.log(%latency)
      %next_successes = core.call intrinsic.add(%successes, 1)
      %negative_mean = core.call intrinsic.mul(-1, %mean)
      %delta = core.call intrinsic.add(%log_latency, %negative_mean)
      %delta_share = core.call intrinsic.div(%delta, %next_successes)
      %next_mean = core.call intrinsic.add(%mean, %delta_share)
      %negative_next_mean = core.call intrinsic.mul(-1, %next_mean)
      %delta_after = core.call intrinsic.add(%log_latency, %negative_next_mean)
      %m2_increment = core.call intrinsic.mul(%delta, %delta_after)
      %next_m2 = core.call intrinsic.add(%m2, %m2_increment)
      core.set %out["successes"] = %next_successes
      core.set %out["logLatencyMean"] = %next_mean
      core.set %out["logLatencyM2"] = %next_m2
      core.return %out
    }
  }

  op ax.provider.semantic @provider_balancer_nonzero_random {
    attr core_kind = "func"
    attr emit_module = "ai"
    attr private = "true"
    tag "provider-balancer-adaptive"
    type signature = "() -> number"
    body @entry {
      %value = core.call intrinsic.math.random()
      %low = core.call intrinsic.lt(%value, 0.0000000000000002220446049250313)
      core.if %low {
        core.return 0.0000000000000002220446049250313
      }
      %high = core.call intrinsic.gt(%value, 0.9999999999999998)
      core.if %high {
        core.return 0.9999999999999998
      }
      core.return %value
    }
  }

  op ax.provider.semantic @provider_balancer_standard_normal {
    attr core_kind = "func"
    attr emit_module = "ai"
    attr private = "true"
    tag "provider-balancer-adaptive"
    type signature = "() -> number"
    body @entry {
      %u1 = core.call @provider_balancer_nonzero_random()
      %u2 = core.call @provider_balancer_nonzero_random()
      %log_u1 = core.call intrinsic.math.log(%u1)
      %negative_two_log = core.call intrinsic.mul(-2, %log_u1)
      %radius = core.call intrinsic.math.sqrt(%negative_two_log)
      %angle = core.call intrinsic.mul(6.283185307179586, %u2)
      %cosine = core.call intrinsic.math.cos(%angle)
      %sample = core.call intrinsic.mul(%radius, %cosine)
      core.return %sample
    }
  }

  op ax.provider.semantic @provider_balancer_gamma_sample {
    attr core_kind = "func"
    attr emit_module = "ai"
    attr private = "true"
    tag "provider-balancer-adaptive"
    type signature = "(shape:number, scale:number) -> number"
    body @entry(%shape: number, %scale: number) {
      %third = core.call intrinsic.div(1, 3)
      %negative_third = core.call intrinsic.mul(-1, %third)
      %d = core.call intrinsic.add(%shape, %negative_third)
      %nine_d = core.call intrinsic.mul(9, %d)
      %sqrt_nine_d = core.call intrinsic.math.sqrt(%nine_d)
      %c = core.call intrinsic.div(1, %sqrt_nine_d)
      %attempts = core.list
      core.append %attempts, 0
      core.append %attempts, 1
      core.append %attempts, 2
      core.append %attempts, 3
      core.append %attempts, 4
      core.append %attempts, 5
      core.append %attempts, 6
      core.append %attempts, 7
      core.append %attempts, 8
      core.append %attempts, 9
      core.append %attempts, 10
      core.append %attempts, 11
      core.append %attempts, 12
      core.append %attempts, 13
      core.append %attempts, 14
      core.append %attempts, 15
      core.for %attempt in %attempts {
        %x = core.call @provider_balancer_standard_normal()
        %cx = core.call intrinsic.mul(%c, %x)
        %base = core.call intrinsic.add(1, %cx)
        %base_bad = core.call intrinsic.lte(%base, 0)
        core.if %base_bad {
          core.continue
        }
        %value = core.call intrinsic.math.pow(%base, 3)
        %u = core.call @provider_balancer_nonzero_random()
        %x2 = core.call intrinsic.math.pow(%x, 2)
        %x4 = core.call intrinsic.math.pow(%x, 4)
        %penalty = core.call intrinsic.mul(0.0331, %x4)
        %negative_penalty = core.call intrinsic.mul(-1, %penalty)
        %fast_threshold = core.call intrinsic.add(1, %negative_penalty)
        %fast_accept = core.call intrinsic.lt(%u, %fast_threshold)
        core.if %fast_accept {
          %dv = core.call intrinsic.mul(%d, %value)
          %sample = core.call intrinsic.mul(%dv, %scale)
          core.return %sample
        }
        %log_u = core.call intrinsic.math.log(%u)
        %half_x2 = core.call intrinsic.mul(0.5, %x2)
        %negative_value = core.call intrinsic.mul(-1, %value)
        %one_minus_value = core.call intrinsic.add(1, %negative_value)
        %log_value = core.call intrinsic.math.log(%value)
        %inside = core.call intrinsic.add(%one_minus_value, %log_value)
        %d_inside = core.call intrinsic.mul(%d, %inside)
        %rhs = core.call intrinsic.add(%half_x2, %d_inside)
        %accept = core.call intrinsic.lt(%log_u, %rhs)
        core.if %accept {
          %dv = core.call intrinsic.mul(%d, %value)
          %sample = core.call intrinsic.mul(%dv, %scale)
          core.return %sample
        }
      }
      %fallback = core.call intrinsic.mul(%shape, %scale)
      core.return %fallback
    }
  }

  op ax.provider.semantic @provider_balancer_normal_cdf {
    attr core_kind = "func"
    attr emit_module = "ai"
    attr private = "true"
    tag "provider-balancer-adaptive"
    type signature = "(value:number) -> number"
    body @entry(%value: number) {
      %sign = core.call intrinsic.add(1, 0)
      %negative = core.call intrinsic.lt(%value, 0)
      core.if %negative {
        %sign = core.call intrinsic.add(-1, 0)
      }
      %absolute = core.call intrinsic.math.abs(%value)
      %sqrt_two = core.call intrinsic.math.sqrt(2)
      %x = core.call intrinsic.div(%absolute, %sqrt_two)
      %scaled_x = core.call intrinsic.mul(0.3275911, %x)
      %denom = core.call intrinsic.add(1, %scaled_x)
      %t = core.call intrinsic.div(1, %denom)
      %p1 = core.call intrinsic.mul(1.061405429, %t)
      %p1 = core.call intrinsic.add(%p1, -1.453152027)
      %p2 = core.call intrinsic.mul(%p1, %t)
      %p2 = core.call intrinsic.add(%p2, 1.421413741)
      %p3 = core.call intrinsic.mul(%p2, %t)
      %p3 = core.call intrinsic.add(%p3, -0.284496736)
      %p4 = core.call intrinsic.mul(%p3, %t)
      %p4 = core.call intrinsic.add(%p4, 0.254829592)
      %polynomial = core.call intrinsic.mul(%p4, %t)
      %negative_x = core.call intrinsic.mul(-1, %x)
      %negative_x2 = core.call intrinsic.mul(%negative_x, %x)
      %exponential = core.call intrinsic.math.exp(%negative_x2)
      %poly_exp = core.call intrinsic.mul(%polynomial, %exponential)
      %negative_poly_exp = core.call intrinsic.mul(-1, %poly_exp)
      %one_minus = core.call intrinsic.add(1, %negative_poly_exp)
      %erf = core.call intrinsic.mul(%sign, %one_minus)
      %one_plus_erf = core.call intrinsic.add(1, %erf)
      %cdf = core.call intrinsic.div(%one_plus_erf, 2)
      core.return %cdf
    }
  }

  op ax.provider.semantic @provider_balancer_sample_health {
    attr core_kind = "func"
    attr emit_module = "ai"
    tag "provider-balancer-adaptive"
    type signature = "(stats:json, deadline_ms:number) -> json"
    body @entry(%stats: json, %deadline_ms: number) {
      %missing = core.call intrinsic.is_none(%stats)
      core.if %missing {
        %stats = core.call @provider_balancer_route_stats()
      }
      %deadline_too_small = core.call intrinsic.lt(%deadline_ms, 1)
      core.if %deadline_too_small {
        %deadline_ms = core.call intrinsic.add(1, 0)
      }
      %half_deadline = core.call intrinsic.div(%deadline_ms, 2)
      %prior_mean = core.call intrinsic.math.log(%half_deadline)
      %count = core.get %stats["successes"] default 0
      %posterior_strength = core.call intrinsic.add(1, %count)
      %count_mean = core.get %stats["logLatencyMean"] default 0
      %weighted_mean = core.call intrinsic.mul(%count, %count_mean)
      %mean_sum = core.call intrinsic.add(%prior_mean, %weighted_mean)
      %posterior_mean = core.call intrinsic.div(%mean_sum, %posterior_strength)
      %half_count = core.call intrinsic.div(%count, 2)
      %posterior_alpha = core.call intrinsic.add(2, %half_count)
      %negative_prior = core.call intrinsic.mul(-1, %prior_mean)
      %mean_delta = core.call intrinsic.add(%count_mean, %negative_prior)
      %mean_delta2 = core.call intrinsic.math.pow(%mean_delta, 2)
      %count_delta2 = core.call intrinsic.mul(%count, %mean_delta2)
      %twice_strength = core.call intrinsic.mul(2, %posterior_strength)
      %mean_adjustment = core.call intrinsic.div(%count_delta2, %twice_strength)
      %m2 = core.get %stats["logLatencyM2"] default 0
      %half_m2 = core.call intrinsic.div(%m2, 2)
      %posterior_beta = core.call intrinsic.add(0.4804530139182014, %half_m2)
      %posterior_beta = core.call intrinsic.add(%posterior_beta, %mean_adjustment)
      %scale = core.call intrinsic.div(1, %posterior_beta)
      %precision = core.call @provider_balancer_gamma_sample(%posterior_alpha, %scale)
      %variance = core.call intrinsic.div(1, %precision)
      %variance_over_strength = core.call intrinsic.div(%variance, %posterior_strength)
      %mean_stddev = core.call intrinsic.math.sqrt(%variance_over_strength)
      %normal = core.call @provider_balancer_standard_normal()
      %mean_noise = core.call intrinsic.mul(%normal, %mean_stddev)
      %sampled_mean = core.call intrinsic.add(%posterior_mean, %mean_noise)
      %log_deadline = core.call intrinsic.math.log(%deadline_ms)
      %negative_sampled_mean = core.call intrinsic.mul(-1, %sampled_mean)
      %z_numerator = core.call intrinsic.add(%log_deadline, %negative_sampled_mean)
      %variance_stddev = core.call intrinsic.math.sqrt(%variance)
      %z = core.call intrinsic.div(%z_numerator, %variance_stddev)
      %cdf = core.call @provider_balancer_normal_cdf(%z)
      %negative_cdf = core.call intrinsic.mul(-1, %cdf)
      %late = core.call intrinsic.add(1, %negative_cdf)
      %failure = core.get %stats["failureEwma"] default 0.05
      %out = core.map
      core.set %out["failureProbability"] = %failure
      core.set %out["deadlineMissProbability"] = %late
      core.return %out
    }
  }

  op ax.provider.semantic @provider_balancer_adaptive_score {
    attr core_kind = "func"
    attr emit_module = "ai"
    tag "provider-balancer-adaptive"
    type signature = "(estimated_cost:number, bad_outcome_cost:number, failure_probability:number, deadline_miss_probability:number) -> number"
    body @entry(%estimated_cost: number, %bad_outcome_cost: number, %failure_probability: number, %deadline_miss_probability: number) {
      %negative_failure = core.call intrinsic.mul(-1, %failure_probability)
      %success_probability = core.call intrinsic.add(1, %negative_failure)
      %successful_late = core.call intrinsic.mul(%success_probability, %deadline_miss_probability)
      %bad_probability = core.call intrinsic.add(%failure_probability, %successful_late)
      %bad_cost = core.call intrinsic.mul(%bad_outcome_cost, %bad_probability)
      %score = core.call intrinsic.add(%estimated_cost, %bad_cost)
      core.return %score
    }
  }

  op ax.provider.semantic @provider_balancer_validate_route_key {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "ai"
    tag "provider-balancer-adaptive"
    type signature = "(route_key:string, seen_keys:json) -> string throws"
    body @entry(%route_key: string, %seen_keys: json) {
      %key = core.string_trim %route_key
      %empty = core.call intrinsic.eq(%key, "")
      core.if %empty {
        %error = core.call intrinsic.error.runtime("Adaptive route keys must be non-empty.")
        core.raise %error
      }
      %duplicate = core.call intrinsic.contains(%seen_keys, %key)
      core.if %duplicate {
        %error = core.call intrinsic.error.runtime("Adaptive route keys must be unique.")
        core.raise %error
      }
      core.return %key
    }
  }

  op ax.provider.semantic @provider_balancer_rank_candidates {
    attr core_kind = "func"
    attr emit_module = "ai"
    tag "provider-balancer-adaptive"
    type signature = "(candidates:json) -> json"
    body @entry(%candidates: json) {
      %ranked = core.list
      %used = core.map
      core.for %slot in %candidates {
        %best = core.map
        %has_best = core.let false
        %best_score = core.let 0
        %best_order = core.let 0
        core.for %candidate in %candidates {
          %route_key = core.get %candidate["routeKey"] default ""
          %already_used = core.call intrinsic.map.contains(%used, %route_key)
          core.if %already_used {
            core.continue
          }
          %score = core.get %candidate["score"] default 0
          %order = core.get %candidate["order"] default 0
          %lower_score = core.call intrinsic.lt(%score, %best_score)
          %equal_score = core.call intrinsic.eq(%score, %best_score)
          %lower_order = core.call intrinsic.lt(%order, %best_order)
          %stable_tie = core.call intrinsic.and(%equal_score, %lower_order)
          %score_or_tie = core.call intrinsic.or(%lower_score, %stable_tie)
          %no_best = core.call intrinsic.not(%has_best)
          %better = core.call intrinsic.or(%no_best, %score_or_tie)
          core.if %better {
            %best = core.let %candidate
            %best_score = core.let %score
            %best_order = core.let %order
            %has_best = core.let true
          }
        }
        %missing = core.call intrinsic.not(%has_best)
        core.if %missing {
          core.continue
        }
        %best_key = core.get %best["routeKey"] default ""
        core.set %used[%best_key] = true
        core.append %ranked, %best
      }
      core.return %ranked
    }
  }

  op ax.provider.semantic @provider_routing_stats {
    attr core_kind = "func"
    attr emit_module = "ai"
    tag "provider-routing-runtime"
    type signature = "(providers:list<json>) -> json"
    body @entry(%providers: json) {
      %matrix = core.map
      %functions = core.list
      %streaming = core.list
      %images = core.list
      %audio = core.list
      %files = core.list
      %urls = core.list
      %caching = core.list
      core.for %provider in %providers {
        %name = core.get %provider["name"] default ""
        %features = core.get %provider["features"] default null
        %ok_functions = core.call @provider_features_support(%features, "functions")
        core.if %ok_functions {
          core.append %functions, %name
        }
        %ok_streaming = core.call @provider_features_support(%features, "streaming")
        core.if %ok_streaming {
          core.append %streaming, %name
        }
        %ok_images = core.call @provider_features_support(%features, "images")
        core.if %ok_images {
          core.append %images, %name
        }
        %ok_audio = core.call @provider_features_support(%features, "audio")
        core.if %ok_audio {
          core.append %audio, %name
        }
        %ok_files = core.call @provider_features_support(%features, "files")
        core.if %ok_files {
          core.append %files, %name
        }
        %ok_urls = core.call @provider_features_support(%features, "urls")
        core.if %ok_urls {
          core.append %urls, %name
        }
        %ok_caching = core.call @provider_features_support(%features, "caching")
        core.if %ok_caching {
          core.append %caching, %name
        }
      }
      %functions_count = core.call intrinsic.len(%functions)
      %has_functions = core.call intrinsic.gt(%functions_count, 0)
      core.if %has_functions {
        core.set %matrix["Functions"] = %functions
      }
      %streaming_count = core.call intrinsic.len(%streaming)
      %has_streaming = core.call intrinsic.gt(%streaming_count, 0)
      core.if %has_streaming {
        core.set %matrix["Streaming"] = %streaming
      }
      %images_count = core.call intrinsic.len(%images)
      %has_images = core.call intrinsic.gt(%images_count, 0)
      core.if %has_images {
        core.set %matrix["Images"] = %images
      }
      %audio_count = core.call intrinsic.len(%audio)
      %has_audio = core.call intrinsic.gt(%audio_count, 0)
      core.if %has_audio {
        core.set %matrix["Audio"] = %audio
      }
      %files_count = core.call intrinsic.len(%files)
      %has_files = core.call intrinsic.gt(%files_count, 0)
      core.if %has_files {
        core.set %matrix["Files"] = %files
      }
      %urls_count = core.call intrinsic.len(%urls)
      %has_urls = core.call intrinsic.gt(%urls_count, 0)
      core.if %has_urls {
        core.set %matrix["URLs"] = %urls
      }
      %caching_count = core.call intrinsic.len(%caching)
      %has_caching = core.call intrinsic.gt(%caching_count, 0)
      core.if %has_caching {
        core.set %matrix["Caching"] = %caching
      }
      %first = core.call intrinsic.list.get(%providers, 0, null)
      %recommended = core.get %first["name"] default "None"
      %out = core.map
      %total = core.call intrinsic.len(%providers)
      core.set %out["totalProviders"] = %total
      core.set %out["capabilityMatrix"] = %matrix
      core.set %out["recommendedProvider"] = %recommended
      core.return %out
    }
  }

  op ax.provider.semantic @provider_descriptor {
    attr core_kind = "func"
    attr emit_module = "ai"
    tag "provider-operation-descriptor"
    type signature = "(profile:string) -> json"
    body @entry(%profile: string) {
      %provider_id = core.call @provider_normalize_profile(%profile)
      %descriptors = core.call intrinsic.json.parse(file "data/provider-descriptors.json")
      %empty = core.map
      %descriptor = core.get %descriptors[%provider_id] default %empty
      core.return %descriptor
    }
  }

  op ax.provider.semantic @provider_resolve_descriptor {
    attr core_kind = "func"
    attr emit_module = "ai"
    tag "provider-operation-descriptor"
    tag "axai-vertex-routing"
    type signature = "(profile:string, options?:json) -> json throws"
    body @entry(%profile: string, %options: json) {
      %descriptor = core.call @provider_descriptor(%profile)
      %provider_id = core.call @provider_normalize_profile(%profile)
      %generic_base_snake = core.get %options["base_url"]
      %generic_base_camel = core.get %options["baseUrl"] default %generic_base_snake
      %generic_base = core.get %options["apiURL"] default %generic_base_camel
      %has_generic_base_override = core.call intrinsic.truthy(%generic_base)
      core.if %has_generic_base_override {
        core.set %descriptor["baseUrl"] = %generic_base
      }
      %endpoint_config = core.get %descriptor["endpoint"]
      %has_endpoint_config = core.call intrinsic.truthy(%endpoint_config)
      %no_generic_override = core.call intrinsic.not(%has_generic_base_override)
      %resolve_endpoint = core.call intrinsic.and(%has_endpoint_config, %no_generic_override)
      core.if %resolve_endpoint {
        %field_aliases = core.get %endpoint_config["fields"]
        %field_names = core.call intrinsic.map.keys(%field_aliases)
        %field_defaults = core.get %endpoint_config["defaults"]
        %normalizers = core.get %endpoint_config["normalizers"]
        %field_values = core.map
        core.for %field_name in %field_names {
          %aliases = core.get %field_aliases[%field_name]
          %field_value = core.call intrinsic.none()
          core.for %alias in %aliases {
            %candidate = core.get %options[%alias]
            %has_candidate = core.call intrinsic.truthy(%candidate)
            core.if %has_candidate {
              %field_value = core.let %candidate
            }
          }
          %has_field_value = core.call intrinsic.truthy(%field_value)
          core.if %has_field_value {
          } else {
            %field_value = core.get %field_defaults[%field_name]
          }
          %normalizer = core.get %normalizers[%field_name]
          %api_version_normalizer = core.call intrinsic.eq(%normalizer, "api-version")
          core.if %api_version_normalizer {
            %has_api_version_prefix = core.call intrinsic.string.starts_with(%field_value, "api-version=")
            core.if %has_api_version_prefix {
              %field_value = core.call intrinsic.string.replace(%field_value, "api-version=", "")
            }
          }
          core.set %field_values[%field_name] = %field_value
        }
        %required_fields = core.get %endpoint_config["required"]
        core.for %required_field in %required_fields {
          %required_value = core.get %field_values[%required_field]
          %has_required_value = core.call intrinsic.truthy(%required_value)
          %missing_required_value = core.call intrinsic.not(%has_required_value)
          core.if %missing_required_value {
            %message = core.call intrinsic.string.format("deployment profile {} requires endpoint option {}", %provider_id, %required_field)
            %error = core.call intrinsic.ai.error.unsupported(%message)
            core.raise %error
          }
        }
        %host_field = core.get %endpoint_config["hostField"]
        %host_value = core.get %field_values[%host_field]
        %scheme = core.get %endpoint_config["scheme"] default "https"
        %host_suffix = core.get %endpoint_config["hostSuffix"] default ""
        %host = core.call intrinsic.string.format("{}://{}{}", %scheme, %host_value, %host_suffix)
        %endpoint_path = core.get %endpoint_config["path"] default ""
        core.for %field_name in %field_names {
          %open_brace = core.let "{"
          %close_brace = core.let "}"
          %token = core.call intrinsic.string.format("{}{}{}", %open_brace, %field_name, %close_brace)
          %field_value = core.get %field_values[%field_name]
          %endpoint_path = core.call intrinsic.string.replace(%endpoint_path, %token, %field_value)
        }
        %endpoint_base_url = core.call intrinsic.string.format("{}{}", %host, %endpoint_path)
        core.set %descriptor["baseUrl"] = %endpoint_base_url
        %api_version_field = core.get %endpoint_config["apiVersionField"]
        %has_api_version_field = core.call intrinsic.truthy(%api_version_field)
        core.if %has_api_version_field {
          %api_version = core.get %field_values[%api_version_field]
          core.set %descriptor["apiVersion"] = %api_version
        }
      }
      %project_snake = core.get %options["project_id"]
      %project = core.get %options["projectId"] default %project_snake
      %region = core.get %options["region"]
      %project_present = core.call intrinsic.truthy(%project)
      %region_present = core.call intrinsic.truthy(%region)
      %is_vertex = core.call intrinsic.and(%project_present, %region_present)
      core.if %is_vertex {
        %transport = core.get %descriptor["transport"] default "openai-chat"
        %is_gemini = core.call intrinsic.eq(%transport, "gemini-generate-content")
        %is_anthropic = core.call intrinsic.eq(%transport, "anthropic-messages")
        %vertex_provider = core.call intrinsic.or(%is_gemini, %is_anthropic)
        core.if %vertex_provider {
          %host = core.call @resolve_vertex_ai_host(%region)
          %base_override_snake = core.get %options["base_url"]
          %base_override = core.get %options["baseUrl"] default %base_override_snake
          %has_base_override = core.call intrinsic.truthy(%base_override)
          %base_url = core.let %base_override
          core.if %has_base_override {
          } else {
            %beta = core.get %options["beta"] default false
            %use_beta = core.call intrinsic.truthy(%beta)
            %version = core.let "v1"
            core.if %use_beta {
              %version = core.let "v1beta1"
            }
            %base_url = core.call intrinsic.string.format("https://{}/{}", %host, %version)
          }
          core.set %descriptor["baseUrl"] = %base_url
          core.set %descriptor["auth"] = "bearer"
          core.call intrinsic.map.delete(%descriptor, "apiKeyQuery")
          core.call intrinsic.map.delete(%descriptor, "apiKeyHeader")
          %operations = core.get %descriptor["operations"]
          %resource_parent = core.call intrinsic.string.format("projects/{}/locations/{}", %project, %region)
          %parent = core.call intrinsic.string.format("/{}", %resource_parent)
          core.if %is_gemini {
            %endpoint_snake = core.get %options["endpoint_id"]
            %endpoint = core.get %options["endpointId"] default %endpoint_snake
            %has_endpoint = core.call intrinsic.truthy(%endpoint)
            %model_prefix_raw = core.call intrinsic.string.format("{}/publishers/google/models/MODEL_TOKEN", %parent)
            %model_prefix = core.call intrinsic.string.replace(%model_prefix_raw, "MODEL_TOKEN", "{model}")
            %embed_prefix = core.let %model_prefix
            core.if %has_endpoint {
              %model_prefix = core.call intrinsic.string.format("{}/endpoints/{}", %parent, %endpoint)
              %embed_prefix = core.let %model_prefix
            }
            %chat_path = core.call intrinsic.string.format("{}:generateContent", %model_prefix)
            %stream_path = core.call intrinsic.string.format("{}:streamGenerateContent?alt=sse", %model_prefix)
            %embed_path = core.call intrinsic.string.format("{}:predict", %embed_prefix)
            %chat = core.get %operations["chat"]
            %stream_chat = core.get %operations["stream_chat"]
            %embed = core.get %operations["embed"]
            %transcribe = core.get %operations["transcribe"]
            %speak = core.get %operations["speak"]
            core.set %chat["path"] = %chat_path
            core.set %stream_chat["path"] = %stream_path
            core.set %embed["path"] = %embed_path
            core.set %transcribe["path"] = %chat_path
            core.set %speak["path"] = %chat_path
            %headers = core.map
            core.set %descriptor["headers"] = %headers
            core.set %descriptor["vertex"] = true
            core.set %descriptor["vertexParent"] = %resource_parent
            %cache_base_url = core.call intrinsic.string.format("https://{}/v1", %host)
            core.if %has_base_override {
              %cache_base_url = core.let %base_override
            }
            core.set %descriptor["vertexCacheBaseUrl"] = %cache_base_url
          } else {
            %model_path_raw = core.call intrinsic.string.format("{}/publishers/anthropic/models/MODEL_TOKEN:rawPredict", %parent)
            %model_path = core.call intrinsic.string.replace(%model_path_raw, "MODEL_TOKEN", "{model}")
            %stream_model_path_raw = core.call intrinsic.string.format("{}/publishers/anthropic/models/MODEL_TOKEN:streamRawPredict?alt=sse", %parent)
            %stream_model_path = core.call intrinsic.string.replace(%stream_model_path_raw, "MODEL_TOKEN", "{model}")
            %chat = core.get %operations["chat"]
            %stream_chat = core.get %operations["stream_chat"]
            core.set %chat["path"] = %model_path
            core.set %stream_chat["path"] = %stream_model_path
            %headers = core.map
            core.set %headers["anthropic-beta"] = "web-search-2025-03-05"
            core.set %descriptor["headers"] = %headers
            core.set %descriptor["vertex"] = true
          }
          core.set %descriptor["operations"] = %operations
        }
      }
      core.return %descriptor
    }
  }

  op ax.provider.semantic @resolve_vertex_ai_host {
    attr core_kind = "func"
    attr emit_module = "ai"
    tag "axai-vertex-routing"
    type signature = "(region:string) -> string"
    body @entry(%region: string) {
      %is_global = core.call intrinsic.eq(%region, "global")
      core.if %is_global {
        core.return "aiplatform.googleapis.com"
      }
      %is_us = core.call intrinsic.eq(%region, "us")
      %is_eu = core.call intrinsic.eq(%region, "eu")
      %is_multi = core.call intrinsic.or(%is_us, %is_eu)
      core.if %is_multi {
        %multi_host = core.call intrinsic.string.format("aiplatform.{}.rep.googleapis.com", %region)
        core.return %multi_host
      }
      %regional_host = core.call intrinsic.string.format("{}-aiplatform.googleapis.com", %region)
      core.return %regional_host
    }
  }

  op ax.provider.semantic @provider_operation_descriptor {
    attr core_kind = "func"
    attr emit_module = "ai"
    tag "provider-operation-descriptor"
    type signature = "(profile:string, operation:string) -> json throws"
    body @entry(%profile: string, %operation: string) {
      %descriptor = core.call @provider_descriptor(%profile)
      %operations = core.get %descriptor["operations"]
      %operation_desc = core.get %operations[%operation]
      %missing = core.call intrinsic.is_none(%operation_desc)
      core.if %missing {
        %message = core.call intrinsic.string.format("provider operation is not supported: {}", %operation)
        %error = core.call intrinsic.ai.error.unsupported(%message)
        core.raise %error
      }
      core.return %operation_desc
    }
  }

  op ax.provider.semantic @provider_resolve_operation_descriptor {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "ai"
    tag "provider-operation-descriptor"
    tag "axai-vertex-routing"
    type signature = "(profile:string, operation:string, options?:json) -> json throws"
    body @entry(%profile: string, %operation: string, %options: json) {
      %descriptor = core.call @provider_resolve_descriptor(%profile, %options)
      %operations = core.get %descriptor["operations"]
      %operation_desc = core.get %operations[%operation]
      %missing = core.call intrinsic.is_none(%operation_desc)
      core.if %missing {
        %message = core.call intrinsic.string.format("provider operation is not supported: {}", %operation)
        %error = core.call intrinsic.ai.error.unsupported(%message)
        core.raise %error
      }
      core.return %operation_desc
    }
  }

  op ax.provider.semantic @provider_realtime_audio_descriptor {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "ai"
    attr private = true
    tag "provider-realtime-audio-descriptor"
    type signature = "(profile:string) -> json throws"
    body @entry(%profile: string) {
      %operation = core.call @provider_operation_descriptor(%profile, "realtime")
      core.return %operation
    }
  }

  op ax.provider.semantic @provider_realtime_ws_url {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "ai"
    tag "provider-realtime-audio-operation"
    type signature = "(profile:string, model:string, api_key:string) -> json throws"
    body @entry(%profile: string, %model: string, %api_key: string) {
      %descriptor = core.call @provider_realtime_audio_descriptor(%profile)
      %grammar = core.get %descriptor["grammar"] default "openai_realtime_compatible"
      %base = core.get %descriptor["url"] default ""
      %out = core.map
      %headers = core.map
      %is_gemini = core.call intrinsic.eq(%grammar, "gemini_live_bidi")
      core.if %is_gemini {
        %gemini_url = core.call intrinsic.string.format("{}?key={}", %base, %api_key)
        core.set %out["url"] = %gemini_url
        core.set %out["headers"] = %headers
        core.return %out
      }
      %openai_url = core.call intrinsic.string.format("{}?model={}", %base, %model)
      %auth = core.call intrinsic.string.format("Bearer {}", %api_key)
      core.set %headers["Authorization"] = %auth
      core.set %out["url"] = %openai_url
      core.set %out["headers"] = %headers
      core.return %out
    }
  }

  op ax.provider.semantic @provider_should_use_realtime {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "ai"
    tag "provider-realtime-audio-operation"
    type signature = "(profile:string, model:string, request:json, options?:json) -> bool throws"
    body @entry(%profile: string, %model: string, %request: json, %options: json) {
      %descriptor = core.call @provider_resolve_descriptor(%profile, %options)
      %operations = core.get %descriptor["operations"]
      %realtime_op = core.get %operations["realtime"]
      %has_realtime = core.call intrinsic.is_not_none(%realtime_op)
      %empty_match = core.map
      %model_match = core.get %realtime_op["modelMatch"] default %empty_match
      %has_model_match = core.call intrinsic.truthy(%model_match)
      %matches_model = core.let true
      core.if %has_model_match {
        %matches_model = core.call @provider_model_matches(%model_match, %model)
      }
      %audio = core.get %request["audio"]
      %output = core.get %audio["output"]
      %enabled = core.get %output["enabled"]
      %explicitly_disabled = core.call intrinsic.eq(%enabled, false)
      %audio_ok = core.call intrinsic.not(%explicitly_disabled)
      %operation_matches = core.call intrinsic.and(%has_realtime, %matches_model)
      %result = core.call intrinsic.and(%operation_matches, %audio_ok)
      core.if %result {
        %grammar = core.get %realtime_op["grammar"] default ""
        %is_gemini_live = core.call intrinsic.eq(%grammar, "gemini_live_bidi")
        core.if %is_gemini_live {
          %is_vertex = core.get %descriptor["vertex"] default false
          %service_tier = core.call @gemini_service_tier_impl(%request, %options, %is_vertex, true)
        }
      }
      core.return %result
    }
  }

  op ax.provider.semantic @provider_build_realtime_audio_setup {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "ai"
    tag "provider-realtime-audio-operation"
    type signature = "(profile:string, request:json, options?:json) -> json throws"
    body @entry(%profile: string, %request: json, %options: json) {
      %descriptor = core.call @provider_resolve_descriptor(%profile, %options)
      %is_vertex = core.get %descriptor["vertex"] default false
      %operations = core.get %descriptor["operations"]
      %descriptor = core.get %operations["realtime"]
      %grammar = core.get %descriptor["grammar"] default "openai_realtime_compatible"
      %is_gemini_live = core.call intrinsic.eq(%grammar, "gemini_live_bidi")
      core.if %is_gemini_live {
        %service_tier = core.call @gemini_service_tier_impl(%request, %options, %is_vertex, true)
        %setup = core.call @gemini_live_bidi_build_setup(%descriptor, %request)
        core.return %setup
      }
      %openai_setup = core.call @openai_realtime_compatible_build_setup(%descriptor, %request)
      core.return %openai_setup
    }
  }

  op ax.provider.semantic @provider_build_realtime_audio_input {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "ai"
    tag "provider-realtime-audio-operation"
    type signature = "(profile:string, request:json) -> list<json> throws"
    body @entry(%profile: string, %request: json) {
      %descriptor = core.call @provider_realtime_audio_descriptor(%profile)
      %grammar = core.get %descriptor["grammar"] default "openai_realtime_compatible"
      %is_gemini_live = core.call intrinsic.eq(%grammar, "gemini_live_bidi")
      core.if %is_gemini_live {
        %input = core.call @gemini_live_bidi_build_input(%descriptor, %request)
        core.return %input
      }
      %openai_input = core.call @openai_realtime_compatible_build_input(%descriptor, %request)
      core.return %openai_input
    }
  }

  op ax.provider.semantic @openai_realtime_compatible_build_setup {
    attr core_kind = "func"
    attr emit_module = "ai"
    attr private = true
    tag "openai-compatible-realtime-audio-core-helper"
