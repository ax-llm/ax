  op ax.provider.semantic @openai_build_chat_request {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "ai"
    ref generic = @build_chat_request
    tag "src/ax/ai/openai/api.ts"
    type signature = "(AxChatRequest, options?:json, prompt_caching?:bool) -> json throws"
    body @entry(%request: AxChatRequest, %options: json, %prompt_caching: bool) {
      %payload = core.call @openai_build_chat_request_impl(%request, %options, %prompt_caching, "none", "none")
      core.return %payload
    }
  }

  op ax.provider.semantic @openai_build_chat_request_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "ai"
    attr private = true
    tag "openai-chat-request-compatibility-helper"
    type signature = "(AxChatRequest, json, bool, string, string) -> json throws"
    body @entry(%request: AxChatRequest, %options: json, %prompt_caching: bool, %reasoning_content_mode: string, %reasoning_details_mode: string) {
      %payload = core.map
      %model = core.get %request["model"]
      core.set %payload["model"] = %model
      %messages = core.list
      %chat_prompt = core.get %request["chat_prompt"]
      %message_count = core.call intrinsic.len(%chat_prompt)
      %last_index = core.call intrinsic.add(%message_count, -1)
      %has_context_cache_snake = core.call intrinsic.map.contains(%options, "context_cache")
      %has_context_cache_camel = core.call intrinsic.map.contains(%options, "contextCache")
      %has_context_cache = core.call intrinsic.or(%has_context_cache_snake, %has_context_cache_camel)
      %has_cache_flag = core.let false
      core.for %raw_message in %chat_prompt {
        %raw_cache = core.get %raw_message["cache"] default false
        %has_cache_flag = core.call intrinsic.or(%has_cache_flag, %raw_cache)
      }
      %empty_functions_for_cache = core.list
      %functions_for_cache = core.get %request["functions"] default %empty_functions_for_cache
      core.for %cache_fn in %functions_for_cache {
        %fn_cache = core.get %cache_fn["cache"] default false
        %has_cache_flag = core.call intrinsic.or(%has_cache_flag, %fn_cache)
      }
      %cache_requested = core.call intrinsic.or(%has_context_cache, %has_cache_flag)
      %is_gpt_56_base = core.call intrinsic.eq(%model, "gpt-5.6")
      %is_gpt_56_tier = core.call intrinsic.string.starts_with(%model, "gpt-5.6-")
      %is_gpt_56 = core.call intrinsic.or(%is_gpt_56_base, %is_gpt_56_tier)
      %cache_provider_and_model = core.call intrinsic.and(%prompt_caching, %is_gpt_56)
      %cache_enabled = core.call intrinsic.and(%cache_provider_and_model, %cache_requested)
      %message_index = core.const 0
      %marker_count = core.const 0
      core.for %message in %chat_prompt {
        %provider_message = core.call @openai_message_impl(%message, %reasoning_content_mode, %reasoning_details_mode)
        core.if %cache_enabled {
          %is_before_last = core.call intrinsic.lt(%message_index, %last_index)
          %explicit_cache = core.get %message["cache"] default false
          %should_mark = core.call intrinsic.or(%is_before_last, %explicit_cache)
          core.if %should_mark {
            %marked = core.call @openai_apply_cache_breakpoint_impl(%provider_message)
            %provider_message = core.get %marked["message"] default %provider_message
            %marker_added = core.get %marked["marked"] default false
            core.if %marker_added {
              %marker_count = core.call intrinsic.add(%marker_count, 1)
            }
          }
        }
        core.append %messages, %provider_message
        %message_index = core.call intrinsic.add(%message_index, 1)
      }
      core.set %payload["messages"] = %messages
      %empty_functions = core.list
      %functions = core.get %request["functions"] default %empty_functions
      %has_functions = core.call intrinsic.truthy(%functions)
      core.if %has_functions {
        %tools = core.list
        core.for %fn in %functions {
          %tool = core.call @openai_tool_spec_impl(%fn)
          core.append %tools, %tool
        }
        core.set %payload["tools"] = %tools
        %tool_choice = core.get %request["function_call"] default "auto"
        core.set %payload["tool_choice"] = %tool_choice
      }
      %response_format = core.get %request["response_format"]
      %has_response_format = core.call intrinsic.truthy(%response_format)
      core.if %has_response_format {
        %response_format_type = core.get %response_format["type"]
        %is_json_object = core.call intrinsic.eq(%response_format_type, "json_object")
        core.if %is_json_object {
          %json_mode_message = core.map
          core.set %json_mode_message["role"] = "system"
          core.set %json_mode_message["content"] = "JSON output is required. Return only the requested JSON object."
          core.append %messages, %json_mode_message
          core.set %payload["messages"] = %messages
        }
        %is_json_schema = core.call intrinsic.eq(%response_format_type, "json_schema")
        core.if %is_json_schema {
          %json_schema_format = core.map
          %schema = core.get %response_format["schema"]
          core.set %json_schema_format["type"] = "json_schema"
          core.set %json_schema_format["json_schema"] = %schema
          core.set %payload["response_format"] = %json_schema_format
        } else {
          core.set %payload["response_format"] = %response_format
        }
      }
      %model_config = core.get %request["model_config"]
      core.call @openai_apply_model_config_impl(%payload, %model_config)
      core.if %cache_enabled {
        %has_markers = core.call intrinsic.gt(%marker_count, 0)
        core.if %has_markers {
          %prompt_cache_options = core.map
          core.set %prompt_cache_options["mode"] = "explicit"
          core.set %payload["prompt_cache_options"] = %prompt_cache_options
        }
        %prompt_key_snake = core.get %options["prompt_cache_key"]
        %prompt_key = core.get %options["promptCacheKey"] default %prompt_key_snake
        %session_snake = core.get %options["session_id"]
        %session = core.get %options["sessionId"] default %session_snake
        %resolved_key = core.call intrinsic.coalesce(%prompt_key, %session)
        %has_resolved_key = core.call intrinsic.truthy(%resolved_key)
        core.if %has_resolved_key {
          core.set %payload["prompt_cache_key"] = %resolved_key
        }
      }
      core.return %payload
    }
  }

  op ax.provider.semantic @openai_apply_cache_breakpoint_impl {
    attr core_kind = "func"
    attr emit_module = "ai"
    attr private = true
    tag "openai-prompt-cache-breakpoint-core-helper"
    type signature = "(json) -> json"
    body @entry(%message: json) {
      %out = core.map
      core.set %out["message"] = %message
      core.set %out["marked"] = false
      %content = core.get %message["content"]
      %content_is_string = core.type_is %content type "string"
      core.if %content_is_string {
        %content_length = core.call intrinsic.len(%content)
        %has_content = core.call intrinsic.gt(%content_length, 0)
        core.if %has_content {
          %breakpoint = core.map
          core.set %breakpoint["mode"] = "explicit"
          %part = core.map
          core.set %part["type"] = "text"
          core.set %part["text"] = %content
          core.set %part["prompt_cache_breakpoint"] = %breakpoint
          %parts = core.list
          core.append %parts, %part
          %copy_seed = core.map
          %message_copy = core.call intrinsic.map.merge(%message, %copy_seed)
          core.set %message_copy["content"] = %parts
          core.set %out["message"] = %message_copy
          core.set %out["marked"] = true
        }
        core.return %out
      }
      %content_is_list = core.type_is %content type "list"
      core.if %content_is_list {
        %part_count = core.call intrinsic.len(%content)
        %has_parts = core.call intrinsic.gt(%part_count, 0)
        core.if %has_parts {
          %last_part_index = core.call intrinsic.add(%part_count, -1)
          %part_index = core.const 0
          %parts = core.list
          core.for %content_part in %content {
            %is_last_part = core.call intrinsic.eq(%part_index, %last_part_index)
            core.if %is_last_part {
              %part_seed = core.map
              %part_copy = core.call intrinsic.map.merge(%content_part, %part_seed)
              %breakpoint = core.map
              core.set %breakpoint["mode"] = "explicit"
              core.set %part_copy["prompt_cache_breakpoint"] = %breakpoint
              core.append %parts, %part_copy
            } else {
              core.append %parts, %content_part
            }
            %part_index = core.call intrinsic.add(%part_index, 1)
          }
          %message_seed = core.map
          %message_copy = core.call intrinsic.map.merge(%message, %message_seed)
          core.set %message_copy["content"] = %parts
          core.set %out["message"] = %message_copy
          core.set %out["marked"] = true
        }
      }
      core.return %out
    }
  }

  op ax.provider.semantic @openai_apply_model_config_impl {
    attr core_kind = "func"
    attr emit_module = "ai"
    attr private = true
    tag "openai-model-config-core-helper"
    type signature = "(json, json) -> void"
    body @entry(%payload: json, %model_config: json) {
      core.call @openai_copy_config_key_impl(%payload, %model_config, "max_tokens", "max_completion_tokens")
      core.call @openai_copy_config_key_impl(%payload, %model_config, "maxTokens", "max_completion_tokens")
      core.call @openai_copy_config_key_impl(%payload, %model_config, "temperature", "temperature")
      core.call @openai_copy_config_key_impl(%payload, %model_config, "top_p", "top_p")
      core.call @openai_copy_config_key_impl(%payload, %model_config, "topP", "top_p")
      core.call @openai_copy_config_key_impl(%payload, %model_config, "n", "n")
      core.call @openai_copy_config_key_impl(%payload, %model_config, "presence_penalty", "presence_penalty")
      core.call @openai_copy_config_key_impl(%payload, %model_config, "presencePenalty", "presence_penalty")
      core.call @openai_copy_config_key_impl(%payload, %model_config, "frequency_penalty", "frequency_penalty")
      core.call @openai_copy_config_key_impl(%payload, %model_config, "frequencyPenalty", "frequency_penalty")
      core.call @openai_copy_config_key_impl(%payload, %model_config, "reasoning_effort", "reasoning_effort")
      core.call @openai_copy_config_key_impl(%payload, %model_config, "reasoningEffort", "reasoning_effort")
      %budget_snake = core.get %model_config["thinking_token_budget"]
      %budget = core.get %model_config["thinkingTokenBudget"] default %budget_snake
      %has_budget = core.call intrinsic.is_not_none(%budget)
      core.if %has_budget {
        %model = core.get %payload["model"] default ""
        %effort = core.call @openai_chat_reasoning_effort(%model, %budget)
        %has_effort = core.call intrinsic.is_not_none(%effort)
        core.if %has_effort {
          core.set %payload["reasoning_effort"] = %effort
        } else {
          core.call intrinsic.map.delete(%payload, "reasoning_effort")
        }
      }
      %stop_snake = core.get %model_config["stop_sequences"]
      %stop = core.get %model_config["stopSequences"] default %stop_snake
      %has_stop = core.call intrinsic.truthy(%stop)
      core.if %has_stop {
        core.set %payload["stop"] = %stop
      }
      %stream = core.get %model_config["stream"]
      %is_stream = core.call intrinsic.truthy(%stream)
      core.if %is_stream {
        core.set %payload["stream"] = true
        %stream_options = core.map
        core.set %stream_options["include_usage"] = true
        core.set %payload["stream_options"] = %stream_options
      }
      core.return
    }
  }

  op ax.provider.semantic @openai_reasoning_effort {
    attr core_kind = "func"
    attr emit_module = "ai"
    tag "openai-reasoning-effort"
    type signature = "(model:string, budget:json) -> json"
    body @entry(%model: string, %budget: json) {
      %is_gpt56_alias = core.call intrinsic.eq(%model, "gpt-5.6")
      %is_gpt56_suffix = core.call intrinsic.string.starts_with(%model, "gpt-5.6-")
      %is_gpt56 = core.call intrinsic.or(%is_gpt56_alias, %is_gpt56_suffix)
      %is_none = core.call intrinsic.eq(%budget, "none")
      core.if %is_none {
        core.if %is_gpt56 {
          core.return "none"
        }
        %none = core.call intrinsic.none()
        core.return %none
      }
      %is_minimal = core.call intrinsic.eq(%budget, "minimal")
      %is_low = core.call intrinsic.eq(%budget, "low")
      %is_medium = core.call intrinsic.eq(%budget, "medium")
      %is_highest = core.call intrinsic.eq(%budget, "highest")
      core.if %is_gpt56 {
        core.if %is_minimal {
          core.return "low"
        }
        core.if %is_low {
          core.return "low"
        }
        core.if %is_medium {
          core.return "medium"
        }
        core.if %is_highest {
          core.return "max"
        }
        core.return "high"
      }
      core.if %is_minimal {
        core.return "minimal"
      }
      core.if %is_low {
        core.return "medium"
      }
      core.if %is_highest {
        core.return "xhigh"
      }
      core.return "high"
    }
  }

  op ax.provider.semantic @openai_chat_reasoning_effort {
    attr core_kind = "func"
    attr emit_module = "ai"
    tag "openai-chat-reasoning-effort"
    type signature = "(model:string, budget:json) -> json"
    body @entry(%model: string, %budget: json) {
      %effort = core.call @openai_reasoning_effort(%model, %budget)
      %is_max = core.call intrinsic.eq(%effort, "max")
      core.if %is_max {
        core.return "xhigh"
      }
      core.return %effort
    }
  }

  op ax.provider.semantic @openai_copy_config_key_impl {
    attr core_kind = "func"
    attr emit_module = "ai"
    attr private = true
    tag "openai-config-copy-core-helper"
    type signature = "(json, json, string, string) -> void"
    body @entry(%payload: json, %model_config: json, %source: string, %target: string) {
      %has_source = core.call intrinsic.map.contains(%model_config, %source)
      core.if %has_source {
        %value = core.get %model_config[%source]
        core.set %payload[%target] = %value
      }
      core.return
    }
  }

  op ax.provider.semantic @openai_message_impl {
    attr core_kind = "func"
    attr emit_module = "ai"
    attr private = true
    tag "openai-message-core-helper"
    type signature = "(json, reasoning_content_mode:string, reasoning_details_mode:string) -> json throws"
    body @entry(%message: json, %reasoning_content_mode: string, %reasoning_details_mode: string) {
      %role = core.get %message["role"]
      %content = core.get %message["content"] default ""
      %is_no_reasoning = core.call intrinsic.eq(%reasoning_content_mode, "none")
      %has_reasoning_mode = core.call intrinsic.not(%is_no_reasoning)
      %is_system = core.call intrinsic.eq(%role, "system")
      core.if %is_system {
        %out = core.map
        core.set %out["role"] = "system"
        core.set %out["content"] = %content
        core.return %out
      }
      %is_user = core.call intrinsic.eq(%role, "user")
      core.if %is_user {
        %content_is_list = core.type_is %content type "list"
        core.if %content_is_list {
          %parts = core.list
          core.for %part in %content {
            %provider_part = core.call @openai_content_part_impl(%part)
            core.append %parts, %provider_part
          }
          %content = core.let %parts
        }
        %out = core.map
        core.set %out["role"] = "user"
        core.set %out["content"] = %content
        %name = core.get %message["name"]
        %has_name = core.call intrinsic.truthy(%name)
        core.if %has_name {
          core.set %out["name"] = %name
        }
        core.return %out
      }
      %is_assistant = core.call intrinsic.eq(%role, "assistant")
      core.if %is_assistant {
        %thought = core.get %message["thought"]
        %has_thought = core.call intrinsic.truthy(%thought)
        %include_thought = core.call intrinsic.and(%has_reasoning_mode, %has_thought)
        %empty_calls = core.list
        %calls_snake = core.get %message["function_calls"] default %empty_calls
        %calls = core.get %message["functionCalls"] default %calls_snake
        %has_calls = core.call intrinsic.truthy(%calls)
        %out = core.map
        core.set %out["role"] = "assistant"
        core.if %include_thought {
          core.set %out[%reasoning_content_mode] = %thought
        }
        %is_no_details = core.call intrinsic.eq(%reasoning_details_mode, "none")
        %has_details_mode = core.call intrinsic.not(%is_no_details)
        %empty_thought_blocks = core.list
        %thought_blocks_snake = core.get %message["thought_blocks"] default %empty_thought_blocks
        %thought_blocks = core.get %message["thoughtBlocks"] default %thought_blocks_snake
        %has_thought_blocks = core.call intrinsic.truthy(%thought_blocks)
        %include_details = core.call intrinsic.and(%has_details_mode, %has_thought_blocks)
        core.if %include_details {
          %details = core.list
          core.for %thought_block in %thought_blocks {
            %data = core.get %thought_block["data"]
            core.try {
              %detail = core.call intrinsic.json.parse(%data)
              core.append %details, %detail
            } catch %parse_error {
            }
          }
          %has_details = core.call intrinsic.truthy(%details)
          core.if %has_details {
            core.set %out[%reasoning_details_mode] = %details
          }
        }
        core.if %has_calls {
          %assistant_content = core.get %message["content"]
          %has_assistant_content = core.call intrinsic.is_not_none(%assistant_content)
          core.if %has_reasoning_mode {
            %reasoning_message_content = core.get %message["content"] default ""
            core.set %out["content"] = %reasoning_message_content
          } else {
            core.if %has_assistant_content {
              core.set %out["content"] = %assistant_content
            }
          }
          %tool_calls = core.list
          core.for %call in %calls {
            %provider_call = core.call @openai_tool_call_to_provider_impl(%call)
            core.append %tool_calls, %provider_call
          }
          core.set %out["tool_calls"] = %tool_calls
        } else {
          core.set %out["content"] = %content
        }
        core.return %out
      }
      %is_function = core.call intrinsic.eq(%role, "function")
      core.if %is_function {
        %out = core.map
        %result = core.get %message["result"] default ""
        %function_id_snake = core.get %message["function_id"]
        %function_id = core.get %message["functionId"] default %function_id_snake
        core.set %out["role"] = "tool"
        core.set %out["content"] = %result
        core.set %out["tool_call_id"] = %function_id
        core.return %out
      }
      %message_text = core.call intrinsic.string.format("Invalid role: {}", %role)
      %error = core.call intrinsic.ai.error.response(%message_text)
      core.raise %error
    }
  }

  op ax.provider.semantic @openai_content_part_impl {
    attr core_kind = "func"
    attr emit_module = "ai"
    attr private = true
    tag "openai-content-part-core-helper"
    type signature = "(json) -> json throws"
    body @entry(%part: json) {
      %type = core.get %part["type"]
      %is_text = core.call intrinsic.eq(%type, "text")
      core.if %is_text {
        %text = core.get %part["text"] default ""
        %out = core.map
        core.set %out["type"] = "text"
        core.set %out["text"] = %text
        core.return %out
      }
      %is_image = core.call intrinsic.eq(%type, "image")
      core.if %is_image {
        %mime_snake = core.get %part["mime_type"]
        %mime_raw = core.get %part["mimeType"] default %mime_snake
        %mime = core.call intrinsic.coalesce(%mime_raw, "image/png")
        %image_value = core.get %part["image"]
        %image_raw = core.get %part["data"] default %image_value
        %image = core.call intrinsic.coalesce(%image_raw, "")
        %is_data_url = core.call intrinsic.string.starts_with(%image, "data:")
        %url = core.const ""
        core.if %is_data_url {
          %url = core.let %image
        } else {
          %url = core.call intrinsic.string.format("data:{};base64,{}", %mime, %image)
        }
        %details = core.get %part["details"] default "auto"
        %image_url = core.map
        core.set %image_url["url"] = %url
        core.set %image_url["detail"] = %details
        %out = core.map
        core.set %out["type"] = "image_url"
        core.set %out["image_url"] = %image_url
        core.return %out
      }
      %is_audio = core.call intrinsic.eq(%type, "audio")
      core.if %is_audio {
        %audio_alt = core.get %part["audio"]
        %data = core.get %part["data"] default %audio_alt
        %format = core.get %part["format"]
        %is_wav = core.call intrinsic.eq(%format, "wav")
        %is_mp3 = core.call intrinsic.eq(%format, "mp3")
        %format_ok = core.call intrinsic.or(%is_wav, %is_mp3)
        core.if %format_ok {
          %out = core.map
          core.set %out["type"] = "input_audio"
          %input_audio = core.map
          core.set %input_audio["data"] = %data
          core.set %input_audio["format"] = %format
          core.set %out["input_audio"] = %input_audio
          core.return %out
        }
        %audio_message = core.call intrinsic.string.format("OpenAI audio chat input supports only wav and mp3 audio, received {}", %format)
        %audio_error = core.call intrinsic.ai.error.unsupported(%audio_message)
        core.raise %audio_error
      }
      %message = core.call intrinsic.string.format("OpenAI-compatible beta does not support content part type: {}", %type)
      %error = core.call intrinsic.ai.error.unsupported(%message)
      core.raise %error
    }
  }

  op ax.provider.semantic @openai_tool_call_to_provider_impl {
    attr core_kind = "func"
    attr emit_module = "ai"
    attr private = true
    tag "openai-tool-call-provider-core-helper"
    type signature = "(json) -> json"
    body @entry(%call: json) {
      %fn = core.get %call["function"]
      %params = core.get %fn["params"]
      %params_is_string = core.type_is %params type "string"
      core.if %params_is_string {
      } else {
        %params_json = core.call intrinsic.json.stringify(%params)
        %params = core.let %params_json
      }
      %id = core.get %call["id"]
      %name = core.get %fn["name"]
      %function = core.map
      core.set %function["name"] = %name
      core.set %function["arguments"] = %params
      %out = core.map
      core.set %out["id"] = %id
      core.set %out["type"] = "function"
      core.set %out["function"] = %function
