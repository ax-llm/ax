      %auto_truncate = core.get %options["autoTruncate"] default %auto_truncate_snake
      %has_auto_truncate = core.call intrinsic.is_not_none(%auto_truncate)
      core.if %has_auto_truncate {
        core.set %parameters["autoTruncate"] = %auto_truncate
      }
      %dimensions = core.get %request["dimensions"]
