      %parts = core.list
      %request_file = core.get %request["file"]
      %audio = core.get %request["audio"] default %request_file
      %mime_type_raw = core.get %audio["mimeType"]
      %mime_type = core.get %audio["mime_type"] default %mime_type_raw
      %has_mime = core.call intrinsic.is_not_none(%mime_type)
      core.if %has_mime {
      } else {
        %mime_type = core.let "audio/wav"
      }
      %data = core.get %audio["data"] default %audio
      %inline_data = core.map
      core.set %inline_data["mimeType"] = %mime_type
      core.set %inline_data["data"] = %data
      %audio_part = core.map
      core.set %audio_part["inlineData"] = %inline_data
      core.append %parts, %audio_part
      %prompt = core.get %request["prompt"] default "Generate a transcript of the speech in this audio."
      %text_part = core.map
      core.set %text_part["text"] = %prompt
      core.append %parts, %text_part
      core.set %turn["parts"] = %parts
      core.append %contents, %turn
      core.set %payload["contents"] = %contents
      core.return %payload
    }
  }

  op ax.provider.semantic @gemini_build_speak_request {
    attr core_kind = "func"
    attr emit_module = "ai"
    attr private = true
    tag "src/ax/ai/google-gemini/api.ts"
    type signature = "(json) -> json"
    body @entry(%request: json) {
      %payload = core.map
      %contents = core.list
      %turn = core.map
      core.set %turn["role"] = "user"
      %parts = core.list
