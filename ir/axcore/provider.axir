  op ax.provider.semantic @provider_reasoning_replay_field {
    attr core_kind = "func"
    attr emit_module = "ai"
    attr private = true
    tag "provider-profile-reasoning-replay"
    type signature = "(profile:string, model:string) -> string"
    body @entry(%profile: string, %model: string) {
      %rule = core.call @provider_resolve_model_rule(%profile, %model)
      %empty_replay = core.map
      %replay = core.get %rule["replay"] default %empty_replay
      %response_field = core.call @provider_reasoning_field(%profile, %model)
      %field = core.get %replay["assistantReasoningField"] default %response_field
      core.return %field
    }
  }

  op ax.provider.semantic @provider_reasoning_details_replay_field {
    attr core_kind = "func"
    attr emit_module = "ai"
    attr private = true
    tag "provider-profile-reasoning-replay"
    type signature = "(profile:string, model:string) -> string"
    body @entry(%profile: string, %model: string) {
      %rule = core.call @provider_resolve_model_rule(%profile, %model)
      %empty_replay = core.map
      %replay = core.get %rule["replay"] default %empty_replay
      %response_field = core.call @provider_reasoning_details_field(%profile, %model)
      %field = core.get %replay["assistantReasoningDetailsField"] default %response_field
      core.return %field
    }
  }

  op ax.provider.semantic @provider_apply_request_rules {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "ai"
    attr private = true
    tag "provider-profile-request-transforms"
    type signature = "(payload:json, request:json, rules:json) -> json throws"
    body @entry(%payload: json, %request: json, %rules: json) {
      %empty_map = core.map
      %empty_list = core.list
      %model_config = core.get %request["model_config"] default %empty_map
      %budget_snake = core.get %model_config["thinking_token_budget"]
      %budget = core.get %model_config["thinkingTokenBudget"] default %budget_snake
      %payload_effort = core.get %payload["reasoning_effort"]
      %configured_effort = core.call intrinsic.coalesce(%budget, %payload_effort)
      %default_thinking_level = core.get %rules["defaultThinkingLevel"]
      %requested_effort = core.call intrinsic.coalesce(%configured_effort, %default_thinking_level)
      %unsupported_thinking_levels = core.get %rules["unsupportedThinkingLevels"] default %empty_map
      %unsupported_thinking_level = core.call intrinsic.map.contains(%unsupported_thinking_levels, %requested_effort)
      core.if %unsupported_thinking_level {
        %unsupported_thinking_message = core.get %unsupported_thinking_levels[%requested_effort]
        %unsupported_thinking_error = core.call intrinsic.ai.error.unsupported(%unsupported_thinking_message)
        core.raise %unsupported_thinking_error
      }
      %effort_map = core.get %rules["effortMap"] default %empty_map
      %has_requested_effort = core.call intrinsic.is_not_none(%requested_effort)
      %has_effort_mapping = core.call intrinsic.map.contains(%effort_map, %requested_effort)
      %mapped_effort = core.get %effort_map[%requested_effort]
      %effective_effort = core.let %requested_effort
      core.if %has_effort_mapping {
        %effective_effort = core.let %mapped_effort
        %mapped_is_none = core.call intrinsic.is_none(%mapped_effort)
        core.if %mapped_is_none {
          core.call intrinsic.map.delete(%payload, "reasoning_effort")
        } else {
          core.set %payload["reasoning_effort"] = %mapped_effort
        }
      }
      %effective_is_none_value = core.call intrinsic.eq(%effective_effort, "none")
      %effective_is_missing = core.call intrinsic.is_none(%effective_effort)
      %effective_is_present = core.call intrinsic.not(%effective_is_missing)
      %effective_disabled = core.call intrinsic.or(%effective_is_none_value, %effective_is_missing)
      %effective_enabled = core.call intrinsic.not(%effective_disabled)
      %has_reasoning = core.call intrinsic.and(%has_requested_effort, %effective_enabled)
      %has_serializable_reasoning_effort = core.call intrinsic.and(%has_requested_effort, %effective_is_present)
      %thinking_boolean = core.get %rules["thinkingBoolean"] default %empty_map
      %thinking_boolean_path = core.get %thinking_boolean["path"] default %empty_list
      %has_thinking_boolean = core.call intrinsic.truthy(%thinking_boolean_path)
      core.if %has_thinking_boolean {
        %thinking_object_name = core.call intrinsic.list.get(%thinking_boolean_path, 0, "")
        %thinking_field_name = core.call intrinsic.list.get(%thinking_boolean_path, 1, "")
        %thinking_nested = core.get %payload[%thinking_object_name] default %empty_map
        %thinking_nested_copy = core.call intrinsic.map.merge(%empty_map, %thinking_nested)
        core.set %thinking_nested_copy[%thinking_field_name] = %effective_enabled
        core.set %payload[%thinking_object_name] = %thinking_nested_copy
      }
      %reasoning_mode = core.get %rules["reasoning"] default ""
      %is_thinking_object_mode = core.call intrinsic.eq(%reasoning_mode, "thinking-object")
      core.if %is_thinking_object_mode {
        %thinking = core.map
        core.if %has_reasoning {
          core.set %thinking["type"] = "enabled"
        } else {
          core.set %thinking["type"] = "disabled"
        }
        core.set %payload["thinking"] = %thinking
      }
      %is_openrouter_mode = core.call intrinsic.eq(%reasoning_mode, "openrouter")
      core.if %is_openrouter_mode {
        core.if %has_serializable_reasoning_effort {
          %reasoning = core.map
          %effort = core.get %payload["reasoning_effort"] default %requested_effort
          core.set %reasoning["effort"] = %effort
          core.set %payload["reasoning"] = %reasoning
        }
        core.call intrinsic.map.delete(%payload, "reasoning_effort")
      }
      %tool_choice_mode = core.get %rules["toolChoice"] default ""
      %unforced = core.call intrinsic.eq(%tool_choice_mode, "unforced")
      core.if %unforced {
        %tool_choice = core.get %payload["tool_choice"]
        %choice_none = core.call intrinsic.eq(%tool_choice, "none")
        core.if %choice_none {
          core.call intrinsic.map.delete(%payload, "tools")
        }
        %choice_required = core.call intrinsic.eq(%tool_choice, "required")
        %choice_is_object = core.type_is %tool_choice type "object"
        %ax_generated = core.let false
        core.if %choice_is_object {
          %choice_function = core.get %tool_choice["function"] default %empty_map
          %choice_name = core.get %choice_function["name"] default ""
          %ax_generated = core.call intrinsic.eq(%choice_name, "__axOutput")
        }
        %not_ax_generated = core.call intrinsic.not(%ax_generated)
        %object_not_ax = core.call intrinsic.and(%choice_is_object, %not_ax_generated)
        %caller_forced = core.call intrinsic.or(%choice_required, %object_not_ax)
        core.if %caller_forced {
          %error = core.call intrinsic.ai.error.unsupported("deployment profile does not support explicitly forced tool choices")
          core.raise %error
        }
        core.call intrinsic.map.delete(%payload, "tool_choice")
      }
      %drop_when_thinking = core.get %rules["dropWhenThinking"] default %empty_list
      core.if %has_reasoning {
        core.for %field in %drop_when_thinking {
          core.call intrinsic.map.delete(%payload, %field)
        }
      }
      %drop_fields = core.get %rules["dropFields"] default %empty_list
      core.for %field in %drop_fields {
        core.call intrinsic.map.delete(%payload, %field)
      }
      %copy_fields = core.get %rules["copyFields"] default %empty_map
      %copy_keys = core.call intrinsic.map.keys(%copy_fields)
      core.for %source in %copy_keys {
        %has_source = core.call intrinsic.map.contains(%payload, %source)
        core.if %has_source {
          %target = core.get %copy_fields[%source]
          %value = core.get %payload[%source]
          core.set %payload[%target] = %value
        }
      }
      %rename_fields = core.get %rules["renameFields"] default %empty_map
      %rename_keys = core.call intrinsic.map.keys(%rename_fields)
      core.for %source in %rename_keys {
        %has_source = core.call intrinsic.map.contains(%payload, %source)
        core.if %has_source {
          %target = core.get %rename_fields[%source]
          %value = core.get %payload[%source]
          core.set %payload[%target] = %value
          core.call intrinsic.map.delete(%payload, %source)
        }
      }
      %enum_maps = core.get %rules["enumMaps"] default %empty_map
      %enum_fields = core.call intrinsic.map.keys(%enum_maps)
      core.for %field in %enum_fields {
        %field_map = core.get %enum_maps[%field]
        %value = core.get %payload[%field]
        %has_value = core.call intrinsic.is_not_none(%value)
        %has_mapping = core.call intrinsic.map.contains(%field_map, %value)
        %should_map = core.call intrinsic.and(%has_value, %has_mapping)
        core.if %should_map {
          %mapped_value = core.get %field_map[%value]
          core.set %payload[%field] = %mapped_value
        }
      }
      %construct_objects = core.get %rules["constructObjects"] default %empty_map
      %object_targets = core.call intrinsic.map.keys(%construct_objects)
      core.for %target in %object_targets {
        %field_sources = core.get %construct_objects[%target]
        %nested_fields = core.call intrinsic.map.keys(%field_sources)
        %nested = core.map
        core.for %nested_field in %nested_fields {
          %source = core.get %field_sources[%nested_field]
          %has_source = core.call intrinsic.map.contains(%payload, %source)
          core.if %has_source {
            %value = core.get %payload[%source]
            core.set %nested[%nested_field] = %value
          }
        }
        %has_nested = core.call intrinsic.truthy(%nested)
        core.if %has_nested {
          core.set %payload[%target] = %nested
        }
      }
      %reasoning_object_fields = core.get %rules["reasoningObjectFields"] default %empty_list
      %has_reasoning_object_fields = core.call intrinsic.truthy(%reasoning_object_fields)
      core.if %has_reasoning_object_fields {
        %reasoning_object = core.get %payload["reasoning"]
        %reasoning_is_object = core.type_is %reasoning_object type "object"
        core.if %reasoning_is_object {
          %filtered_reasoning = core.map
          core.for %field in %reasoning_object_fields {
            %has_field = core.call intrinsic.map.contains(%reasoning_object, %field)
            core.if %has_field {
              %value = core.get %reasoning_object[%field]
              core.set %filtered_reasoning[%field] = %value
            }
          }
          core.set %payload["reasoning"] = %filtered_reasoning
        }
      }
      %image_shape = core.get %rules["imageURLShape"] default ""
      %image_object = core.call intrinsic.eq(%image_shape, "object")
      core.if %image_object {
        %payload = core.call @provider_apply_image_url_object_shape(%payload)
      }
      %option_dialect = core.get %rules["optionDialect"] default ""
      %search_parameters = core.call intrinsic.eq(%option_dialect, "search-parameters")
      core.if %search_parameters {
        %payload = core.call @provider_apply_search_parameters_option(%payload, %request, %model_config)
      }
      core.return %payload
    }
  }

  op ax.provider.semantic @provider_build_chat_request {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "ai"
    tag "provider-operation-dispatch"
    type signature = "(profile:string, AxChatRequest, options?:json) -> json throws"
    body @entry(%profile: string, %request: AxChatRequest, %options: json) {
      %provider_id = core.call @provider_normalize_profile(%profile)
      %descriptor = core.call @provider_resolve_descriptor(%provider_id, %options)
      %transport = core.get %descriptor["transport"] default "openai-chat"
      %is_responses = core.call intrinsic.eq(%transport, "openai-responses")
      %is_gemini = core.call intrinsic.eq(%transport, "gemini-generate-content")
      %is_anthropic = core.call intrinsic.eq(%transport, "anthropic-messages")
      %model = core.get %request["model"] default ""
      %reasoning_content_mode = core.call @provider_reasoning_replay_field(%provider_id, %model)
      %reasoning_details_mode = core.call @provider_reasoning_details_replay_field(%provider_id, %model)
      %payload = core.map
      core.if %is_responses {
        %responses_payload = core.call @openai_responses_build_chat_request(%request)
        %payload = core.let %responses_payload
      } else {
        core.if %is_gemini {
          %is_vertex = core.get %descriptor["vertex"] default false
          %gemini_payload = core.call @gemini_build_chat_request(%request, %options, %is_vertex)
          %payload = core.let %gemini_payload
        } else {
          core.if %is_anthropic {
            %anthropic_payload = core.call @anthropic_build_chat_request(%request)
            %is_vertex = core.get %descriptor["vertex"] default false
            core.if %is_vertex {
              core.call intrinsic.map.delete(%anthropic_payload, "model")
              core.set %anthropic_payload["anthropic_version"] = "vertex-2023-10-16"
            }
            %payload = core.let %anthropic_payload
          } else {
            %is_official_openai = core.call intrinsic.eq(%provider_id, "openai")
            %compatible_payload = core.call @openai_build_chat_request_impl(%request, %options, %is_official_openai, %reasoning_content_mode, %reasoning_details_mode)
            %payload = core.let %compatible_payload
          }
        }
      }
      %empty_rules = core.map
      %empty_list = core.list
      %profile_rules = core.get %descriptor["request"] default %empty_rules
      %payload = core.call @provider_apply_request_rules(%payload, %request, %profile_rules)
      %model_rule = core.call @provider_resolve_model_rule(%provider_id, %model)
      %model_rules = core.get %model_rule["request"] default %empty_rules
      %payload = core.call @provider_apply_request_rules(%payload, %request, %model_rules)
      %features = core.call @provider_resolve_features(%provider_id, %model, %options)
      %response_format = core.get %payload["response_format"] default %empty_rules
      %response_format_type = core.get %response_format["type"] default ""
      %is_json_schema = core.call intrinsic.eq(%response_format_type, "json_schema")
      core.if %is_json_schema {
        %native_support = core.get %features["structured_outputs"] default false
        %native_unsupported = core.call intrinsic.not(%native_support)
        core.if %native_unsupported {
          %native_message = core.call intrinsic.string.format("native JSON Schema output is not supported by profile {} model {}", %provider_id, %model)
          %native_error = core.call intrinsic.ai.error.unsupported(%native_message)
          core.raise %native_error
        }
      }
      %is_json_object = core.call intrinsic.eq(%response_format_type, "json_object")
      core.if %is_json_object {
        %structured_modes = core.get %features["structured_output_modes"] default %empty_list
        %supports_json_object = core.let false
        core.for %structured_mode in %structured_modes {
          %mode_is_json_object = core.call intrinsic.eq(%structured_mode, "json_object")
          core.if %mode_is_json_object {
            %supports_json_object = core.let true
          }
        }
        %json_object_unsupported = core.call intrinsic.not(%supports_json_object)
        core.if %json_object_unsupported {
          %json_object_message = core.call intrinsic.string.format("JSON object output is not supported by profile {} model {}", %provider_id, %model)
          %json_object_error = core.call intrinsic.ai.error.unsupported(%json_object_message)
          core.raise %json_object_error
        }
      }
      core.return %payload
    }
  }

  op ax.provider.semantic @provider_apply_image_url_object_shape {
    attr core_kind = "func"
    attr emit_module = "ai"
    attr private = true
    tag "provider-profile-request-transforms"
    type signature = "(payload:json) -> json"
    body @entry(%payload: json) {
      %empty_list = core.list
      %messages = core.get %payload["messages"] default %empty_list
      core.for %message in %messages {
        %content = core.get %message["content"]
        %content_is_list = core.type_is %content type "list"
        core.if %content_is_list {
          core.for %part in %content {
            %part_type = core.get %part["type"] default ""
            %is_image_url = core.call intrinsic.eq(%part_type, "image_url")
            core.if %is_image_url {
              %empty_image = core.map
              %image = core.get %part["image_url"] default %empty_image
              %url = core.get %image["url"]
              %next_image = core.map
              core.set %next_image["url"] = %url
              core.set %part["image_url"] = %next_image
            }
          }
        }
      }
      core.return %payload
    }
  }

  op ax.provider.semantic @provider_apply_search_parameters_option {
    attr core_kind = "func"
    attr emit_module = "ai"
    attr private = true
    tag "provider-profile-request-transforms"
    type signature = "(payload:json, request:json, model_config:json) -> json"
    body @entry(%payload: json, %request: json, %model_config: json) {
      %empty_map = core.map
      %search_snake = core.get %request["search_parameters"]
      %search_camel = core.get %request["searchParameters"] default %search_snake
      %search_config_snake = core.get %model_config["search_parameters"] default %search_camel
      %search = core.get %model_config["searchParameters"] default %search_config_snake
      %has_search = core.call intrinsic.is_not_none(%search)
      core.if %has_search {
        %search_payload = core.map
        %mode = core.get %search["mode"]
        %return_citations = core.get %search["returnCitations"]
        %return_citations_snake = core.get %search["return_citations"] default %return_citations
        %from_date = core.get %search["fromDate"]
        %from_date_snake = core.get %search["from_date"] default %from_date
        %to_date = core.get %search["toDate"]
        %to_date_snake = core.get %search["to_date"] default %to_date
        %max_results = core.get %search["maxSearchResults"]
        %max_results_snake = core.get %search["max_search_results"] default %max_results
        %sources = core.get %search["sources"]
        %has_mode = core.call intrinsic.is_not_none(%mode)
        core.if %has_mode {
          core.set %search_payload["mode"] = %mode
        }
        %has_return_citations = core.call intrinsic.is_not_none(%return_citations_snake)
        core.if %has_return_citations {
          core.set %search_payload["return_citations"] = %return_citations_snake
        }
        %has_from_date = core.call intrinsic.is_not_none(%from_date_snake)
        core.if %has_from_date {
          core.set %search_payload["from_date"] = %from_date_snake
        }
        %has_to_date = core.call intrinsic.is_not_none(%to_date_snake)
        core.if %has_to_date {
          core.set %search_payload["to_date"] = %to_date_snake
        }
        %has_max_results = core.call intrinsic.is_not_none(%max_results_snake)
        core.if %has_max_results {
          core.set %search_payload["max_search_results"] = %max_results_snake
        }
        core.if %sources {
          %mapped_sources = core.list
          core.for %source in %sources {
            %mapped_source = core.map
            %source_type = core.get %source["type"]
            %source_country = core.get %source["country"]
            %excluded_websites_camel = core.get %source["excludedWebsites"]
            %excluded_websites = core.get %source["excluded_websites"] default %excluded_websites_camel
            %allowed_websites_camel = core.get %source["allowedWebsites"]
            %allowed_websites = core.get %source["allowed_websites"] default %allowed_websites_camel
            %safe_search_camel = core.get %source["safeSearch"]
            %safe_search = core.get %source["safe_search"] default %safe_search_camel
            %x_handles_camel = core.get %source["xHandles"]
            %x_handles = core.get %source["x_handles"] default %x_handles_camel
            %links = core.get %source["links"]
            %has_source_type = core.call intrinsic.is_not_none(%source_type)
            core.if %has_source_type {
              core.set %mapped_source["type"] = %source_type
            }
            %has_source_country = core.call intrinsic.is_not_none(%source_country)
            core.if %has_source_country {
              core.set %mapped_source["country"] = %source_country
            }
            %has_excluded_websites = core.call intrinsic.is_not_none(%excluded_websites)
            core.if %has_excluded_websites {
              core.set %mapped_source["excluded_websites"] = %excluded_websites
            }
            %has_allowed_websites = core.call intrinsic.is_not_none(%allowed_websites)
            core.if %has_allowed_websites {
              core.set %mapped_source["allowed_websites"] = %allowed_websites
            }
            %has_safe_search = core.call intrinsic.is_not_none(%safe_search)
            core.if %has_safe_search {
              core.set %mapped_source["safe_search"] = %safe_search
            }
            %has_x_handles = core.call intrinsic.is_not_none(%x_handles)
            core.if %has_x_handles {
              core.set %mapped_source["x_handles"] = %x_handles
            }
            %has_links = core.call intrinsic.is_not_none(%links)
            core.if %has_links {
              core.set %mapped_source["links"] = %links
            }
            core.append %mapped_sources, %mapped_source
          }
          core.set %search_payload["sources"] = %mapped_sources
        }
        core.set %payload["search_parameters"] = %search_payload
      }
      core.return %payload
    }
  }

  op ax.provider.semantic @provider_build_embed_request {
    attr core_kind = "func"
    attr emit_module = "ai"
    tag "provider-operation-dispatch"
    type signature = "(profile:string, AxEmbedRequest, options?:json) -> json throws"
    body @entry(%profile: string, %request: AxEmbedRequest, %options: json) {
      %provider_id = core.call @provider_normalize_profile(%profile)
      %descriptor = core.call @provider_resolve_descriptor(%provider_id, %options)
      %transport = core.get %descriptor["transport"] default "openai-chat"
      %is_gemini = core.call intrinsic.eq(%transport, "gemini-generate-content")
      %is_anthropic = core.call intrinsic.eq(%transport, "anthropic-messages")
      %payload = core.map
      core.if %is_gemini {
        %is_vertex = core.get %descriptor["vertex"] default false
        %gemini_payload = core.map
        core.if %is_vertex {
          %vertex_payload = core.call @gemini_build_vertex_embed_request(%request, %options)
          %gemini_payload = core.let %vertex_payload
        } else {
          %developer_payload = core.call @gemini_build_embed_request(%request)
          %gemini_payload = core.let %developer_payload
        }
        %payload = core.let %gemini_payload
      } else {
        core.if %is_anthropic {
          %error = core.call intrinsic.ai.error.unsupported("embed is not supported by Anthropic provider")
          core.raise %error
        } else {
          %openai_payload = core.call @openai_build_embed_request(%request)
          %payload = core.let %openai_payload
        }
      }
      core.return %payload
    }
  }

  op ax.provider.semantic @provider_normalize_chat_response {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "ai"
    tag "provider-operation-dispatch"
    type signature = "(profile:string, json, string, string) -> AxChatResponse throws"
    body @entry(%profile: string, %raw: json, %ai_name: string, %model: string) {
      %provider_id = core.call @provider_normalize_profile(%profile)
      %descriptor = core.call @provider_descriptor(%provider_id)
      %transport = core.get %descriptor["transport"] default "openai-chat"
      %is_responses = core.call intrinsic.eq(%transport, "openai-responses")
      %is_gemini = core.call intrinsic.eq(%transport, "gemini-generate-content")
      %is_anthropic = core.call intrinsic.eq(%transport, "anthropic-messages")
      %reasoning_content_mode = core.call @provider_reasoning_field(%provider_id, %model)
      %reasoning_details_mode = core.call @provider_reasoning_details_field(%provider_id, %model)
      %response = core.map
      core.if %is_responses {
        %responses_response = core.call @openai_responses_normalize_chat_response(%raw, %ai_name, %model)
        %response = core.let %responses_response
      } else {
        core.if %is_gemini {
          %gemini_response = core.call @gemini_normalize_chat_response(%raw, %ai_name, %model)
          %response = core.let %gemini_response
        } else {
          core.if %is_anthropic {
            %anthropic_response = core.call @anthropic_normalize_chat_response(%raw, %ai_name, %model)
            %response = core.let %anthropic_response
          } else {
            %compatible_response = core.call @openai_normalize_chat_response_impl(%raw, %ai_name, %model, %reasoning_content_mode, %reasoning_details_mode)
            %response = core.let %compatible_response
          }
        }
      }
      core.return %response
    }
  }

  op ax.provider.semantic @provider_normalize_stream_delta {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "ai"
    tag "provider-operation-dispatch"
    type signature = "(profile:string, json, json, string, string) -> AxChatResponse throws"
    body @entry(%profile: string, %raw: json, %state: json, %ai_name: string, %model: string) {
      %provider_id = core.call @provider_normalize_profile(%profile)
      %descriptor = core.call @provider_descriptor(%provider_id)
      %transport = core.get %descriptor["transport"] default "openai-chat"
      %is_responses = core.call intrinsic.eq(%transport, "openai-responses")
      %is_gemini = core.call intrinsic.eq(%transport, "gemini-generate-content")
      %is_anthropic = core.call intrinsic.eq(%transport, "anthropic-messages")
      %reasoning_content_mode = core.call @provider_reasoning_field(%provider_id, %model)
      %reasoning_details_mode = core.call @provider_reasoning_details_field(%provider_id, %model)
      %response = core.map
      core.if %is_responses {
        %responses_response = core.call @openai_responses_normalize_stream_delta(%raw, %state, %ai_name, %model)
        %response = core.let %responses_response
      } else {
        core.if %is_gemini {
          %gemini_response = core.call @gemini_normalize_chat_response(%raw, %ai_name, %model)
          %response = core.let %gemini_response
        } else {
          core.if %is_anthropic {
            %anthropic_response = core.call @anthropic_normalize_stream_delta(%raw, %state, %ai_name, %model)
            %response = core.let %anthropic_response
          } else {
            %compatible_response = core.call @openai_normalize_stream_delta_impl(%raw, %state, %ai_name, %model, %reasoning_content_mode, %reasoning_details_mode)
            %response = core.let %compatible_response
          }
        }
      }
      core.return %response
    }
  }

  op ax.provider.semantic @provider_classify_stream_error_status {
    attr core_kind = "func"
    attr emit_module = "ai"
    tag "src/ax/ai/anthropic/api.ts"
    type signature = "(profile:string, json) -> json"
    body @entry(%profile: string, %event: json) {
      %provider_id = core.call @provider_normalize_profile(%profile)
      %descriptor = core.call @provider_descriptor(%provider_id)
      %transport = core.get %descriptor["transport"] default "openai-chat"
      %none = core.call intrinsic.none()
      %status = core.let %none
      %is_anthropic = core.call intrinsic.eq(%transport, "anthropic-messages")
      core.if %is_anthropic {
        %event_is_object = core.type_is %event type "object"
        core.if %event_is_object {
          %type = core.get %event["type"] default ""
          %is_error = core.call intrinsic.eq(%type, "error")
          core.if %is_error {
            %error_body = core.get %event["error"]
            %error_type = core.get %error_body["type"] default ""
            %mapped = core.call @anthropic_error_type_to_status(%error_type)
            %status = core.let %mapped
          }
        }
      }
      core.return %status
    }
  }

  op ax.provider.semantic @is_retryable_status {
    attr core_kind = "func"
    attr emit_module = "ai"
    tag "src/ax/util/apicall.ts"
    type signature = "(i64) -> bool"
    body @entry(%status: i64) {
      %is_408 = core.call intrinsic.eq(%status, 408)
      %is_429 = core.call intrinsic.eq(%status, 429)
      %is_500 = core.call intrinsic.eq(%status, 500)
      %is_502 = core.call intrinsic.eq(%status, 502)
      %is_503 = core.call intrinsic.eq(%status, 503)
      %is_504 = core.call intrinsic.eq(%status, 504)
      %is_529 = core.call intrinsic.eq(%status, 529)
      %r1 = core.call intrinsic.or(%is_408, %is_429)
      %r2 = core.call intrinsic.or(%is_500, %is_502)
      %r3 = core.call intrinsic.or(%is_503, %is_504)
      %r4 = core.call intrinsic.or(%r1, %r2)
      %r5 = core.call intrinsic.or(%r3, %is_529)
      %retryable = core.call intrinsic.or(%r4, %r5)
      core.return %retryable
    }
  }

  op ax.provider.semantic @default_retry_config {
    attr core_kind = "func"
    attr emit_module = "ai"
    tag "src/ax/util/apicall.ts"
    type signature = "() -> json"
    body @entry {
      %config = core.map
      core.set %config["max_retries"] = 3
      core.set %config["initial_delay_ms"] = 1000
      core.set %config["max_delay_ms"] = 60000
      core.set %config["backoff_factor"] = 2
      core.return %config
    }
  }

  op ax.provider.semantic @retry_opt_value {
    attr core_kind = "func"
    attr emit_module = "ai"
    tag "src/ax/util/apicall.ts"
    type signature = "(json, string, string, json) -> json"
    body @entry(%map: json, %camel: string, %snake: string, %fallback: json) {
      %camel_val = core.get %map[%camel]
      %has_camel = core.call intrinsic.is_not_none(%camel_val)
      core.if %has_camel {
        core.return %camel_val
      }
      %snake_val = core.get %map[%snake]
      %has_snake = core.call intrinsic.is_not_none(%snake_val)
      core.if %has_snake {
        core.return %snake_val
      }
      core.return %fallback
    }
  }

  op ax.provider.semantic @resolve_stream_retry {
    attr core_kind = "func"
    attr emit_module = "ai"
    tag "src/ax/util/apicall.ts"
    type signature = "(json) -> json"
    body @entry(%options: json) {
      %cfg = core.call @default_retry_config()
      %def_max = core.get %cfg["max_retries"]
      %def_initial = core.get %cfg["initial_delay_ms"]
      %def_max_delay = core.get %cfg["max_delay_ms"]
      %def_backoff = core.get %cfg["backoff_factor"]
      %retry = core.get %options["retry"]
      %max_retries = core.call @retry_opt_value(%retry, "maxRetries", "max_retries", %def_max)
      %initial = core.call @retry_opt_value(%retry, "initialDelayMs", "initial_delay_ms", %def_initial)
      %max_delay = core.call @retry_opt_value(%retry, "maxDelayMs", "max_delay_ms", %def_max_delay)
      %backoff = core.call @retry_opt_value(%retry, "backoffFactor", "backoff_factor", %def_backoff)
      %out = core.map
      core.set %out["max_retries"] = %max_retries
      core.set %out["initial_delay_ms"] = %initial
      core.set %out["max_delay_ms"] = %max_delay
      core.set %out["backoff_factor"] = %backoff
      core.return %out
    }
  }

