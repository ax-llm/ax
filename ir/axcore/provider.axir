  op ax.provider.semantic @gemini_live_bidi_build_setup {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "ai"
    attr private = true
    tag "gemini-live-bidi-realtime-audio-core-helper"
    type signature = "(descriptor:json, request:json) -> json throws"
    body @entry(%descriptor: json, %request: json) {
      %response_format = core.get %request["response_format"]
      %has_response_format = core.call intrinsic.truthy(%response_format)
      core.if %has_response_format {
        %error = core.call intrinsic.ai.error.unsupported("Gemini Live audio does not support structured response formats")
        core.raise %error
      }
      %default_model = core.get %descriptor["defaultModel"] default "gemini-2.5-flash-native-audio-preview-12-2025"
      %request_model = core.get %request["model"] default %default_model
      %model_prefix = core.call intrinsic.contains(%request_model, "models/")
      %model = core.let %request_model
      core.if %model_prefix {
      } else {
        %model = core.call intrinsic.string.format("models/{}", %request_model)
      }
      %audio_descriptor = core.get %descriptor["audio"]
      %output_audio_descriptor = core.get %audio_descriptor["output"]
      %request_audio = core.get %request["audio"]
      %request_output_audio = core.get %request_audio["output"]
      %default_voice = core.get %output_audio_descriptor["defaultVoice"] default "Kore"
      %voice = core.get %request_output_audio["voice"] default %default_voice
      %voice_name = core.get %voice["name"] default %voice
      %setup = core.map
      core.set %setup["model"] = %model
      %generation_config = core.map
      %modalities = core.call intrinsic.json.parse("[\"AUDIO\"]")
      core.set %generation_config["responseModalities"] = %modalities
      %speech_config = core.map
      %voice_config = core.map
      %prebuilt_voice = core.map
      core.set %prebuilt_voice["voiceName"] = %voice_name
      core.set %voice_config["prebuiltVoiceConfig"] = %prebuilt_voice
      core.set %speech_config["voiceConfig"] = %voice_config
      core.set %generation_config["speechConfig"] = %speech_config
      core.set %setup["generationConfig"] = %generation_config
      %include_transcript = core.get %request_output_audio["transcript"] default true
      core.if %include_transcript {
        %transcript = core.map
        core.set %setup["outputAudioTranscription"] = %transcript
      }
      %instructions = core.call @realtime_request_system_instruction_impl(%request)
      %has_instructions = core.call intrinsic.truthy(%instructions)
      core.if %has_instructions {
        %part = core.map
        core.set %part["text"] = %instructions
        %parts = core.list
        core.append %parts, %part
        %system_instruction = core.map
        core.set %system_instruction["parts"] = %parts
        core.set %setup["systemInstruction"] = %system_instruction
      }
      %out = core.map
      core.set %out["setup"] = %setup
      core.return %out
    }
  }

  op ax.provider.semantic @gemini_live_bidi_build_input {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "ai"
    attr private = true
    tag "gemini-live-bidi-realtime-audio-core-helper"
    type signature = "(descriptor:json, request:json) -> list<json> throws"
    body @entry(%descriptor: json, %request: json) {
      %events = core.list
      %messages = core.call @realtime_request_user_messages_impl(%request)
      core.for %message in %messages {
        %content = core.get %message["content"] default ""
        %is_list = core.type_is %content type "list"
        %text_parts = core.list
        %audio_events = core.list
        core.if %is_list {
          core.for %part in %content {
            %part_type = core.get %part["type"] default "text"
            %is_text = core.call intrinsic.eq(%part_type, "text")
            core.if %is_text {
              %text_part = core.map
              %text = core.get %part["text"] default ""
              core.set %text_part["text"] = %text
              core.append %text_parts, %text_part
            }
            %is_audio = core.call intrinsic.eq(%part_type, "audio")
            core.if %is_audio {
              %format = core.get %part["format"] default "pcm16"
              %format_lower = core.call intrinsic.string.lower(%format)
              %is_pcm16 = core.call intrinsic.eq(%format_lower, "pcm16")
              %is_pcm = core.call intrinsic.eq(%format_lower, "pcm")
              %valid_pcm = core.call intrinsic.or(%is_pcm16, %is_pcm)
              core.if %valid_pcm {
              } else {
                %error = core.call intrinsic.ai.error.unsupported("Gemini Live audio input must be PCM")
                core.raise %error
              }
              %data = core.get %part["data"] default ""
              %sample_rate = core.get %part["sampleRate"]
              %sample_rate_snake = core.get %part["sample_rate"] default %sample_rate
              %sample_rate_final = core.let %sample_rate_snake
              %has_sample_rate = core.call intrinsic.is_not_none(%sample_rate_final)
              core.if %has_sample_rate {
              } else {
                %sample_rate_final = core.let 16000
              }
              %mime = core.call intrinsic.string.format("audio/pcm;rate={}", %sample_rate_final)
              %audio = core.map
              core.set %audio["data"] = %data
              core.set %audio["mimeType"] = %mime
              %realtime_input = core.map
              core.set %realtime_input["audio"] = %audio
              %audio_event = core.map
              core.set %audio_event["realtimeInput"] = %realtime_input
              core.append %audio_events, %audio_event
            }
          }
        } else {
          %text_part = core.map
          core.set %text_part["text"] = %content
          core.append %text_parts, %text_part
        }
        %audio_count = core.call intrinsic.len(%audio_events)
        %msg_has_audio = core.call intrinsic.gt(%audio_count, 0)
        %text_count = core.call intrinsic.len(%text_parts)
        %has_text = core.call intrinsic.gt(%text_count, 0)
        core.if %has_text {
          %turn = core.map
          core.set %turn["role"] = "user"
          core.set %turn["parts"] = %text_parts
          %turns = core.list
          core.append %turns, %turn
          %client_content = core.map
          core.set %client_content["turns"] = %turns
          %turn_complete = core.call intrinsic.not(%msg_has_audio)
          core.set %client_content["turnComplete"] = %turn_complete
          %content_event = core.map
          core.set %content_event["clientContent"] = %client_content
          core.append %events, %content_event
        }
        core.for %audio_event in %audio_events {
          core.append %events, %audio_event
        }
        core.if %msg_has_audio {
          %stream_end = core.map
          core.set %stream_end["audioStreamEnd"] = true
          %end_event = core.map
          core.set %end_event["realtimeInput"] = %stream_end
          core.append %events, %end_event
        }
      }
      core.return %events
    }
  }

  op ax.provider.semantic @realtime_request_system_instruction_impl {
    attr core_kind = "func"
    attr emit_module = "ai"
    attr private = true
    tag "provider-realtime-audio-core-helper"
    type signature = "(request:json) -> string"
    body @entry(%request: json) {
      %direct = core.get %request["instructions"]
      %has_direct = core.call intrinsic.truthy(%direct)
      core.if %has_direct {
        core.return %direct
      }
      %empty_prompt = core.list
      %prompt = core.get %request["chat_prompt"] default %empty_prompt
      %parts = core.list
      core.for %message in %prompt {
        %role = core.get %message["role"]
        %is_system = core.call intrinsic.eq(%role, "system")
        core.if %is_system {
          %content = core.get %message["content"] default ""
          core.append %parts, %content
        }
      }
      %out = core.call intrinsic.string.join("\n", %parts)
      core.return %out
    }
  }

  op ax.provider.semantic @realtime_request_user_messages_impl {
    attr core_kind = "func"
    attr emit_module = "ai"
    attr private = true
    tag "provider-realtime-audio-core-helper"
    type signature = "(request:json) -> list<json>"
    body @entry(%request: json) {
      %empty_prompt = core.list
      %prompt = core.get %request["chat_prompt"] default %empty_prompt
      %out = core.list
      core.for %message in %prompt {
        %role = core.get %message["role"]
        %is_user = core.call intrinsic.eq(%role, "user")
        core.if %is_user {
          core.append %out, %message
        }
      }
      %count = core.call intrinsic.len(%out)
      %has_out = core.call intrinsic.gt(%count, 0)
      core.if %has_out {
      } else {
        %input = core.get %request["input"]
        %has_input = core.call intrinsic.is_not_none(%input)
        core.if %has_input {
          %message = core.map
          core.set %message["role"] = "user"
          core.set %message["content"] = %input
          core.append %out, %message
        }
      }
      core.return %out
    }
  }

  op ax.provider.semantic @openai_realtime_content_parts_impl {
    attr core_kind = "func"
    attr emit_module = "ai"
    attr private = true
    tag "openai-compatible-realtime-audio-core-helper"
    type signature = "(content:json) -> list<json>"
    body @entry(%content: json) {
      %parts = core.list
      %is_list = core.type_is %content type "list"
      core.if %is_list {
        core.for %part in %content {
          %type = core.get %part["type"] default "text"
          %is_audio = core.call intrinsic.eq(%type, "audio")
          core.if %is_audio {
            %audio_part = core.map
            core.set %audio_part["type"] = "input_audio"
            %input_audio = core.map
            %data = core.get %part["data"] default ""
            core.set %input_audio["data"] = %data
            %format = core.get %part["format"] default "pcm16"
            core.set %input_audio["format"] = %format
            core.set %audio_part["input_audio"] = %input_audio
            core.append %parts, %audio_part
          } else {
            %text_part = core.map
            core.set %text_part["type"] = "input_text"
            %text = core.get %part["text"] default ""
            core.set %text_part["text"] = %text
            core.append %parts, %text_part
          }
        }
      } else {
        %part = core.map
        core.set %part["type"] = "input_text"
        core.set %part["text"] = %content
        core.append %parts, %part
      }
      core.return %parts
    }
  }

  op ax.provider.semantic @provider_model_matches {
    attr core_kind = "func"
    attr emit_module = "ai"
    attr private = true
    tag "provider-profile-model-rule"
    type signature = "(match:json, model:string) -> bool"
    body @entry(%match: json, %model: string) {
      %empty_values = core.list
      %exact = core.get %match["exact"] default %empty_values
      %exact_match = core.call intrinsic.contains(%exact, %model)
      core.if %exact_match {
        core.return true
      }
      %prefixes = core.get %match["prefix"] default %empty_values
      core.for %prefix in %prefixes {
        %prefix_match = core.call intrinsic.string.starts_with(%model, %prefix)
        core.if %prefix_match {
          core.return true
        }
      }
      %contains_values = core.get %match["contains"] default %empty_values
      %model_lower = core.call intrinsic.string.lower(%model)
      core.for %part in %contains_values {
        %part_lower = core.call intrinsic.string.lower(%part)
        %contains_match = core.call intrinsic.contains(%model_lower, %part_lower)
        core.if %contains_match {
          core.return true
        }
      }
      core.return false
    }
  }

  op ax.provider.semantic @provider_resolve_model_rule {
    attr core_kind = "func"
    attr emit_module = "ai"
    attr private = true
    tag "provider-profile-model-rule"
    type signature = "(profile:string, model:string) -> json"
    body @entry(%profile: string, %model: string) {
      %descriptor = core.call @provider_descriptor(%profile)
      %empty_rules = core.list
      %rules = core.get %descriptor["modelRules"] default %empty_rules
      core.for %rule in %rules {
        %empty_match = core.map
        %match = core.get %rule["match"] default %empty_match
        %matched = core.call @provider_model_matches(%match, %model)
        core.if %matched {
          core.return %rule
        }
      }
      %empty = core.map
      core.return %empty
    }
  }

  op ax.provider.semantic @provider_resolve_features {
    attr core_kind = "func"
    attr emit_module = "ai"
    tag "provider-profile-model-features"
    type signature = "(profile:string, model:string, options?:json) -> json"
    body @entry(%profile: string, %model: string, %options: json) {
      %descriptor = core.call @provider_descriptor(%profile)
      %empty_map = core.map
      %base_features = core.get %descriptor["features"] default %empty_map
      %features = core.call intrinsic.map.merge(%empty_map, %base_features)
      %rule = core.call @provider_resolve_model_rule(%profile, %model)
      %capabilities = core.get %rule["capabilities"] default %empty_map
      %capability_keys = core.call intrinsic.map.keys(%capabilities)
      core.for %key in %capability_keys {
        %value = core.get %capabilities[%key]
        %is_structured_outputs = core.call intrinsic.eq(%key, "structuredOutputs")
        %is_structured_modes = core.call intrinsic.eq(%key, "structuredOutputModes")
        %is_multi_turn = core.call intrinsic.eq(%key, "multiTurn")
        %is_thinking_budget = core.call intrinsic.eq(%key, "thinkingBudget")
        %is_show_thoughts = core.call intrinsic.eq(%key, "showThoughts")
        core.if %is_structured_outputs {
          core.set %features["structured_outputs"] = %value
        } else {
          core.if %is_structured_modes {
            core.set %features["structured_output_modes"] = %value
          } else {
            core.if %is_multi_turn {
              core.set %features["multi_turn"] = %value
            } else {
              core.if %is_thinking_budget {
                core.set %features["has_thinking_budget"] = %value
              } else {
                core.if %is_show_thoughts {
                  core.set %features["has_show_thoughts"] = %value
                } else {
                  core.set %features[%key] = %value
                }
              }
            }
          }
        }
      }
      %model_info_snake = core.get %options["model_info"]
      %empty_list = core.list
      %model_info = core.get %options["modelInfo"] default %model_info_snake
      %model_info_missing = core.call intrinsic.is_none(%model_info)
      core.if %model_info_missing {
        %model_info = core.let %empty_list
      }
      core.for %item in %model_info {
        %item_name = core.get %item["name"] default ""
        %matches_name = core.call intrinsic.eq(%item_name, %model)
        %matches_alias = core.let false
        %aliases = core.get %item["aliases"] default %empty_list
        core.for %alias in %aliases {
          %alias_match = core.call intrinsic.eq(%alias, %model)
          core.if %alias_match {
            %matches_alias = core.let true
          }
        }
        %matches = core.call intrinsic.or(%matches_name, %matches_alias)
        core.if %matches {
          %supported = core.get %item["supported"] default %empty_map
          %override_modes_snake = core.get %supported["structured_output_modes"]
          %override_modes = core.get %supported["structuredOutputModes"] default %override_modes_snake
          %has_override_modes = core.call intrinsic.is_not_none(%override_modes)
          core.if %has_override_modes {
            core.set %features["structured_output_modes"] = %override_modes
            %has_native = core.let false
            core.for %override_mode in %override_modes {
              %override_native = core.call intrinsic.eq(%override_mode, "native")
              core.if %override_native {
                %has_native = core.let true
              }
            }
            core.set %features["structured_outputs"] = %has_native
          }
          %override_native_snake = core.get %supported["structured_outputs"]
          %override_native = core.get %supported["structuredOutputs"] default %override_native_snake
          %has_override_native = core.call intrinsic.is_not_none(%override_native)
          %no_override_modes = core.call intrinsic.not(%has_override_modes)
          %apply_native_override = core.call intrinsic.and(%has_override_native, %no_override_modes)
          core.if %apply_native_override {
            core.set %features["structured_outputs"] = %override_native
            %current_modes = core.get %features["structured_output_modes"] default %empty_list
            %modes_without_native = core.list
            core.for %current_mode in %current_modes {
              %current_is_native = core.call intrinsic.eq(%current_mode, "native")
              %current_is_not_native = core.call intrinsic.not(%current_is_native)
              core.if %current_is_not_native {
                core.append %modes_without_native, %current_mode
              }
            }
            core.if %override_native {
              %modes_with_native = core.list
              core.append %modes_with_native, "native"
              core.for %non_native_mode in %modes_without_native {
                core.append %modes_with_native, %non_native_mode
              }
              core.set %features["structured_output_modes"] = %modes_with_native
            } else {
              core.set %features["structured_output_modes"] = %modes_without_native
            }
          }
          %thinking_budget_snake = core.get %supported["thinking_budget"]
          %thinking_budget = core.get %supported["thinkingBudget"] default %thinking_budget_snake
          %has_thinking_budget = core.call intrinsic.is_not_none(%thinking_budget)
          core.if %has_thinking_budget {
            core.set %features["has_thinking_budget"] = %thinking_budget
          }
          %show_thoughts_snake = core.get %supported["show_thoughts"]
          %show_thoughts = core.get %supported["showThoughts"] default %show_thoughts_snake
          %has_show_thoughts = core.call intrinsic.is_not_none(%show_thoughts)
          core.if %has_show_thoughts {
            core.set %features["has_show_thoughts"] = %show_thoughts
          }
          %has_thinking_override = core.call intrinsic.or(%has_thinking_budget, %has_show_thoughts)
          core.if %has_thinking_override {
            %thinking_budget_enabled = core.get %features["has_thinking_budget"] default false
            %show_thoughts_enabled = core.get %features["has_show_thoughts"] default false
            %thinking_enabled = core.call intrinsic.or(%thinking_budget_enabled, %show_thoughts_enabled)
            core.set %features["thinking"] = %thinking_enabled
          }
        }
      }
      core.return %features
    }
  }

  op ax.provider.semantic @provider_reasoning_field {
    attr core_kind = "func"
    attr emit_module = "ai"
    attr private = true
    tag "provider-profile-reasoning-replay"
