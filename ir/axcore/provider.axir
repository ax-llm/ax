    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "ai"
    tag "provider-audio-operation"
    type signature = "(profile:string, json) -> json throws"
    body @entry(%profile: string, %request: json) {
      %provider_id = core.call @provider_normalize_profile(%profile)
      %operation = core.call @provider_operation_descriptor(%provider_id, "transcribe")
      %dialect = core.get %operation["dialect"] default "openai-transcription"
      %is_gemini = core.call intrinsic.eq(%dialect, "gemini-generate-content")
      %is_xai = core.call intrinsic.eq(%dialect, "xai-transcription")
      %payload = core.map
      core.if %is_gemini {
        %gemini_payload = core.call @gemini_build_transcribe_request(%request)
        %payload = core.let %gemini_payload
      } else {
        core.if %is_xai {
          %xai_payload = core.call @grok_build_transcribe_request(%request)
          %payload = core.let %xai_payload
        } else {
          %responses_payload = core.call @openai_responses_build_transcribe_request(%request)
          %payload = core.let %responses_payload
