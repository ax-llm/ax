      %empty_response = core.map
      %response = core.get %rule["response"] default %empty_response
      %empty_fields = core.list
      %fields = core.get %response["reasoningFields"] default %empty_fields
      %field = core.call intrinsic.list.get(%fields, 0, "none")
      core.return %field
    }
  }

