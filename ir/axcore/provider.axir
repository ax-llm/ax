        %instance = core.map
        core.set %instance["content"] = %text
        %task_type_snake = core.get %options["embed_type"]
        %task_type = core.get %options["embedType"] default %task_type_snake
        %has_task_type = core.call intrinsic.truthy(%task_type)
        core.if %has_task_type {
          core.set %instance["taskType"] = %task_type
