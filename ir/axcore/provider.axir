  op ax.provider.semantic @openai_normalize_choice_impl {
    attr core_kind = "func"
    attr emit_module = "ai"
    attr private = true
    tag "openai-choice-core-helper"
    type signature = "(json, json, reasoning_content_mode:string, reasoning_details_mode:string) -> json throws"
    body @entry(%choice: json, %raw: json, %reasoning_content_mode: string, %reasoning_details_mode: string) {
      %empty_message = core.map
      %message = core.get %choice["message"] default %empty_message
      %refusal = core.get %message["refusal"]
      %has_refusal = core.call intrinsic.truthy(%refusal)
      core.if %has_refusal {
        %error = core.call intrinsic.ai.error.refusal(%refusal, %raw)
        core.raise %error
      }
      %index = core.get %choice["index"] default 0
      %id = core.call intrinsic.string.str(%index)
      %content_raw = core.get %message["content"]
      %content = core.call intrinsic.none()
      %has_content = core.call intrinsic.truthy(%content_raw)
      core.if %has_content {
        %content = core.let %content_raw
      } else {
        %content = core.call intrinsic.none()
      }
      %empty_calls = core.list
      %tool_calls = core.get %message["tool_calls"] default %empty_calls
      %function_calls = core.call @openai_normalize_tool_calls_impl(%tool_calls)
      %finish_reason_raw = core.get %choice["finish_reason"]
      %finish_reason = core.call @openai_finish_reason_impl(%finish_reason_raw)
      %out = core.map
      core.set %out["index"] = %index
      core.set %out["id"] = %id
      core.set %out["content"] = %content
      %reasoning_content = core.get %message[%reasoning_content_mode]
      %has_reasoning_content = core.call intrinsic.truthy(%reasoning_content)
      %is_no_reasoning = core.call intrinsic.eq(%reasoning_content_mode, "none")
      %has_reasoning_mode = core.call intrinsic.not(%is_no_reasoning)
      %include_reasoning_content = core.call intrinsic.and(%has_reasoning_mode, %has_reasoning_content)
      core.if %include_reasoning_content {
        core.set %out["thought"] = %reasoning_content
        %thought_blocks = core.list
        %thought_block = core.map
        core.set %thought_block["data"] = %reasoning_content
        core.set %thought_block["encrypted"] = false
        core.append %thought_blocks, %thought_block
        core.set %out["thought_blocks"] = %thought_blocks
      }
      %is_no_details = core.call intrinsic.eq(%reasoning_details_mode, "none")
      %has_details_mode = core.call intrinsic.not(%is_no_details)
      %reasoning_details = core.get %message[%reasoning_details_mode]
      %has_reasoning_details = core.call intrinsic.truthy(%reasoning_details)
      %include_reasoning_details = core.call intrinsic.and(%has_details_mode, %has_reasoning_details)
      core.if %include_reasoning_details {
        %detail_blocks = core.list
        core.for %detail in %reasoning_details {
          %detail_block = core.map
          %data = core.call intrinsic.json.stringify(%detail)
          core.set %detail_block["data"] = %data
          %type = core.get %detail["type"] default ""
          %encrypted = core.call intrinsic.contains(%type, "encrypted")
          core.set %detail_block["encrypted"] = %encrypted
          %detail_id = core.get %detail["id"]
          %has_detail_id = core.call intrinsic.truthy(%detail_id)
          core.if %has_detail_id {
            core.set %detail_block["signature"] = %detail_id
          }
          core.append %detail_blocks, %detail_block
        }
        core.set %out["thought_blocks"] = %detail_blocks
      }
      core.set %out["function_calls"] = %function_calls
      core.set %out["finish_reason"] = %finish_reason
      core.return %out
    }
  }

  op ax.provider.semantic @openai_normalize_tool_calls_impl {
    attr core_kind = "func"
    attr emit_module = "ai"
