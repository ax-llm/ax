module @ax.tool version "0.1" {
  dialect @ax.tool version "0.1"

  op ax.tool.record @Tool {
    attr core_kind = "record"
    attr public = true
    tag "src/ax/dsp/functions.ts"
    type fields = "name:string,description:string,parameters:AxFunctionJSONSchema,handler:HostFunction,returns?:list<Field>,execution?:string"
  }

  op ax.tool.record @ToolBuilder {
    attr core_kind = "record"
    tag "src/ax/dsp/sig.ts"
    type fields = "name:string,args:list<Field>,returns:list<Field>"
  }

  op ax.tool.interface @HostFunction {
    attr core_kind = "interface"
    type call = "(json) -> json throws"
  }

  op ax.tool.semantic @execute_tool_call {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    ref validate = @validate_fields
    tag "native-tool-call"
    type signature = "(list<Tool>, json, json) -> json throws"
    body @entry(%functions: list<Tool>, %call: json, %options: json) {
      %fn_call = core.get %call["function"]
      %direct_name = core.get %call["name"]
      %name = core.get %fn_call["name"] default %direct_name
      %direct_params = core.get %call["params"]
      %params = core.get %fn_call["params"] default %direct_params
      %missing_params = core.call intrinsic.is_none(%params)
      core.if %missing_params {
        %argument_params = core.get %call["arguments"]
        %params = core.let %argument_params
      }
      %params_is_string = core.type_is %params type "string"
      core.if %params_is_string {
        %parsed_params = core.call intrinsic.json.parse(%params)
        %params = core.let %parsed_params
      }
      %params_still_missing = core.call intrinsic.is_none(%params)
      core.if %params_still_missing {
        %empty_params = core.map
        %params = core.let %empty_params
      }
      core.for %fn in %functions {
        %fn_name = core.get %fn["name"]
        %matches = core.call intrinsic.eq(%fn_name, %name)
        core.if %matches {
          // As TS, the tool gets the run's extras (see @tool_call_extras).
          %extras = core.call @tool_call_extras(%options, %name)
          %result = core.call intrinsic.tool.invoke(%fn, %params, %extras)
          core.return %result
        }
      }
      %available_names = core.list
      core.for %fn in %functions {
        %available_name = core.get %fn["name"]
        core.append %available_names, %available_name
      }
      %available_joined = core.call intrinsic.string.join(", ", %available_names)
      %available = core.call intrinsic.string.default_if_empty(%available_joined, "(none)")
      %message = core.call intrinsic.string.format("Function not found: {}. Available functions: {}. Call one of these exact function names.", %name, %available)
      %error = core.call intrinsic.error.validation(%message)
      core.raise %error
    }
  }

  op ax.tool.semantic @tool_call_extras {
    attr core_kind = "func"
    attr emit_module = "gen"
    tag "source:src/ax/dsp/functions.ts#processFunctions"
    type signature = "(options:json, name:string) -> json"
    body @entry(%options: json, %name: string) {
      // The extras TS gives a tool of a run with these options: its
      // sessionId and eventContext when set, and under a run control its
      // executionPath, <the run's path>/<the tool's name>.
      %extras = core.map
      %options_map = core.type_is %options type "object"
      core.if %options_map {
      } else {
        core.return %extras
      }
      %session_snake = core.get %options["session_id"] default null
      %session = core.get %options["sessionId"] default %session_snake
      %has_session = core.call intrinsic.is_not_none(%session)
      core.if %has_session {
        core.set %extras["sessionId"] = %session
      }
      %control = core.get %options["control"] default null
      %controlled = core.call intrinsic.is_not_none(%control)
      core.if %controlled {
        %path_snake = core.get %options["execution_path"] default "root"
        %path = core.get %options["executionPath"] default %path_snake
        %tool_path = core.call intrinsic.string.format("{}/{}", %path, %name)
        core.set %extras["executionPath"] = %tool_path
      }
      %event_snake = core.get %options["event_context"] default null
      %event_context = core.get %options["eventContext"] default %event_snake
      %has_event_context = core.call intrinsic.is_not_none(%event_context)
      core.if %has_event_context {
        core.set %extras["eventContext"] = %event_context
      }
      core.return %extras
    }
  }
}
