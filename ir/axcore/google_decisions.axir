  op ax.provider.semantic @google_decisions_require_object {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "ai"
    tag "src/ax/ai/google-gemini-decisions/validate.ts"
    type signature = "(json, string) -> json throws"
    body @entry(%value: json, %context: string) {
      %valid = core.type_is %value type "object"
      %invalid = core.call intrinsic.not(%valid)
      core.if %invalid {
        %message = core.call intrinsic.string.format("Google Gemini Decisions: {} must be an object", %context)
        %error = core.call intrinsic.error.validation(%message)
        core.raise %error
      }
      core.return %value
    }
  }

  op ax.provider.semantic @google_decisions_require_string {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "ai"
    tag "src/ax/ai/google-gemini-decisions/validate.ts"
    type signature = "(json, string, bool) -> string throws"
    body @entry(%value: json, %context: string, %nonempty: bool) {
      %valid = core.type_is %value type "string"
      core.if %valid {
        core.if %nonempty {
          %text = core.string_trim %value
          %valid = core.call intrinsic.ne(%text, "")
        }
      }
      %invalid = core.call intrinsic.not(%valid)
      core.if %invalid {
        %message = core.call intrinsic.string.format("Google Gemini Decisions: {} must be a string (nonempty where required)", %context)
        %error = core.call intrinsic.error.validation(%message)
        core.raise %error
      }
      core.return %value
    }
  }

  op ax.provider.semantic @google_decisions_require_number {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "ai"
    tag "src/ax/ai/google-gemini-decisions/validate.ts"
    type signature = "(json, string, f64, f64) -> f64 throws"
    body @entry(%value: json, %context: string, %minimum: f64, %maximum: f64) {
      %valid = core.type_is %value type "number"
      core.if %valid {
        %valid = core.call intrinsic.math.is_finite(%value)
        %low = core.call intrinsic.lt(%value, %minimum)
        %high = core.call intrinsic.gt(%value, %maximum)
        %outside = core.call intrinsic.or(%low, %high)
        %within = core.call intrinsic.not(%outside)
        %valid = core.call intrinsic.and(%valid, %within)
      }
      %invalid = core.call intrinsic.not(%valid)
      core.if %invalid {
        %message = core.call intrinsic.string.format("Google Gemini Decisions: {} must be a finite number between {} and {}", %context, %minimum, %maximum)
        %error = core.call intrinsic.error.validation(%message)
        core.raise %error
      }
      core.return %value
    }
  }

  op ax.provider.semantic @google_decisions_require_list {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "ai"
    tag "src/ax/ai/google-gemini-decisions/validate.ts"
    type signature = "(json, string, f64, f64) -> json throws"
    body @entry(%value: json, %context: string, %minimum: f64, %maximum: f64) {
      %valid = core.type_is %value type "list"
      %invalid = core.call intrinsic.not(%valid)
      core.if %invalid {
        %message = core.call intrinsic.string.format("Google Gemini Decisions: {} must be an array", %context)
        %error = core.call intrinsic.error.validation(%message)
        core.raise %error
      }
      %size = core.call intrinsic.len(%value)
      core.call @google_decisions_require_number(%size, %context, %minimum, %maximum)
      core.return %value
    }
  }

  op ax.provider.semantic @google_decisions_require_count {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "ai"
    tag "src/ax/ai/google-gemini-decisions/validate.ts"
    type signature = "(json) -> void throws"
    body @entry(%value: json) {
      core.call @google_decisions_require_number(%value, "token count", 0, 9007199254740991)
      %integer = core.call intrinsic.math.floor(%value)
      %fractional = core.call intrinsic.ne(%integer, %value)
      core.if %fractional {
        core.raise "Google Gemini Decisions: token counts must be nonnegative safe integers"
      }
      core.return
    }
  }

  op ax.provider.semantic @google_decisions_text_content {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "ai"
    tag "src/ax/ai/google-gemini-decisions"
    type signature = "(json, string) -> void throws"
    body @entry(%value: json, %context: string) {
      %is_string = core.type_is %value type "string"
      core.if %is_string {
        core.call @google_decisions_require_string(%value, %context, true)
        core.return
      }
      %blocks = core.list
      %list = core.type_is %value type "list"
      core.if %list {
        %blocks = core.let %value
      } else {
        core.append %blocks, %value
      }
      %joined = core.let ""
      core.for %block in %blocks {
        core.call @google_decisions_require_object(%block, %context)
        %kind = core.get %block["type"]
        %wrong = core.call intrinsic.ne(%kind, "text")
        core.if %wrong {
          core.raise "Google Gemini Decisions: instructions accepts text only"
        }
        %text = core.get %block["text"]
        core.call @google_decisions_require_string(%text, %context, false)
        %joined = core.call intrinsic.string.format("{}{}", %joined, %text)
      }
      core.call @google_decisions_require_string(%joined, %context, true)
      core.return
    }
  }

  op ax.provider.semantic @google_decisions_validate_input {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "ai"
    tag "src/ax/ai/google-gemini-decisions"
    type signature = "(json) -> void throws"
    body @entry(%value: json) {
      %text = core.type_is %value type "string"
      core.if %text {
        core.call @google_decisions_require_string(%value, "input", true)
        core.return
      }
      %blocks = core.list
      %list = core.type_is %value type "list"
      core.if %list {
        %blocks = core.let %value
      } else {
        core.append %blocks, %value
      }
      core.call @google_decisions_require_list(%blocks, "input", 1, 9007199254740991)
      %has_content = core.let false
      %bytes = core.let 0
      %pdf_bytes = core.let 0
      core.for %block in %blocks {
        core.call @google_decisions_require_object(%block, "input block")
        %kind = core.get %block["type"]
        %is_text = core.call intrinsic.eq(%kind, "text")
        core.if %is_text {
          %text = core.get %block["text"]
          core.call @google_decisions_require_string(%text, "input text", false)
          %trimmed = core.string_trim %text
          %nonempty = core.call intrinsic.ne(%trimmed, "")
          %has_content = core.call intrinsic.or(%has_content, %nonempty)
          core.continue
        }
        %allowed = core.regex_match %kind pattern "^(image|audio|video|document)$"
        %invalid = core.call intrinsic.not(%allowed)
        core.if %invalid {
          core.raise "Google Gemini Decisions: unsupported input block"
        }
        %mime = core.get %block["mime_type"]
        core.call @google_decisions_require_string(%mime, "mime_type", true)
        %document = core.call intrinsic.eq(%kind, "document")
        %prefix = core.call intrinsic.string.format("{}/", %kind)
        %valid_mime = core.call intrinsic.string.starts_with(%mime, %prefix)
        core.if %document {
          %valid_mime = core.call intrinsic.eq(%mime, "application/pdf")
        }
        %invalid = core.call intrinsic.not(%valid_mime)
        core.if %invalid {
          core.raise "Google Gemini Decisions: MIME type must match the input block type (documents must be PDF)"
        }
        %resolution = core.get %block["resolution"]
        %has_resolution = core.call intrinsic.map.contains(%block, "resolution")
        core.if %has_resolution {
          %media = core.regex_match %kind pattern "^(image|video)$"
          %valid_resolution = core.regex_match %resolution pattern "^(low|medium|high|ultra_high)$"
          %valid_resolution = core.call intrinsic.and(%media, %valid_resolution)
          %video = core.call intrinsic.eq(%kind, "video")
          %ultra = core.call intrinsic.eq(%resolution, "ultra_high")
          %bad_ultra = core.call intrinsic.and(%video, %ultra)
          %not_ultra = core.call intrinsic.not(%bad_ultra)
          %valid_resolution = core.call intrinsic.and(%valid_resolution, %not_ultra)
          %invalid = core.call intrinsic.not(%valid_resolution)
          core.if %invalid {
            core.raise "Google Gemini Decisions: invalid media resolution"
          }
        }
        %has_data = core.call intrinsic.map.contains(%block, "data")
        %has_uri = core.call intrinsic.map.contains(%block, "uri")
        %same = core.call intrinsic.eq(%has_data, %has_uri)
        core.if %same {
          core.raise "Google Gemini Decisions: media requires exactly one of data or uri"
        }
        core.if %has_data {
          %data = core.get %block["data"]
          core.call @google_decisions_require_string(%data, "media data", true)
          %length = core.call intrinsic.len(%data)
          %groups = core.call intrinsic.div(%length, 4)
          %whole = core.call intrinsic.math.floor(%groups)
          %padded = core.call intrinsic.eq(%groups, %whole)
          %base64 = core.regex_match %data pattern "^[A-Za-z0-9+/]+={0,2}$"
          %lf = core.call intrinsic.string.ends_with(%data, "\n")
          %cr = core.call intrinsic.string.ends_with(%data, "\r")
          %newline = core.call intrinsic.or(%lf, %cr)
          %valid = core.call intrinsic.and(%padded, %base64)
          %invalid = core.call intrinsic.not(%valid)
          %invalid = core.call intrinsic.or(%invalid, %newline)
          core.if %invalid {
            core.raise "Google Gemini Decisions: media data must be base64 without a data URL prefix"
          }
          %size = core.call intrinsic.mul(%groups, 3)
          %two = core.call intrinsic.string.ends_with(%data, "==")
          %one = core.call intrinsic.string.ends_with(%data, "=")
          core.if %two {
            %size = core.call intrinsic.add(%size, -2)
          } else {
            core.if %one {
              %size = core.call intrinsic.add(%size, -1)
            }
          }
          %bytes = core.call intrinsic.add(%bytes, %size)
          core.if %document {
            %pdf_bytes = core.call intrinsic.add(%pdf_bytes, %size)
          }
        } else {
          %uri = core.get %block["uri"]
          core.call @google_decisions_require_string(%uri, "media URI", true)
          %valid = core.call intrinsic.url.valid(%uri)
          %uri = core.string_trim %uri
          %lower = core.call intrinsic.string.lower(%uri)
          %https = core.call intrinsic.string.starts_with(%lower, "https://")
          %valid = core.call intrinsic.and(%valid, %https)
          %youtube = core.regex_match %lower pattern "^https://([^/?#]*@)?([^/?#:]+\\.)*(youtube\\.com|youtu\\.be)(:[0-9]+)?([/?#]|$)"
          %invalid = core.call intrinsic.not(%valid)
          %invalid = core.call intrinsic.or(%invalid, %youtube)
          core.if %invalid {
            core.raise "Google Gemini Decisions: media URI must be a Files API or public HTTPS URL; YouTube is unsupported"
          }
        }
        %has_content = core.let true
      }
      %empty = core.call intrinsic.not(%has_content)
      core.if %empty {
        core.raise "Google Gemini Decisions: input cannot be empty"
      }
      %large = core.call intrinsic.gt(%bytes, 104857600)
      %large_pdf = core.call intrinsic.gt(%pdf_bytes, 52428800)
      %large = core.call intrinsic.or(%large, %large_pdf)
      core.if %large {
        core.raise "Google Gemini Decisions: inline media exceeds 100 MB (50 MB for PDFs)"
      }
      core.return
    }
  }

  op ax.provider.semantic @google_decisions_validate_request {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "ai"
    tag "src/ax/ai/google-gemini-decisions"
    type signature = "(json) -> void throws"
    body @entry(%request: json) {
      core.call @google_decisions_require_object(%request, "request")
      %model = core.get %request["model"]
      core.call @google_decisions_require_string(%model, "model", true)
      %input = core.get %request["input"]
      core.call @google_decisions_validate_input(%input)
      %questions = core.get %request["questions"]
      core.call @google_decisions_require_object(%questions, "questions")
      %names = core.call intrinsic.map.keys(%questions)
      %count = core.call intrinsic.len(%names)
      core.call @google_decisions_require_number(%count, "questions (1–1000)", 1, 1000)
      core.for %name in %names {
        %valid = core.regex_match %name pattern "^[A-Za-z0-9_-]{1,64}$"
        %trimmed = core.string_trim %name
        %same = core.call intrinsic.eq(%trimmed, %name)
        %valid = core.call intrinsic.and(%valid, %same)
        %invalid = core.call intrinsic.not(%valid)
        core.if %invalid {
          core.raise "Google Gemini Decisions: question keys must contain 1–64 ASCII letters, digits, underscores or hyphens"
        }
        %question = core.get %questions[%name]
        core.call @google_decisions_require_object(%question, "question")
        %instructions = core.get %question["instructions"]
        core.call @google_decisions_text_content(%instructions, "instructions")
        %kind = core.get %question["type"]
        %criteria = core.get %question["criteria"]
        %noul = core.call intrinsic.eq(%kind, "noul")
        %choice = core.call intrinsic.eq(%kind, "choice")
        %score = core.call intrinsic.eq(%kind, "score")
        core.if %noul {
          %has_criteria = core.call intrinsic.map.contains(%question, "criteria")
          core.if %has_criteria {
            core.call @google_decisions_require_object(%criteria, "criteria")
            %keys = core.call intrinsic.map.keys(%criteria)
            core.for %key in %keys {
              %valid = core.regex_match %key pattern "^(true_description|false_description)$"
              %invalid = core.call intrinsic.not(%valid)
              core.if %invalid {
                core.raise "Google Gemini Decisions: unknown noul criterion"
              }
              %description = core.get %criteria[%key]
              core.call @google_decisions_require_string(%description, "criteria", false)
            }
          }
        } else {
          core.if %choice {
            core.call @google_decisions_require_object(%criteria, "choice criteria")
            %keys = core.call intrinsic.map.keys(%criteria)
            %count = core.call intrinsic.len(%keys)
            core.call @google_decisions_require_number(%count, "choice requires 2–255 options", 2, 255)
            core.for %key in %keys {
              %count = core.call intrinsic.string.codepoint_length(%key)
              core.call @google_decisions_require_number(%count, "option key", 1, 128)
              %bytes = core.call intrinsic.string.utf8_length(%key)
              core.call @google_decisions_require_number(%bytes, "option key bytes", 1, 512)
              %trimmed = core.string_trim %key
              %changed = core.call intrinsic.ne(%trimmed, %key)
              core.if %changed {
                core.raise "Google Gemini Decisions: invalid option key"
              }
              %units = core.call intrinsic.string.utf16_units(%key)
              core.for %unit in %units {
                %control = core.call intrinsic.lt(%unit, 32)
                %high_control = core.call intrinsic.gte(%unit, 127)
                %below = core.call intrinsic.lte(%unit, 159)
                %high_control = core.call intrinsic.and(%high_control, %below)
                %control = core.call intrinsic.or(%control, %high_control)
                %unicode_space = core.call @google_decisions_space(%unit)
                %not_space = core.call intrinsic.ne(%unit, 32)
                %unicode_space = core.call intrinsic.and(%unicode_space, %not_space)
                %invalid = core.call intrinsic.or(%control, %unicode_space)
                core.if %invalid {
                  core.raise "Google Gemini Decisions: invalid option key"
                }
              }
              %description = core.get %criteria[%key]
              core.call @google_decisions_require_string(%description, "criteria", false)
            }
          } else {
            core.if %score {
              core.call @google_decisions_require_list(%criteria, "score requires 2–255 levels", 2, 255)
              core.for %level in %criteria {
                core.call @google_decisions_require_string(%level, "criteria", true)
              }
            } else {
              core.raise "Google Gemini Decisions: unknown question type"
            }
          }
        }
      }
      core.return
    }
  }

  op ax.provider.semantic @google_decisions_prepare_request {
    attr core_kind = "func"
    attr emit_module = "ai"
    tag "src/ax/ai/google-gemini-decisions/api.ts"
    type signature = "(json) -> json"
    body @entry(%request: json) {
      %empty = core.map
      %snake = core.get %request["model_config"] default %empty
      %camel = core.get %request["modelConfig"] default %empty
      %config = core.call intrinsic.map.merge(%snake, %camel)
      %prepared = core.call intrinsic.map.merge(%empty, %request)
      core.set %prepared["model_config"] = %config
      core.call intrinsic.map.delete(%prepared, "modelConfig")
      core.return %prepared
    }
  }

  op ax.provider.semantic @google_decisions_truthy {
    attr core_kind = "func"
    attr emit_module = "ai"
    tag "src/ax/ai/google-gemini-decisions/api.ts"
    type signature = "(json) -> bool"
    body @entry(%value: json) {
      %object = core.type_is %value type "object"
      %list = core.type_is %value type "list"
      %collection = core.call intrinsic.or(%object, %list)
      %truthy = core.call intrinsic.truthy(%value)
      %truthy = core.call intrinsic.or(%truthy, %collection)
      core.return %truthy
    }
  }

  op ax.provider.semantic @google_decisions_build_chat_request {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "ai"
    tag "src/ax/ai/google-gemini-decisions/validate.ts"
    type signature = "(json, json) -> json throws"
    body @entry(%request: json, %options: json) {
      %empty_map = core.map
      %empty_list = core.list
      %threshold_snake = core.get %options["true_threshold"] default 0.5
      %threshold = core.get %options["trueThreshold"] default %threshold_snake
      core.call @google_decisions_require_number(%threshold, "trueThreshold", 0, 1)
      %functions = core.get %request["functions"] default %empty_list
      %function_call_snake = core.get %request["function_call"] default "none"
      %function_call = core.get %request["functionCall"] default %function_call_snake
      %has_functions = core.call intrinsic.truthy(%functions)
      %has_call = core.call intrinsic.ne(%function_call, "none")
      %has_call_value = core.call intrinsic.truthy(%function_call)
      %has_call = core.call intrinsic.and(%has_call, %has_call_value)
      %tools = core.call intrinsic.or(%has_functions, %has_call)
      core.if %tools {
        core.raise "Google Gemini Decisions does not support tools; use a generative provider for tool execution"
      }
      %config_snake = core.get %request["model_config"] default %empty_map
      %config = core.get %request["modelConfig"] default %config_snake
      %controls = core.call intrinsic.map.keys(%config)
      core.for %control in %controls {
        %value = core.get %config[%control]
        %present = core.call intrinsic.is_not_none(%value)
        core.if %present {
          %is_stream = core.call intrinsic.eq(%control, "stream")
          %is_n = core.call intrinsic.eq(%control, "n")
          %one = core.call intrinsic.eq(%value, 1)
          %numeric = core.type_is %value type "number"
          %one = core.call intrinsic.and(%one, %numeric)
          %allowed_n = core.call intrinsic.and(%is_n, %one)
          %allowed = core.call intrinsic.or(%is_stream, %allowed_n)
          %unsupported = core.call intrinsic.not(%allowed)
          core.if %unsupported {
            %message = core.call intrinsic.string.format("Google Gemini Decisions does not support generation control {}", %control)
            %error = core.call intrinsic.error.validation(%message)
            core.raise %error
          }
        }
      }
      %format_snake = core.get %request["response_format"]
      %format = core.get %request["responseFormat"] default %format_snake
      %format_type = core.get %format["type"]
      %wrong_format = core.call intrinsic.ne(%format_type, "json_schema")
      core.if %wrong_format {
        core.raise "Google Gemini Decisions requires an output schema. Use ax() with required boolean, class or rubric score outputs"
      }
      %wrapper = core.get %format["schema"]
      core.call @google_decisions_require_object(%wrapper, "responseFormat.schema")
      %schema = core.get %wrapper["schema"]
      core.call @google_decisions_require_object(%schema, "output schema")
      %root_type = core.get %schema["type"]
      %flat = core.call intrinsic.eq(%root_type, "object")
      %forbidden = core.list
      core.append %forbidden, "anyOf"
      core.append %forbidden, "oneOf"
      core.append %forbidden, "allOf"
      core.append %forbidden, "$ref"
      core.for %key in %forbidden {
        %value = core.get %schema[%key]
        %has_value = core.call @google_decisions_truthy(%value)
        core.if %has_value {
          %flat = core.let false
        }
      }
      %not_flat = core.call intrinsic.not(%flat)
      core.if %not_flat {
        core.raise "Google Gemini Decisions requires a flat object output schema"
      }
      %properties = core.get %schema["properties"]
      core.call @google_decisions_require_object(%properties, "output properties")
      %required = core.get %schema["required"] default %empty_list
      %required_list = core.type_is %required type "list"
      %annotations = core.get %format["fieldDescriptions"] default %empty_map
      %decision_fields = core.get %format["decisionFields"] default %empty_map
      %questions = core.map
      %names = core.call intrinsic.map.keys(%properties)
      %count = core.call intrinsic.len(%names)
      %empty = core.call intrinsic.eq(%count, 0)
      core.if %empty {
        core.raise "Google Gemini Decisions requires at least one output field"
      }
      core.append %forbidden, "const"
      core.for %name in %names {
        %field = core.get %properties[%name]
        core.call @google_decisions_require_object(%field, %name)
        %decision = core.get %decision_fields[%name]
        %rich = core.call intrinsic.is_not_none(%decision)
        core.if %rich {
          %array = core.get %decision["isArray"] default false
          %optional = core.get %decision["isOptional"] default false
          %invalid = core.call intrinsic.or(%array, %optional)
          core.if %invalid {
            core.raise "Decision providers require flat, required scalar outputs"
          }
          %wire_description = core.get %field["description"]
          %field = core.call intrinsic.map.merge(%empty_map, %field)
          core.call intrinsic.map.delete(%field, "anyOf")
          core.call intrinsic.map.delete(%field, "enum")
          %kind = core.get %decision["type"]
          %class_kind = core.call intrinsic.eq(%kind, "class")
          core.if %class_kind {
            %kind = core.let "string"
          }
          core.set %field["type"] = %kind
          core.set %field["description"] = %wire_description
          core.if %class_kind {
            %labels = core.get %decision["options"]
            core.set %field["enum"] = %labels
          }
        }
        %supported = core.let false
        core.if %required_list {
          %supported = core.call intrinsic.contains(%required, %name)
        }
        core.for %key in %forbidden {
          %has_key = core.call intrinsic.map.contains(%field, %key)
          %is_const = core.call intrinsic.eq(%key, "const")
          %not_const = core.call intrinsic.not(%is_const)
          core.if %not_const {
            %value = core.get %field[%key]
            %has_key = core.call @google_decisions_truthy(%value)
          }
          core.if %has_key {
            %supported = core.let false
          }
        }
        %type_name = core.get %field["type"]
        %class_options = core.get %field["enum"]
        %is_boolean = core.call intrinsic.eq(%type_name, "boolean")
        %has_enum = core.call intrinsic.is_not_none(%class_options)
        %no_enum = core.call intrinsic.not(%has_enum)
        %is_boolean = core.call intrinsic.and(%is_boolean, %no_enum)
        %is_string = core.call intrinsic.eq(%type_name, "string")
        %is_enum = core.type_is %class_options type "list"
        %is_class = core.call intrinsic.and(%is_string, %is_enum)
        %supported_type = core.call intrinsic.or(%is_boolean, %is_class)
        %is_score = core.call intrinsic.eq(%type_name, "score")
