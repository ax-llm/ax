            } else {
              core.if %audio {
                %format = core.get %raw["format"]
                %has_mime = core.call intrinsic.truthy(%mime)
                %has_format = core.call intrinsic.truthy(%format)
                %valid = core.call intrinsic.or(%has_mime, %has_format)
                %invalid = core.call intrinsic.not(%valid)
                core.if %invalid {
                  core.raise "Google Gemini Decisions requires an audio MIME type or format"
                }
                %no_mime = core.call intrinsic.not(%has_mime)
                core.if %no_mime {
                  %mime = core.call @audio_mime_type_impl(%format)
                  %rate_snake = core.get %raw["sample_rate"]
                  %rate = core.get %raw["sampleRate"] default %rate_snake
                  %has_rate = core.call intrinsic.truthy(%rate)
                  %raw_audio = core.regex_match %mime pattern "^audio/(pcm|basic|alaw)$"
                  %add_rate = core.call intrinsic.and(%has_rate, %raw_audio)
                  core.if %add_rate {
                    %mime = core.call intrinsic.string.format("{};rate={}", %mime, %rate)
                  }
                }
              } else {
                core.if %file {
                  core.call @google_decisions_require_string(%mime, "mime_type", true)
                  %kind = core.let "document"
                  %is_image = core.call intrinsic.string.starts_with(%mime, "image/")
                  %is_audio = core.call intrinsic.string.starts_with(%mime, "audio/")
                  %is_video = core.call intrinsic.string.starts_with(%mime, "video/")
                  core.if %is_image {
                    %kind = core.let "image"
                  }
                  core.if %is_audio {
                    %kind = core.let "audio"
                  }
                  core.if %is_video {
                    %kind = core.let "video"
                  }
                  %has_uri_snake = core.call intrinsic.map.contains(%raw, "file_uri")
                  %has_uri_camel = core.call intrinsic.map.contains(%raw, "fileUri")
                  %uri = core.call intrinsic.or(%has_uri_snake, %has_uri_camel)
                  core.if %uri {
                    %data_snake = core.get %raw["file_uri"]
                    %data = core.get %raw["fileUri"] default %data_snake
                  }
                } else {
                  core.raise "Google Gemini Decisions supports text, images, audio, video and PDF files; URL context is unsupported"
                }
              }
            }
            %part = core.call @google_decisions_media(%kind, %mime, %data, %uri, %resolution)
            core.append %input, %part
          }
        }
      }
      core.return %input
    }
  }
}
