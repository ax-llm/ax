    body @entry(%field: json) {
      %name = core.get %field["name"] default ""
      %title = core.get %field["title"] default %name
      %has_title = core.call intrinsic.truthy(%title)
      core.if %has_title {
        core.return %title
      }
      core.return %name
    }
  }

  op ax.stream.semantic @stream_required_missing_error_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/errors.ts"
    type signature = "(json) -> error"
    body @entry(%field: json) {
      %title = core.call @stream_field_title_impl(%field)
      %label = core.call @stream_field_type_label_impl(%field)
      %message = core.call intrinsic.string.format("Required field is missing: '{}'. After the \"{}:\" label, provide a non-empty {}. Do not use null, undefined, or leave it blank.", %title, %title, %label)
      %error = core.call intrinsic.error.validation(%message)
      core.return %error
    }
  }

  op ax.stream.semantic @stream_url_error_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/validators.ts"
    type signature = "(json, json) -> json"
    body @entry(%field: json, %value: json) {
      // validateURL: returns the TS error, or none for a valid URL.
      %title = core.call @stream_field_title_impl(%field)
      %is_string = core.type_is %value type "string"
      %not_string = core.call intrinsic.not(%is_string)
      core.if %not_string {
        %shown = core.call @stream_js_string_impl(%value)
        %type_message = core.call intrinsic.string.format("Invalid URL for '{}': URL must be a string. Use a valid URL format (e.g., https://example.com). You provided: {}.", %title, %shown)
        %type_error = core.call intrinsic.error.validation(%type_message)
        core.return %type_error
      }
      %valid = core.call intrinsic.url.valid(%value)
      core.if %valid {
        %none = core.call intrinsic.none()
        core.return %none
      }
      %message = core.call intrinsic.string.format("Invalid URL for '{}': Invalid URL format. Expected a valid URL like https://example.com. Use a valid URL format (e.g., https://example.com). You provided: {}.", %title, %value)
      %error = core.call intrinsic.error.validation(%message)
      core.return %error
    }
  }

  op ax.stream.semantic @stream_validate_constraints_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/validators.ts"
    type signature = "(json, json, string) -> void throws"
    body @entry(%field: json, %value: json, %kind: string) {
      // validateURL, validateStringConstraints or validateNumberConstraints,
      // as kind says, with the TS messages. Values of another JSON type pass.
      %title = core.call @stream_field_title_impl(%field)
      %typ = core.get %field["type"]
      %is_url = core.call intrinsic.eq(%kind, "url")
      core.if %is_url {
        %url_error = core.call @stream_url_error_impl(%field, %value)
        %bad_url = core.call intrinsic.is_not_none(%url_error)
        core.if %bad_url {
          core.raise %url_error
        }
        core.return
      }
      %is_number_kind = core.call intrinsic.eq(%kind, "number")
      core.if %is_number_kind {
        %is_number = core.type_is %value type "number"
        %not_number = core.call intrinsic.not(%is_number)
        core.if %not_number {
          core.return
        }
        %minimum = core.get %typ["minimum"]
        %has_minimum = core.call intrinsic.is_not_none(%minimum)
        core.if %has_minimum {
          %too_small = core.call intrinsic.lt(%value, %minimum)
          core.if %too_small {
            %minimum_message = core.call intrinsic.string.format("Field '{}' failed validation: Number must be at least {}. You provided: {}.", %title, %minimum, %value)
            %minimum_error = core.call intrinsic.error.validation(%minimum_message)
            core.raise %minimum_error
          }
        }
        %maximum = core.get %typ["maximum"]
        %has_maximum = core.call intrinsic.is_not_none(%maximum)
        core.if %has_maximum {
          %too_large = core.call intrinsic.gt(%value, %maximum)
          core.if %too_large {
            %maximum_message = core.call intrinsic.string.format("Field '{}' failed validation: Number must be at most {}. You provided: {}.", %title, %maximum, %value)
            %maximum_error = core.call intrinsic.error.validation(%maximum_message)
            core.raise %maximum_error
          }
        }
        core.return
      }
      %is_string = core.type_is %value type "string"
      %not_string = core.call intrinsic.not(%is_string)
      core.if %not_string {
        core.return
      }
      %length = core.call intrinsic.len(%value)
      %min_snake = core.get %typ["min_length"]
      %min_length = core.get %typ["minLength"] default %min_snake
      %has_min = core.call intrinsic.is_not_none(%min_length)
      core.if %has_min {
        %too_short = core.call intrinsic.lt(%length, %min_length)
        core.if %too_short {
          %short_message = core.call intrinsic.string.format("Field '{}' failed validation: String must be at least {} characters long. You provided: \"{}\" ({} characters).", %title, %min_length, %value, %length)
          %short_error = core.call intrinsic.error.validation(%short_message)
          core.raise %short_error
        }
      }
      %max_snake = core.get %typ["max_length"]
      %max_length = core.get %typ["maxLength"] default %max_snake
      %has_max = core.call intrinsic.is_not_none(%max_length)
      core.if %has_max {
        %too_long = core.call intrinsic.gt(%length, %max_length)
        core.if %too_long {
          %long_message = core.call intrinsic.string.format("Field '{}' failed validation: String must be at most {} characters long. You provided: \"{}\" ({} characters).", %title, %max_length, %value, %length)
          %long_error = core.call intrinsic.error.validation(%long_message)
          core.raise %long_error
        }
      }
      %pattern = core.get %typ["pattern"]
      %has_pattern = core.call intrinsic.is_not_none(%pattern)
      core.if %has_pattern {
        %matches = core.call @regex_test(%pattern, %value)
        %no_match = core.call intrinsic.not(%matches)
        core.if %no_match {
          %pattern_message = core.call intrinsic.string.format("Field '{}' failed validation: String must match pattern /{}/. You provided: \"{}\".", %title, %pattern, %value)
          %pattern_error = core.call intrinsic.error.validation(%pattern_message)
          core.raise %pattern_error
        }
      }
      %format = core.get %typ["format"]
      %is_email = core.call intrinsic.eq(%format, "email")
      core.if %is_email {
        %email_ok = core.regex_match %value pattern "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        %email_bad = core.call intrinsic.not(%email_ok)
        core.if %email_bad {
          %email_message = core.call intrinsic.string.format("Field '{}' failed validation: String must be a valid email address. You provided: \"{}\".", %title, %value)
          %email_error = core.call intrinsic.error.validation(%email_message)
          core.raise %email_error
        }
      }
      %is_uri = core.call intrinsic.eq(%format, "uri")
      %is_url_format = core.call intrinsic.eq(%format, "url")
      %url_format = core.call intrinsic.or(%is_uri, %is_url_format)
      core.if %url_format {
        %url_ok = core.call intrinsic.url.valid(%value)
        %url_bad = core.call intrinsic.not(%url_ok)
        core.if %url_bad {
          %format_message = core.call intrinsic.string.format("Field '{}' failed validation: String must be a valid URL. You provided: \"{}\".", %title, %value)
          %format_error = core.call intrinsic.error.validation(%format_message)
          core.raise %format_error
        }
      }
      core.return
    }
  }

  op ax.stream.semantic @stream_convert_value_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/extract/fieldValue.ts"
    type signature = "(json, json, bool) -> json throws"
    body @entry(%field: json, %value: json, %required: bool) {
      // convertValueToType. Returns {has, value}: has is false where TS
      // returns undefined. Failures raise plain errors for the caller to wrap.
      %out = core.map
      core.set %out["has"] = true
      core.set %out["value"] = %value
      %typ = core.get %field["type"]
      %name = core.get %typ["name"] default "string"
      %optional = core.call @stream_field_flag_impl(%field, "is_optional", "isOptional")
      %lenient = core.call intrinsic.not(%required)
      %may_skip = core.call intrinsic.and(%optional, %lenient)
      %is_code = core.call intrinsic.eq(%name, "code")
      core.if %is_code {
        %code_text = core.call @stream_js_string_impl(%value)
        %block = core.call @stream_extract_block_impl(%code_text)
        core.set %out["value"] = %block
        core.return %out
      }
      %is_string = core.call intrinsic.eq(%name, "string")
      core.if %is_string {
        %text = core.call @stream_js_string_impl(%value)
        core.set %out["value"] = %text
        core.return %out
      }
      %is_number = core.call intrinsic.eq(%name, "number")
      core.if %is_number {
        %number = core.call @stream_js_number_impl(%value)
        %nan = core.call intrinsic.is_none(%number)
        core.if %nan {
          core.if %may_skip {
            core.set %out["has"] = false
            core.return %out
          }
          %number_error = core.call intrinsic.error.runtime("Invalid number")
          core.raise %number_error
        }
        core.set %out["value"] = %number
        core.return %out
      }
      %is_boolean = core.call intrinsic.eq(%name, "boolean")
      core.if %is_boolean {
        %already = core.type_is %value type "boolean"
        core.if %already {
          core.return %out
        }
        %bool_text = core.call @stream_js_string_impl(%value)
        %lowered = core.call intrinsic.string.lower(%bool_text)
        %is_true = core.call intrinsic.eq(%lowered, "true")
        core.if %is_true {
          core.set %out["value"] = true
          core.return %out
        }
        %is_false = core.call intrinsic.eq(%lowered, "false")
        core.if %is_false {
          core.set %out["value"] = false
          core.return %out
        }
        core.if %may_skip {
          core.set %out["has"] = false
          core.return %out
        }
        %boolean_error = core.call intrinsic.error.runtime("Invalid boolean")
        core.raise %boolean_error
      }
      %is_class = core.call intrinsic.eq(%name, "class")
      core.if %is_class {
        %class_name = core.call @stream_js_string_impl(%value)
        %options = core.get %typ["options"]
        %has_options = core.call intrinsic.truthy(%options)
        core.if %has_options {
          %known = core.call intrinsic.contains(%options, %class_name)
          %unknown = core.call intrinsic.not(%known)
          core.if %unknown {
            core.if %optional {
              core.set %out["has"] = false
              core.return %out
            }
            %option_list = core.string_join %options sep ", "
            %class_message = core.call intrinsic.string.format("Invalid class '{}', expected one of the following: {}", %class_name, %option_list)
            %class_error = core.call intrinsic.error.runtime(%class_message)
            core.raise %class_error
          }
        }
        core.set %out["value"] = %class_name
        core.return %out
      }
      // Date and datetime fields keep their text, as the ports' forward does;
      // TS parses them into Date values.
      core.return %out
    }
  }

  op ax.stream.semantic @stream_field_value_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/extract/fieldValue.ts"
    type signature = "(json, string) -> json throws"
    body @entry(%field: json, %text: string) {
      // validateAndParseFieldValue. Returns {has, value}; has is false where
      // TS returns undefined.
      %out = core.map
      core.set %out["has"] = false
      %none = core.call intrinsic.none()
      core.set %out["value"] = %none
      %optional = core.call @stream_field_flag_impl(%field, "is_optional", "isOptional")
      %title = core.call @stream_field_title_impl(%field)
      %type_label = core.call @stream_field_type_label_impl(%field)
      %empty = core.call intrinsic.eq(%text, "")
      %lowered = core.call intrinsic.string.lower(%text)
      %null_rest = core.let "x"
      %starts_null = core.call intrinsic.string.starts_with(%lowered, "null")
      core.if %starts_null {
        %after_null = core.call intrinsic.string.slice(%lowered, 4)
        %null_rest = core.string_trim %after_null
      }
      %starts_undefined = core.call intrinsic.string.starts_with(%lowered, "undefined")
      core.if %starts_undefined {
        %after_undefined = core.call intrinsic.string.slice(%lowered, 9)
        %null_rest = core.string_trim %after_undefined
      }
      %null_text = core.call intrinsic.eq(%null_rest, "")
      %missing = core.call intrinsic.or(%empty, %null_text)
      core.if %missing {
        core.if %optional {
          core.return %out
        }
        %missing_error = core.call @stream_required_missing_error_impl(%field)
        core.raise %missing_error
      }
      %typ = core.get %field["type"]
      %name = core.get %typ["name"] default "string"
      %is_array = core.call @stream_field_flag_impl(%typ, "is_array", "isArray")
      %is_json = core.call intrinsic.eq(%name, "json")
      %not_array = core.call intrinsic.not(%is_array)
      %json_scalar = core.call intrinsic.and(%is_json, %not_array)
      core.if %json_scalar {
        core.try {
          %json_text = core.call @stream_extract_block_impl(%text)
          %json_value = core.call intrinsic.json.parse_strict(%json_text)
          core.set %out["has"] = true
          core.set %out["value"] = %json_value
        } catch %json_error {
          %json_detail = core.call intrinsic.exception.message(%json_error)
          %json_message = core.call intrinsic.string.format("Invalid JSON: {} in field '{}'. Return only valid JSON. Prefer a fenced code block containing a single JSON object or array with no trailing text.", %json_detail, %title)
          %invalid_json = core.call intrinsic.error.validation(%json_message)
          core.raise %invalid_json
        }
        core.return %out
      }
      %value = core.call intrinsic.none()
      %has_value = core.let false
      core.if %is_array {
        core.try {
          %parsed_list = core.call intrinsic.none()
          core.try {
            %parsed_list = core.call intrinsic.json.parse_strict(%text)
          } catch %not_json {
            %parsed_list = core.call @stream_markdown_list_impl(%text)
          }
          %is_list = core.type_is %parsed_list type "list"
          %not_list = core.call intrinsic.not(%is_list)
          core.if %not_list {
            %shape_error = core.call intrinsic.error.runtime("Expected an array")
            core.raise %shape_error
          }
          %value = core.let %parsed_list
        } catch %array_error {
          %array_detail = core.call intrinsic.exception.message(%array_error)
          %no_items = core.call intrinsic.string.index_of(%array_detail, "no valid list items found", 0)
          %found_no_items = core.call intrinsic.gte(%no_items, 0)
          %expected_array = core.call intrinsic.eq(%array_detail, "Expected an array")
          %single_value = core.call intrinsic.or(%found_no_items, %expected_array)
          core.if %single_value {
            %single = core.list
            core.append %single, %text
            %value = core.let %single
          } else {
            %array_message = core.call intrinsic.string.format("Invalid Array: {} for '{}'. Provide a JSON array of {} items (e.g., [ ... ]). Markdown lists are also accepted if each item is on its own line starting with a hyphen.", %array_detail, %title, %type_label)
            %invalid_array = core.call intrinsic.error.validation(%array_message)
            core.raise %invalid_array
          }
        }
        %has_value = core.let true
      }
      core.try {
        core.if %is_array {
          %converted_items = core.list
          %is_object_type = core.call intrinsic.eq(%name, "object")
          %json_items = core.call intrinsic.or(%is_object_type, %is_json)
          core.for %item in %value {
            %item_value = core.let %item
            %item_is_string = core.type_is %item type "string"
            core.if %item_is_string {
              %item_value = core.string_trim %item
              core.if %json_items {
                core.try {
                  %item_block = core.call @stream_extract_block_impl(%item_value)
                  %item_value = core.call intrinsic.json.parse_strict(%item_block)
                } catch %item_json_error {
                }
              }
            }
            %converted = core.call @stream_convert_value_impl(%field, %item_value, true)
            %converted_has = core.get %converted["has"] default false
            core.if %converted_has {
              %converted_value = core.get %converted["value"]
              core.append %converted_items, %converted_value
            } else {
              %undefined_item = core.call intrinsic.none()
              core.append %converted_items, %undefined_item
            }
          }
          %value = core.let %converted_items
        } else {
          %scalar = core.call @stream_convert_value_impl(%field, %text, false)
          %has_value = core.get %scalar["has"] default false
          %value = core.get %scalar["value"]
        }
      } catch %convert_error {
        %convert_detail = core.call intrinsic.exception.message(%convert_error)
        %convert_message = core.call intrinsic.string.format("Field '{}' has an invalid value '{}': {}. Provide a {}. Ensure formatting exactly matches the expected type.", %title, %text, %convert_detail, %type_label)
        %invalid_value = core.call intrinsic.error.validation(%convert_message)
        core.raise %invalid_value
      }
      %not_has = core.call intrinsic.not(%has_value)
      core.if %not_has {
        core.return %out
      }
      %value_is_string = core.type_is %value type "string"
      core.if %value_is_string {
        %empty_value = core.call intrinsic.eq(%value, "")
        core.if %empty_value {
          core.return %out
        }
      }
      %is_url = core.call intrinsic.eq(%name, "url")
      %is_code = core.call intrinsic.eq(%name, "code")
      %is_string = core.call intrinsic.eq(%name, "string")
      %string_like = core.call intrinsic.or(%is_string, %is_code)
      %is_number = core.call intrinsic.eq(%name, "number")
      %scalar_url = core.call intrinsic.and(%is_url, %not_array)
      core.if %scalar_url {
        core.call @stream_validate_constraints_impl(%field, %value, "url")
      }
      core.if %string_like {
        core.call @stream_validate_constraints_impl(%field, %value, "string")
      }
      core.if %is_number {
        core.call @stream_validate_constraints_impl(%field, %value, "number")
      }
      %value_is_list = core.type_is %value type "list"
      %check_items = core.call intrinsic.and(%is_array, %value_is_list)
      core.if %check_items {
        core.for %checked in %value {
          %checked_missing = core.call intrinsic.is_none(%checked)
          core.if %checked_missing {
            core.continue
          }
          core.if %is_url {
            core.call @stream_validate_constraints_impl(%field, %checked, "url")
          } else {
            core.if %string_like {
              core.call @stream_validate_constraints_impl(%field, %checked, "string")
            }
            core.if %is_number {
              core.call @stream_validate_constraints_impl(%field, %checked, "number")
            }
          }
        }
      }
      core.set %out["has"] = true
      core.set %out["value"] = %value
      core.return %out
    }
  }

  op ax.stream.semantic @stream_text_state_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/extract/streamingText.ts"
    type signature = "() -> json"
    body @entry() {
      // extractionState: the current field, where its value starts (s), the
      // closed fields not yet streamed, and how much of each field streamed.
      %xstate = core.map
      %prev_fields = core.list
      core.set %xstate["prev_fields"] = %prev_fields
      %none = core.call intrinsic.none()
      core.set %xstate["curr_field"] = %none
      core.set %xstate["curr_field_index"] = %none
      core.set %xstate["in_assumed_field"] = false
      %extracted = core.list
      core.set %xstate["extracted_fields"] = %extracted
      %streamed = core.map
      core.set %xstate["streamed_index"] = %streamed
      core.set %xstate["s"] = -1
      core.return %xstate
    }
  }

  op ax.stream.semantic @stream_text_note_field_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/extract/streamingText.ts"
    type signature = "(json, json, bool) -> void"
    body @entry(%xstate: json, %field: json, %init_streamed: bool) {
      %name = core.get %field["name"] default ""
      %empty_extracted = core.list
      %extracted = core.get %xstate["extracted_fields"] default %empty_extracted
      %seen = core.call intrinsic.contains(%extracted, %name)
      %unseen = core.call intrinsic.not(%seen)
      core.if %unseen {
        core.append %extracted, %name
        core.set %xstate["extracted_fields"] = %extracted
      }
      core.if %init_streamed {
        %empty_streamed = core.map
        %streamed = core.get %xstate["streamed_index"] default %empty_streamed
        %has_index = core.call intrinsic.map.contains(%streamed, %name)
        %missing_index = core.call intrinsic.not(%has_index)
        core.if %missing_index {
          core.set %streamed[%name] = 0
        }
        core.set %xstate["streamed_index"] = %streamed
      }
      core.return
    }
  }

  op ax.stream.semantic @stream_text_extract_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/extract/streamingText.ts"
    type signature = "(json, json, string, list<json>) -> bool throws"
    body @entry(%xstate: json, %values: json, %content: string, %fields: list<json>) {
      // streamingExtractValues: finds the next `Label:` after the current
      // field's value start, parses the field it closes into values, and
      // records the closed field for streaming. Returns true to skip the
      // chunk while the content may still end in a partial label. A
      // single-field signature with no label yet assumes that field.
      %field_count = core.call intrinsic.len(%fields)
      core.loop {
        %exclude = core.let -1
        %curr_index = core.get %xstate["curr_field_index"]
        %assumed = core.get %xstate["in_assumed_field"] default false
        %has_index = core.call intrinsic.is_not_none(%curr_index)
        %not_assumed = core.call intrinsic.not(%assumed)
        %exclude_curr = core.call intrinsic.and(%has_index, %not_assumed)
        core.if %exclude_curr {
          %exclude = core.let %curr_index
        }
        %chosen_index = core.let -1
        %chosen_field = core.call intrinsic.none()
        %end = core.let -1
        %prefix_length = core.let 0
        %partial_prefix = core.let false
        %empty_extracted = core.list
        %extracted = core.get %xstate["extracted_fields"] default %empty_extracted
        %extracted_count = core.call intrinsic.len(%extracted)
        %is_first = core.call intrinsic.eq(%extracted_count, 0)
        %start = core.get %xstate["s"] default -1
        %position = core.let 0
        core.for %field in %fields {
          %skip_field = core.call intrinsic.eq(%position, %exclude)
          %try_field = core.call intrinsic.not(%skip_field)
          core.if %try_field {
            %labels = core.call @stream_field_labels_impl(%field)
            core.for %label in %labels {
              %prefix = core.call intrinsic.string.format("\n{}:", %label)
              core.if %is_first {
                %prefix = core.call intrinsic.string.format("{}:", %label)
              }
              %match_at = core.call @stream_matches_content_impl(%content, %prefix, %start)
              %partial = core.call intrinsic.lte(%match_at, -2)
              core.if %partial {
                %partial_prefix = core.let true
              }
              %hit = core.call intrinsic.gte(%match_at, 0)
              core.if %hit {
                %first_hit = core.call intrinsic.eq(%end, -1)
                %earlier = core.call intrinsic.lt(%match_at, %end)
                %better = core.call intrinsic.or(%first_hit, %earlier)
                core.if %better {
                  %end = core.let %match_at
                  %prefix_length = core.call intrinsic.len(%prefix)
                  %chosen_index = core.let %position
                  %chosen_field = core.let %field
                }
              }
            }
          }
          %position = core.call intrinsic.add(%position, 1)
        }
        %not_found = core.call intrinsic.eq(%end, -1)
        core.if %not_found {
          core.if %partial_prefix {
            core.return true
          }
          %curr_field = core.get %xstate["curr_field"]
          %no_curr = core.call intrinsic.is_none(%curr_field)
          %nothing_extracted = core.call intrinsic.eq(%extracted_count, 0)
          %single = core.call intrinsic.eq(%field_count, 1)
          %assume_start = core.call intrinsic.and(%no_curr, %nothing_extracted)
          %assume = core.call intrinsic.and(%assume_start, %single)
          core.if %assume {
            %only = core.call intrinsic.list.get(%fields, 0)
            core.set %xstate["in_assumed_field"] = true
            core.set %xstate["curr_field"] = %only
            core.set %xstate["curr_field_index"] = 0
            core.set %xstate["s"] = 0
            core.call @stream_text_note_field_impl(%xstate, %only, true)
            core.return false
          }
          core.break
        }
        %curr = core.get %xstate["curr_field"]
        %has_curr = core.call intrinsic.is_not_none(%curr)
        %in_assumed = core.get %xstate["in_assumed_field"] default false
        %leave_assumed = core.call intrinsic.and(%has_curr, %in_assumed)
        core.if %leave_assumed {
          // A label after an assumed single field starts the field over.
          core.set %xstate["in_assumed_field"] = false
          %assumed_name = core.get %curr["name"] default ""
          %empty_streamed = core.map
          %streamed = core.get %xstate["streamed_index"] default %empty_streamed
          core.set %streamed[%assumed_name] = 0
          core.set %xstate["streamed_index"] = %streamed
          %cleared = core.call intrinsic.none()
          core.set %xstate["curr_field"] = %cleared
          %has_curr = core.let false
        }
        core.if %has_curr {
          %raw = core.call @stream_substring_impl(%content, %start, %end)
          %text = core.string_trim %raw
          %parsed = core.call @stream_field_value_impl(%curr, %text)
          %parsed_has = core.get %parsed["has"] default false
          core.if %parsed_has {
            %curr_name = core.get %curr["name"] default ""
            %parsed_value = core.get %parsed["value"]
            core.set %values[%curr_name] = %parsed_value
          }
          %entry = core.map
          core.set %entry["field"] = %curr
          core.set %entry["s"] = %start
          core.set %entry["e"] = %end
          %empty_prev = core.list
          %prev_fields = core.get %xstate["prev_fields"] default %empty_prev
          core.append %prev_fields, %entry
          core.set %xstate["prev_fields"] = %prev_fields
        }
        %next_start = core.call intrinsic.add(%end, %prefix_length)
        core.set %xstate["s"] = %next_start
        core.set %xstate["curr_field"] = %chosen_field
        core.set %xstate["curr_field_index"] = %chosen_index
        core.call @stream_text_note_field_impl(%xstate, %chosen_field, true)
      }
      core.return false
    }
  }

  op ax.stream.semantic @stream_text_required_check_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/extract/streamingText.ts"
    type signature = "(json, list<json>) -> void throws"
    body @entry(%values: json, %fields: list<json>) {
      // checkMissingRequiredFields, internal fields included.
      %parts = core.list
      %first = core.call intrinsic.none()
      core.for %field in %fields {
        %optional = core.call @stream_field_flag_impl(%field, "is_optional", "isOptional")
        core.if %optional {
          core.continue
        }
        %name = core.get %field["name"] default ""
        %present = core.call intrinsic.map.contains(%values, %name)
        core.if %present {
          core.continue
        }
        %no_first = core.call intrinsic.is_none(%first)
        core.if %no_first {
          %first = core.let %field
        }
        %title = core.call @stream_field_title_impl(%field)
        %label = core.call @stream_field_type_label_impl(%field)
        %part = core.call intrinsic.string.format("'{}' ({})", %title, %label)
        core.append %parts, %part
      }
      %missing_count = core.call intrinsic.len(%parts)
      %none_missing = core.call intrinsic.eq(%missing_count, 0)
      core.if %none_missing {
        core.return
      }
      %list = core.string_join %parts sep ", "
      %first_title = core.call @stream_field_title_impl(%first)
      %first_label = core.call @stream_field_type_label_impl(%first)
      %message = core.call intrinsic.string.format("Required field not found: {}. Add a line starting with the exact label followed by a colon (e.g., \"{}:\") and then provide a valid {} value. Keep the output concise and avoid unrelated text.", %list, %first_title, %first_label)
      %error = core.call intrinsic.error.validation(%message)
      core.raise %error
    }
  }

  op ax.stream.semantic @stream_text_missed_fields_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/extract/streamingText.ts"
    type signature = "(json, string, list<json>) -> void throws"
    body @entry(%values: json, %content: string, %fields: list<json>) {
      // parseMissedFieldsFromFullContent: a single field takes the text after
      // its first label; otherwise each missing field takes the first line
      // that starts with its label.
      %field_count = core.call intrinsic.len(%fields)
      %single = core.call intrinsic.eq(%field_count, 1)
      core.if %single {
        %field = core.call intrinsic.list.get(%fields, 0)
        %labels = core.call @stream_field_labels_impl(%field)
        %best_start = core.let -1
        %best_length = core.let 0
        core.for %label in %labels {
          %prefix = core.call intrinsic.string.format("{}:", %label)
          %at = core.call intrinsic.string.index_of(%content, %prefix, 0)
          %found = core.call intrinsic.gte(%at, 0)
          core.if %found {
            %first_found = core.call intrinsic.eq(%best_start, -1)
            %earlier = core.call intrinsic.lt(%at, %best_start)
            %better = core.call intrinsic.or(%first_found, %earlier)
            core.if %better {
              %best_start = core.let %at
              %best_length = core.call intrinsic.len(%prefix)
            }
          }
        }
        %labelled = core.call intrinsic.gte(%best_start, 0)
        core.if %labelled {
          %value_start = core.call intrinsic.add(%best_start, %best_length)
          %value_end = core.call intrinsic.len(%content)
          core.for %boundary_label in %labels {
            %boundary = core.call intrinsic.string.format("\n{}:", %boundary_label)
            %boundary_at = core.call intrinsic.string.index_of(%content, %boundary, %value_start)
            %boundary_found = core.call intrinsic.gte(%boundary_at, 0)
            %boundary_earlier = core.call intrinsic.lt(%boundary_at, %value_end)
            %use_boundary = core.call intrinsic.and(%boundary_found, %boundary_earlier)
            core.if %use_boundary {
              %value_end = core.let %boundary_at
            }
          }
          %raw = core.call @stream_substring_impl(%content, %value_start, %value_end)
          %text = core.string_trim %raw
          %has_text = core.call intrinsic.ne(%text, "")
          core.if %has_text {
            %done = core.let false
            core.try {
              %parsed = core.call @stream_field_value_impl(%field, %text)
              %parsed_has = core.get %parsed["has"] default false
              core.if %parsed_has {
                %name = core.get %field["name"] default ""
                %parsed_value = core.get %parsed["value"]
                core.set %values[%name] = %parsed_value
                %done = core.let true
              }
            } catch %single_error {
            }
            core.if %done {
              core.return
            }
          }
        }
      }
      %lines = core.call intrinsic.string.split(%content, "\n")
      core.for %missed in %fields {
        %missed_name = core.get %missed["name"] default ""
        %present = core.call intrinsic.map.contains(%values, %missed_name)
        core.if %present {
          core.continue
        }
        %missed_labels = core.call @stream_field_labels_impl(%missed)
        %optional = core.call @stream_field_flag_impl(%missed, "is_optional", "isOptional")
        core.for %line in %lines {
          %trimmed_line = core.string_trim %line
          %matched = core.call intrinsic.none()
          core.for %line_label in %missed_labels {
            %line_prefix = core.call intrinsic.string.format("{}:", %line_label)
            %starts = core.call intrinsic.string.starts_with(%trimmed_line, %line_prefix)
            core.if %starts {
              %matched = core.let %line_prefix
              core.break
            }
          }
          %no_match = core.call intrinsic.is_none(%matched)
          core.if %no_match {
            core.continue
          }
          %matched_length = core.call intrinsic.len(%matched)
          %after = core.call intrinsic.string.slice(%trimmed_line, %matched_length)
          %line_value = core.string_trim %after
          %has_line_value = core.call intrinsic.ne(%line_value, "")
          core.if %has_line_value {
            core.try {
              %line_parsed = core.call @stream_field_value_impl(%missed, %line_value)
              %line_has = core.get %line_parsed["has"] default false
              core.if %line_has {
                %line_parsed_value = core.get %line_parsed["value"]
                core.set %values[%missed_name] = %line_parsed_value
              }
            } catch %line_error {
              %required = core.call intrinsic.not(%optional)
              core.if %required {
                core.raise %line_error
              }
            }
          }
          core.break
        }
      }
      core.return
    }
  }

  op ax.stream.semantic @stream_text_final_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/extract/streamingText.ts"
    type signature = "(json, json, string, list<json>) -> void throws"
    body @entry(%xstate: json, %values: json, %content: string, %fields: list<json>) {
      // streamingExtractFinalValue with forceFinalize: parse the current
      // field up to the next label, recover missed fields, then require the
      // required ones.
      %field_count = core.call intrinsic.len(%fields)
      %curr = core.get %xstate["curr_field"]
      %no_curr = core.call intrinsic.is_none(%curr)
      %single = core.call intrinsic.eq(%field_count, 1)
      %assume = core.call intrinsic.and(%no_curr, %single)
      core.if %assume {
        %only = core.call intrinsic.list.get(%fields, 0)
        core.set %xstate["curr_field"] = %only
        core.set %xstate["curr_field_index"] = 0
        core.set %xstate["in_assumed_field"] = true
        core.set %xstate["s"] = 0
        core.call @stream_text_note_field_impl(%xstate, %only, false)
        %curr = core.let %only
      }
      %has_curr = core.call intrinsic.is_not_none(%curr)
      core.if %has_curr {
        %curr_name = core.get %curr["name"] default ""
        %start = core.get %xstate["s"] default 0
        %end = core.call intrinsic.len(%content)
        core.for %other in %fields {
          %other_name = core.get %other["name"] default ""
          %same = core.call intrinsic.eq(%other_name, %curr_name)
          core.if %same {
            core.continue
          }
          %other_labels = core.call @stream_field_labels_impl(%other)
          core.for %label in %other_labels {
            %pattern = core.call intrinsic.string.format("\n{}:", %label)
            %at = core.call intrinsic.string.index_of(%content, %pattern, %start)
            %found = core.call intrinsic.gte(%at, 0)
            %earlier = core.call intrinsic.lt(%at, %end)
            %closer = core.call intrinsic.and(%found, %earlier)
            core.if %closer {
              %end = core.let %at
            }
          }
        }
        %raw = core.call @stream_substring_impl(%content, %start, %end)
        %text = core.string_trim %raw
        %parsed = core.call @stream_field_value_impl(%curr, %text)
        %parsed_has = core.get %parsed["has"] default false
        core.if %parsed_has {
          %parsed_value = core.get %parsed["value"]
          core.set %values[%curr_name] = %parsed_value
        }
      }
      core.call @stream_text_missed_fields_impl(%values, %content, %fields)
      core.call @stream_text_required_check_impl(%values, %fields)
      core.return
    }
  }

  op ax.stream.semantic @stream_text_extract_values_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/extract/streamingText.ts"
    type signature = "(string, list<json>) -> json throws"
    body @entry(%content: string, %fields: list<json>) {
      // extractValues: TS parses a whole response with the streaming
      // extractor and drops the internal fields.
      %values = core.map
      %xstate = core.call @stream_text_state_impl()
      core.call @stream_text_extract_impl(%xstate, %values, %content, %fields)
      core.call @stream_text_final_impl(%xstate, %values, %content, %fields)
      core.for %field in %fields {
        %internal = core.call @stream_field_flag_impl(%field, "is_internal", "isInternal")
        core.if %internal {
          %name = core.get %field["name"] default ""
          core.call intrinsic.map.delete(%values, %name)
        }
      }
      core.return %values
    }
  }

  op ax.stream.semantic @stream_text_yield_delta_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/extract/delta.ts"
    type signature = "(string, json, i64, i64, json, list<string>) -> json"
    body @entry(%content: string, %field: json, %start: i64, %end: i64, %xstate: json, %held: list<string>) {
      // yieldDelta: the not yet streamed text of a string or code field,
      // holding back trailing whitespace and code fences. Returns the delta
      // or none.
      %none = core.call intrinsic.none()
      %name = core.get %field["name"] default ""
      %internal = core.call @stream_field_flag_impl(%field, "is_internal", "isInternal")
      %typ = core.get %field["type"]
      %type_name = core.get %typ["name"] default ""
      %is_array = core.call @stream_field_flag_impl(%typ, "is_array", "isArray")
      %untyped = core.call intrinsic.eq(%type_name, "")
      %is_string = core.call intrinsic.eq(%type_name, "string")
      %is_code = core.call intrinsic.eq(%type_name, "code")
      %texty = core.call intrinsic.or(%untyped, %is_string)
      %texty = core.call intrinsic.or(%texty, %is_code)
      %not_texty = core.call intrinsic.not(%texty)
      %skip = core.call intrinsic.or(%internal, %is_array)
      %skip = core.call intrinsic.or(%skip, %not_texty)
      %is_held = core.call intrinsic.contains(%held, %name)
      %skip = core.call intrinsic.or(%skip, %is_held)
      core.if %skip {
        core.return %none
      }
      %empty_streamed = core.map
      %streamed = core.get %xstate["streamed_index"] default %empty_streamed
      %position = core.get %streamed[%name] default 0
      %first_chunk = core.call intrinsic.eq(%position, 0)
      %base = core.let %start
      %before_start = core.call intrinsic.lt(%base, 0)
      core.if %before_start {
        %base = core.let 0
      }
      %from_index = core.call intrinsic.add(%base, %position)
      %d1 = core.call @stream_substring_impl(%content, %from_index, %end)
      %d1_length = core.call intrinsic.len(%d1)
      %nothing = core.call intrinsic.eq(%d1_length, 0)
      core.if %nothing {
        core.return %none
      }
      %curr = core.get %xstate["curr_field"]
      %curr_type = core.get %curr["type"]
      %curr_type_name = core.get %curr_type["name"] default ""
      %curr_code = core.call intrinsic.eq(%curr_type_name, "code")
      %d2 = core.call @stream_trim_end_impl(%d1)
      core.if %curr_code {
        %d2 = core.call @stream_strip_trailing_fence_impl(%d2)
      }
      %d3 = core.let %d2
      core.if %first_chunk {
        %d3 = core.call @stream_trim_start_impl(%d2)
      }
      core.if %curr_code {
        %d3 = core.call @stream_strip_leading_fence_impl(%d3)
      }
      %d3_length = core.call intrinsic.len(%d3)
      %has_text = core.call intrinsic.gt(%d3_length, 0)
      core.if %has_text {
        %d2_length = core.call intrinsic.len(%d2)
