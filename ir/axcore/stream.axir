module @ax.stream version "0.1" {
  dialect @ax.stream version "0.1"

  op ax.stream.semantic @fold_stream {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    tag "src/ax/dsp/response/streaming.ts"
    type signature = "(list<json>) -> string throws"
    body @entry(%events: list<json>) {
      %chunks = core.list
      core.for %event in %events {
        %empty_results = core.list
        %results = core.get %event["results"] default %empty_results
        core.for %result in %results {
          %finish_snake = core.get %result["finish_reason"]
          %finish = core.get %result["finishReason"] default %finish_snake
          %is_length = core.call intrinsic.eq(%finish, "length")
          core.if %is_length {
            core.raise "Max tokens reached before completion"
          }
          %is_error = core.call intrinsic.eq(%finish, "error")
          core.if %is_error {
            core.raise "Streaming response failed"
          }
        }
        %parts = core.call @stream_event_content_parts_impl(%event)
        core.for %part in %parts {
          core.append %chunks, %part
        }
      }
      %folded = core.string_join %chunks sep ""
      core.return %folded
    }
  }

  op ax.stream.semantic @stream_extraction_route {
    attr core_kind = "func"
    attr emit_module = "gen"
    tag "structured-stream-routing"
    type signature = "(has_complex_fields:bool) -> string"
    body @entry(%has_complex_fields: bool) {
      core.if %has_complex_fields {
        core.return "structured_json"
      }
      core.return "prompt_extraction"
    }
  }

  op ax.stream.semantic @stream_structured_delta {
    attr core_kind = "func"
    attr emit_module = "gen"
    tag "structured-stream-delta"
    type signature = "(fields:list<json>, parsed_values:json, previous_values:json, partial_array_incomplete:bool) -> json"
    body @entry(%fields: list<json>, %parsed_values: json, %previous_values: json, %partial_array_incomplete: bool) {
      %delta = core.map
      %full_values = core.map
      core.for %field in %fields {
        %key = core.get %field["name"] default ""
        %internal_snake = core.get %field["is_internal"] default false
        %is_internal = core.get %field["isInternal"] default %internal_snake
        %has_parsed = core.call intrinsic.map.contains(%parsed_values, %key)
        %not_internal = core.call intrinsic.not(%is_internal)
        %include = core.call intrinsic.and(%has_parsed, %not_internal)
        core.if %include {
          %new_value_raw = core.get %parsed_values[%key]
          %new_is_list = core.type_is %new_value_raw type "list"
          %new_value = core.let %new_value_raw
          core.if %new_is_list {
            %new_count_raw = core.call intrinsic.len(%new_value_raw)
            %has_last = core.call intrinsic.gt(%new_count_raw, 0)
            %trim_last = core.call intrinsic.and(%partial_array_incomplete, %has_last)
            core.if %trim_last {
              %trimmed = core.list
              %keep_count = core.call intrinsic.add(%new_count_raw, -1)
              %trim_cursor = core.let 0
              core.for %item in %new_value_raw {
                %keep_item = core.call intrinsic.lt(%trim_cursor, %keep_count)
                core.if %keep_item {
                  core.append %trimmed, %item
                }
                %trim_cursor_next = core.call intrinsic.add(%trim_cursor, 1)
                %trim_cursor = core.let %trim_cursor_next
              }
              %new_value = core.let %trimmed
            }
          }
          core.set %full_values[%key] = %new_value

          %old_present = core.call intrinsic.map.contains(%previous_values, %key)
          %old_value = core.get %previous_values[%key]
          %old_is_list = core.type_is %old_value type "list"
          %should_emit = core.let false
          %delta_value = core.call intrinsic.none()

          core.if %new_is_list {
            core.if %old_is_list {
              %new_count = core.call intrinsic.len(%new_value)
              %old_count = core.call intrinsic.len(%old_value)
              %grew = core.call intrinsic.gt(%new_count, %old_count)
              core.if %grew {
                %suffix = core.list
                %cursor = core.let 0
                core.for %item in %new_value {
                  %is_suffix = core.call intrinsic.gte(%cursor, %old_count)
                  core.if %is_suffix {
                    core.append %suffix, %item
                  }
                  %cursor_next = core.call intrinsic.add(%cursor, 1)
                  %cursor = core.let %cursor_next
                }
                %delta_value = core.let %suffix
                %should_emit = core.let true
              }
            } else {
              %old_missing = core.call intrinsic.not(%old_present)
              core.if %old_missing {
                %delta_value = core.let %new_value
                %should_emit = core.let true
              }
            }
          } else {
            %new_is_string = core.type_is %new_value type "string"
            %old_is_string = core.type_is %old_value type "string"
            %both_strings = core.call intrinsic.and(%new_is_string, %old_is_string)
            core.if %both_strings {
              %prefix_growing = core.call intrinsic.string.starts_with(%new_value, %old_value)
              core.if %prefix_growing {
                %old_length = core.call intrinsic.len(%old_value)
                %new_length = core.call intrinsic.len(%new_value)
                %string_grew = core.call intrinsic.gt(%new_length, %old_length)
                core.if %string_grew {
                  %suffix = core.call intrinsic.string.slice(%new_value, %old_length)
                  %delta_value = core.let %suffix
                  %should_emit = core.let true
                }
              } else {
                %same_string = core.call intrinsic.eq(%new_value, %old_value)
                %changed_string = core.call intrinsic.not(%same_string)
                core.if %changed_string {
                  %delta_value = core.let %new_value
                  %should_emit = core.let true
                }
              }
            } else {
              %same_value = core.call intrinsic.eq(%new_value, %old_value)
              %changed_value = core.call intrinsic.not(%same_value)
              %old_missing = core.call intrinsic.not(%old_present)
              %emit_value = core.call intrinsic.or(%changed_value, %old_missing)
              core.if %emit_value {
                %delta_value = core.let %new_value
                %should_emit = core.let true
              }
            }
          }
          core.if %should_emit {
            core.set %delta[%key] = %delta_value
          }
        }
      }
      %out = core.map
      core.set %out["delta"] = %delta
      core.set %out["full_values"] = %full_values
      core.return %out
    }
  }

  op ax.stream.semantic @stream_event_content_parts_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "stream-event-content-parts-core-helper"
    type signature = "(json) -> list<string>"
    body @entry(%event: json) {
      %parts = core.call intrinsic.stream.event_content_parts(%event)
      core.return %parts
    }
  }

  // ----- TypeScript streaming extraction -----
  // Ports of src/ax/dsp/extract/streamingText.ts, delta.ts and fieldValue.ts,
  // src/ax/dsp/util.ts (matchesContent, parseMarkdownList, mergeDeltas),
  // src/ax/util/partialJson.ts and src/ax/dsp/response/structuredDelta.ts.
  // String offsets use each port's native string units consistently.

  op ax.stream.semantic @stream_substring_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/extract/delta.ts"
    type signature = "(string, i64, i64) -> string"
    body @entry(%text: string, %start: i64, %end: i64) {
      // JS substring: bounds clamp to [0, length] and a start after the end
      // swaps them.
      %length = core.call intrinsic.len(%text)
      %low = core.let %start
      %low_negative = core.call intrinsic.lt(%low, 0)
      core.if %low_negative {
        %low = core.let 0
      }
      %low_past = core.call intrinsic.gt(%low, %length)
      core.if %low_past {
        %low = core.let %length
      }
      %high = core.let %end
      %high_negative = core.call intrinsic.lt(%high, 0)
      core.if %high_negative {
        %high = core.let 0
      }
      %high_past = core.call intrinsic.gt(%high, %length)
      core.if %high_past {
        %high = core.let %length
      }
      %swapped = core.call intrinsic.gt(%low, %high)
      core.if %swapped {
        %first = core.let %high
        %high = core.let %low
        %low = core.let %first
      }
      %out = core.call intrinsic.string.slice(%text, %low, %high)
      core.return %out
    }
  }

  op ax.stream.semantic @stream_trim_end_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/extract/delta.ts"
    type signature = "(string) -> string"
    body @entry(%text: string) {
      // text.replace(/\s+$/, ''): the trimmed text starts where the leading
      // whitespace ends, so it ends at that offset plus its length.
      %trimmed = core.string_trim %text
      %blank = core.call intrinsic.eq(%trimmed, "")
      core.if %blank {
        core.return ""
      }
      %lead = core.call intrinsic.string.index_of(%text, %trimmed, 0)
      %trimmed_length = core.call intrinsic.len(%trimmed)
      %end = core.call intrinsic.add(%lead, %trimmed_length)
      %out = core.call intrinsic.string.slice(%text, 0, %end)
      core.return %out
    }
  }

  op ax.stream.semantic @stream_trim_start_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/extract/delta.ts"
    type signature = "(string) -> string"
    body @entry(%text: string) {
      %trimmed = core.string_trim %text
      %blank = core.call intrinsic.eq(%trimmed, "")
      core.if %blank {
        core.return ""
      }
      %lead = core.call intrinsic.string.index_of(%text, %trimmed, 0)
      %out = core.call intrinsic.string.slice(%text, %lead)
      core.return %out
    }
  }

  op ax.stream.semantic @stream_is_space_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/util.ts"
    type signature = "(string) -> bool"
    body @entry(%ch: string) {
      %empty = core.call intrinsic.eq(%ch, "")
      core.if %empty {
        core.return false
      }
      %trimmed = core.string_trim %ch
      %space = core.call intrinsic.eq(%trimmed, "")
      core.return %space
    }
  }

  op ax.stream.semantic @stream_field_labels_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/extract/streamingText.ts"
    type signature = "(json) -> list<string>"
    body @entry(%field: json) {
      // TS labels a field by its title, then its name, without duplicates.
      %labels = core.list
      %name = core.get %field["name"] default ""
      %title = core.get %field["title"] default ""
      %has_title = core.call intrinsic.truthy(%title)
      core.if %has_title {
        core.append %labels, %title
      }
      %has_name = core.call intrinsic.truthy(%name)
      %same = core.call intrinsic.eq(%name, %title)
      %distinct = core.call intrinsic.not(%same)
      %add_name = core.call intrinsic.and(%has_name, %distinct)
      core.if %add_name {
        core.append %labels, %name
      }
      core.return %labels
    }
  }

  op ax.stream.semantic @stream_matches_content_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/util.ts"
    type signature = "(string, string, i64) -> i64"
    body @entry(%content: string, %prefix: string, %start: i64) {
      // matchesContent: -4 for a lone opening code fence, -3 for blank or
      // backtick-only content, the index of the prefix at or after start,
      // -2 when the content ends with a partial prefix, else -1.
      %fence = core.regex_match %content pattern "^```[a-zA-Z]*\\s*$"
      core.if %fence {
        core.return -4
      }
      %blank = core.regex_match %content pattern "^[\\s`]*$"
      core.if %blank {
        core.return -3
      }
      %exact = core.call intrinsic.string.index_of(%content, %prefix, %start)
      %found = core.call intrinsic.gte(%exact, 0)
      core.if %found {
        core.return %exact
      }
      %size = core.call intrinsic.len(%prefix)
      core.loop {
        %exhausted = core.call intrinsic.lte(%size, 0)
        core.if %exhausted {
          core.break
        }
        %partial = core.call intrinsic.string.slice(%prefix, 0, %size)
        %ends = core.call intrinsic.string.ends_with(%content, %partial)
        core.if %ends {
          core.return -2
        }
        %size = core.call intrinsic.add(%size, -1)
      }
      core.return -1
    }
  }

  op ax.stream.semantic @stream_extract_block_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/extract/fieldValue.ts"
    type signature = "(string) -> string"
    body @entry(%input: string) {
      // extractBlock: the text of the first ```lang ... ``` block, else the
      // input. The language letters and the whitespace around the text are
      // not part of it.
      %open = core.call intrinsic.string.index_of(%input, "```", 0)
      %no_open = core.call intrinsic.lt(%open, 0)
      core.if %no_open {
        core.return %input
      }
      %length = core.call intrinsic.len(%input)
      %cursor = core.call intrinsic.add(%open, 3)
      core.loop {
        %at_end = core.call intrinsic.gte(%cursor, %length)
        core.if %at_end {
          core.break
        }
        %next = core.call intrinsic.add(%cursor, 1)
        %ch = core.call intrinsic.string.slice(%input, %cursor, %next)
        %letter = core.regex_match %ch pattern "^[A-Za-z]$"
        %not_letter = core.call intrinsic.not(%letter)
        core.if %not_letter {
          core.break
        }
        %cursor = core.let %next
      }
      core.loop {
        %at_end = core.call intrinsic.gte(%cursor, %length)
        core.if %at_end {
          core.break
        }
        %next = core.call intrinsic.add(%cursor, 1)
        %ch = core.call intrinsic.string.slice(%input, %cursor, %next)
        %space = core.call @stream_is_space_impl(%ch)
        %not_space = core.call intrinsic.not(%space)
        core.if %not_space {
          core.break
        }
        %cursor = core.let %next
      }
      %close = core.call intrinsic.string.index_of(%input, "```", %cursor)
      %no_close = core.call intrinsic.lt(%close, 0)
      core.if %no_close {
        core.return %input
      }
      %inner = core.call intrinsic.string.slice(%input, %cursor, %close)
      %block = core.call @stream_trim_end_impl(%inner)
      core.return %block
    }
  }

  op ax.stream.semantic @stream_strip_leading_fence_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/extract/delta.ts"
    type signature = "(string) -> string"
    body @entry(%text: string) {
      // text.replace(/^[ ]*```[a-zA-Z0-9]*\n\s*/, '')
      %length = core.call intrinsic.len(%text)
      %cursor = core.let 0
      core.loop {
        %at_end = core.call intrinsic.gte(%cursor, %length)
        core.if %at_end {
          core.break
        }
        %next = core.call intrinsic.add(%cursor, 1)
        %ch = core.call intrinsic.string.slice(%text, %cursor, %next)
        %is_blank = core.call intrinsic.eq(%ch, " ")
        %not_blank = core.call intrinsic.not(%is_blank)
        core.if %not_blank {
          core.break
        }
        %cursor = core.let %next
      }
      %rest = core.call intrinsic.string.slice(%text, %cursor)
      %fenced = core.call intrinsic.string.starts_with(%rest, "```")
      %not_fenced = core.call intrinsic.not(%fenced)
      core.if %not_fenced {
        core.return %text
      }
      %cursor = core.call intrinsic.add(%cursor, 3)
      core.loop {
        %at_end = core.call intrinsic.gte(%cursor, %length)
        core.if %at_end {
          core.break
        }
        %next = core.call intrinsic.add(%cursor, 1)
        %ch = core.call intrinsic.string.slice(%text, %cursor, %next)
        %word = core.regex_match %ch pattern "^[a-zA-Z0-9]$"
        %not_word = core.call intrinsic.not(%word)
        core.if %not_word {
          core.break
        }
        %cursor = core.let %next
      }
      %after = core.call intrinsic.add(%cursor, 1)
      %newline = core.call intrinsic.string.slice(%text, %cursor, %after)
      %has_newline = core.call intrinsic.eq(%newline, "\n")
      %no_newline = core.call intrinsic.not(%has_newline)
      core.if %no_newline {
        core.return %text
      }
      %tail = core.call intrinsic.string.slice(%text, %after)
      %stripped = core.call @stream_trim_start_impl(%tail)
      core.return %stripped
    }
  }

  op ax.stream.semantic @stream_strip_trailing_fence_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/extract/delta.ts"
    type signature = "(string) -> string"
    body @entry(%text: string) {
      // text.replace(/\s*```\s*$/, '')
      %trimmed = core.call @stream_trim_end_impl(%text)
      %fenced = core.call intrinsic.string.ends_with(%trimmed, "```")
      %not_fenced = core.call intrinsic.not(%fenced)
      core.if %not_fenced {
        core.return %text
      }
      %length = core.call intrinsic.len(%trimmed)
      %end = core.call intrinsic.add(%length, -3)
      %body = core.call intrinsic.string.slice(%trimmed, 0, %end)
      %out = core.call @stream_trim_end_impl(%body)
      core.return %out
    }
  }

  op ax.stream.semantic @stream_markdown_list_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/util.ts"
    type signature = "(string) -> list<string> throws"
    body @entry(%input: string) {
      // parseMarkdownList: bullet (-, *, +) or numbered (1. 1) 1]) items;
      // text before the first item is skipped, text after it is an error.
      %items = core.list
      %blank = core.string_trim %input
      %is_blank = core.call intrinsic.eq(%blank, "")
      core.if %is_blank {
        core.return %items
      }
      %lines = core.call intrinsic.string.split(%input, "\n")
      core.for %line in %lines {
        %text = core.string_trim %line
        %empty = core.call intrinsic.eq(%text, "")
        core.if %empty {
          core.continue
        }
        %first = core.call intrinsic.string.slice(%text, 0, 1)
        %bullet = core.regex_match %first pattern "^[-*+]$"
        core.if %bullet {
          %rest = core.call intrinsic.string.slice(%text, 1)
          %item = core.string_trim %rest
          core.append %items, %item
          core.continue
        }
        %numbered = core.regex_match %text pattern "^[0-9]+\\s*[.)\\]]"
        core.if %numbered {
          %length = core.call intrinsic.len(%text)
          %cursor = core.let 0
          core.loop {
            %next = core.call intrinsic.add(%cursor, 1)
            %ch = core.call intrinsic.string.slice(%text, %cursor, %next)
            %digit = core.regex_match %ch pattern "^[0-9]$"
            %not_digit = core.call intrinsic.not(%digit)
            core.if %not_digit {
              core.break
            }
            %cursor = core.let %next
          }
          core.loop {
            %next = core.call intrinsic.add(%cursor, 1)
            %ch = core.call intrinsic.string.slice(%text, %cursor, %next)
            %space = core.call @stream_is_space_impl(%ch)
            %not_space = core.call intrinsic.not(%space)
            core.if %not_space {
              core.break
            }
            %cursor = core.let %next
          }
          %marker_end = core.call intrinsic.add(%cursor, 1)
          %rest = core.call intrinsic.string.slice(%text, %marker_end)
          %item = core.string_trim %rest
          core.append %items, %item
          core.continue
        }
        %count = core.call intrinsic.len(%items)
        %started = core.call intrinsic.gt(%count, 0)
        core.if %started {
          %mixed = core.call intrinsic.error.runtime("Could not parse markdown list: mixed content detected")
          core.raise %mixed
        }
      }
      %found = core.call intrinsic.len(%items)
      %none_found = core.call intrinsic.eq(%found, 0)
      core.if %none_found {
        %missing = core.call intrinsic.error.runtime("Could not parse markdown list: no valid list items found")
        core.raise %missing
      }
      core.return %items
    }
  }

  op ax.stream.semantic @stream_js_string_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/extract/fieldValue.ts"
    type signature = "(json) -> string"
    body @entry(%value: json) {
      // JS String(value) for JSON values.
      %is_string = core.type_is %value type "string"
      core.if %is_string {
        core.return %value
      }
      %is_null = core.call intrinsic.is_none(%value)
      core.if %is_null {
        core.return "null"
      }
      %is_boolean = core.type_is %value type "boolean"
      core.if %is_boolean {
        core.if %value {
          core.return "true"
        }
        core.return "false"
      }
      %is_number = core.type_is %value type "number"
      core.if %is_number {
        %whole = core.call intrinsic.math.floor(%value)
        %integral = core.call intrinsic.eq(%whole, %value)
        core.if %integral {
          %whole_text = core.call intrinsic.string.format("{}", %whole)
          core.return %whole_text
        }
        %number_text = core.call intrinsic.string.format("{}", %value)
        core.return %number_text
      }
      %is_list = core.type_is %value type "list"
      core.if %is_list {
        %parts = core.list
        core.for %item in %value {
          %item_null = core.call intrinsic.is_none(%item)
          core.if %item_null {
            core.append %parts, ""
            core.continue
          }
          %part = core.call @stream_js_string_impl(%item)
          core.append %parts, %part
        }
        %joined = core.string_join %parts sep ","
        core.return %joined
      }
      core.return "[object Object]"
    }
  }

  op ax.stream.semantic @stream_js_number_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/extract/fieldValue.ts"
    type signature = "(json) -> json throws"
    body @entry(%value: json) {
      // JS Number(value); none stands for NaN.
      %is_number = core.type_is %value type "number"
      core.if %is_number {
        core.return %value
      }
      %is_null = core.call intrinsic.is_none(%value)
      core.if %is_null {
        core.return 0
      }
      %is_boolean = core.type_is %value type "boolean"
      core.if %is_boolean {
        core.if %value {
          core.return 1
        }
        core.return 0
      }
      %is_string = core.type_is %value type "string"
      %is_list = core.type_is %value type "list"
      %text = core.let ""
      core.if %is_string {
        %text = core.let %value
      } else {
        core.if %is_list {
          %text = core.call @stream_js_string_impl(%value)
        } else {
          %nan = core.call intrinsic.none()
          core.return %nan
        }
      }
      %trimmed = core.string_trim %text
      %empty = core.call intrinsic.eq(%trimmed, "")
      core.if %empty {
        core.return 0
      }
      %base = core.let 0
      %digits = core.let ""
      %hex = core.regex_match %trimmed pattern "^0[xX][0-9a-fA-F]+$"
      core.if %hex {
        %base = core.let 16
      }
      %octal = core.regex_match %trimmed pattern "^0[oO][0-7]+$"
      core.if %octal {
        %base = core.let 8
      }
      %binary = core.regex_match %trimmed pattern "^0[bB][01]+$"
      core.if %binary {
        %base = core.let 2
      }
      %radix = core.call intrinsic.gt(%base, 0)
      core.if %radix {
        %digits = core.call intrinsic.string.slice(%trimmed, 2)
        %lower_digits = core.call intrinsic.string.lower(%digits)
        %alphabet = core.let "0123456789abcdef"
        %total = core.let 0
        %count = core.call intrinsic.len(%lower_digits)
        %cursor = core.let 0
        core.loop {
          %done = core.call intrinsic.gte(%cursor, %count)
          core.if %done {
            core.break
          }
          %next = core.call intrinsic.add(%cursor, 1)
          %ch = core.call intrinsic.string.slice(%lower_digits, %cursor, %next)
          %digit = core.call intrinsic.string.index_of(%alphabet, %ch, 0)
          %scaled = core.call intrinsic.mul(%total, %base)
          %total = core.call intrinsic.add(%scaled, %digit)
          %cursor = core.let %next
        }
        core.return %total
      }
      %decimal = core.regex_match %trimmed pattern "^[+-]?([0-9]+\\.?[0-9]*|\\.[0-9]+)([eE][+-]?[0-9]+)?$"
      %not_decimal = core.call intrinsic.not(%decimal)
      core.if %not_decimal {
        %nan = core.call intrinsic.none()
        core.return %nan
      }
      // Rewrite the JS numeric literal as JSON: no plus sign, no extra
      // leading zeros, digits on both sides of a decimal point.
      %sign = core.let ""
      %magnitude = core.let %trimmed
      %plus = core.call intrinsic.string.starts_with(%trimmed, "+")
      %minus = core.call intrinsic.string.starts_with(%trimmed, "-")
      %has_sign = core.call intrinsic.or(%plus, %minus)
      core.if %has_sign {
        core.if %minus {
          %sign = core.let "-"
        }
        %magnitude = core.call intrinsic.string.slice(%trimmed, 1)
      }
      %mantissa = core.let %magnitude
      %exponent = core.let ""
      %lower_unsigned = core.call intrinsic.string.lower(%magnitude)
      %e_at = core.call intrinsic.string.index_of(%lower_unsigned, "e", 0)
      %has_exponent = core.call intrinsic.gte(%e_at, 0)
      core.if %has_exponent {
        %mantissa = core.call intrinsic.string.slice(%magnitude, 0, %e_at)
        %exponent = core.call intrinsic.string.slice(%magnitude, %e_at)
      }
      %whole_part = core.let %mantissa
      %fraction_part = core.let ""
      %dot_at = core.call intrinsic.string.index_of(%mantissa, ".", 0)
      %has_dot = core.call intrinsic.gte(%dot_at, 0)
      core.if %has_dot {
        %whole_part = core.call intrinsic.string.slice(%mantissa, 0, %dot_at)
        %after_dot = core.call intrinsic.add(%dot_at, 1)
        %fraction_part = core.call intrinsic.string.slice(%mantissa, %after_dot)
      }
      core.loop {
        %leading_zero = core.call intrinsic.string.starts_with(%whole_part, "0")
        %whole_length = core.call intrinsic.len(%whole_part)
        %more = core.call intrinsic.gt(%whole_length, 1)
        %strip = core.call intrinsic.and(%leading_zero, %more)
        %keep = core.call intrinsic.not(%strip)
        core.if %keep {
          core.break
        }
        %whole_part = core.call intrinsic.string.slice(%whole_part, 1)
      }
      %no_whole = core.call intrinsic.eq(%whole_part, "")
      core.if %no_whole {
        %whole_part = core.let "0"
      }
      %literal = core.call intrinsic.add(%sign, %whole_part)
      %has_fraction = core.call intrinsic.ne(%fraction_part, "")
      core.if %has_fraction {
        %with_dot = core.call intrinsic.add(%literal, ".")
        %literal = core.call intrinsic.add(%with_dot, %fraction_part)
      }
      %literal = core.call intrinsic.add(%literal, %exponent)
      %parsed = core.call intrinsic.json.parse_strict(%literal)
      core.return %parsed
    }
  }

  op ax.stream.semantic @stream_field_flag_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/sig.ts"
    type signature = "(json, string, string) -> bool"
    body @entry(%target: json, %snake: string, %camel: string) {
      %snake_value = core.get %target[%snake] default false
      %value = core.get %target[%camel] default %snake_value
      %flag = core.call intrinsic.truthy(%value)
      core.return %flag
    }
  }

  op ax.stream.semantic @stream_field_type_label_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/errors.ts"
    type signature = "(json) -> string"
    body @entry(%field: json) {
      // toFieldType: the type wording TS error messages use.
      %typ = core.get %field["type"]
      %name = core.get %typ["name"] default "string"
      %base = core.let "string"
      %is_number = core.call intrinsic.eq(%name, "number")
      core.if %is_number {
        %base = core.let "number"
      }
      %is_boolean = core.call intrinsic.eq(%name, "boolean")
      core.if %is_boolean {
        %base = core.let "boolean"
      }
      %is_date = core.call intrinsic.eq(%name, "date")
      core.if %is_date {
        %base = core.let "date (YYYY-MM-DD, e.g. 2024-05-09)"
      }
      %is_datetime = core.call intrinsic.eq(%name, "datetime")
      core.if %is_datetime {
        %base = core.let "datetime (ISO 8601 with timezone, e.g. 2024-05-09T14:30:00Z)"
      }
      %is_date_range = core.call intrinsic.eq(%name, "dateRange")
      core.if %is_date_range {
        %base = core.let "date range ({ \"start\": \"YYYY-MM-DD\", \"end\": \"YYYY-MM-DD\" })"
      }
      %is_datetime_range = core.call intrinsic.eq(%name, "datetimeRange")
      core.if %is_datetime_range {
        %base = core.let "datetime range ({ \"start\": \"2024-05-09T14:30:00Z\", \"end\": \"2024-05-09T15:30:00Z\" })"
      }
      %is_json = core.call intrinsic.eq(%name, "json")
      core.if %is_json {
        %base = core.let "JSON object"
      }
      %is_class = core.call intrinsic.eq(%name, "class")
      core.if %is_class {
        %base = core.let "classification class"
      }
      %is_code = core.call intrinsic.eq(%name, "code")
      core.if %is_code {
        %base = core.let "code"
      }
      %is_object = core.call intrinsic.eq(%name, "object")
      core.if %is_object {
        %base = core.let "object"
      }
      %is_array = core.call @stream_field_flag_impl(%typ, "is_array", "isArray")
      core.if %is_array {
        %array_label = core.call intrinsic.string.format("array of {}s", %base)
        core.return %array_label
      }
      core.return %base
    }
  }

  op ax.stream.semantic @stream_field_title_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/errors.ts"
