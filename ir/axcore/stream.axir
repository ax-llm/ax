      %marker = core.call @stream_json_context_impl(%json_text)
      core.set %out["marker"] = %marker
      %repaired = core.call @stream_json_repair_impl(%json_text)
      core.try {
        %repaired_value = core.call intrinsic.json.parse_strict(%repaired)
        core.set %out["parsed"] = %repaired_value
      } catch %repair_error {
      }
      core.return %out
    }
  }

  op ax.stream.semantic @stream_json_should_parse_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/response/structuredDelta.ts"
    type signature = "(json, string) -> bool"
    body @entry(%state: json, %content: string) {
      // StructuredStreamAccumulator.shouldParse: reparse after 160 new
      // characters, or after 80 when the text ends at `}`, `]` or `,`.
      %length = core.call intrinsic.len(%content)
      %last = core.get %state["last_parse_length"] default 0
      %negative_last = core.call intrinsic.mul(%last, -1)
      %fresh = core.call intrinsic.add(%length, %negative_last)
      %nothing_new = core.call intrinsic.lte(%fresh, 0)
      core.if %nothing_new {
        core.return false
      }
      %plenty = core.call intrinsic.gte(%fresh, 160)
      core.if %plenty {
        core.set %state["last_parse_length"] = %length
        core.return true
      }
      %too_few = core.call intrinsic.lt(%fresh, 80)
      core.if %too_few {
        core.return false
      }
      %cursor = core.let %length
      %last_ch = core.let ""
      core.loop {
        %at_start = core.call intrinsic.lte(%cursor, 0)
        core.if %at_start {
          core.break
        }
        %before = core.call intrinsic.add(%cursor, -1)
        %ch = core.call intrinsic.string.slice(%content, %before, %cursor)
        %space = core.regex_match %ch pattern "^[ \\n\\r\\t]$"
        %not_space = core.call intrinsic.not(%space)
        core.if %not_space {
          %last_ch = core.let %ch
          core.break
        }
        %cursor = core.let %before
      }
      %brace = core.call intrinsic.eq(%last_ch, "}")
      %bracket = core.call intrinsic.eq(%last_ch, "]")
      %comma = core.call intrinsic.eq(%last_ch, ",")
      %boundary = core.call intrinsic.or(%brace, %bracket)
      %boundary = core.call intrinsic.or(%boundary, %comma)
      %not_boundary = core.call intrinsic.not(%boundary)
      core.if %not_boundary {
        core.return false
      }
      core.set %state["last_parse_length"] = %length
      core.return true
    }
  }

  op ax.stream.semantic @stream_json_validate_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/extract/structuredJson.ts"
    type signature = "(list<json>, json, bool, bool) -> void throws"
    body @entry(%fields: list<json>, %values: json, %allow_missing: bool, %reject_unknown: bool) {
      // validateStructuredOutputValues: unknown top-level keys (when asked),
      // required fields (unless allowed missing), and the URL, string and
      // number constraints, recursing into object fields.
      core.if %reject_unknown {
        %keys = core.call intrinsic.map.keys(%values)
        core.for %key in %keys {
          %known = core.let false
          core.for %declared in %fields {
            %declared_name = core.get %declared["name"] default ""
            %same = core.call intrinsic.eq(%declared_name, %key)
            core.if %same {
              %known = core.let true
            }
          }
          %unknown = core.call intrinsic.not(%known)
          core.if %unknown {
            %unknown_message = core.call intrinsic.string.format("Unexpected field '{}' in output. Use only the exact declared wire keys.", %key)
            %unknown_error = core.call intrinsic.error.validation(%unknown_message)
            core.raise %unknown_error
          }
        }
      }
      core.for %field in %fields {
        %internal = core.call @stream_field_flag_impl(%field, "is_internal", "isInternal")
        core.if %internal {
          core.continue
        }
        %name = core.get %field["name"] default ""
        %value = core.get %values[%name]
        %missing = core.call intrinsic.is_none(%value)
        core.if %missing {
          %optional = core.call @stream_field_flag_impl(%field, "is_optional", "isOptional")
          %required = core.call intrinsic.not(%optional)
          %not_allowed = core.call intrinsic.not(%allow_missing)
          %fail = core.call intrinsic.and(%required, %not_allowed)
          core.if %fail {
            %missing_error = core.call @stream_required_missing_error_impl(%field)
            core.raise %missing_error
          }
          core.continue
        }
        core.call @stream_json_validate_value_impl(%field, %value, %allow_missing)
      }
      core.return
    }
  }

  op ax.stream.semantic @stream_json_validate_value_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/extract/structuredJson.ts"
    type signature = "(json, json, bool) -> void throws"
    body @entry(%field: json, %value: json, %allow_missing: bool) {
      // validateStructuredFieldValue.
      %typ = core.get %field["type"]
      %no_type = core.call intrinsic.is_none(%typ)
      core.if %no_type {
        core.return
      }
      %name = core.get %typ["name"] default "string"
      %is_array = core.call @stream_field_flag_impl(%typ, "is_array", "isArray")
      %not_array = core.call intrinsic.not(%is_array)
      %is_url = core.call intrinsic.eq(%name, "url")
      %scalar_url = core.call intrinsic.and(%is_url, %not_array)
      core.if %scalar_url {
        core.call @stream_validate_constraints_impl(%field, %value, "url")
      }
      %is_string = core.call intrinsic.eq(%name, "string")
      %is_code = core.call intrinsic.eq(%name, "code")
      %string_like = core.call intrinsic.or(%is_string, %is_code)
      core.if %string_like {
        core.call @stream_validate_constraints_impl(%field, %value, "string")
      }
      %is_number = core.call intrinsic.eq(%name, "number")
      core.if %is_number {
        core.call @stream_validate_constraints_impl(%field, %value, "number")
      }
      %value_is_list = core.type_is %value type "list"
      %check_items = core.call intrinsic.and(%is_array, %value_is_list)
      core.if %check_items {
        core.for %item in %value {
          %item_missing = core.call intrinsic.is_none(%item)
          core.if %item_missing {
            core.continue
          }
          core.if %is_url {
            core.call @stream_validate_constraints_impl(%field, %item, "url")
          } else {
            core.if %string_like {
              core.call @stream_validate_constraints_impl(%field, %item, "string")
            }
            core.if %is_number {
              core.call @stream_validate_constraints_impl(%field, %item, "number")
            }
          }
        }
      }
      %is_object = core.call intrinsic.eq(%name, "object")
      %nested = core.get %typ["fields"]
      %has_nested = core.call intrinsic.truthy(%nested)
      %object_fields = core.call intrinsic.and(%is_object, %has_nested)
      %value_is_map = core.type_is %value type "object"
      %scalar_object = core.call intrinsic.and(%object_fields, %value_is_map)
      %scalar_object = core.call intrinsic.and(%scalar_object, %not_array)
      core.if %scalar_object {
        core.call @stream_json_validate_nested_impl(%field, %value, %allow_missing)
      }
      %object_items = core.call intrinsic.and(%object_fields, %check_items)
      core.if %object_items {
        core.for %element in %value {
          %element_is_map = core.type_is %element type "object"
          core.if %element_is_map {
            core.call @stream_json_validate_nested_impl(%field, %element, %allow_missing)
          }
        }
      }
      core.return
    }
  }

  op ax.stream.semantic @stream_json_validate_nested_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/extract/structuredJson.ts"
    type signature = "(json, json, bool) -> void throws"
    body @entry(%parent: json, %object: json, %allow_missing: bool) {
      // validateNestedObjectFields: nested keys must be declared and visible;
      // nested fields use their own names as titles.
      %typ = core.get %parent["type"]
      %nested_map = core.get %typ["fields"]
      %nested_fields = core.call intrinsic.fields.from_map(%nested_map)
      %parent_name = core.get %parent["name"] default ""
      %keys = core.call intrinsic.map.keys(%object)
      core.for %key in %keys {
        %visible = core.let false
        core.for %candidate in %nested_fields {
          %candidate_name = core.get %candidate["name"] default ""
          %same = core.call intrinsic.eq(%candidate_name, %key)
          %candidate_internal = core.call @stream_field_flag_impl(%candidate, "is_internal", "isInternal")
          %candidate_visible = core.call intrinsic.not(%candidate_internal)
          %match_at = core.call intrinsic.and(%same, %candidate_visible)
          core.if %match_at {
            %visible = core.let true
          }
        }
        %hidden = core.call intrinsic.not(%visible)
        core.if %hidden {
          %unexpected_message = core.call intrinsic.string.format("Unexpected field '{}' in '{}'. Use only the exact declared wire keys.", %key, %parent_name)
          %unexpected_error = core.call intrinsic.error.validation(%unexpected_message)
          core.raise %unexpected_error
        }
      }
      core.for %nested_field in %nested_fields {
        %nested_internal = core.call @stream_field_flag_impl(%nested_field, "is_internal", "isInternal")
        core.if %nested_internal {
          core.continue
        }
        %nested_name = core.get %nested_field["name"] default ""
        %titled = core.map
        %nested_type = core.get %nested_field["type"]
        %nested_optional = core.call @stream_field_flag_impl(%nested_field, "is_optional", "isOptional")
        core.set %titled["name"] = %nested_name
        core.set %titled["title"] = %nested_name
        core.set %titled["type"] = %nested_type
        core.set %titled["is_optional"] = %nested_optional
        %nested_value = core.get %object[%nested_name]
        %nested_missing = core.call intrinsic.is_none(%nested_value)
        core.if %nested_missing {
          %nested_required = core.call intrinsic.not(%nested_optional)
          %not_allowed = core.call intrinsic.not(%allow_missing)
          %fail = core.call intrinsic.and(%nested_required, %not_allowed)
          core.if %fail {
            %nested_error = core.call @stream_required_missing_error_impl(%titled)
            core.raise %nested_error
          }
          core.continue
        }
        core.call @stream_json_validate_value_impl(%titled, %nested_value, %allow_missing)
      }
      core.return
    }
  }

  op ax.stream.semantic @stream_json_select_fields_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/response/structuredDelta.ts"
    type signature = "(list<json>, json) -> json"
    body @entry(%fields: list<json>, %values: json) {
      // selectOutputFields: the declared output keys, in the order parsed.
      %out = core.map
      %keys = core.call intrinsic.map.keys(%values)
      core.for %key in %keys {
        %declared = core.let false
        core.for %field in %fields {
          %name = core.get %field["name"] default ""
          %same = core.call intrinsic.eq(%name, %key)
          core.if %same {
            %declared = core.let true
          }
        }
        core.if %declared {
          %value = core.get %values[%key]
          core.set %out[%key] = %value
        }
      }
      core.return %out
    }
  }

  op ax.stream.semantic @stream_json_nested_fields_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/extract/structuredJson.ts"
    type signature = "(json) -> list<json>"
    body @entry(%fields_map: json) {
      // nestedFieldFromType: nested fields are titled by their own names.
      %out = core.list
      %nested_fields = core.call intrinsic.fields.from_map(%fields_map)
      core.for %nested in %nested_fields {
        %name = core.get %nested["name"] default ""
        %typ = core.get %nested["type"]
        %optional = core.call @stream_field_flag_impl(%nested, "is_optional", "isOptional")
        %internal = core.call @stream_field_flag_impl(%nested, "is_internal", "isInternal")
        %field = core.map
        core.set %field["name"] = %name
        core.set %field["title"] = %name
        core.set %field["type"] = %typ
        core.set %field["is_optional"] = %optional
        core.set %field["is_internal"] = %internal
        core.append %out, %field
      }
      core.return %out
    }
  }

  op ax.stream.semantic @stream_json_flexible_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/extract/structuredJson.ts"
    type signature = "(json) -> bool"
    body @entry(%field: json) {
      // isFlexibleJsonField: json, or object without declared fields.
      %typ = core.get %field["type"]
      %name = core.get %typ["name"] default ""
      %is_json = core.call intrinsic.eq(%name, "json")
      core.if %is_json {
        core.return true
      }
      %is_object = core.call intrinsic.eq(%name, "object")
      %nested = core.get %typ["fields"]
      %has_nested = core.call intrinsic.truthy(%nested)
      %open_object = core.call intrinsic.not(%has_nested)
      %flexible = core.call intrinsic.and(%is_object, %open_object)
      core.return %flexible
    }
  }

  op ax.stream.semantic @stream_json_string_value_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/extract/structuredJson.ts"
    type signature = "(json, json) -> json throws"
    body @entry(%field: json, %value: json) {
      // parseJsonStringFieldValue: a string value must parse as JSON.
      %is_string = core.type_is %value type "string"
      %not_string = core.call intrinsic.not(%is_string)
      core.if %not_string {
        core.return %value
      }
      %parsed = core.call intrinsic.none()
      core.try {
        %parsed = core.call intrinsic.json.parse_strict(%value)
      } catch %parse_error {
        %title = core.call @stream_field_title_impl(%field)
        %detail = core.call intrinsic.exception.message(%parse_error)
        %message = core.call intrinsic.string.format("Invalid JSON: {} in field '{}'. Return only valid JSON. Prefer a fenced code block containing a single JSON object or array with no trailing text.", %detail, %title)
        %invalid = core.call intrinsic.error.validation(%message)
        core.raise %invalid
      }
      core.return %parsed
    }
  }

  op ax.stream.semantic @stream_json_strings_for_field_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/extract/structuredJson.ts"
    type signature = "(json, json) -> json throws"
    body @entry(%field: json, %value: json) {
      // parseJsonStringValuesForField.
      %typ = core.get %field["type"]
      %no_type = core.call intrinsic.is_none(%typ)
      %no_value = core.call intrinsic.is_none(%value)
      %skip = core.call intrinsic.or(%no_type, %no_value)
      core.if %skip {
        core.return %value
      }
      %flexible = core.call @stream_json_flexible_impl(%field)
      %nested = core.get %typ["fields"]
      %has_nested = core.call intrinsic.truthy(%nested)
      %is_array = core.call @stream_field_flag_impl(%typ, "is_array", "isArray")
      core.if %is_array {
        %is_list = core.type_is %value type "list"
        %not_list = core.call intrinsic.not(%is_list)
        core.if %not_list {
          core.return %value
        }
        core.if %flexible {
          %items = core.list
          core.for %item in %value {
            %parsed_item = core.call @stream_json_string_value_impl(%field, %item)
            core.append %items, %parsed_item
          }
          core.return %items
        }
        core.if %has_nested {
          core.for %element in %value {
            %element_is_map = core.type_is %element type "object"
            core.if %element_is_map {
              core.call @stream_json_strings_for_fields_impl(%nested, %element)
            }
          }
        }
        core.return %value
      }
      core.if %flexible {
        %parsed = core.call @stream_json_string_value_impl(%field, %value)
        core.return %parsed
      }
      %name = core.get %typ["name"] default ""
      %is_object = core.call intrinsic.eq(%name, "object")
      %value_is_map = core.type_is %value type "object"
      %object_fields = core.call intrinsic.and(%is_object, %has_nested)
      %nested_object = core.call intrinsic.and(%object_fields, %value_is_map)
      core.if %nested_object {
        core.call @stream_json_strings_for_fields_impl(%nested, %value)
      }
      core.return %value
    }
  }

  op ax.stream.semantic @stream_json_strings_for_fields_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/extract/structuredJson.ts"
    type signature = "(json, json) -> void throws"
    body @entry(%fields_map: json, %values: json) {
      // parseJsonStringValuesForFields, in place.
      %nested_fields = core.call @stream_json_nested_fields_impl(%fields_map)
      core.for %field in %nested_fields {
        %name = core.get %field["name"] default ""
        %present = core.call intrinsic.map.contains(%values, %name)
        core.if %present {
          %value = core.get %values[%name]
          %parsed = core.call @stream_json_strings_for_field_impl(%field, %value)
          core.set %values[%name] = %parsed
        }
      }
      core.return
    }
  }

  op ax.stream.semantic @stream_json_strings_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/extract/structuredJson.ts"
    type signature = "(list<json>, json, bool) -> void throws"
    body @entry(%fields: list<json>, %values: json, %partial: bool) {
      // parseStructuredJsonFieldValues, or its Partial variant: there a
      // flexible field whose string does not parse yet is left out.
      core.for %field in %fields {
        %name = core.get %field["name"] default ""
        %present = core.call intrinsic.map.contains(%values, %name)
        %absent = core.call intrinsic.not(%present)
        core.if %absent {
          core.continue
        }
        %value = core.get %values[%name]
        core.try {
          %parsed = core.call @stream_json_strings_for_field_impl(%field, %value)
          core.set %values[%name] = %parsed
        } catch %parse_error {
          %flexible = core.call @stream_json_flexible_impl(%field)
          %is_string = core.type_is %value type "string"
          %droppable = core.call intrinsic.and(%flexible, %is_string)
          %drop = core.call intrinsic.and(%droppable, %partial)
          %keep_error = core.call intrinsic.not(%drop)
          core.if %keep_error {
            core.raise %parse_error
          }
          core.call intrinsic.map.delete(%values, %name)
        }
      }
      core.return
    }
  }

  op ax.stream.semantic @stream_state_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/generate.ts"
    type signature = "(i64) -> json"
    body @entry(%index: i64) {
      // One sample's streaming state for an attempt.
      %state = core.map
      core.set %state["index"] = %index
      core.set %state["content"] = ""
      %values = core.map
      core.set %state["values"] = %values
      %xstate = core.call @stream_text_state_impl()
      core.set %state["xstate"] = %xstate
      core.set %state["last_parse_length"] = 0
      core.return %state
    }
  }

  op ax.stream.semantic @stream_merge_value_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/util.ts"
    type signature = "(json, bool, json) -> json"
    body @entry(%base: json, %has_base: bool, %delta: json) {
      // mergeDeltas for one key: strings and arrays append, anything else
      // replaces.
      %delta_is_list = core.type_is %delta type "list"
      %base_is_list = core.type_is %base type "list"
      %missing = core.call intrinsic.not(%has_base)
      %both_lists = core.call intrinsic.and(%base_is_list, %delta_is_list)
      %list_start = core.call intrinsic.and(%missing, %delta_is_list)
      %join_lists = core.call intrinsic.or(%both_lists, %list_start)
      core.if %join_lists {
        %joined = core.list
        core.if %both_lists {
          core.for %old_item in %base {
            core.append %joined, %old_item
          }
        }
        core.for %new_item in %delta {
          core.append %joined, %new_item
        }
        core.return %joined
      }
      %delta_is_string = core.type_is %delta type "string"
      %base_is_string = core.type_is %base type "string"
      %string_base = core.call intrinsic.or(%missing, %base_is_string)
      %join_strings = core.call intrinsic.and(%string_base, %delta_is_string)
      core.if %join_strings {
        %prefix = core.let ""
        core.if %base_is_string {
          %prefix = core.let %base
        }
        %text = core.call intrinsic.add(%prefix, %delta)
        core.return %text
      }
      core.return %delta
    }
  }

  op ax.stream.semantic @stream_commit_delta_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/generate.ts"
    type signature = "(json, json, json) -> json"
    body @entry(%committed: json, %current: json, %delta: json) {
      // The attempt's values accumulate the delta; what a consumer has not
      // seen yet (committed) is yielded. A string that is a prefix of what
      // was committed is a replay and yields nothing.
      %effective = core.map
      %keys = core.call intrinsic.map.keys(%delta)
      core.for %key in %keys {
        %value = core.get %delta[%key]
        %has_current = core.call intrinsic.map.contains(%current, %key)
        %current_value = core.get %current[%key]
        %merged = core.call @stream_merge_value_impl(%current_value, %has_current, %value)
        core.set %current[%key] = %merged
        %has_committed = core.call intrinsic.map.contains(%committed, %key)
        %committed_value = core.get %committed[%key]
        %merged_is_string = core.type_is %merged type "string"
        %committed_is_string = core.type_is %committed_value type "string"
        %both_strings = core.call intrinsic.and(%merged_is_string, %committed_is_string)
        core.if %both_strings {
          %extends = core.call intrinsic.string.starts_with(%merged, %committed_value)
          core.if %extends {
            %committed_length = core.call intrinsic.len(%committed_value)
            %diff = core.call intrinsic.string.slice(%merged, %committed_length)
            %has_diff = core.call intrinsic.ne(%diff, "")
            core.if %has_diff {
              core.set %effective[%key] = %diff
              core.set %committed[%key] = %merged
            }
            core.continue
          }
          %replay = core.call intrinsic.string.starts_with(%committed_value, %merged)
          core.if %replay {
            core.continue
          }
          %changed_text = core.call intrinsic.ne(%merged, %committed_value)
          core.if %changed_text {
            core.set %effective[%key] = %merged
            core.set %committed[%key] = %merged
          }
          core.continue
        }
        %merged_is_list = core.type_is %merged type "list"
        %committed_is_list = core.type_is %committed_value type "list"
        %both_lists = core.call intrinsic.and(%merged_is_list, %committed_is_list)
        core.if %both_lists {
          %merged_count = core.call intrinsic.len(%merged)
          %committed_count = core.call intrinsic.len(%committed_value)
          %grew = core.call intrinsic.gt(%merged_count, %committed_count)
          core.if %grew {
            %fresh = core.list
            %position = core.let 0
            core.for %item in %merged {
              %is_fresh = core.call intrinsic.gte(%position, %committed_count)
              core.if %is_fresh {
                core.append %fresh, %item
              }
              %position = core.call intrinsic.add(%position, 1)
            }
            core.set %effective[%key] = %fresh
            core.set %committed[%key] = %merged
          }
          core.continue
        }
        %equal = core.call intrinsic.eq(%merged, %committed_value)
        %same = core.call intrinsic.and(%has_committed, %equal)
        %differs = core.call intrinsic.not(%same)
        core.if %differs {
          core.set %effective[%key] = %merged
          core.set %committed[%key] = %merged
        }
      }
      core.return %effective
    }
  }

  op ax.stream.semantic @stream_run_state_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/generate.ts"
    type signature = "(json, bool, string) -> json"
    body @entry(%sink: json, %buffered: bool, %thought_field: string) {
      // The run's delta bookkeeping: the version consumers hold, the thought
      // and output yielded in it, and the merged view (discarded when the
      // version changes) that becomes the result.
      %run = core.map
      core.set %run["sink"] = %sink
      core.set %run["buffered"] = %buffered
      core.set %run["thought_field"] = %thought_field
      core.set %run["current_version"] = 0
      core.set %run["output_emitted"] = false
      %emitted_thought = core.list
      core.set %run["emitted_thought"] = %emitted_thought
      %buffer = core.list
      core.set %run["buffer"] = %buffer
      core.return %run
    }
  }

  op ax.stream.semantic @stream_run_new_version_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/generate.ts"
    type signature = "(json, i64) -> void"
    body @entry(%run: json, %version: i64) {
      // Consumers discard what they merged when the version changes.
      core.set %run["current_version"] = %version
      %cleared_thought = core.list
      core.set %run["emitted_thought"] = %cleared_thought
      core.set %run["output_emitted"] = false
      %cleared_buffer = core.list
      core.set %run["buffer"] = %cleared_buffer
      core.return
    }
  }

  op ax.stream.semantic @stream_yield_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/generate.ts"
    type signature = "(json, i64, i64, json) -> void throws"
    body @entry(%run: json, %version: i64, %index: i64, %delta: json) {
      // Yields {version, index, delta}: tracks the version, the thought and
      // whether output fields were yielded, merges it into the view a
      // consumer holds, and sends it to the sink unless a result picker
      // buffers the run. A forward with stream: true has no sink.
      %current_version = core.get %run["current_version"] default 0
      %new_version = core.call intrinsic.ne(%version, %current_version)
      core.if %new_version {
        core.call @stream_run_new_version_impl(%run, %version)
      }
      %thought_field = core.get %run["thought_field"] default "thought"
      %empty_thought = core.list
      %emitted_thought = core.get %run["emitted_thought"] default %empty_thought
      %keys = core.call intrinsic.map.keys(%delta)
      core.for %key in %keys {
        %value = core.get %delta[%key]
        %is_thought = core.call intrinsic.eq(%key, %thought_field)
        %is_string = core.type_is %value type "string"
        %thought_text = core.call intrinsic.and(%is_thought, %is_string)
        core.if %thought_text {
          %thought_entry = core.call intrinsic.none()
          core.for %candidate_thought in %emitted_thought {
            %thought_index = core.get %candidate_thought["index"]
            %same_thought_index = core.call intrinsic.eq(%thought_index, %index)
            core.if %same_thought_index {
              %thought_entry = core.let %candidate_thought
            }
          }
          %no_thought_entry = core.call intrinsic.is_none(%thought_entry)
          core.if %no_thought_entry {
            %thought_entry = core.map
            core.set %thought_entry["index"] = %index
            core.set %thought_entry["text"] = ""
            core.append %emitted_thought, %thought_entry
          }
          %so_far = core.get %thought_entry["text"] default ""
          %joined = core.call intrinsic.add(%so_far, %value)
          core.set %thought_entry["text"] = %joined
        } else {
          core.set %run["output_emitted"] = true
        }
      }
      core.set %run["emitted_thought"] = %emitted_thought
      %empty_buffer = core.list
      %buffer = core.get %run["buffer"] default %empty_buffer
      %entry = core.call intrinsic.none()
      core.for %candidate in %buffer {
        %candidate_index = core.get %candidate["index"]
        %same_index = core.call intrinsic.eq(%candidate_index, %index)
        core.if %same_index {
          %entry = core.let %candidate
        }
      }
      %no_entry = core.call intrinsic.is_none(%entry)
      core.if %no_entry {
        %entry = core.map
        core.set %entry["index"] = %index
        %fresh_delta = core.map
        core.set %entry["delta"] = %fresh_delta
        core.append %buffer, %entry
        core.set %run["buffer"] = %buffer
      }
      %empty_view = core.map
      %view = core.get %entry["delta"] default %empty_view
      core.for %merge_key in %keys {
        %merge_value = core.get %delta[%merge_key]
        %has_base = core.call intrinsic.map.contains(%view, %merge_key)
        %base = core.get %view[%merge_key]
        %merged = core.call @stream_merge_value_impl(%base, %has_base, %merge_value)
        core.set %view[%merge_key] = %merged
      }
      core.set %entry["delta"] = %view
      %buffered = core.get %run["buffered"] default false
      core.if %buffered {
        core.return
      }
      %sink = core.get %run["sink"]
      %no_sink = core.call intrinsic.is_none(%sink)
      core.if %no_sink {
        core.return
      }
      %envelope = core.map
      core.set %envelope["version"] = %version
      core.set %envelope["index"] = %index
      core.set %envelope["delta"] = %delta
      core.call intrinsic.axgen.emit_delta(%sink, %envelope)
      core.return
    }
  }

  op ax.stream.semantic @stream_marker_incomplete_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/response/structuredDelta.ts"
    type signature = "(json) -> bool"
    body @entry(%marker: json) {
      // isLastArrayItemIncomplete
      %no_marker = core.call intrinsic.is_none(%marker)
      core.if %no_marker {
        core.return false
      }
      %depth = core.get %marker["nesting_level"] default 0
      %nested = core.call intrinsic.gt(%depth, 0)
      %in_array = core.get %marker["in_array"] default false
      %in_object = core.get %marker["in_object"] default false
      %open = core.call intrinsic.or(%nested, %in_array)
      %open = core.call intrinsic.or(%open, %in_object)
      core.return %open
    }
  }

  op ax.stream.semantic @stream_apply_structured_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/response/structuredDelta.ts"
    type signature = "(json, list<json>, json, json, list<string>) -> list<json>"
    body @entry(%state: json, %fields: list<json>, %parsed: json, %marker: json, %held: list<string>) {
      // createStructuredDelta against the state's values; the full values are
      // merged into them. Held (transformed) fields wait for finalize.
      %deltas = core.list
      %empty_values = core.map
      %values = core.get %state["values"] default %empty_values
      %incomplete = core.call @stream_marker_incomplete_impl(%marker)
      %result = core.call @stream_structured_delta(%fields, %parsed, %values, %incomplete)
      %empty_full = core.map
      %full_values = core.get %result["full_values"] default %empty_full
      %full_keys = core.call intrinsic.map.keys(%full_values)
      core.for %full_key in %full_keys {
        %full_value = core.get %full_values[%full_key]
        core.set %values[%full_key] = %full_value
      }
      core.set %state["values"] = %values
      %empty_delta = core.map
      %delta = core.get %result["delta"] default %empty_delta
      %visible = core.map
      %delta_keys = core.call intrinsic.map.keys(%delta)
      core.for %delta_key in %delta_keys {
        %is_held = core.call intrinsic.contains(%held, %delta_key)
        core.if %is_held {
          core.continue
        }
        %delta_value = core.get %delta[%delta_key]
        core.set %visible[%delta_key] = %delta_value
      }
      %visible_count = core.call intrinsic.len(%visible)
      %has_delta = core.call intrinsic.gt(%visible_count, 0)
      core.if %has_delta {
        core.append %deltas, %visible
      }
      core.return %deltas
    }
  }

  op ax.stream.semantic @stream_feedback_text_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/fieldProcessor.ts"
    type signature = "(json) -> json"
    body @entry(%result: json) {
      // addToMemory: a processor result becomes feedback text unless it is
      // undefined, empty, or the text null/undefined.
      %none = core.call intrinsic.none()
      %missing = core.call intrinsic.is_none(%result)
      core.if %missing {
        core.return %none
      }
      %is_string = core.type_is %result type "string"
      core.if %is_string {
        %empty = core.call intrinsic.eq(%result, "")
        core.if %empty {
          core.return %none
        }
        %lowered = core.call intrinsic.string.lower(%result)
        %null_rest = core.let "x"
        %starts_null = core.call intrinsic.string.starts_with(%lowered, "null")
        core.if %starts_null {
          %after_null = core.call intrinsic.string.slice(%lowered, 4)
          %null_rest = core.string_trim %after_null
        }
        %starts_undefined = core.call intrinsic.string.starts_with(%lowered, "undefined")
        core.if %starts_undefined {
          %after_undefined = core.call intrinsic.string.slice(%lowered, 9)
          %null_rest = core.string_trim %after_undefined
        }
        %null_text = core.call intrinsic.eq(%null_rest, "")
        core.if %null_text {
          core.return %none
        }
        core.return %result
      }
      %text = core.call @stream_js_string_impl(%result)
      core.return %text
    }
  }

  op ax.stream.semantic @stream_run_processors_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/fieldProcessor.ts"
    type signature = "(AxGen, string, json, json, bool) -> list<string> throws"
    body @entry(%gen: AxGen, %kind: string, %state: json, %content: string, %done: bool) {
      // processFieldProcessors (kind "feedback") calls each processor whose
      // field has a value; processStreamingFieldProcessors (kind "streaming")
      // calls those of the current field with its raw text so far. Returns
      // the feedback texts, in order, for the caller to send as user
      // messages. A processor error is left in state["fatal_error"].
      %feedback = core.list
      %empty_values = core.map
      %values = core.get %state["values"] default %empty_values
      %empty_specs = core.list
      %specs = core.get %gen["feedback_processors"] default %empty_specs
      %streaming = core.call intrinsic.eq(%kind, "streaming")
      %curr_name = core.let ""
      %raw_value = core.let ""
      core.if %streaming {
        %specs = core.get %gen["streaming_field_processors"] default %empty_specs
        %empty_xstate = core.map
        %xstate = core.get %state["xstate"] default %empty_xstate
        %curr = core.get %xstate["curr_field"]
        %no_curr = core.call intrinsic.is_none(%curr)
        core.if %no_curr {
          core.return %feedback
        }
        %curr_name = core.get %curr["name"] default ""
        %start = core.get %xstate["s"] default 0
        %raw_value = core.call intrinsic.string.slice(%content, %start)
        %curr_type = core.get %curr["type"]
        %curr_type_name = core.get %curr_type["name"] default ""
        %is_code = core.call intrinsic.eq(%curr_type_name, "code")
        core.if %is_code {
          %raw_value = core.call @stream_strip_leading_fence_impl(%raw_value)
          %raw_value = core.call @stream_strip_trailing_fence_impl(%raw_value)
        }
      }
      core.for %spec in %specs {
        %field = core.get %spec["field"] default ""
        %value = core.call intrinsic.none()
        core.if %streaming {
          %matches = core.call intrinsic.eq(%field, %curr_name)
          %other = core.call intrinsic.not(%matches)
          core.if %other {
            core.continue
          }
          %value = core.let %raw_value
        } else {
          %present = core.call intrinsic.map.contains(%values, %field)
          %absent = core.call intrinsic.not(%present)
          core.if %absent {
            core.continue
          }
          %value = core.get %values[%field]
        }
        %context = core.map
        core.set %context["values"] = %values
        core.set %context["done"] = %done
        %result = core.call intrinsic.none()
        core.try {
          %result = core.call intrinsic.axgen.call_processor(%spec, %value, %context)
        } catch %processor_error {
          // As in TS, a processor's own error ends the run without a retry.
          core.set %state["fatal_error"] = %processor_error
          core.return %feedback
        }
        %text = core.call @stream_feedback_text_impl(%result)
        %has_text = core.call intrinsic.is_not_none(%text)
        core.if %has_text {
          core.append %feedback, %text
        }
      }
      core.return %feedback
    }
  }

  op ax.stream.semantic @stream_check_assertions_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/asserts.ts"
    type signature = "(AxGen, json, string, bool) -> json throws"
    body @entry(%gen: AxGen, %xstate: json, %content: string, %done: bool) {
      // assertStreamingAssertions: the current field's assertions see its raw
      // text so far; a failure raises a retryable error. An error the
      // assertion itself raises is returned for the caller to raise without
      // a retry, as TS does.
      %none = core.call intrinsic.none()
      %curr = core.get %xstate["curr_field"]
      %no_curr = core.call intrinsic.is_none(%curr)
      %start = core.get %xstate["s"] default -1
      %unstarted = core.call intrinsic.eq(%start, -1)
      %skip = core.call intrinsic.or(%no_curr, %unstarted)
      core.if %skip {
        core.return %none
      }
      %curr_name = core.get %curr["name"] default ""
      %value = core.call intrinsic.string.slice(%content, %start)
      %empty_specs = core.list
      %specs = core.get %gen["streaming_assertions"] default %empty_specs
      core.for %spec in %specs {
        %field = core.get %spec["field"] default ""
        %matches = core.call intrinsic.eq(%field, %curr_name)
        %other = core.call intrinsic.not(%matches)
        core.if %other {
          core.continue
        }
        %outcome = core.map
        core.try {
          %outcome = core.call intrinsic.axgen.check_streaming_assertion(%spec, %value, %done)
        } catch %assertion_error {
          core.return %assertion_error
        }
        %status = core.get %outcome["status"] default "pass"
        %failed = core.call intrinsic.eq(%status, "fail")
        core.if %failed {
          %returned = core.get %outcome["message"]
          %spec_message = core.get %spec["message"]
          %default_message = core.call intrinsic.string.format("Streaming assertion failed for field '{}'. Output was stopped.", %field)
          %message = core.call intrinsic.coalesce(%spec_message, %default_message)
          %has_returned = core.call intrinsic.is_not_none(%returned)
          core.if %has_returned {
            %message = core.let %returned
          }
          %error = core.call intrinsic.error.validation(%message)
          core.raise %error
        }
      }
      core.return %none
    }
  }

  op ax.stream.semantic @stream_emit_deltas_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/generate.ts"
    type signature = "(json, i64, list<json>) -> void throws"
    body @entry(%ctx: json, %index: i64, %deltas: list<json>) {
      // Diffs each delta against what consumers hold for this sample and
      // yields the rest at the attempt's version.
      %index_key = core.call intrinsic.string.format("{}", %index)
      %empty_all = core.map
      %committed_all = core.get %ctx["committed"] default %empty_all
      %current_all = core.get %ctx["current"] default %empty_all
      %empty_committed = core.map
      %committed = core.get %committed_all[%index_key] default %empty_committed
      core.set %committed_all[%index_key] = %committed
      %empty_current = core.map
      %current = core.get %current_all[%index_key] default %empty_current
      core.set %current_all[%index_key] = %current
      %run = core.get %ctx["run"]
      %version = core.get %ctx["version"] default 0
      core.for %delta in %deltas {
        %effective = core.call @stream_commit_delta_impl(%committed, %current, %delta)
        %count = core.call intrinsic.len(%effective)
        %has_effective = core.call intrinsic.gt(%count, 0)
        core.if %has_effective {
          core.call @stream_yield_impl(%run, %version, %index, %effective)
        }
      }
      core.return
    }
  }

  op ax.stream.semantic @stream_held_fields_impl {
    attr core_kind = "func"
    attr emit_module = "gen"
    attr private = true
    tag "field-transforms-streaming"
    type signature = "(AxGen, list<json>) -> list<string>"
    body @entry(%gen: AxGen, %fields: list<json>) {
      // Port-only field transforms rewrite a field's final value, which a
      // stream cannot replace once sent: such fields are held back and sent
      // once, transformed. A whole-output transform holds every field.
      %held = core.list
      %empty_specs = core.list
      %specs = core.get %gen["field_processors"] default %empty_specs
      core.for %spec in %specs {
        %is_spec_map = core.type_is %spec type "object"
        core.if %is_spec_map {
          %name_alias = core.get %spec["name"] default ""
          %name = core.get %spec["field"] default %name_alias
          %has_name = core.call intrinsic.truthy(%name)
          %seen = core.call intrinsic.contains(%held, %name)
          %unseen = core.call intrinsic.not(%seen)
          %add = core.call intrinsic.and(%has_name, %unseen)
          core.if %add {
            core.append %held, %name
          }
          core.continue
        }
        core.for %field in %fields {
          %field_name = core.get %field["name"] default ""
          %field_seen = core.call intrinsic.contains(%held, %field_name)
          %field_unseen = core.call intrinsic.not(%field_seen)
          core.if %field_unseen {
            core.append %held, %field_name
          }
        }
      }
      core.return %held
    }
  }

  op ax.stream.semantic @stream_chunk_content_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/response/streaming.ts"
    type signature = "(AxGen, json, json, json) -> list<json> throws"
    body @entry(%gen: AxGen, %config: json, %state: json, %result: json) {
      // processStreamingResult after the thought: content appends to the
      // sample's text, which structured routes reparse as partial JSON and
      // the text contract extracts field by field. Function-call chunks
      // yield nothing.
      %deltas = core.list
      %empty_calls = core.list
      %calls_snake = core.get %result["function_calls"] default %empty_calls
      %calls = core.get %result["functionCalls"] default %calls_snake
      %call_count = core.call intrinsic.len(%calls)
      %has_calls = core.call intrinsic.gt(%call_count, 0)
      core.if %has_calls {
        core.return %deltas
      }
      %chunk_text = core.get %result["content"] default ""
      %is_text = core.type_is %chunk_text type "string"
      %not_text = core.call intrinsic.not(%is_text)
      core.if %not_text {
        core.return %deltas
      }
      %empty_chunk = core.call intrinsic.eq(%chunk_text, "")
      core.if %empty_chunk {
        core.return %deltas
      }
      %old_content = core.get %state["content"] default ""
      %content = core.call intrinsic.add(%old_content, %chunk_text)
      core.set %state["content"] = %content
      %empty_fields = core.list
      %fields = core.get %config["fields"] default %empty_fields
      %empty_held = core.list
      %held = core.get %config["held"] default %empty_held
      %structured = core.get %config["structured"] default false
      core.if %structured {
        %should_parse = core.call @stream_json_should_parse_impl(%state, %content)
        %skip_parse = core.call intrinsic.not(%should_parse)
        core.if %skip_parse {
          core.return %deltas
        }
        %partial = core.call @stream_json_parse_partial_impl(%content)
        %parsed = core.get %partial["parsed"]
        %marker = core.get %partial["marker"]
        %is_map = core.type_is %parsed type "object"
        %not_map = core.call intrinsic.not(%is_map)
        core.if %not_map {
          core.return %deltas
        }
        %has_marker = core.call intrinsic.is_not_none(%marker)
        %prepared = core.map
        %parse_strings = core.get %config["parse_json_strings"] default false
        core.try {
          %prepared = core.call @stream_json_select_fields_impl(%fields, %parsed)
          core.if %parse_strings {
            core.call @stream_json_strings_impl(%fields, %prepared, true)
          }
        } catch %prepare_error {
          core.if %has_marker {
            core.return %deltas
          }
          core.raise %prepare_error
        }
        core.try {
          core.call @stream_json_validate_impl(%fields, %prepared, true, false)
        } catch %partial_error {
          %complete = core.call intrinsic.not(%has_marker)
          core.if %complete {
            core.raise %partial_error
          }
        }
        %structured_deltas = core.call @stream_apply_structured_impl(%state, %fields, %prepared, %marker, %held)
        core.return %structured_deltas
      }
      %empty_xstate = core.map
      %xstate = core.get %state["xstate"] default %empty_xstate
      %empty_values = core.map
      %values = core.get %state["values"] default %empty_values
      %skip = core.call @stream_text_extract_impl(%xstate, %values, %content, %fields)
      core.if %skip {
        core.return %deltas
      }
      %assertion_thrown = core.call @stream_check_assertions_impl(%gen, %xstate, %content, false)
      %assertion_threw = core.call intrinsic.is_not_none(%assertion_thrown)
      core.if %assertion_threw {
        core.set %state["fatal_error"] = %assertion_thrown
        core.return %deltas
      }
      %feedback = core.call @stream_run_processors_impl(%gen, "streaming", %state, %content, false)
      %processor_failure = core.get %state["fatal_error"]
      %processor_failed = core.call intrinsic.is_not_none(%processor_failure)
      core.if %processor_failed {
        core.return %deltas
      }
      %empty_feedback = core.list
      %pending = core.get %state["feedback"] default %empty_feedback
      core.for %text in %feedback {
        core.append %pending, %text
      }
      core.set %state["feedback"] = %pending
      %text_deltas = core.call @stream_text_values_impl(%fields, %content, %values, %xstate, %held)
      core.return %text_deltas
    }
  }

  op ax.stream.semantic @stream_finalize_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/response/finalize.ts"
    type signature = "(AxGen, json, json, json) -> json throws"
    body @entry(%gen: AxGen, %config: json, %ctx: json, %state: json) {
      // finalizeStreamingResponse for a sample with no function calls: the
      // final JSON or text parse, streaming assertions, feedback and
      // streaming processors, port transforms, assertions, then the rest of
      // the text. Returns {feedback, output} or {failure} for an assertion
      // error the caller raises outside its retries.
      %out = core.map
      %empty_fields = core.list
      %fields = core.get %config["fields"] default %empty_fields
      %empty_held = core.list
      %held = core.get %config["held"] default %empty_held
      %structured = core.get %config["structured"] default false
      %strict_json = core.get %config["strict_json"] default false
      %parse_strings = core.get %config["parse_json_strings"] default false
      %thought_field = core.get %config["thought_field"] default "thought"
      %content = core.get %state["content"] default ""
      %index = core.get %state["index"] default 0
      %empty_values = core.map
      %values = core.get %state["values"] default %empty_values
      %empty_xstate = core.map
      %xstate = core.get %state["xstate"] default %empty_xstate
      %json_parsed = core.let false
      core.if %structured {
        %final_json = core.call intrinsic.none()
        %syntax_error = core.let false
        core.try {
          %final_json = core.call intrinsic.json.parse_strict(%content)
        } catch %parse_error {
          %syntax_error = core.let true
        }
        core.if %syntax_error {
          core.if %strict_json {
            %strict_error = core.call intrinsic.error.validation("Structured output must be one JSON object with no prose or Markdown fences.")
            core.raise %strict_error
          }
        } else {
          %final_is_map = core.type_is %final_json type "object"
          %final_not_map = core.call intrinsic.not(%final_is_map)
          core.if %final_not_map {
            %shape_error = core.call intrinsic.error.validation("Structured output must be a JSON object matching the output fields.")
            core.raise %shape_error
          }
          core.if %parse_strings {
            core.call @stream_json_strings_impl(%fields, %final_json, false)
          }
          core.call @stream_json_validate_impl(%fields, %final_json, false, %strict_json)
          %no_marker = core.call intrinsic.none()
          %final_deltas = core.call @stream_apply_structured_impl(%state, %fields, %final_json, %no_marker, %held)
          core.call @stream_emit_deltas_impl(%ctx, %index, %final_deltas)
          %json_parsed = core.let true
        }
      }
      %text_route = core.call intrinsic.not(%json_parsed)
      core.if %text_route {
        core.call @stream_text_final_impl(%xstate, %values, %content, %fields)
      }
      %assertion_thrown = core.call @stream_check_assertions_impl(%gen, %xstate, %content, true)
      %assertion_threw = core.call intrinsic.is_not_none(%assertion_thrown)
      core.if %assertion_threw {
        core.set %out["failure"] = %assertion_thrown
        core.return %out
      }
      %empty_feedback = core.list
      %feedback = core.get %state["feedback"] default %empty_feedback
      %processed = core.call @stream_run_processors_impl(%gen, "feedback", %state, %content, true)
      core.for %processed_text in %processed {
        core.append %feedback, %processed_text
      }
      %streamed = core.call @stream_run_processors_impl(%gen, "streaming", %state, %content, true)
      core.for %streamed_text in %streamed {
        core.append %feedback, %streamed_text
      }
      %processor_failure = core.get %state["fatal_error"]
      %processor_failed = core.call intrinsic.is_not_none(%processor_failure)
      core.if %processor_failed {
        core.set %out["failure"] = %processor_failure
        core.return %out
      }
      // Assertions see the transformed output without the thought, as in
      // forward.
      %output = core.map
      %value_keys = core.call intrinsic.map.keys(%values)
      core.for %value_key in %value_keys {
        %is_thought = core.call intrinsic.eq(%value_key, %thought_field)
        core.if %is_thought {
          core.continue
        }
        %value = core.get %values[%value_key]
        core.set %output[%value_key] = %value
      }
      %transformed = core.call @apply_field_processors(%gen, %output)
      %failure = core.call @run_assertions(%gen, %transformed)
      %failed = core.call intrinsic.is_not_none(%failure)
      core.if %failed {
        core.set %out["failure"] = %failure
        core.return %out
      }
      core.if %text_route {
        %text_deltas = core.call @stream_text_values_impl(%fields, %content, %values, %xstate, %held)
        core.call @stream_emit_deltas_impl(%ctx, %index, %text_deltas)
      }
      %held_deltas = core.list
      core.for %held_name in %held {
        %has_held = core.call intrinsic.map.contains(%transformed, %held_name)
        %internal = core.let false
        core.for %field in %fields {
          %field_name = core.get %field["name"] default ""
          %same = core.call intrinsic.eq(%field_name, %held_name)
          core.if %same {
            %internal = core.call @stream_field_flag_impl(%field, "is_internal", "isInternal")
          }
        }
        %visible = core.call intrinsic.not(%internal)
        %send = core.call intrinsic.and(%has_held, %visible)
        core.if %send {
          %held_value = core.get %transformed[%held_name]
          %held_delta = core.map
          core.set %held_delta[%held_name] = %held_value
          core.append %held_deltas, %held_delta
        }
      }
      core.call @stream_emit_deltas_impl(%ctx, %index, %held_deltas)
      core.set %out["feedback"] = %feedback
      core.set %out["output"] = %transformed
      core.return %out
    }
  }

  op ax.stream.semantic @stream_result_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "gen"
    attr private = true
    tag "src/ax/dsp/generate.ts"
    type signature = "(json, json) -> json throws"
    body @entry(%run: json, %options: json) {
      // The run's result: without a result picker, the first sample merged
      // in the last version, as forward returns it. With one, the picked
      // sample is sent as a single envelope; its index is its position in
      // the merged view, as in TS.
      %empty_buffer = core.list
      %buffer = core.get %run["buffer"] default %empty_buffer
      %buffered = core.get %run["buffered"] default false
      %selected = core.let 0
      core.if %buffered {
        %samples = core.list
        %position = core.let 0
        core.for %entry in %buffer {
          %sample = core.map
          core.set %sample["index"] = %position
          %entry_delta = core.get %entry["delta"]
          core.set %sample["sample"] = %entry_delta
          core.append %samples, %sample
          %position = core.call intrinsic.add(%position, 1)
        }
        %selected = core.call @select_sample_index(%samples, %options)
      }
      %none = core.call intrinsic.none()
      %picked = core.call intrinsic.list.get(%buffer, %selected, %none)
      %missing = core.call intrinsic.is_none(%picked)
      core.if %missing {
        %empty_output = core.map
        core.return %empty_output
      }
      %empty_delta = core.map
      %output = core.get %picked["delta"] default %empty_delta
      %sink = core.get %run["sink"]
      %has_sink = core.call intrinsic.is_not_none(%sink)
      %send_picked = core.call intrinsic.and(%buffered, %has_sink)
      core.if %send_picked {
        %envelope = core.map
        %version = core.get %run["current_version"] default 0
        core.set %envelope["version"] = %version
        core.set %envelope["index"] = %selected
        core.set %envelope["delta"] = %output
        core.call intrinsic.axgen.emit_delta(%sink, %envelope)
      }
      core.return %output
    }
  }
}
