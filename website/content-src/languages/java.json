      "ucp": {
        "code": [
          "Response handleUCPWebhook(Request request) {",
          "  // Verify signer profile, RFC 9421 signature, digest, freshness,",
          "  // key rotation, and replay state before publishing.",
          "  VerifiedOrder order = verifyUCPRequest(request);",
          "  String identity = lookupBuyerIdentity(order.checkoutId());",
          "  runtime.publish(",
          "      new AxEventEnvelope(order.id(), \"ucp://orders\",",
          "          \"ucp.order.fulfilled\", order.data()),",
          "      identity, \"authenticated\");",
          "  return new Response(202);",
          "}"
        ]
      }
