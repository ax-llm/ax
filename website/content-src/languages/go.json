      "wake": {
        "code": [
          "source := ax.NewAxMCPEventSourceWithPolicy(",
          "    client, \"inventory\", \"tenant:demo\", \"authenticated\",",
          "    ax.AxMCPSubscribeAll(),",
          ")",
          "runtime, err := ax.NewAxEventRuntime([]ax.AxEventRoute{{",
