        "code": [
          "transport, err := ax.NewAxMCPStreamableHTTPTransport(endpoint, nil)",
          "if err != nil { panic(err) }",
          "mcp := ax.NewAxMCPClient(transport, map[string]ax.Value{\"namespace\": \"inventory\"})",
          "defer func() { _ = mcp.Close() }()",
