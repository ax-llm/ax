          "program := ax.NewAx(\"request:string -> answer:string\", map[string]ax.Value{\"mcp\": mcp})",
          "llm := ax.NewOpenAICompatibleClient(map[string]ax.Value{",
          "    \"api_key\": key, \"model\": \"gpt-5.4-mini\",",
          "})",
          "output, err := program.Forward(context.Background(), llm,",
          "    map[string]ax.Value{\"request\": \"Reindex inventory.\"}, nil)",
          "if err != nil { panic(err) }",
