      "ucp": {
        "code": [
          "fn handle_ucp_webhook(request: Request) -> AxResult<()> {",
          "    // Verify signer profile, RFC 9421 signature, digest, freshness,",
          "    // key rotation, and replay state before publishing.",
          "    let order = verify_ucp_request(request)?;",
          "    let identity = lookup_buyer_identity(&order.checkout_id)?;",
          "    runtime.lock().unwrap().publish(",
          "        AxEventEnvelope {",
          "            specversion: \"1.0\".into(),",
          "            id: order.id, source: \"ucp://orders\".into(),",
          "            r#type: \"ucp.order.fulfilled\".into(),",
          "            subject: Some(order.checkout_id),",
          "            data: order.data,",
          "            extensions: serde_json::Map::new(), correlation: vec![],",
          "        },",
          "        &identity, \"authenticated\",",
          "    )?;",
          "    Ok(())",
          "}"
        ]
      }
