          "let mut runtime = AxEventRuntime::new(vec![route], json!({}))?;",
          "runtime.register_target(target);",
          "runtime.start()?;",
          "let runtime = Arc::new(Mutex::new(runtime));",
          "let mut source = AxMCPEventSource::with_policy(",
