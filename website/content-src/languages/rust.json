        "code": [
          "let route = AxEventRoute {",
          "    id: \"resource-wake\".into(),",
          "    action: \"wake\".into(),",
          "    r#match: json!({\"types\":[\"mcp.resource.updated\"]}),",
          "    target_id: Some(\"inventory-agent\".into()),",
          "    require_authenticated: true,",
          "    ordering: \"strict\".into(), debounce_ms: 0, instance_key: None,",
