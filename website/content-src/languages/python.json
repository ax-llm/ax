      "ucp": {
        "code": [
          "def handle_ucp_webhook(request):",
          "    # Verify signer profile, RFC 9421 signature, digest, freshness,",
          "    # key rotation, and replay state before publishing.",
          "    order = verify_ucp_request(request)",
          "    identity_scope = lookup_buyer_identity(order[\"checkout_id\"])",
          "    runtime.publish(",
          "        AxEventEnvelope(",
          "            order[\"id\"], \"ucp://orders\",",
          "            \"ucp.order.fulfilled\", order,",
          "        ),",
          "        identity_scope=identity_scope,",
          "        trust=\"authenticated\",",
          "    )",
          "    return Response(status=202)"
        ]
      }
