      "resourceWake": {
        "code": [
          "auto source = std::make_shared<axllm::AxMCPEventSource>(",
          "  client, \"inventory\", \"tenant:demo\", \"authenticated\",",
          "  axllm::AxMCPResourceSubscriptionPolicy::all());",
          "axllm::AxEventTarget target;",
          "target.id = \"inventory-agent\";",
          "target.retrySafety = \"idempotent\";",
          "target.mapInput = [](const axllm::AxEventEnvelope& event,",
