      "ucp": {
        "code": [
          "void handle_ucp_webhook(const HttpRequest& request) {",
          "  // Verify signer profile, RFC 9421 signature, digest, freshness,",
          "  // key rotation, and replay state before publishing.",
          "  auto order = verify_ucp_request(request);",
          "  auto identity = lookup_buyer_identity(order.checkout_id);",
          "  axllm::AxEventEnvelope event;",
          "  event.id = order.id;",
          "  event.source = \"ucp://orders\";",
          "  event.type = \"ucp.order.fulfilled\";",
          "  event.data = order.data;",
          "  runtime.publish(event, identity, \"authenticated\");",
          "}"
        ]
      }
