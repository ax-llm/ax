          "auto strategy = std::make_shared<axllm::AxBalancerAdaptiveStrategy>();",
          "strategy->deadline_ms = 6000; strategy->bad_outcome_cost = 0.02;",
          "strategy->stats_store = store; strategy->route_key = stable_route_key;",
          "strategy->slice = workflow_slice; strategy->on_routing_event = analytics_hook;",
          "axllm::AxBalancerOptions options; options.strategy = strategy;",
          "axllm::AxBalancer balancer(services, options);"
        ]
