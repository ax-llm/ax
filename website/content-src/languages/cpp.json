          "  return axllm::object({{\"uri\", axllm::Core::get(event.data, \"uri\")}});",
          "};",
          "target.invoke = invoke_agent;",
          "axllm::AxEventRuntime runtime({axllm::AxEventRoute{",
          "  \"resource-wake\", \"wake\",",
          "  axllm::object({{\"types\", axllm::array({\"mcp.resource.updated\"})}}),",
          "  \"inventory-agent\", true,",
          "}});",
          "runtime.register_target(std::move(target)).add_source(source).start();"
        ]
      },
